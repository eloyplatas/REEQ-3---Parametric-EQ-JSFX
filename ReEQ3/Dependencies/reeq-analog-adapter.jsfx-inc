function ri_commit(reset_state) instance(plan,nrun,tag,steps,ramp_left)(
 nrun=plan[0];tag=plan[1];ramp_left=reset_state?0:steps;
 nrun>0?this.s1.ri_load(plan+4,steps,reset_state);
 nrun>1?this.s2.ri_load(plan+28,steps,reset_state);
 nrun>2?this.s3.ri_load(plan+52,steps,reset_state);
 nrun>3?this.s4.ri_load(plan+76,steps,reset_state);
 nrun>4?this.s5.ri_load(plan+100,steps,reset_state);
 nrun>5?this.s6.ri_load(plan+124,steps,reset_state);
 nrun>6?this.s7.ri_load(plan+148,steps,reset_state);
 nrun>7?this.s8.ri_load(plan+172,steps,reset_state);
 nrun>8?this.s9.ri_load(plan+196,steps,reset_state);
 nrun>9?this.s10.ri_load(plan+220,steps,reset_state);
 nrun>10?this.s11.ri_load(plan+244,steps,reset_state);
 nrun>11?this.s12.ri_load(plan+268,steps,reset_state);
 nrun>12?this.s13.ri_load(plan+292,steps,reset_state);
 nrun>13?this.s14.ri_load(plan+316,steps,reset_state);
 nrun>14?this.s15.ri_load(plan+340,steps,reset_state);
 nrun>15?this.s16.ri_load(plan+364,steps,reset_state);
 nrun>16?this.s17.ri_load(plan+388,steps,reset_state);
 nrun>17?this.s18.ri_load(plan+412,steps,reset_state);
 nrun>18?this.s19.ri_load(plan+436,steps,reset_state);
 nrun>19?this.s20.ri_load(plan+460,steps,reset_state);
 );
function ri_fade(value) instance(wet,goal,fade_left,mix_step)(
 goal!==value || fade_left<=0?(goal=value;fade_left=max(16,ceil(.015*srate));mix_step=(goal-wet)/fade_left;);
);
function ri_accept(interval) instance(plan,domain,tag,nrun,wet,fade_left,goal,steps)(
 steps=interval;
 domain===1?(
  tag===plan[1]?(this.ri_commit(0);nrun && goal===0?this.ri_fade(1);):
  wet<=0?(this.ri_commit(1);nrun?this.ri_fade(1);):
  this.ri_fade(0);
