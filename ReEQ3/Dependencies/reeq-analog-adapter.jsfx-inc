@init
// A plan contains a count and topology tag, then up to twenty sections (two-pole,
// or one-pole where a record's order is 1). Each record includes the display's power coefficients.
function ri_bind(plan_address, curve_address, band_index, role)
 instance(plan,curve,idx,domain,nrun,tag,wet,fade_left,goal,ramp_left)(
  plan=plan_address;curve=curve_address;idx=band_index;domain=role;
  plan[0]=0;plan[1]=0;nrun=tag=wet=fade_left=goal=ramp_left=0;
  role===2?(this.n_run=this.op_run=0;);
);
function ri_record(plan,slot,kind,ord,hz,q,db) local(r)(
  r=plan+4+slot*24;r[0]=kind;r[1]=ord;r[2]=hz/srate;r[3]=q;r[4]=db;
);
// ---------------------------------------------------------------------------------------------------
// ReEQ3 designs. Every band is a chain of the engine's sections (kinds: 0 high pass, 1 low pass,
// 2 all pass, 3 high shelf, 4 low shelf, 5 band pass, 6 notch, 7 bell; order 1 or 2), so the audio, the
// drawn curve, the auto gain and the linear phase engine all follow the same recipe.
//
// Slopes: a band's slope step k is 6 * (k + 1) dB/oct, and may be fractional.
// ---------------------------------------------------------------------------------------------------
RI_MAX_SECTIONS = 20;

/*
 * A fractional-order shelf (Holters and Zoelzer's high order shelving: second-order shelves with the
 * Butterworth pole Qs, each a share of the gain), from slot n. N is the order (N * 6 dB/oct); a
 * fractional order puts its remainder into a first-order shelf and a second-order one whose shares
 * cross over smoothly, so the response never jumps as N moves. qmul scales the most resonant section
 * (1 keeps the Butterworth shape; an order-2 shelf with qmul q/0.7071 is the classic shelf at Q q).
 * Returns the next free slot.
 */
function ri_hz_shelf(plan, n, kind, hz, qmul, db, ordn) local(m, r, i, qs, best, bq) (
  ordn = max(ordn, 1); m = floor(ordn / 2 + 0.000001); r = ordn - 2 * m;
  best = -1; bq = 0; i = 0;
  loop(m,
    n < RI_MAX_SECTIONS ? (
      qs = 0.5 / sin((2 * i + 1) * $pi / (2 * ordn));
      ri_record(plan, n, kind, 2, hz, qs, 2 * db / ordn);
      qs > bq ? (bq = qs; best = n);
      n += 1;
    );
    i += 1;
  );
  r > 0.000001 ? (
    r <= 1 ? (
      n < RI_MAX_SECTIONS ? (ri_record(plan, n, kind, 1, hz, 1, r * db / ordn); n += 1);
    ) : (
      qs = 0.5 / sin((2 * m + 1) * $pi / (2 * (2 * m + 2)));
      n < RI_MAX_SECTIONS ? (ri_record(plan, n, kind, 1, hz, 1, (2 - r) * db / ordn); n += 1);
      n < RI_MAX_SECTIONS ? (ri_record(plan, n, kind, 2, hz, qs, 2 * (r - 1) * db / ordn); qs > bq ? (bq = qs; best = n); n += 1);
    );
  );
  best >= 0 && qmul != 1 ? plan[4 + best * 24 + 3] = max(plan[4 + best * 24 + 3] * qmul, 0.1);
  n;
);

/*
 * One second-order low shelf of the normalised prototype (gain g dB, quality Q), taken through the
 * low-pass to band-pass transform p = qb (s + 1/s) around hz. Its fourth-order result factors exactly
 * into two biquads (one above hz, one below); each biquad is a bell at its zeros' frequency times a
 * shelf that moves the poles to theirs. So four records, from slot n; returns the next free slot.
 */
function ri_csqrt(a, b) local(m) (
  m = sqrt(a * a + b * b);
  ri_sq_re = sqrt(max((m + a) * 0.5, 0));
  ri_sq_im = (b < 0 ? -1 : 1) * sqrt(max((m - a) * 0.5, 0));
);
// The two roots of s^2 - t s + 1 for the complex t = (tr, ti): (ri_ua_re, ri_ua_im) the one outside
// the unit circle, (ri_ul_re, ri_ul_im) the one inside
function ri_bp_roots(tr, ti) local(ar, ai, br, bi) (
  ri_csqrt(tr * tr - ti * ti - 4, 2 * tr * ti);
  ar = (tr + ri_sq_re) * 0.5; ai = (ti + ri_sq_im) * 0.5;
  br = (tr - ri_sq_re) * 0.5; bi = (ti - ri_sq_im) * 0.5;
  ar * ar + ai * ai >= br * br + bi * bi ? (
    ri_ua_re = ar; ri_ua_im = ai; ri_ul_re = br; ri_ul_im = bi;
  ) : (
    ri_ua_re = br; ri_ua_im = bi; ri_ul_re = ar; ri_ul_im = ai;
  );
);
function ri_bp_pair(plan, n, hz, zr, zi, pr, pi) local(wz, zz, wp, zp) (
  wz = sqrt(zr * zr + zi * zi); zz = max(-zr / wz, 0.00001);
  wp = sqrt(pr * pr + pi * pi); zp = max(-pr / wp, 0.00001);
  n < RI_MAX_SECTIONS ? (
    ri_record(plan, n, 7, 2, hz * wz, 0.5 / sqrt(zz * zp), 20 * log10(zz / zp)); n += 1;
  );
  n < RI_MAX_SECTIONS ? (
    ri_record(plan, n, 4, 2, hz * sqrt(wz * wp), 0.5 / zp, 40 * log10(wz / wp)); n += 1;
  );
  n;
);
function ri_bp_section(plan, n, hz, qb, qs, g) local(aG, aZ, b, c, d, zr, zi, pr, pi, zur, zui, zlr, zli) (
  aG = 10 ^ (g / 40); aZ = 0.5 / qs;
  // A root of each quadratic (Q >= 0.5, so they are complex or double)
  b = 2 * aZ * sqrt(aG); c = aG; d = b * b - 4 * c;
  zr = -b * 0.5; zi = sqrt(max(-d, 0)) * 0.5;
  b = 2 * aZ / sqrt(aG); c = 1 / aG; d = b * b - 4 * c;
  pr = -b * 0.5; pi = sqrt(max(-d, 0)) * 0.5;
  ri_bp_roots(zr / qb, zi / qb);
  zur = ri_ua_re; zui = ri_ua_im; zlr = ri_ul_re; zli = ri_ul_im;
  ri_bp_roots(pr / qb, pi / qb);
  n = ri_bp_pair(plan, n, hz, zur, zui, ri_ua_re, ri_ua_im);
  ri_bp_pair(plan, n, hz, zlr, zli, ri_ul_re, ri_ul_im);
);

/*
 * A bell steeper than 12 dB/oct: the band-pass transform of a fractional-order shelf (order S / 12), so
 * the half-gain bandwidth stays the one Q gives and the skirts fall at S dB/oct. At 12 dB/oct it is
 * exactly the classic bell.
 */
function ri_steep_bell(plan, n, hz, qb, db, S) local(ordn, m, r, i, qs) (
  ordn = max(S / 12, 1); m = floor(ordn / 2 + 0.000001); r = ordn - 2 * m;
  i = 0;
  loop(m,
    qs = 0.5 / sin((2 * i + 1) * $pi / (2 * ordn));
    n + 4 <= RI_MAX_SECTIONS ? n = ri_bp_section(plan, n, hz, qb, qs, 2 * db / ordn);
    i += 1;
  );
  r > 0.000001 ? (
    r <= 1 ? (
      n < RI_MAX_SECTIONS ? (ri_record(plan, n, 7, 2, hz, qb, r * db / ordn); n += 1);
    ) : (
      n < RI_MAX_SECTIONS ? (ri_record(plan, n, 7, 2, hz, qb, (2 - r) * db / ordn); n += 1);
      qs = 0.5 / sin((2 * m + 1) * $pi / (2 * (2 * m + 2)));
      n + 4 <= RI_MAX_SECTIONS ? n = ri_bp_section(plan, n, hz, qb, qs, 2 * (r - 1) * db / ordn);
    );
  );
  n;
);

/*
 * The extra fraction a (0..1) of 6 dB/oct beyond a cut's whole order: a staircase of shelves an octave
 * and a half apart, each 9a dB, running from the cut frequency out to the edge of the audio range. Low
 * cuts (lo = 1) step down below hz, high cuts above it.
 */
function ri_cut_fraction(plan, n, lo, hz, a) local(j, f) (
  a > 0.005 ? (
    j = 0;
    f = lo ? hz * 2 ^ (-0.75) : hz * 2 ^ 0.75;
    while (n < RI_MAX_SECTIONS && (lo ? f >= 7 : f <= 40000)) (
      ri_record(plan, n, lo ? 4 : 3, 2, f, 0.55, -9 * a);
      n += 1; j += 1;
      f = lo ? hz * 2 ^ (-(j + 0.5) * 1.5) : hz * 2 ^ ((j + 0.5) * 1.5);
    );
  );
  n;
);

/*
 * Flat Tilt: a constant slope through hz across the whole range, db at five octaves either side (so
 * db / 5 dB/oct). High shelves above the pivot and low shelves below it, an octave and a half apart.
 */
function ri_flat_tilt(plan, n, hz, db) local(st, j, f, done_hi, done_lo) (
  db != 0 ? (
    st = db / 5 * 1.5;
    j = 0; done_hi = done_lo = 0;
    while (n < RI_MAX_SECTIONS && !(done_hi && done_lo)) (
      f = hz * 2 ^ ((j + 0.5) * 1.5);
      f <= 40000 && n < RI_MAX_SECTIONS ? (ri_record(plan, n, 3, 2, f, 0.55, st); n += 1) : done_hi = 1;
      f = hz * 2 ^ (-(j + 0.5) * 1.5);
      f >= 7 && n < RI_MAX_SECTIONS ? (ri_record(plan, n, 4, 2, f, 0.55, -st); n += 1) : done_lo = 1;
      j += 1;
    );
  );
  n;
);

// Whether a band's design is the one section the dynamic engine glides through its curve cache: a 12
// dB/oct bell or shelf
function ri_single_section(type, slope) (
  (type === 0 && slope <= 1.0001) || ((type === 3 || type === 4) && abs(slope - 1) < 0.0001);
);

function ri_recipe(plan,type,hz,q,db,slope,dynamic) local(n,i,ord,k,qq,cut,t,fr,cs,r)(
  n=0;
  type===0 ? (
    dynamic || db!==0 ? (
      slope <= 1.0001 ? (ri_record(plan,0,7,2,hz,q,db);n=1;) : n=ri_steep_bell(plan,0,hz,q,db,6*(slope+1));
    );
  ):type===3 || type===4 ? (
    dynamic || db!==0 ? (
      k=type===3?4:3;
      abs(slope-1)<0.0001 ? (ri_record(plan,0,k,2,hz,q,db);n=1;) : n=ri_hz_shelf(plan,0,k,hz,q/0.7071,db,slope+1);
    );
  ):type===1 || type===2 || type===5 || type===6 ? (
    slope=min(max(slope,0),19);
    ord=min(20,max(1,floor(slope+0.000001)+1));fr=slope+1-ord;k=type<=2?0:1;i=0;
    loop(floor(ord/2),qq=(type===2 || type===6)?.5/cos($pi*(2*i+1+(ord&1))/(2*ord)):q;
      ri_record(plan,i,k,2,hz,qq,0);i+=1;);
    n=i;ord&1?(ri_record(plan,n,k,1,hz,1,0);n+=1;);
    n=ri_cut_fraction(plan,n,type<=2,hz,fr);
  ):type===7 || type===8 || type===11 ? (
    ri_record(plan,0,type===7?6:type===8?5:2,2,hz,q,0);n=1;
  ):type===9 ? (
    db!==0?(
      abs(slope-1)<0.0001 ? (ri_record(plan,0,3,2,hz,q,db);ri_record(plan,1,4,2,hz,q,-db);n=2;) : (
        n=ri_hz_shelf(plan,0,3,hz,q/0.7071,db,slope+1);
        n=ri_hz_shelf(plan,n,4,hz,q/0.7071,-db,slope+1);
      );
    );
  ):type===10 ? (
    db!==0?(cut=(q/40)*min(max(db,0),10);ri_record(plan,0,4,2,1.5*hz,.701,db);
      ri_record(plan,1,7,2,1.5*hz,.701,-cut);n=2;);
  ):type===12 ? (
    ri_record(plan,0,4,2,1.25*hz,.701,db);ri_record(plan,1,0,1,hz,1,0);n=2;
  ):type===13 ? (
    t=1+max(db,-12)/12;cut=min(22040,db>0?22000:hz*(1+3.25*t));
    ri_record(plan,0,3,2,hz,.701,db);ri_record(plan,1,1,2,cut,.701,0);n=2;
  ):type===14 ? (
    n=ri_flat_tilt(plan,0,hz,db);
  );
  // The topology tag: the band glides between designs with the same sections, and crossfades when
  // they change
  cs=0;i=0;loop(n,r=plan+4+i*24;cs+=(r[0]*2+r[1]+1)*(i+1);i+=1;);
  plan[0]=n;plan[1]=n?(type+1)*1000000+n*10000+(cs%10000):0;
);
// Supply the original analog magnitude evaluator with the same section recipe as the audio.
function ri_visual_section(r) instance(aT,aF,aZ,aG,aO)(
  aT=r[0];aO=r[1]===1;aF=r[2]*srate;aZ=.5/r[3];aG=r[4]===0?1:10^(r[4]/40);
);
function ri_prepare_visual() instance(plan,n_run,op_run)(
  // Every section draws itself, first-order ones included (ri_visual_section keeps the order)
  n_run=min(plan[0],20);op_run=0;
  n_run>0?this.s1.ri_visual_section(plan+4);
  n_run>1?this.s2.ri_visual_section(plan+28);
  n_run>2?this.s3.ri_visual_section(plan+52);
  n_run>3?this.s4.ri_visual_section(plan+76);
  n_run>4?this.s5.ri_visual_section(plan+100);
  n_run>5?this.s6.ri_visual_section(plan+124);
  n_run>6?this.s7.ri_visual_section(plan+148);
  n_run>7?this.s8.ri_visual_section(plan+172);
  n_run>8?this.s9.ri_visual_section(plan+196);
  n_run>9?this.s10.ri_visual_section(plan+220);
  n_run>10?this.s11.ri_visual_section(plan+244);
  n_run>11?this.s12.ri_visual_section(plan+268);
  n_run>12?this.s13.ri_visual_section(plan+292);
  n_run>13?this.s14.ri_visual_section(plan+316);
  n_run>14?this.s15.ri_visual_section(plan+340);
  n_run>15?this.s16.ri_visual_section(plan+364);
  n_run>16?this.s17.ri_visual_section(plan+388);
  n_run>17?this.s18.ri_visual_section(plan+412);
  n_run>18?this.s19.ri_visual_section(plan+436);
  n_run>19?this.s20.ri_visual_section(plan+460);
 );
function ri_target(r,curve,k,o,f,q,g,graphics) local(hit)(
    hit=curve>=0 && curve[0]>0 && k===curve[1] && o===curve[2] && f===curve[3] && q===curve[4] && g>=curve[8] && g<=curve[8+(curve[0]-1)*40+1];
    !(hit && this.reader.wf_curve_read(this.v,curve,g))?this.designer.wf_design(this.v,AF_Bank,AF_Notch,AF_Wide,k,o,f,q,g);
    r[5]=this.v.md;r[6]=this.v.mp;r[7]=this.v.mr;r[8]=this.v.mq;r[9]=this.v.mo0;r[10]=this.v.mo1;
    r[11]=this.v.cp;r[12]=this.v.cd;r[13]=this.v.nv_k;r[14]=this.v.mt;
    graphics?(
      this.plot.ef_plot_coefficients(this.v,k,o===1);
      r[14]=this.plot.num_dc;r[15]=this.plot.num_real_mix;r[16]=this.plot.num_imag_mix;r[17]=this.plot.num_ny;
      r[18]=this.plot.den_dc;r[19]=this.plot.den_real_mix;r[20]=this.plot.den_imag_mix;r[21]=this.plot.den_ny;
    );
);
function ri_compute(plan,curve,graphics) local(n,r,k,o,f,q,g,prev)(
  n=plan[0];n>0?(
    r=plan+4;this.ri_target(r,curve,r[0],r[1],r[2],r[3],r[4],graphics);
    n>1?loop(n-1,
      prev=r;r+=24;k=r[0];o=r[1];f=r[2];q=r[3];g=r[4];
      k===prev[0] && o===prev[1] && f===prev[2] && q===prev[3] && g===prev[4]?memcpy(r+5,prev+5,graphics?17:10):
        this.following.ri_target(r,curve,k,o,f,q,g,graphics);
