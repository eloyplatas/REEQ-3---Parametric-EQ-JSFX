desc: ReEQ3 Clarity (adaptive unmasking)
/*
  ReEQ3: Clarity, an equaliser that readjusts itself all the time to reduce masking: it brings down what
  dominates its neighbourhood and brings up what is being masked. Built from textbook psychoacoustics
  (critical bands and a spreading function), not from anyone's proprietary model.

  Analysis (every CL_H samples, about 190 times a second at 48 kHz): one complex transform of the last
  CL_N samples (left in the real part, right in the imaginary one) gives the power of both channels in
  31 third-octave bands. Each band's level is compared with the excitation the other bands spread onto
  it (27 dB per Bark towards lower frequencies, 10 dB per Bark towards higher ones), relative to what a
  flat (pink) spectrum would give:
    - above it by more than the dead zone: dominant, Tame cuts it;
    - below it: masked, Recover lifts it (not what lies far below the programme: noise).
  Bias moves the frontier between both, Brighten leans the correction towards the highs or the lows,
  Boost adds the change in balance that a change of listening level brings (equal-loudness contours),
  and the two range limits keep Recover and Tame inside (or, crossed, outside) a range.

  Processing (3.7): the curve is applied by a linear-phase, time-varying FIR through windowed
  overlap-add with zero padding (Allen; Smith, "Spectral Audio Signal Processing", STFT with
  modifications): frames of M samples (Hann, hop M/2, which adds to a constant), each filtered by the
  curve of its moment, a 2M+1-tap linear-phase response (the curve, interpolated per bin, turned into
  a zero-phase impulse, Hann-windowed to 2M+1 taps and delayed by M), in an FFT of 4M points so the
  convolution never wraps (N >= M + L - 1). Successive frames' filters are cross-faded by the windows'
  overlap; since every filter has the same, pure delay, nothing moves in phase while the curve moves:
  no phasing or flanging, whatever the settings (minimum-phase filters that move do move their phase,
  which is what was heard before). Latency 2M (43 ms at 44.1 and 48 kHz).

  MIT License, (c) 2026 Eloy Platas.
*/

@init

CL_NB = 31;

function cl_bark(f) ( 13 * atan(0.00076 * f) + 3.5 * atan(sqr(f / 7500)); );
// K-weighting as a power gain (as in the Tonal Balance engine)
function cl_kw(f) local(o, a, sa, q, nr, ni, dr, di, hs) (
  o = f / 1681.97; a = 10 ^ (4 / 40); sa = sqrt(a); q = 0.7072;
  nr = a * (1 - a * o * o); ni = a * sa / q * o; dr = a - o * o; di = sa / q * o;
  hs = (nr * nr + ni * ni) / (dr * dr + di * di);
  o = f / 38.135;
  hs * o * o * o * o / (sqr(1 - o * o) + sqr(o / 0.5003));
);

function cl_alloc(mem) (
  mem = ceil(mem / 65536) * 65536;
  CL_X = mem; mem += 32768; CL_HF = mem; mem += 32768;      // a frame's transform, the filter's
  mem = ceil(mem / 65536) * 65536;
  CL_HD = mem; mem += 32768; CL_FFT = mem; mem += 16384;    // designing the filter; the analysis
  CL_WIN = mem; mem += 8192; CL_FW = mem; mem += 4096;      // the analysis window; the frames' window
  CL_RL = mem; mem += 8192; CL_RR = mem; mem += 8192;       // what is analysed
  CL_ML = mem; mem += 8192; CL_MR = mem; mem += 8192;       // the main input, while a sidechain is analysed
  CL_IL = mem; mem += 8192; CL_IR = mem; mem += 8192;       // the input, for the frames
  CL_AL = mem; mem += 32768; CL_AR = mem; mem += 32768;     // the output being overlap-added
  CL_BP = mem; mem += 8200;                                 // each bin's place among the bands
  CL_FC = mem; mem += CL_NB;
  CL_K0 = mem; mem += CL_NB; CL_K1 = mem; mem += CL_NB; CL_KF = mem; mem += CL_NB; CL_KS = mem; mem += CL_NB;
  CL_P = mem; mem += CL_NB; CL_LS = mem; mem += CL_NB; CL_PM = mem; mem += CL_NB; CL_LM = mem; mem += CL_NB;
  CL_D0 = mem; mem += CL_NB; CL_KWT = mem; mem += CL_NB; CL_BK = mem; mem += CL_NB; CL_TL = mem; mem += CL_NB;
  CL_RW = mem; mem += CL_NB;
  CL_T = mem; mem += CL_NB; CL_T2 = mem; mem += CL_NB; CL_G = mem; mem += CL_NB;
  CL_G1 = mem; mem += CL_NB; CL_G2 = mem; mem += CL_NB;
  CL_W = mem; mem += CL_NB * CL_NB;      // the spreading weights, onto band i from band j
  mem;
);

function cl_reset() (
  memset(CL_RL, 0, 8192); memset(CL_RR, 0, 8192); memset(CL_ML, 0, 8192); memset(CL_MR, 0, 8192);
  memset(CL_IL, 0, 8192); memset(CL_IR, 0, 8192); memset(CL_AL, 0, 32768); memset(CL_AR, 0, 32768);
  memset(CL_LS, 0, CL_NB); memset(CL_LM, 0, CL_NB);
  memset(CL_G, 0, CL_NB); memset(CL_G1, 0, CL_NB); memset(CL_G2, 0, CL_NB); memset(CL_T2, 0, CL_NB);
  CL_RP = CL_IP = CL_HC = 0; CL_TT = 0; CL_Comp1 = CL_Comp2 = 0; CL_CompT = 0;
  CL_Primed = 0; CL_Designed = -1;
);

// The speed: how fast the levels follow (up, down) and the gains glide, per hop. 0 Slow, 1 Medium, 2 Fast.
function cl_speed(sp) local(u, d, g, r) (
  sp == 0 ? (u = 0.2; d = 0.4; g = 0.12; r = 15) : sp == 1 ? (u = 0.08; d = 0.15; g = 0.04; r = 40) : (u = 0.03; d = 0.07; g = 0.02; r = 100);
  CL_LA = 1 - exp(-CL_R / (u * CL_SR)); CL_LR = 1 - exp(-CL_R / (d * CL_SR));
  CL_GC = 1 - exp(-CL_R / (g * CL_SR));
  // The most a band's gain may move per hop (dB): r dB per second
  CL_SLEW = r * CL_R / CL_SR;
  CL_SpeedLive = sp;
);

function cl_setup(sr) local(i, j, f, lo, hi, df, dz, s, k) (
  CL_SR = sr;
  s = sr > 100000 ? 4 : sr > 50000 ? 2 : 1;
  // Analysis: CL_N samples (about 43 ms); processing: frames of CL_M, hop CL_R, FFT of CL_NF, delay CL_D
  CL_N = 2048 * s;
  CL_M = 1024 * s; CL_R = CL_M / 2; CL_NF = 4 * CL_M; CL_DL0 = CL_M; CL_D = 2 * CL_M;
  i = 0; loop(CL_N, CL_WIN[i] = 0.5 - 0.5 * cos(2 * $pi * i / CL_N); i += 1);
  i = 0; loop(CL_M, CL_FW[i] = 0.5 - 0.5 * cos(2 * $pi * i / CL_M); i += 1);
  df = sr / CL_N;
  CL_NA = 0;
  i = 0;
  loop(CL_NB,
    f = 20 * 2 ^ (i / 3);
    CL_FC[i] = f;
    f < 0.45 * sr ? CL_NA = i + 1;
    lo = f * 2 ^ (-1 / 6); hi = min(f * 2 ^ (1 / 6), 0.5 * sr - df);
    CL_K0[i] = max(ceil(lo / df), 1); CL_K1[i] = min(floor(hi / df), CL_N / 2 - 1);
    // Narrower than two bins: the density at the centre, times the width
    CL_KF[i] = f / df; CL_KS[i] = (hi - lo) / df;
    CL_KWT[i] = cl_kw(f);
    CL_BK[i] = cl_bark(f);
    // Boost: how the balance shifts per dB of level (from the equal-loudness contours, 60 to 80 phon)
    CL_TL[i] = min(max(log(f / 1000) / log(2) / 4, -1), 1);
    i += 1;
  );
  // Each filter bin's place among the bands (fractional), for interpolating the curve
  k = 0;
  loop(CL_NF / 2 + 1,
    f = max(k * sr / CL_NF, 1);
    CL_BP[k] = min(max(3 * log(f / 20) / log(2), 0), CL_NA - 1);
    k += 1;
  );
  // Spreading: band j's power onto band i
  i = 0;
  loop(CL_NB,
    s = 0; j = 0;
    loop(CL_NB,
      dz = CL_BK[i] - CL_BK[j];
      CL_W[i * CL_NB + j] = i == j ? 0 : 10 ^ ((dz >= 0 ? -10 * dz : 27 * dz) / 10);
      j < CL_NA ? s += CL_W[i * CL_NB + j];
      j += 1;
    );
    // What a flat spectrum gives: the reference
    CL_D0[i] = -10 * log10(s + 0.000001);
    i += 1;
  );
  cl_speed(CL_SpeedLive);
  cl_reset();
);

// The range limits' weight per band: inside lo..hi, or outside hi..lo when they are crossed (a third of
// an octave of transition)
function cl_range(lo, hi) local(i, o, a, b, w) (
  i = 0;
  loop(CL_NB,
    o = log(CL_FC[i]) / log(2);
    a = log(min(lo, hi)) / log(2); b = log(max(lo, hi)) / log(2);
    w = min(max((o - a) * 3 + 0.5, 0), 1) * min(max((b - o) * 3 + 0.5, 0), 1);
    CL_RW[i] = lo <= hi ? w : 1 - w;
    i += 1;
  );
);

// The band powers of a pair of rings (their last CL_N samples up to pos) into out
function cl_levels(rl, rr, pos, out) local(i, p, k, acc, x, sc, n2, a, b) (
  i = 0; p = pos;
  loop(CL_N,
    CL_FFT[2 * i] = rl[p] * CL_WIN[i]; CL_FFT[2 * i + 1] = rr[p] * CL_WIN[i];
    p = (p + 1) & (CL_N - 1);
    i += 1;
  );
  fft(CL_FFT, CL_N);
  fft_permute(CL_FFT, CL_N);
  // |L|^2 + |R|^2 at bin k is half of |Z(k)|^2 + |Z(N-k)|^2; Hann's power gain 0.375, one side twice
  sc = 0.5 * 2 / (CL_N * CL_N * 0.375);
  n2 = 2 * CL_N;
  i = 0;
  loop(CL_NA,
    CL_K1[i] - CL_K0[i] >= 1 ? (
      acc = 0; k = CL_K0[i];
      loop(CL_K1[i] - CL_K0[i] + 1,
        acc += sqr(CL_FFT[2 * k]) + sqr(CL_FFT[2 * k + 1]) + sqr(CL_FFT[n2 - 2 * k]) + sqr(CL_FFT[n2 - 2 * k + 1]);
        k += 1;
      );
    ) : (
      k = max(floor(CL_KF[i]), 1); x = CL_KF[i] - k;
      a = sqr(CL_FFT[2 * k]) + sqr(CL_FFT[2 * k + 1]) + sqr(CL_FFT[n2 - 2 * k]) + sqr(CL_FFT[n2 - 2 * k + 1]);
      k += 1;
      b = sqr(CL_FFT[2 * k]) + sqr(CL_FFT[2 * k + 1]) + sqr(CL_FFT[n2 - 2 * k]) + sqr(CL_FFT[n2 - 2 * k + 1]);
      acc = ((1 - x) * a + x * b) * CL_KS[i];
    );
    out[i] = acc * sc;
    i += 1;
  );
);

/*
 * An analysis: levels, the model, the wanted curve and the bells' gains. rec and tame 0..2, bias and
 * bright -1..1, boost in dB, sc whether a sidechain is analysed.
 */
function cl_analyse(rec, tame, bias, bright, boost, sc) local(i, j, a, xo, d, lv, lmax, up, dn, t, w, num, den, g, row, s, x) (
  cl_levels(CL_RL, CL_RR, CL_RP, CL_P);
  sc ? cl_levels(CL_ML, CL_MR, CL_RP, CL_PM);
  lmax = 0;
  i = 0;
  loop(CL_NA,
    a = CL_P[i] > CL_LS[i] ? CL_LA : CL_LR;
    CL_Primed ? CL_LS[i] += a * (CL_P[i] - CL_LS[i]) : CL_LS[i] = CL_P[i];
    sc ? (CL_Primed ? CL_LM[i] += a * (CL_PM[i] - CL_LM[i]) : CL_LM[i] = CL_PM[i]);
    lmax = max(lmax, CL_LS[i]);
    i += 1;
  );
  CL_Primed = 1;
  s = 4 * bias;
  // Each band against what the others spread onto it (relative to a flat spectrum)...
  i = 0;
  loop(CL_NA,
    row = CL_W + i * CL_NB;
    xo = 0; j = 0;
    loop(CL_NA, xo += row[j] * CL_LS[j]; j += 1);
    lv = CL_LS[i];
    CL_T[i] = lv > 0.0000000001 ? 10 * log10(lv / (xo + 0.000000000001)) - CL_D0[i] : -999;
    i += 1;
  );
  // ...less its local trend (about an octave and a half each way), so the overall tilt is left to Brighten
  i = 0;
  loop(CL_NA,
    w = 0; t = 0; j = max(i - 4, 0);
    loop(min(i + 4, CL_NA - 1) - j + 1, j != i && CL_T[j] > -900 ? (t += CL_T[j]; w += 1); j += 1);
    CL_PM[i] = w > 0 ? t / w : 0;
    i += 1;
  );
  i = 0;
  loop(CL_NA,
    lv = CL_LS[i];
    t = 0;
    CL_T[i] > -900 && lmax > 0.00000001 ? (
      d = CL_T[i] - CL_PM[i];
      // Dominant: a cut that grows with how far the band stands out, and saturates (8.5 dB at 100%)
      x = max(d - 1 - s, 0);
      dn = tame * 8.5 * (1 - exp(-x / 5));
      // Masked: a lift (7 dB at most at 100%) for what is at risk of being masked; what lies far under
      // its neighbours (12 dB and more) is inaudible or noise, and is left alone
      x = max(s - 1 - d, 0);
      up = rec * 7 * (1 - exp(-x / 4)) * exp(-sqr(max(x - 12, 0) / 8));
      up *= min(max((10 * log10(lv / lmax) + 60) / 12, 0), 1);
      up *= max(1 + bright * CL_TL[i], 0); dn *= max(1 - bright * CL_TL[i], 0);
      t = CL_RW[i] * (up - dn);
    );
    CL_T2[i] = t;
    i += 1;
  );
  // Brighten also leans the whole curve (up to 3 dB at the ends at 100%), scaled by how much is going on
  i = 0; loop(CL_NA, CL_T[i] = CL_T2[i] + bright * 3 * CL_TL[i] * min(rec + tame, 1); i += 1);
  // Across the bands: a little smoothing, then Boost's fixed shape
  num = den = 0;
  i = 0;
  loop(CL_NA,
    t = 0.7 * CL_T[i] + 0.15 * CL_T[max(i - 1, 0)] + 0.15 * CL_T[min(i + 1, CL_NA - 1)];
    t += boost * 0.75 / (1 + (CL_FC[i] / 40) ^ 1.4);
    t = min(max(t, -18), 18);
    CL_T2[i] = t;
    // The loudness the curve adds, on the processed signal's own levels
    w = (sc ? CL_LM[i] : CL_LS[i]) * CL_KWT[i];
    num += w * 10 ^ (t / 10); den += w;
    i += 1;
  );
  CL_CompT = den > 0.000000000001 ? -10 * log10(num / den) : 0;
  CL_CompT = min(max(CL_CompT, -18), 18);
  i = 0; loop(CL_NA, CL_G[i] = CL_T2[i]; i += 1);
);

/*
 * Per hop: the curve glides, the filter that applies it (times m, the Mix) is designed, and the newest
 * frame goes through it into the overlap-add.
 */
function cl_design(m) local(k, f, p, i0, x, db, mag, n, w, nf, d) (
  nf = CL_NF; d = CL_DL0;
  // The magnitude per bin, zero phase, in natural order
  k = 0;
  loop(nf / 2 + 1,
    p = CL_BP[k]; i0 = min(floor(p), CL_NA - 2); x = p - i0;
    db = m * ((1 - x) * CL_G2[i0] + x * CL_G2[i0 + 1] + CL_Comp2);
    mag = exp(db * 0.1151292546);
    CL_HD[2 * k] = mag; CL_HD[2 * k + 1] = 0;
    k > 0 && k < nf / 2 ? (CL_HD[2 * (nf - k)] = mag; CL_HD[2 * (nf - k) + 1] = 0);
    k += 1;
  );
  fft_ipermute(CL_HD, nf);
  ifft(CL_HD, nf);
  // Its impulse, Hann-windowed to 2d+1 taps and delayed by d, then transformed (kept in the FFT's order)
  memset(CL_HF, 0, 2 * nf);
  n = -d;
  loop(2 * d + 1,
    w = 0.5 + 0.5 * cos($pi * n / (d + 1));
    CL_HF[2 * (n + d)] = CL_HD[2 * ((n + nf) % nf)] * w / nf;
    n += 1;
  );
  fft(CL_HF, nf);
);

function cl_frame() local(i, p, nf, a, re, im, hr, hi, sc) (
  nf = CL_NF;
  // The newest M input samples (stereo as real and imaginary), windowed, zero padded
  memset(CL_X, 0, 2 * nf);
  p = (CL_IP - CL_M) & 8191;
  i = 0;
  loop(CL_M,
    CL_X[2 * i] = CL_IL[p] * CL_FW[i]; CL_X[2 * i + 1] = CL_IR[p] * CL_FW[i];
    p = (p + 1) & 8191;
    i += 1;
  );
  fft(CL_X, nf);
  i = 0;
  loop(nf,
    re = CL_X[2 * i]; im = CL_X[2 * i + 1]; hr = CL_HF[2 * i]; hi = CL_HF[2 * i + 1];
    CL_X[2 * i] = re * hr - im * hi; CL_X[2 * i + 1] = re * hi + im * hr;
    i += 1;
  );
  ifft(CL_X, nf);
  // Into the overlap-add, from the frame's start
  sc = 1 / nf;
  a = (CL_TT - CL_M) & 32767;
  i = 0;
  loop(nf,
    CL_AL[a] += CL_X[2 * i] * sc; CL_AR[a] += CL_X[2 * i + 1] * sc;
    a = (a + 1) & 32767;
    i += 1;
  );
);

function cl_hop(rec, tame, bias, bright, boost, sc, m) local(i) (
  cl_analyse(rec, tame, bias, bright, boost, sc);
  // Each band's gain: a slew limit (no sudden jumps, the source of crackle and phasiness in
  // time-varying filters), then two one-pole smoothers
  i = 0;
  loop(CL_NA,
    CL_G1[i] += min(max(CL_GC * (CL_G[i] - CL_G1[i]), -CL_SLEW), CL_SLEW);
    CL_G2[i] += CL_GC * (CL_G1[i] - CL_G2[i]);
    i += 1;
  );
  CL_Comp1 += CL_GC * (CL_CompT - CL_Comp1);
  CL_Comp2 += CL_GC * (CL_Comp1 - CL_Comp2);
  cl_design(m);
  cl_frame();
);

// One stereo sample in (l, r); CL_OL and CL_OR out, CL_D samples late
function cl_tick(l, r, rec, tame, bias, bright, boost, sc, m) local(a) (
  CL_IL[CL_IP] = l; CL_IR[CL_IP] = r;
  CL_IP = (CL_IP + 1) & 8191;
  CL_TT = (CL_TT + 1) & 32767;
  // What is due now: frames are added from their start, so the output trails the input by M (plus the
  // filter's own delay, d)
  a = (CL_TT - CL_M - 1) & 32767;
  CL_OL = CL_AL[a]; CL_OR = CL_AR[a]; CL_AL[a] = 0; CL_AR[a] = 0;
  (CL_HC += 1) >= CL_R ? (CL_HC = 0; cl_hop(rec, tame, bias, bright, boost, sc, m));
);

// The curve in force at a frequency (dB, before the Mix), for drawing
function cl_curve_db(f) local(p, i0, x) (
  p = min(max(3 * log(max(f, 1) / 20) / log(2), 0), CL_NA - 1);
  i0 = min(floor(p), CL_NA - 2); x = p - i0;
  (1 - x) * CL_G2[i0] + x * CL_G2[i0 + 1] + CL_Comp2;
);
