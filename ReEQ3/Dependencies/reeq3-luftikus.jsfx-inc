/*
 * Memory: the table, per channel (2) the six filters' states and gains, the coefficients in use
 */
function lf_alloc(base) (
  LF_TAB = base; base += 300;
  LF_CO = base; base += 30;          // the six filters' coefficients in use
  LF_ST = base; base += 2 * 6 * 4;   // per channel and filter: x1 x2 y1 y2
  LF_GN = base; base += 2 * 6;       // per channel the six gains as set (with Analog's offsets)
  LF_G = base; base += 2 * 6;        // per channel the six summing gains
  LF_PG = base; base += 2 * 6;       // per channel the six wet gains
  LF_LAST = base; base += 6;         // the parameters as last seen
  LF_GG = base; base += 2;           // per channel the global gain
  LF_CURVE = base; base += 16384;    // the drawn response, per column, in dB
  lf_tables(LF_TAB);
  memset(LF_ST, 0, 48);
  memset(LF_LAST, -1000, 6);
  memset(LF_GN, 0, 12);
  LF_SRK = -1;
  base;
);

// The original's choice of table for a sample rate
function lf_srk(sr) (
  sr <= 44100 ? 0 : sr <= 48000 ? 1 : sr <= 88200 ? 2 : sr <= 96000 ? 3 : sr <= 176400 ? 4 : 5;
);

// The coefficients for the sample rate and the Air type (0 off: an all-zero filter)
function lf_setup(sr, hitype) local(k, i, j) (
  k = lf_srk(sr);
  i = 0;
  loop(5, j = 0; loop(5, LF_CO[i * 5 + j] = LF_TAB[(k * 10 + i) * 5 + j]; j += 1); i += 1);
  hitype > 0 ? (
    j = 0; loop(5, LF_CO[25 + j] = LF_TAB[(k * 10 + 4 + hitype) * 5 + j]; j += 1);
  ) : memset(LF_CO + 25, 0, 5);
  LF_SRK = k; LF_HIT = hitype;
);

/*
 * EqDsp::setGain for one parameter, both channels. A move bigger than 0.08 with Analog on lands with a
 * random error (a fifth of it in Mastering), drawn per channel as the original's EqDsp per channel does.
 */
function lf_set_gain(i, v) local(ch, g, changed) (
  ch = 0;
  loop(2,
    g = LF_GN[ch * 6 + i];
    changed = abs(g - v) > 0.08;
    g = v;
    LF_Analog && changed ? g += (rand(1) - 0.5) * 0.08 * (LF_Mastering ? 0.2 : 1);
    LF_GN[ch * 6 + i] = g;
    ch += 1;
  );
);

/*
 * The gain laws of EqDsp::processBlock: the summing gain g and wet gain pg per filter, and the global
 * gain (Keep Gain: 0.398 over the summed g, else 0.29)
 */
function lf_gains() local(ch, i, x, g, dc) (
  ch = 0;
  loop(2,
    dc = 0; i = 0;
    loop(5,
      x = LF_GN[ch * 6 + i] / 20 + 0.5;
      x > 0.5 ? (
        g = 0.5 * 56.2 / (5.56 + (4011.4 * exp(-7.4746 * x) - 0.54573)); LF_PG[ch * 6 + i] = 1;
      ) : x >= 0.25 ? (
        g = 0.5 * 56.2 / (5.56 + (500 - 810 * (x - 0.25) * 2)); LF_PG[ch * 6 + i] = 1;
      ) : (
        g = 0.5 * 56.2 / (5.56 + 500); LF_PG[ch * 6 + i] = x * 4;
      );
      LF_G[ch * 6 + i] = g; dc += g;
      i += 1;
    );
    x = LF_GN[ch * 6 + 5] / 10;
    g = 0.5 * 56.2 / (5.56 + (x <= 0.5 ? 500 - 823.6 * x : 3258.2 * exp(-7.4126 * x) - 1.8466));
    LF_G[ch * 6 + 5] = g; LF_PG[ch * 6 + 5] = 1;
    LF_HIT > 0 ? dc += g;
    LF_GG[ch] = LF_KeepGain ? 0.398 / dc : 0.29;
    ch += 1;
  );
);

/*
 * Per block: the parameters (gains -10..10, Air 0..10, its type, the switches, the trim in dB) into
 * the engine. Only a parameter that moved goes through setGain, as with the original's setParameter.
 */
function lf_block(sr, g10, g40, g160, g640, g2k5, air, hitype, keep, analog, mastering, trim_db) local(i, v, re) (
  LF_KeepGain = keep; LF_Analog = analog; LF_Mastering = mastering;
  LF_Vol = 10 ^ (min(max(trim_db, -20), 20) / 20);
  re = 0;
  i = 0;
  loop(6,
    v = i == 0 ? g10 : i == 1 ? g40 : i == 2 ? g160 : i == 3 ? g640 : i == 4 ? g2k5 : air;
    v = i < 5 ? min(max(v, -10), 10) : min(max(v, 0), 10);
    v != LF_LAST[i] ? (LF_LAST[i] = v; lf_set_gain(i, v); re = 1);
    i += 1;
  );
  lf_srk(sr) != LF_SRK || hitype != LF_HIT ? (lf_setup(sr, hitype); re = 1);
  keep != LF_LastKeep ? (LF_LastKeep = keep; re = 1);
  re ? (lf_gains(); LF_CurveDirty = 1);
);

/*
 * One sample of one channel: the six filters in parallel, each output scaled by its wet gain, added to
 * the input and scaled by its summing gain; the sum times the global gain and the trim. Analog adds the
 * original's tiny noise at each filter's input and at the output.
 */
function lf_tick(x, ch) local(i, c, s, xn, y, acc, n, gb) (
  acc = 0; i = 0; gb = ch * 6;
  n = LF_HIT > 0 ? 6 : 5;
  loop(n,
    c = LF_CO + i * 5; s = LF_ST + (gb + i) * 4;
    xn = LF_Analog ? x + 0.00001 * (rand(1) - 0.5) : x;
    y = xn * c[0] + s[0] * c[1] + s[1] * c[2] - s[2] * c[3] - s[3] * c[4];
    !LF_Analog && y > -0.0000000001 && y < 0.0000000001 ? y = 0;
    s[1] = s[0]; s[0] = xn; s[3] = s[2]; s[2] = y;
    acc += (y * LF_PG[gb + i] + x) * LF_G[gb + i];
    i += 1;
  );
  // With the Air type off its filter still runs (all zero), as in the original
  n == 5 ? (s = LF_ST + (gb + 5) * 4; s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = 0);
  acc *= LF_GG[ch];
  LF_Analog ? acc += 0.00001 * (rand(1) - 0.5);
  acc * LF_Vol;
);

// Clear the filters (when the mode is switched on)
function lf_reset() ( memset(LF_ST, 0, 48); );

/*
 * The response (channel 1's gains) at f Hz, in dB, trim included
 */
function lf_response_db(f, sr) local(w, cr, ci, c2r, c2i, i, c, nr, ni, dr, di, hr, hi, sr_, si_, d, n) (
  w = 2 * $pi * f / sr;
  cr = cos(w); ci = -sin(w); c2r = cos(2 * w); c2i = -sin(2 * w);
  sr_ = 0; si_ = 0;
  n = LF_HIT > 0 ? 6 : 5;
  i = 0;
  loop(n,
    c = LF_CO + i * 5;
    nr = c[0] + c[1] * cr + c[2] * c2r; ni = c[1] * ci + c[2] * c2i;
    dr = 1 + c[3] * cr + c[4] * c2r; di = c[3] * ci + c[4] * c2i;
    d = dr * dr + di * di;
    hr = (nr * dr + ni * di) / d; hi = (ni * dr - nr * di) / d;
    sr_ += (hr * LF_PG[i] + 1) * LF_G[i]; si_ += hi * LF_PG[i] * LF_G[i];
    i += 1;
  );
  20 * log10(max(sqrt(sr_ * sr_ + si_ * si_) * LF_GG[0] * LF_Vol, 0.00001));
);
