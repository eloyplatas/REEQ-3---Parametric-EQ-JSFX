    TB_CkMs / TB_CkN > 0.0000001 ? (
      TB_CRING[2 * TB_CPos] = TB_CkPk; TB_CRING[2 * TB_CPos + 1] = TB_CkMs / TB_CkN;
      TB_CPos = (TB_CPos + 1) % 32; TB_CCnt = min(TB_CCnt + 1, 32);
      TB_CAllPk = max(TB_CAllPk, TB_CkPk); TB_CAllMs += TB_CkMs / TB_CkN; TB_CAllN += 1;
      TB_CrestDue = 1;
    );
    TB_CkPk = TB_CkMs = TB_CkN = 0;
  );
);
TB_Learn ? (
  tb_l = TB_Learn == 1 ? pub_in : TB_Learn == 2 ? (spl0 + spl1) * 0.5 : (spl2 + spl3) * 0.5;
  tb_l = tblb.tb_tick(tbla.tb_tick(tb_l));
  TB_LCPk = max(TB_LCPk, abs(tb_l)); TB_LCMs += tb_l * tb_l; TB_LCN += 1;
);
TB_Solo >= 0 ? (
  TB_Solo != 3 ? (spl0 = tsl0b.tb_tick(tsl0a.tb_tick(spl0)); spl1 = tsl1b.tb_tick(tsl1a.tb_tick(spl1)));
  TB_Solo != 0 ? (spl0 = tsh0b.tb_tick(tsh0a.tb_tick(spl0)); spl1 = tsh1b.tb_tick(tsh1a.tb_tick(spl1)));
);

// Output peak for the meter, read and reset by @gfx
out_pk0 = max(out_pk0, abs(spl0));
out_pk1 = max(out_pk1, abs(spl1));

@gfx 1000 564

// Embedded in the track or mixer panel (gfx_ext_flags bit 1, REAPER 6.30+): curves, fills, nodes and the
// analyser only, with no header, toolbar, panel, labels or hover card
UI_EMBED = gfx_ext_flags & 1;

/*
 * The UI scale: pixels per point. gfx_ext_retina is 2 on a Mac Retina display, and on Windows it follows
 * the display scaling (1.25, 1.5...). The UI size zooms on top of it: this instance's size, else the
 * default, held back so the full layout still fits the window (never below 1, in 1/16 steps so resizing
 * doesn't shimmer). The embedded panel ignores the UI size.
 */
ui_size_live();
ui_r = max(gfx_ext_retina, 1);
ui_zoom = UI_EMBED ? 1 : (UI_Size ? UI_Size : UI_Size_Default) / 100;
ui_zoom = floor(max(1, min(ui_zoom, min(gfx_w / (ui_r * UI_W_FULL), gfx_h / (ui_r * UI_H_FULL)))) * 16) / 16;
UI_SCALE = ui_r * ui_zoom;
// Last frame's geometry (buttons, dials, popover anchors) is stale for one frame when the scale changes.
// Only the window tracks it: the embedded panel shares these variables at its own scale, and would flip
// the window's last scale every frame.
!UI_EMBED ? (
  ui_scale_changed = UI_SCALE != ui_last_scale;
  ui_last_scale = UI_SCALE;
) : ui_scale_changed = 0;

/*
 * Sizes tuned at 1x and 2x displays: interpolate between the two, scale up beyond 2x, then zoom by the
 * UI size in proportion
 */
function rscale(v1, v2) (
  (ui_r <= 2 ? v1 + (v2 - v1) * (ui_r - 1) : v2 * ui_r * 0.5) * ui_zoom;
);

// Draw the extra strokes meant for high resolution displays
HIDPI = UI_SCALE >= 1.5;

////////////////////////////////////////////////////////////////////////////////////////////
// UI: theme, drawing helpers and widgets
//
// Sizes are given in points and scaled by ui_pt(). Colours are 0-255. Widgets are drawn and
// handled in one call; a click is a fresh press (ui_press) while nothing else has the mouse.
////////////////////////////////////////////////////////////////////////////////////////////

function ui_pt(v) (
  v * UI_SCALE;
);

// Sets font slot to Arial at pt points, flags 'b' for bold or 0
function ui_font(slot, pt, flags) (
  gfx_setfont(slot, "Arial", floor(ui_pt(pt) + 0.5), flags);
);

// Colours come from the palette (Pal, by T_ token). ui_mix (0..1) fades them toward T_TILE, for
// dimmed controls drawn in several passes; ui_cola is never faded.

// Token t's colour at its alpha
function ui_col(t) local(i, d) (
  i = t * 4; d = T_TILE * 4;
  gfx_r = (Pal[i] + (Pal[d] - Pal[i]) * ui_mix) / 255;
  gfx_g = (Pal[i + 1] + (Pal[d + 1] - Pal[i + 1]) * ui_mix) / 255;
  gfx_b = (Pal[i + 2] + (Pal[d + 2] - Pal[i + 2]) * ui_mix) / 255;
  gfx_a = Pal[i + 3];
);

// Token t's colour at alpha a times its own
function ui_col_a(t, a) (
  ui_col(t);
  gfx_a = a * Pal[t * 4 + 3];
);

// Token t's colour, not faded, at alpha a times its own
function ui_cola(t, a) local(i) (
  i = t * 4;
  gfx_r = Pal[i] / 255; gfx_g = Pal[i + 1] / 255; gfx_b = Pal[i + 2] / 255;
  gfx_a = a * Pal[i + 3];
);

// From token t0's colour toward t1's by f (0..1), faded by ui_mix, at alpha a times t0's
function ui_col_mix(t0, t1, f, a) local(i, j, d, v) (
  i = t0 * 4; j = t1 * 4; d = T_TILE * 4;
  v = Pal[i] + (Pal[j] - Pal[i]) * f; gfx_r = (v + (Pal[d] - v) * ui_mix) / 255;
  v = Pal[i + 1] + (Pal[j + 1] - Pal[i + 1]) * f; gfx_g = (v + (Pal[d + 1] - v) * ui_mix) / 255;
  v = Pal[i + 2] + (Pal[j + 2] - Pal[i + 2]) * f; gfx_b = (v + (Pal[d + 2] - v) * ui_mix) / 255;
  gfx_a = a * Pal[i + 3];
);

/*
 * Band colour, fixed per band index: T_BAND1 to T_BAND8 in turn
 */
function ui_band_col(b) local(i) (
  i = b % 8;
  ui_col(T_BAND1 + (i >= 0 && i < 8 ? i : 7));
);

/*
 * Filled rounded rectangle. The corners are drawn as scanlines so nothing overlaps, which
 * keeps translucent fills even.
 */
function ui_fill_rrect(x, y, w, h, r) local(i, dy, dx, xi, fr, a0) (
  x = floor(x); y = floor(y); w = floor(w); h = floor(h);
  r = floor(min(r, min(w, h) * 0.5));
  a0 = gfx_a;
  gfx_rect(x, y + r, w, h - 2 * r);
  i = 0;
  loop(r,
    dy = r - i - 0.5;
    dx = r - sqrt(max(r * r - dy * dy, 0));
    xi = ceil(dx);
    fr = xi - dx;
    gfx_rect(x + xi, y + i, w - 2 * xi, 1);
    gfx_rect(x + xi, y + h - 1 - i, w - 2 * xi, 1);
    fr > 0.02 ? (
      gfx_a = a0 * fr;
      gfx_rect(x + xi - 1, y + i, 1, 1);
      gfx_rect(x + w - xi, y + i, 1, 1);
      gfx_rect(x + xi - 1, y + h - 1 - i, 1, 1);
      gfx_rect(x + w - xi, y + h - 1 - i, 1, 1);
      gfx_a = a0;
    );
    i += 1;
  );
);

/*
 * Rounded box: fill in token tf at alpha fa (times the token's), then a 1px border in token tb
 */
function ui_box(x, y, w, h, r, tf, fa, tb) (
  x = floor(x); y = floor(y); w = floor(w); h = floor(h);
  ui_cola(tf, fa);
  ui_fill_rrect(x, y, w, h, r);
  ui_cola(tb, 1);
  gfx_roundrect(x, y, w - 1, h - 1, r, 1);
);

function ui_text_c(x, y, w, h, s) (
  gfx_x = floor(x); gfx_y = floor(y);
  gfx_drawstr(s, 1 | 4, floor(x + w), floor(y + h));
);

function ui_text_l(x, y, h, s) (
  gfx_x = floor(x); gfx_y = floor(y);
  gfx_drawstr(s, 4 | 256, floor(x + gfx_w), floor(y + h));
);

// Centre text on a point, measured, so it sits on shapes drawn at fractional positions
function ui_text_at(cx, cy, s) local(w, h) (
  gfx_measurestr(s, w, h);
  gfx_x = floor(cx - w * 0.5 + 0.5); gfx_y = floor(cy - h * 0.5 + 0.5);
  gfx_drawstr(s);
);

function ui_text_r(x, y, w, h, s) (
  gfx_x = floor(x); gfx_y = floor(y);
  gfx_drawstr(s, 2 | 4, floor(x + w), floor(y + h));
);

function ui_text_w(s) local(w, h) (
  gfx_measurestr(s, w, h);
  w;
);

function ui_in(x, y, w, h) (
  mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
);

// Nothing else (a drag, an open popover, a held press) owns the mouse
function ui_free() (
  button_focus == -1 && node_drag_mode == 0 && box_region_drag_mode == 0 && ui_popup == 0 && !ui_block;
);

function ui_hover(x, y, w, h) (
  ui_free() && ui_in(x, y, w, h);
);

function ui_clicked(x, y, w, h) (
  ui_press && ui_hover(x, y, w, h);
);

/*
 * Antialiased line w pixels wide
 */
function ui_thick_line(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny, o) (
  dx = x2 - x1; dy = y2 - y1;
  l = max(sqrt(dx * dx + dy * dy), 0.001);
  nx = -dy / l; ny = dx / l;
  o = -(w - 1) * 0.5;
  while (
    gfx_line(x1 + nx * o, y1 + ny * o, x2 + nx * o, y2 + ny * o, 1);
    o += 0.75;
    o <= (w - 1) * 0.5 + 0.01;
  );
);

/*
 * Arc w pixels wide. Angles in radians, 0 is up, clockwise.
 */
function ui_thick_arc(cx, cy, r, a0, a1, w) local(o) (
  o = -(w - 1) * 0.5;
  while (
    gfx_arc(cx, cy, r + o, a0, a1, 1);
    o += 0.5;
    o <= (w - 1) * 0.5 + 0.01;
  );
);

/*
 * Small triangle pointing down (dir 1) or up (dir -1)
 */
function ui_chevron(cx, cy, s, dir) (
  gfx_triangle(cx - s, cy - s * 0.5 * dir, cx + s, cy - s * 0.5 * dir, cx, cy + s * 0.5 * dir);
);

/*
 * Machined dial. v is 0..1; bipolar fills from the centre; nd > 1 draws that many detent dots;
 * dim draws it inactive.
 */
function ui_dial(cx, cy, v, bipolar, nd, dim) local(s, a0, a1, t0, t1, i, n, t, rr, k, th, x, y, cur) (
  s = ui_pt(1);
  cx = floor(cx) + 0.5; cy = floor(cy) + 0.5;
  ui_mix = dim ? 0.65 : 0;
  gfx_a = 1;

  // Detents
  nd > 1 ? (
    cur = floor(v * (nd - 1) + 0.5);
    k = 0;
    loop(nd,
      th = 0.75 * $pi + 1.5 * $pi * k / (nd - 1);
      x = cx + 32.2 * s * cos(th); y = cy + 32.2 * s * sin(th);
      k == cur ? ((ui_dial_accent ? ui_col(T_ACCENT) : ui_band_col(selected_node)); gfx_circle(x, y, 1.6 * s, 1, 1)) : (ui_col(T_DIAL_EDGE); gfx_circle(x, y, 1.2 * s, 1, 1));
      k += 1;
    );
  );

  // Halo track and value
  ui_col(T_DIAL_TRACK);
  ui_thick_arc(cx, cy, 29 * s, 1.25 * $pi, 2.75 * $pi, 2 * s);
  bipolar ? (t0 = min(0.5, v); t1 = max(0.5, v)) : (t0 = 0; t1 = v);
  t1 - t0 > 0.004 ? (
    (ui_dial_accent ? ui_col(T_ACCENT) : ui_band_col(selected_node));
    ui_thick_arc(cx, cy, 29 * s, 1.25 * $pi + 1.5 * $pi * t0, 1.25 * $pi + 1.5 * $pi * t1, 2 * s);
  );

  // Rim and a very soft radial face, lit from up and left
  ui_col(T_DIAL_RIM); gfx_circle(cx, cy, 21 * s, 1, 1);
  n = 10; i = 0;
  loop(n,
    t = i / n;
    rr = 20 * s * (1 - t * 0.85);
    ui_col_mix(T_DIAL_FACE, T_DIAL_FACE_LIT, t, 1);
    gfx_circle(cx - 3.2 * s * t, cy - 5.6 * s * t, rr, 1, 1);
    i += 1;
  );
  ui_col(T_DIAL_EDGE); gfx_circle(cx, cy, 19.5 * s, 0, 1);

  // Pointer with a soft shadow
  th = 0.75 * $pi + 1.5 * $pi * v;
  ui_col(T_DIAL_SHADOW);
  ui_thick_line(cx + 7 * s * cos(th) + 0.8 * s, cy + 7 * s * sin(th) + 0.8 * s, cx + 16 * s * cos(th) + 0.8 * s, cy + 16 * s * sin(th) + 0.8 * s, 2.4 * s);
  ui_col(T_DIAL_POINTER);
  ui_thick_line(cx + 7 * s * cos(th), cy + 7 * s * sin(th), cx + 16 * s * cos(th), cy + 16 * s * sin(th), 2 * s);
  ui_mix = 0;
);

/*
 * Icons in a 14pt box centred on cx, cy, in the current colour.
 * 1 solo, 2 bypass, 3 duplicate, 4 delete, 5 settings, 6 ear (the dynamics detector's Listen),
 * 7 linked and 8 unlinked (the detector's link to its band)
 */
function ui_icon(kind, cx, cy) local(s, w, k, a, ex, ey, x1, y1) (
  s = ui_pt(1); w = 1.4 * s;
  kind == 1 ? (
    ui_thick_arc(cx, cy + 1 * s, 5 * s, -0.5 * $pi, 0.5 * $pi, w);
    ui_thick_line(cx - 5 * s, cy + 1 * s, cx - 5 * s, cy + 2.5 * s, w);
    ui_thick_line(cx + 5 * s, cy + 1 * s, cx + 5 * s, cy + 2.5 * s, w);
    gfx_roundrect(cx - 5.5 * s, cy + 1.5 * s, 2.5 * s, 4 * s, s, 1);
    gfx_roundrect(cx + 3 * s, cy + 1.5 * s, 2.5 * s, 4 * s, s, 1);
  ) : kind == 2 ? (
    ui_thick_arc(cx, cy + 0.8 * s, 4.5 * s, 0.22 * $pi, 1.78 * $pi, w);
    ui_thick_line(cx, cy - 5.2 * s, cx, cy - 0.3 * s, w);
  ) : kind == 3 ? (
    gfx_roundrect(cx - 2.5 * s, cy - 2.5 * s, 8 * s, 8 * s, 1.5 * s, 1);
    ui_thick_line(cx + 2.5 * s, cy - 2.5 * s, cx + 2.5 * s, cy - 5 * s, w);
    ui_thick_line(cx + 2.5 * s, cy - 5.5 * s, cx - 5 * s, cy - 5.5 * s, w);
    ui_thick_line(cx - 5.5 * s, cy - 5.5 * s, cx - 5.5 * s, cy + 2 * s, w);
    ui_thick_line(cx - 5.5 * s, cy + 2.5 * s, cx - 3 * s, cy + 2.5 * s, w);
  ) : kind == 4 ? (
    ui_thick_line(cx - 5 * s, cy - 3.5 * s, cx + 5 * s, cy - 3.5 * s, w);
    ui_thick_line(cx - 1.5 * s, cy - 3.5 * s, cx - 1.5 * s, cy - 5 * s, w);
    ui_thick_line(cx - 1.5 * s, cy - 5 * s, cx + 1.5 * s, cy - 5 * s, w);
    ui_thick_line(cx + 1.5 * s, cy - 5 * s, cx + 1.5 * s, cy - 3.5 * s, w);
    ui_thick_line(cx - 3.5 * s, cy - 3.5 * s, cx - 2.9 * s, cy + 5 * s, w);
    ui_thick_line(cx - 2.9 * s, cy + 5 * s, cx + 2.9 * s, cy + 5 * s, w);
    ui_thick_line(cx + 2.9 * s, cy + 5 * s, cx + 3.5 * s, cy - 3.5 * s, w);
  ) : kind == 5 ? (
    ui_thick_arc(cx, cy, 2.2 * s, 0, 2 * $pi, w);
    k = 0;
    loop(8,
      a = k * $pi / 4;
      ui_thick_line(cx + 3.7 * s * sin(a), cy - 3.7 * s * cos(a), cx + 5.5 * s * sin(a), cy - 5.5 * s * cos(a), w);
      k += 1;
    );
  ) : kind == 6 ? (
    // The outer ear from its front edge over the top, then down to the lobe; the inner fold
    ex = cx + 0.5 * s; ey = cy - 1.5 * s;
    a = 2.62 * $pi;
    ui_thick_arc(ex, ey, 4.5 * s, 1.5 * $pi, a, w);
    x1 = ex + 4.5 * s * sin(a); y1 = ey - 4.5 * s * cos(a);
    ui_thick_line(x1, y1, cx + 1.8 * s, cy + 3.2 * s, w);
    ui_thick_line(cx + 1.8 * s, cy + 3.2 * s, cx - 0.6 * s, cy + 5.4 * s, w);
    ui_thick_line(cx - 0.6 * s, cy + 5.4 * s, cx - 2.8 * s, cy + 4.6 * s, w);
    ui_thick_arc(ex, ey, 2 * s, 1.5 * $pi, 2.4 * $pi, w);
  ) : kind == 7 || kind == 8 ? (
    // Two chain links, joined, or pulled apart
    k = kind == 7 ? 0 : 1.5 * s;
    a = floor(2.5 * s);
    gfx_roundrect(floor(cx - 6.5 * s - k), floor(cy - 2.5 * s), floor(8 * s), floor(5 * s), a, 1);
    gfx_roundrect(floor(cx - 6.5 * s - k) + 1, floor(cy - 2.5 * s) + 1, floor(8 * s) - 2, floor(5 * s) - 2, a - 1, 1);
    gfx_roundrect(floor(cx - 1.5 * s + k), floor(cy - 2.5 * s), floor(8 * s), floor(5 * s), a, 1);
    gfx_roundrect(floor(cx - 1.5 * s + k) + 1, floor(cy - 2.5 * s) + 1, floor(8 * s) - 2, floor(5 * s) - 2, a - 1, 1);
  ) : kind == 9 ? (
    // Revert: an arc over the top from the left, coming back down to an arrowhead on the left
    ui_thick_arc(cx + 0.5 * s, cy + 0.5 * s, 4.5 * s, 1.5 * $pi, 2.8 * $pi, w);
    ex = cx - 4 * s; ey = cy + 0.5 * s;
    gfx_triangle(ex - 2.6 * s, ey - 0.6 * s, ex + 2.6 * s, ey - 0.6 * s, ex, ey + 2.8 * s);
  ) : kind == 10 ? (
    // Close: a cross
    ui_thick_line(cx - 4 * s, cy - 4 * s, cx + 4 * s, cy + 4 * s, w);
    ui_thick_line(cx - 4 * s, cy + 4 * s, cx + 4 * s, cy - 4 * s, w);
  );
);

/*
 * Bordered button. style: 0 normal, 1 on (accent), 2 danger on hover. Returns 1 when clicked.
 */
function ui_button_draw(x, y, w, h, label, style, hov) (
  style == 1 ? ui_box(x, y, w, h, ui_pt(5), T_ACCENT_FILL, 1, T_ACCENT_BORDER) :
    style == 2 && hov ? ui_box(x, y, w, h, ui_pt(5), T_DANGER_FILL, 1, T_DANGER_BORDER) :
      ui_box(x, y, w, h, ui_pt(5), hov ? T_CONTROL_HOVER : T_CONTROL, 1, T_BORDER);
  strlen(label) > 0 ? (
    gfx_setfont(style == 1 ? FONT_BODY_B : FONT_BODY);
    ui_col(style == 1 ? T_ACCENT : hov ? T_TEXT : T_TEXT_DIM);
    ui_text_c(x, y, w, h, label);
  );
);

function ui_button(x, y, w, h, label, style) (
  ui_button_draw(x, y, w, h, label, style, ui_hover(x, y, w, h));
  ui_clicked(x, y, w, h);
);

/*
 * Icon button. style as ui_button. Returns 1 when clicked.
 */
function ui_icon_button_draw(x, y, w, h, kind, style, hov) (
  ui_button_draw(x, y, w, h, "", style, hov);
  ui_col(style == 1 ? T_ACCENT : style == 2 && hov ? T_DANGER : hov ? T_TEXT : T_TEXT_SECONDARY);
  ui_icon(kind, x + w * 0.5, y + h * 0.5);
);

function ui_icon_button(x, y, w, h, kind, style) (
  ui_icon_button_draw(x, y, w, h, kind, style, ui_hover(x, y, w, h));
  ui_clicked(x, y, w, h);
);

/*
 * Dropdown style button showing label and a chevron. Returns 1 when clicked.
 */
function ui_dropdown(x, y, w, h, label, open) local(hov) (
  hov = ui_hover(x, y, w, h);
  open ? ui_box(x, y, w, h, ui_pt(5), T_ACCENT_FILL, 1, T_ACCENT_BORDER) :
    ui_box(x, y, w, h, ui_pt(5), hov ? T_CONTROL_HOVER : T_CONTROL, 1, T_BORDER);
  gfx_setfont(FONT_BODY);
  ui_col(T_TEXT);
  ui_text_l(x + ui_pt(9), y, h, label);
  ui_col(open ? T_ACCENT : T_TEXT_FAINT);
  ui_chevron(x + w - ui_pt(11), y + h * 0.5, ui_pt(3), open ? -1 : 1);
  ui_clicked(x, y, w, h);
);

/*
 * Two segment control. sel is the active segment (0 or 1). Returns the segment clicked, or sel.
 */
function ui_seg2(x, y, h, w0, w1, l0, l1, sel) local(r, hov0, hov1) (
  r = ui_pt(5);
  hov0 = ui_hover(x, y, w0, h);
  hov1 = ui_hover(x + w0, y, w1, h);
  ui_cola(T_CONTROL, 1); ui_fill_rrect(x, y, w0 + w1, h, r);
  ui_cola(T_ACCENT_FILL, 1);
  // The active segment is a rounded box overlapping its neighbour, with the overlap painted back
  sel == 0 ? (ui_fill_rrect(x, y, w0 + r, h, r); ui_col(T_CONTROL); gfx_rect(x + w0, y, r, h))
           : (ui_fill_rrect(x + w0 - r, y, w1 + r, h, r); ui_col(T_CONTROL); gfx_rect(x + w0 - r, y, r, h));
  ui_cola(T_BORDER, 1);
  gfx_roundrect(x, y, w0 + w1 - 1, h - 1, r, 1);
  gfx_line(x + w0, y, x + w0, y + h - 1, 0);

  gfx_setfont(sel == 0 ? FONT_BODY_B : FONT_BODY);
  ui_col(sel == 0 ? T_ACCENT : hov0 ? T_TEXT : T_TEXT_DIM);
  ui_text_c(x, y, w0, h, l0);
  gfx_setfont(sel == 1 ? FONT_BODY_B : FONT_BODY);
  ui_col(sel == 1 ? T_ACCENT : hov1 ? T_TEXT : T_TEXT_DIM);
  ui_text_c(x + w0, y, w1, h, l1);

  ui_clicked(x, y, w0, h) ? 0 : ui_clicked(x + w0, y, w1, h) ? 1 : sel;
);

/*
 * Recessed value field: LABEL value unit. Drawing only; the caller handles the mouse.
 * Returns the x just after the drawn text.
 */
function ui_field(x, y, w, h, label, val, unit, hot) local(tx) (
  ui_box(x, y, w, h, ui_pt(5), T_CONTROL, 1, hot ? T_BORDER_HOVER : T_BORDER);
  tx = x + ui_pt(9);
  strlen(label) > 0 ? (
    gfx_setfont(FONT_CAP); ui_col(T_TEXT_FAINT);
    ui_text_l(tx, y, h, label);
    tx += ui_text_w(label) + ui_pt(7);
  );
  gfx_setfont(FONT_BODY_B); ui_col(T_TEXT);
  ui_text_l(tx, y, h, val);
  tx += ui_text_w(val);
  strlen(unit) > 0 ? (
    gfx_setfont(FONT_BODY); ui_col(T_TEXT_DIM);
    tx += ui_pt(3);
    ui_text_l(tx, y, h, unit);
    tx += ui_text_w(unit);
  );
  tx;
);

function ui_fmt_db(s, v) (
  abs(v) < 0.05 ? strcpy(s, "0.0") : v > 0 ? sprintf(s, "+%.1f", v) : sprintf(s, "−%.1f", -v);
  s;
);

function ui_shape_name(t) (
  t == 0 ? "Bell" : t == 1 ? "Low Cut" : t == 2 ? "Low Cut BW" : t == 3 ? "Low Shelf" : t == 4 ? "High Shelf" :
    t == 5 ? "High Cut" : t == 6 ? "High Cut BW" : t == 7 ? "Notch" : t == 8 ? "Band Pass" : t == 9 ? "Tilt Shelf" :
      t == 10 ? "Pultec Low" : t == 11 ? "All Pass" : t == 12 ? "Vintage Lo" : t == 13 ? "Vintage Hi" : "Flat Tilt";
);

function ui_is_cut(t) (
  t == FILTER_LOW_CUT || t == FILTER_LOW_CUT_BUTTERWORTH || t == FILTER_HIGH_CUT || t == FILTER_HIGH_CUT_BUTTERWORTH;
);

// The ten slopes the menus offer, in dB/oct
function ui_slope_db(i) (
  i < 6 ? 6 * (i + 1) : i == 6 ? 48 : i == 7 ? 72 : i == 8 ? 96 : 120;
);

// Nearest of the ten slopes to a band's slope step (step k is 6 * (k + 1) dB/oct)
function ui_slope_index(k) local(db, i, best, d) (
  db = 6 * (k + 1);
  best = 0; i = 1;
  loop(9,
    abs(ui_slope_db(i) - db) < abs(ui_slope_db(best) - db) ? best = i;
    i += 1;
  );
  best;
);

/*
 * ReEQ3 slopes by shape family: cuts (6..120), shelves and the tilt shelf (6..96), bells (12..96). The
 * chips the pickers offer, and any value between them with Shift (a band's slope step k is
 * 6 * (k + 1) dB/oct and may be fractional).
 */
function ui_has_slope(t) (
  ui_is_cut(t) || t == FILTER_PEAK || t == FILTER_LOW_SHELF || t == FILTER_HIGH_SHELF || t == FILTER_TILT_SHELF;
);
function ui_slope_n(t) (
  ui_is_cut(t) ? 10 : t == FILTER_PEAK ? 7 : 8;
);
function ui_slope_chip(t, i) (
  ui_is_cut(t) ? ui_slope_db(i) :
    t == FILTER_PEAK ? (i == 0 ? 12 : i == 1 ? 18 : i == 2 ? 24 : i == 3 ? 36 : i == 4 ? 48 : i == 5 ? 72 : 96) :
      (i == 0 ? 6 : i == 1 ? 12 : i == 2 ? 18 : i == 3 ? 24 : i == 4 ? 36 : i == 5 ? 48 : i == 6 ? 72 : 96);
);
// The slope step range of a shape
function ui_slope_kmin(t) ( t == FILTER_PEAK ? 1 : 0; );
function ui_slope_kmax(t) ( ui_is_cut(t) ? 19 : 15; );
// The chip nearest a slope step, for a shape
function ui_slope_index_t(t, k) local(db, i, best) (
  db = 6 * (k + 1);
  best = 0; i = 1;
  loop(ui_slope_n(t) - 1,
    abs(ui_slope_chip(t, i) - db) < abs(ui_slope_chip(t, best) - db) ? best = i;
    i += 1;
  );
  best;
);
// Whether a slope step sits on a chip (else it is a fractional slope in between)
function ui_slope_on_chip(t, k) (
  abs(ui_slope_chip(t, ui_slope_index_t(t, k)) - 6 * (k + 1)) < 0.05;
);
// The default slope step of a shape: 12 dB/oct for bells, shelves and the tilt shelf
function ui_slope_default(t) ( 1; );
// A slope's text: whole numbers, or one decimal for a fractional slope
function ui_slope_text(s, k) local(db) (
  db = 6 * (k + 1);
  abs(db - floor(db + 0.5)) < 0.05 ? sprintf(s, "%d", floor(db + 0.5)) : sprintf(s, "%.1f", db);
);

gfx_mode = 0;

gfx_set(1,1,1,1);

gfx_x = 100; gfx_y = 100;

actual_width = gfx_w / UI_SCALE;
actual_height = gfx_h / UI_SCALE;

// This is necessary!
// Without this, the mouse_caps don't register key presses until the
// mouse button is clicked.
ui_key = gfx_getchar();

// A fresh left press this frame; held presses never count
ui_press = (mouse_cap & 1) && !(ui_prev_cap & 1);
ui_rpress = (mouse_cap & 2) && !(ui_prev_cap & 2);

// When the scale changes, a press would be tested against last frame's geometry: ignore it (and a held
// one until release, since dials and number buttons take a held press), and close the popovers anchored
// to controls (the top popovers follow their buttons; the credits are centred)
ui_scale_changed ? (
  ui_press = ui_rpress = 0;
  ui_popup != 4 && ui_popup != 5 && ui_popup != 8 ? ui_popup = 0;
  mouse_cap & 1 ? ui_block = 1;
);

// A press that closed a popover stays ignored until it is released
!(mouse_cap & 1) ? ui_block = 0;

// Number buttons and dials own the mouse by their x position until release. Release it here too,
// so a handler that was skipped on the release frame (hidden, or moved) can never keep it.
!(mouse_cap & 1) ? (ui_ddrag && ui_ddrag_moved ? notify_dyn_state(ui_ddrag_b); button_focus = -1; ui_kd = -1; ui_rdrag = 0; ui_ddrag = 0);

// Calculage compact view flags
// These are used to disable certain elements for graceful visual shrinking
compact_width = actual_width < 600;
compact_height = actual_height < 320;
very_compact_width = actual_width < 300;
very_compact_height = actual_height < 160;

// Embedded (UI_EMBED, set at the top of @gfx): the compact layout throughout
UI_EMBED ? (compact_width = compact_height = very_compact_width = very_compact_height = 1);

// A header strip holds the logo and the top buttons; the graph starts below it. Compact sizes keep
// just the wordmark (short windows in a slimmer strip); very short windows drop it.
HEADER_H = very_compact_height ? 0 : compact_height ? floor(ui_pt(24)) : floor(ui_pt(34));
TOP_MARGIN = HEADER_H == 0 ? floor(ui_pt(10)) : HEADER_H + floor(compact_width || compact_height ? ui_pt(10) : ui_pt(16));
// The bottom toolbar is 40pt, and the node panel sits about 176pt above it
BOTTOM_MARGIN = 40 * UI_SCALE;
RAISED_BOTTOM = 176 * UI_SCALE;

compact_width || compact_height ? BOTTOM_MARGIN = 0;

// Node panel: 560 x 146pt, centred above the toolbar. A dynamic band's panel is wider, 700pt, for its
// dynamics block and header; in a narrow window it fits the window (its dials closer together, and
// below about 620pt its header drops the band navigation).
ui_dyn_panel = selected_node >= 0 && Band_Dyn_On[selected_node] && band_dyn_capable(Band_Type[selected_node]);
panel_w = floor(ui_dyn_panel ? max(ui_pt(560), min(ui_pt(700), gfx_w - ui_pt(8))) : ui_pt(560));
panel_h = floor(ui_pt(146));
panel_x = floor(gfx_w / 2 - panel_w / 2);
panel_y = floor(gfx_h - BOTTOM_MARGIN - ui_pt(44) - panel_h);

ShowPanel = PanelEnabled && !compact_width && !compact_height;

ENABLE_RAISED_BOTTOM = ShowPanel;

LEFT_MARGIN = 0;
RIGHT_MARGIN = 0;

spectrum.top_margin = TOP_MARGIN;
spectrum.bottom_margin = BOTTOM_MARGIN;
spectrum.left_margin = LEFT_MARGIN;
spectrum.left_margin = RIGHT_MARGIN;

/*
 * Set rgb from 0..255
 */
function set_rgb255(r, g, b) (
  gfx_r = r / 255;
  gfx_g = g / 255;
  gfx_b = b / 255;
);

/*
 * Set rgba from 0..255
 */
function set_rgba255(r, g, b, a) (
  gfx_r = r / 255;
  gfx_g = g / 255;
  gfx_b = b / 255;
  gfx_a = b / 255;
);

/*
 * Get screen x from freq
 */
function freq_to_scx(freq) (
  LEFT_MARGIN + ((gfx_w - LEFT_MARGIN - RIGHT_MARGIN) * log(freq / MIN_FREQ) / FREQ_LOG_MAX);
);

/*
 * Get freq from screen x
 */
function scx_to_freq(x) (
  x = MIN_FREQ * exp(FREQ_LOG_MAX * (x - LEFT_MARGIN) / (gfx_w - LEFT_MARGIN - RIGHT_MARGIN));
  max(min(x, MAX_FREQ), MIN_FREQ);
);

/*
 * Convert eq dB to screen y
 */
function db_to_y(db) local(m) (
  m = 1.0 - (((db / DB_EQ_RANGE) / 2) + 0.5);
  TOP_MARGIN+(m * (gfx_h - (ui_th1*2) - BOTTOM_MARGIN - (RAISED_BOTTOM * ENABLE_RAISED_BOTTOM)));
);

/*
 * Get eq dB from screen y
 */
function y_to_db(y) local(m) (
  m = (y - TOP_MARGIN) / (gfx_h - (ui_th1*2) - BOTTOM_MARGIN - (RAISED_BOTTOM * ENABLE_RAISED_BOTTOM));
  m = (1.0 - (m + 0.5)) * 2 * DB_EQ_RANGE;
  max(min(m, DB_EQ_RANGE), -DB_EQ_RANGE);
);

// ReEQ3: with the piano shown, a node's frequency sits on the nearest note (Alt, the fine drag, moves it freely)
function note_quantize(f) (
  440 * 2 ^ (floor(12 * log(max(f, 1) / 440) / log(2) + 0.5) / 12);
);

function set_filter_from_xy(band, x, y) local(gain, s) (
    Band_Frequency[band] = scx_to_freq(x);
    Show_Piano && !(mouse_cap & 16) ? Band_Frequency[band] = min(max(note_quantize(Band_Frequency[band]), MIN_FREQ), MAX_FREQ);
    // A bell just made by Spectrum Grab stays on its peak while it is dragged
    band == Grab_Band && (mouse_cap & 1) ? Band_Frequency[band] = ui_grab_f_held;
    Band_Type[band] == FILTER_HIGH_CUT || Band_Type[band] == FILTER_LOW_CUT ? (
      Band_Slope[band] == 0 ? (
        Band_Q[band] = 0.707;
      ) : (
        // Convert from gain dB to Q
        gain = y_to_db(y);
        s = floor(((Band_Slope[band] + 1) * 6) / 12);  // Number of 12dB's
        Band_Q[band] = pow(2, ((gain / s) - 3) / 6);
      );
      // Notify Reaper that a parameter change has happened
      notify_touched_Q(band);
    ) : (
      // Normal
      Band_Type[band] == FILTER_NOTCH || Band_Type[band] == FILTER_BAND_PASS || Band_Type[band] == FILTER_ALL_PASS
        || Band_Type[band] == FILTER_LOW_CUT_BUTTERWORTH || Band_Type[band] == FILTER_HIGH_CUT_BUTTERWORTH ? Band_Gain[band] = 0 
        : Band_Gain[band] = y_to_db(y);
      // Notify Reaper that a parameter change has happened
      notify_touched_gain(band);
    );
    // Notify Reaper that a parameter change has happened
    notify_touched_frequency(band);
    flag_filter_update(band);
);

function get_filter_x(band) (
    freq_to_scx(Band_Frequency[band]);
);

function get_filter_y(band) local(y, s) (
    Band_Type[band] == FILTER_HIGH_CUT || Band_Type[band] == FILTER_LOW_CUT ? (
      Band_Slope[band] == 0 ? y = db_to_y(0) : (
        // Convert Q to dB, then to screen Y
        s = floor(((Band_Slope[band] + 1) * 6) / 12);  // Number of 12dB's
        y = db_to_y(((6 * s * log(Band_Q[band])) / log(2)) + (3 * s));
      );
    ) : (
      // Butterworth, notch, bandpass and allpass don't have gain
      Band_Type[band] == 2 || Band_Type[band] == 6 || Band_Type[band] == 7 || Band_Type[band] == 8 || Band_Type[band] == 11 ?  (
        y = db_to_y(0);
      ) : (
        // Normal
        y = db_to_y(Band_Gain[band]);
      );
    );
    // Gains beyond the dB range stay in the graph, clear of the header
    max(y, TOP_MARGIN);
);

/*
 * Draw the node indicators for a band/node
 * Used for mid/side and left/right indicators
 */
function draw_node_stereo(band, x, y, alpha) local (size, nx, ny, x1, x2, x3, y1, y2, y3) (
  size = ui_pt(7.5);

  ui_cola(T_HIGHLIGHT, alpha);

  // Top + bottom
  (Band_Group[band] == 1) ? (
    start = 14 * (2*$pi/16);
    end = 18 * (2*$pi/16);

    gfx_arc(x, y, size*2, start, end, 1);
    gfx_arc(x, y, (size*2)-0.5, start, end, 1);
    HIDPI ? gfx_arc(x, y, (size*2)-1.0, start, end, 1);
   
    start = 22 * (2*$pi/16);
    end = 26 * (2*$pi/16);

    gfx_arc(x, y, size*2, start, end, 1);
    gfx_arc(x, y, (size*2)-0.5, start, end, 1);
    HIDPI ? gfx_arc(x, y, (size*2)-1.0, start, end, 1);
  );

  // Left
  (Band_Group[band] == 2 || Band_Group[band] == 3) ? (
    start = 26 * (2*$pi/16);
    end = 30 * (2*$pi/16);

    gfx_arc(x, y, size*2, start, end, 1);
    gfx_arc(x, y, (size*2)-0.5, start, end, 1);
    HIDPI ? gfx_arc(x, y, (size*2)-1.0, start, end, 1);
  );

  // Right
  (Band_Group[band] == 2 || Band_Group[band] == 4) ? (
    start = 18 * (2*$pi/16);
    end = 22 * (2*$pi/16);

    gfx_arc(x, y, size*2, start, end, 1);
    gfx_arc(x, y, (size*2)-0.5, start, end, 1);
    HIDPI ? gfx_arc(x, y, (size*2)-1.0, start, end, 1);
  );
);

/*
 * Draw the node/band
 */
function draw_node(band, freq, db, enabled, selected) local(x, y, m, scy, transfer, size, alpha, width, height, a0, a1, da) (
  //jj
  x = get_filter_x(band);
  y = get_filter_y(band);

  y > gfx_h - gfx_texth - BOTTOM_MARGIN - (RAISED_BOTTOM * ENABLE_RAISED_BOTTOM) ? (
    node_alpha = 0.5;
  ) : node_alpha = 1.0;

  y > gfx_h - gfx_texth - BOTTOM_MARGIN ? node_alpha = 0;
  
  draw_node_stereo(band, x, y, node_alpha);

  // Halo in the band colour when hovered or selected
  band == node_hover || selected_node == band ? (
    gfx_r = Band_Red[band]; gfx_g = Band_Green[band]; gfx_b = Band_Blue[band];
    gfx_a = node_alpha * (selected_node == band ? 0.35 : 0.2);
    ui_thick_arc(x, y, ui_pt(12), 0, 2 * $pi, ui_pt(2));
  );

  // Disc in the band colour, a white edge when selected, and a dark band number
  size = selected_node == band ? ui_pt(8) : ui_pt(7);
  gfx_r = Band_Red[band]; gfx_g = Band_Green[band]; gfx_b = Band_Blue[band];
  da = enabled == 2 ? node_alpha : node_alpha * 0.3;
  gfx_a = da;
  gfx_circle(x, y, size, 1, 1);

  selected_node == band ? (
    ui_cola(T_HIGHLIGHT, da);
    ui_thick_arc(x, y, size, 0, 2 * $pi, ui_pt(1.5));
  ) : (
    ui_cola(T_NODE_EDGE, da);
    gfx_circle(x, y, size, 0, 1);
  );

  gfx_setfont(FONT_NODE);
  ui_col_a(T_BADGE_TEXT, enabled == 2 ? node_alpha : node_alpha * 0.6);
  ui_text_at(x, y, sprintf(#, "%d", band+1));
  gfx_setfont(FONT_BASE);

  // Draw band selected indicator
  Band_Selected[band] == 1 ? (
    ui_cola(T_HIGHLIGHT, band_selected_circle_alpha);
    gfx_circle(x, y, size*1.5, 0, 1);
    ui_cola(T_HIGHLIGHT, band_selected_circle_alpha * 0.5); gfx_circle(x, y, (size*1.5)+1, 0, 1);
    ui_cola(T_HIGHLIGHT, band_selected_circle_alpha * 0.5); gfx_circle(x, y, (size*1.5)-1, 0, 1);
  );

  // Draw connecting line so that we can see which node affects which part of the curve
  // Low Cut,Low Cut (Butterworth),High Cut,High Cut (Butterworth),Band Pass,Notch,Peak,Low Shelf,High Shelf,Tilt Shelf,Pultec Low Shelf,All Pass
  Band_Type[band] != BAND_STATE_OFF || Scale != 100 ? (
    transfer = (
      band == 0 ? gfx_band1.filter.ivf_analog_magnitude(freq) :
        band == 1 ? gfx_band2.filter.ivf_analog_magnitude(freq) :
          band == 2 ? gfx_band3.filter.ivf_analog_magnitude(freq) :
            band == 3 ? gfx_band4.filter.ivf_analog_magnitude(freq) :
              band == 4 ? gfx_band5.filter.ivf_analog_magnitude(freq) :
                band == 5 ? gfx_band6.filter.ivf_analog_magnitude(freq) :
                  band == 6 ? gfx_band7.filter.ivf_analog_magnitude(freq) :
                    band == 7 ? gfx_band8.filter.ivf_analog_magnitude(freq) :
                      band == 8 ? gfx_band9.filter.ivf_analog_magnitude(freq) :
                        band == 9 ? gfx_band10.filter.ivf_analog_magnitude(freq) :
                          band == 10 ? gfx_band11.filter.ivf_analog_magnitude(freq) :
                            band == 11 ? gfx_band12.filter.ivf_analog_magnitude(freq) :
                              band == 12 ? gfx_band13.filter.ivf_analog_magnitude(freq) :
                                band == 13 ? gfx_band14.filter.ivf_analog_magnitude(freq) :
                                  band == 14 ? gfx_band15.filter.ivf_analog_magnitude(freq) :
                                    band == 15 ? gfx_band16.filter.ivf_analog_magnitude(freq);
    );

    // Prevent magnitude from blowing up
    transfer < 0.001 ? transfer = 0.001;

    // Convert from scalar to db
    m = 20 * log10(transfer);

    // Convert db to screen y
    scy = db_to_y(m);

    // Notch filters transfer is somewhere down the abyss...compensate
    Band_Enabled[band] == 2 && Band_Type[band] == 7 ? scy = gfx_h - BOTTOM_MARGIN - gfx_texth;

    scy = min(gfx_h - BOTTOM_MARGIN - gfx_texth, scy);

    // From the node's edge to the curve, fading towards the node
    scy > y ? y = min(y+size, scy) : y = max(y-size, scy);
    height = abs(scy - y);
    height >= 1 ? (
      width = max(1, floor(ui_pt(1.25) + 0.5));
      a1 = enabled == 2 ? node_alpha : node_alpha * 0.3;
      a0 = a1 * 0.2;
      scy > y ?
        gfx_gradrect(floor(x - width * 0.5), y, width, height, Band_Red[band], Band_Green[band], Band_Blue[band], a0, 0, 0, 0, 0, 0, 0, 0, (a1 - a0) / height) :
        gfx_gradrect(floor(x - width * 0.5), scy, width, height, Band_Red[band], Band_Green[band], Band_Blue[band], a1, 0, 0, 0, 0, 0, 0, 0, (a0 - a1) / height);
    );
  ); 
);

/*
 * Draw all node/bands
 */
function draw_nodes() local (band) (
  band = 0;
  loop (NUM_BANDS, (
      Band_Enabled[band] ? draw_node(band, Band_Frequency[band], Band_Gain[band], Band_Enabled[band], 0);
      band += 1;
    );
  );
);

/*
 * Draw a normal line
 */
function draw_line(x1, y1, x2, y2)
(
  x1 = floor(x1);
  x2 = floor(x2);
  x2 = floor(x2);
  y2 = floor(y2);
  
  gfx_a = 1;
  gfx_line(x1, y1, x2, y2, 1); 
);

/*
 * Draw a thick line
 */
function draw_thick_line(x1, y1, x2, y2)
(
  x1 = floor(x1);
  x2 = floor(x2);
  x2 = floor(x2);
  y2 = floor(y2);
  
  gfx_a = 1;
  gfx_line(x1, y1, x2, y2, 1); 
  gfx_a = 0.25;
  gfx_line(x1-1, y1-1, x2+1, y2-1, 1);
  gfx_line(x1-1, y1+1, x2+1, y2+1, 1);
);

/*
 * A band's response at gain g, drawn in the current colour as dashes dash points long with gaps gap
 * points long, measured across the graph
 */
function draw_dyn_curve(t, f, g, qv, dash, gap) local(s, xf, step, freq, m, scy, xo, yo, bottom, period) (
  s = ui_pt(1);
  dyn_curve.band_set_visual(t, f, g, qv, 0);

  bottom = gfx_h - BOTTOM_MARGIN - gfx_texth;
  step = max(2, floor(2 * s));
  period = (dash + gap) * s;
  xf = 0;
  loop(ceil(gfx_w / step) + 1,
    freq = scx_to_freq(xf);
    m = max(dyn_curve.filter.ivf_analog_magnitude(freq), 0.001);
    scy = db_to_y(20 * log10(m));
    xf > 0 && yo < bottom && scy < bottom && xf - floor(xf / period) * period < dash * s ? gfx_line(xo, yo, xf, scy, 1);
    xo = xf; yo = scy;
    xf += step;
  );
);

/*
 * Dynamic bands whose gain has moved: a dotted line at their static setting
 */
function draw_dyn_static() local(b, t) (
  b = 0;
  loop(NUM_BANDS,
    t = Band_Type[b];
    Band_Dyn_On[b] && band_dyn_capable(t) && Band_Enabled[b] == BAND_STATE_ENABLED && abs(Band_Dyn_Gain[b]) > 0.1 ? (
      gfx_r = Band_Red[b]; gfx_g = Band_Green[b]; gfx_b = Band_Blue[b]; gfx_a = 0.55;
      draw_dyn_curve(t, Band_Frequency[b], Band_Gain[b] * Scale / 100, Band_Q[b], 1.5, 2.5);
    );
    b += 1;
  );
);

/*
 * Whether band b (or -1) can show a ghost spectrum: dynamic, enabled, and hearing a sidechain or unlinked
 */
function dyn_ghost_ok(b) (
  b >= 0 && Band_Dyn_On[b] && band_dyn_capable(Band_Type[b]) && Band_Enabled[b] == BAND_STATE_ENABLED &&
    (Band_Dyn_Source[b] > 0 || !Band_Dyn_Link[b]);
);

/*
 * Unlinked detectors: whether a band has one, and where its node sits (at its frequency, low in the graph)
 */
function dyn_det_on(b) (
  Band_Dyn_On[b] && band_dyn_capable(Band_Type[b]) && Band_Enabled[b] != BAND_STATE_OFF && !Band_Dyn_Link[b];
);

function dyn_det_nx(b) (
  floor(freq_to_scx(dyn_det_freq_u(b))) + 0.5;
);

function dyn_det_ny() (
  floor(db_to_y(-0.75 * DB_EQ_RANGE)) + 0.5;
);

/*
 * The band whose detector node is under the mouse, or -1. Callers check for a band node first.
 */
function dyn_det_hit() local(b, r, hit) (
  hit = -1; r = sqr(ui_pt(9));
  !UI_EMBED ? (
    b = 0;
    loop(NUM_BANDS,
      dyn_det_on(b) && sqr(mouse_x - dyn_det_nx(b)) + sqr(mouse_y - dyn_det_ny()) < r ? hit = b;
      b += 1;
    );
  );
  hit;
);

/*
 * Detector nodes: a hollow ring in the band colour with a centre dot, a faint dashed link to the band's
 * node, and "SC n" under it when it hears a sidechain. No other text.
 */
function draw_dyn_detectors() local(s, b, x, y, nx, ny, dx, dy, l, k, n, t0, t1, hov, dim) (
  s = ui_pt(1);
  b = 0;
  loop(NUM_BANDS,
    dyn_det_on(b) && !UI_EMBED ? (
      x = dyn_det_nx(b); y = dyn_det_ny();
      dim = Band_Enabled[b] != BAND_STATE_ENABLED;

      // Dashes from the node's edge to the ring's edge
      nx = get_filter_x(b); ny = get_filter_y(b);
      dx = x - nx; dy = y - ny; l = sqrt(dx * dx + dy * dy);
      l > 20 * s ? (
        gfx_r = Band_Red[b]; gfx_g = Band_Green[b]; gfx_b = Band_Blue[b]; gfx_a = dim ? 0.15 : 0.35;
        n = floor((l - 18 * s) / (6 * s));
        k = 0;
        loop(n,
          t0 = (9 * s + k * 6 * s) / l; t1 = min((12 * s + k * 6 * s) / l, 1 - 9 * s / l);
          gfx_line(nx + dx * t0, ny + dy * t0, nx + dx * t1, ny + dy * t1, 1);
          k += 1;
        );
      );

      hov = (ui_ddrag && ui_ddrag_b == b) || (ui_free() && sqr(mouse_x - x) + sqr(mouse_y - y) < sqr(9 * s));
      ui_col(T_TILE);
      gfx_circle(x, y, 7 * s, 1, 1);
      gfx_r = Band_Red[b]; gfx_g = Band_Green[b]; gfx_b = Band_Blue[b]; gfx_a = dim ? 0.4 : 1;
      ui_thick_arc(x, y, (hov ? 7.5 : 6.5) * s, 0, 2 * $pi, 2 * s);
      gfx_circle(x, y, 2.2 * s, 1, 1);
      Band_Dyn_Source[b] > 0 ? (
        gfx_setfont(FONT_CAP);
        ui_text_at(x, y + 15 * s, sprintf(#, "SC %d", Band_Dyn_Source[b]));
        gfx_setfont(FONT_BASE);
      );
    );
    b += 1;
  );
);

/*
 * The ghost spectrum: band gb's detector input (its sidechain, or its own input) in light grey. The
 * analyser dims under it; the detector's range (where its response is within 3dB of its centre) is
 * tinted in the band colour between two edge lines; inside it the spectrum is filled and its line
 * bright, fading just past the edges to a faint line that fades away. a is its opacity.
 */
function draw_dyn_ghost(gb, a) local(s, norm, c, n, m, cl, cr, d, w, top, bottom, ew) (
  s = ui_pt(1);
  norm = ghost_det.dyn_det_put(gb);
  n = min(floor(gfx_w), 16384);
  cl = cr = -1;
  c = 0;
  loop(n,
    m = norm * ghost_det.ivf_analog_magnitude(spectrum.x_to_freq(c));
    m >= 0.7071 ? (cl < 0 ? cl = c; cr = c);
    c += 1;
  );
  cl >= 0 ? (
    // Opacity per column for the spectrum's ghost mode: 1 inside, down to 0.25 over 10pt past an edge
    // (the fill follows this part), then from 0.25 to nothing over 60pt
    c = 0;
    loop(n,
      d = c < cl ? cl - c : c > cr ? c - cr : 0;
      w = d <= 0 ? 1 : d < 10 * s ? 1 - 0.75 * d / (10 * s) : 0.25 * max(0, 1 - (d - 10 * s) / (60 * s));
      spectrum.ghost_w[c] = w;
      c += 1;
    );
    top = TOP_MARGIN; bottom = gfx_h - BOTTOM_MARGIN - gfx_texth;

    // The analyser dims to about 40% (the background colour over it)
    Display_Mode != 2 ? (
      ui_cola(T_GRAPH_BG, 0.6 * a);
      gfx_rect(0, top, gfx_w, bottom - top);
    );

    gfx_r = Band_Red[gb]; gfx_g = Band_Green[gb]; gfx_b = Band_Blue[gb]; gfx_a = 0.06 * a;
    gfx_rect(cl, top, cr - cl + 1, bottom - top);

    // In the main display's style: Line, Heat, or Fill (also when the analyser is off)
    spectrum.ghost_style = Display_Mode == 1 ? 1 : Display_Mode == 3 ? 2 : 0;
    spectrum.alpha[6] = a;
    spectrum.draw(6);

    // The edges (a shelf's detector has only one inside the graph)
    ew = max(1, floor(1.3 * s + 0.5));
    gfx_r = Band_Red[gb]; gfx_g = Band_Green[gb]; gfx_b = Band_Blue[gb]; gfx_a = 0.75 * a;
    cl > 0 ? gfx_rect(cl, top, ew, bottom - top);
    cr < n - 1 ? gfx_rect(cr - ew + 1, top, ew, bottom - top);
  );
);

/*
 * The selected dynamic band's range: a dashed line at the range limit, and the range handle on a stem
 * from the node, with a tick at the live gain. Records the handle for the mouse code.
 */
function draw_dyn_range() local(s, b, t, x, y, hy, ly, nr, bottom, hov) (
  s = ui_pt(1);
  ui_rh_on = 0;
  b = selected_node;
  b >= 0 && !UI_EMBED ? (
    t = Band_Type[b];
    Band_Dyn_On[b] && band_dyn_capable(t) && Band_Enabled[b] == BAND_STATE_ENABLED ? (
      gfx_r = Band_Red[b]; gfx_g = Band_Green[b]; gfx_b = Band_Blue[b]; gfx_a = 0.7;
      draw_dyn_curve(t, Band_Frequency[b], (Band_Gain[b] + Band_Dynamic_Range[b]) * Scale / 100, Band_Q[b], 6, 4);

      bottom = gfx_h - BOTTOM_MARGIN - gfx_texth;
      x = floor(get_filter_x(b)) + 0.5; y = get_filter_y(b);
      hy = min(max(db_to_y(Band_Gain[b] + Band_Dynamic_Range[b]), TOP_MARGIN), bottom - 6 * s);
      nr = ui_pt(8);
      abs(hy - y) > nr + 3 * s ? (
        // Stem from the node's edge to the handle
        gfx_a = 0.5;
        hy > y ? gfx_line(x, y + nr, x, hy - 4.5 * s, 0) : gfx_line(x, hy + 4.5 * s, x, y - nr, 0);

        // The live gain
        ly = db_to_y(Band_Gain[b] + Band_Dyn_Gain[b]);
        abs(Band_Dyn_Gain[b]) > 0.05 && ly < bottom ? (
          ui_cola(T_HIGHLIGHT, 0.9);
          gfx_rect(floor(x - 5 * s), floor(ly - 0.75 * s), floor(10 * s), max(1, floor(1.5 * s)));
        );

        // The handle: a ring in the band colour, brighter while hovered or dragged
        hov = ui_rdrag || (ui_free() && sqr(mouse_x - x) + sqr(mouse_y - hy) < sqr(7 * s));
        ui_col(T_TILE);
        gfx_circle(x, hy, (hov ? 5.5 : 4.5) * s, 1, 1);
        hov ? ui_cola(T_HIGHLIGHT, 1) : (gfx_r = Band_Red[b]; gfx_g = Band_Green[b]; gfx_b = Band_Blue[b]);
        ui_thick_arc(x, hy, (hov ? 5.5 : 4.5) * s, 0, 2 * $pi, 1.5 * s);

        ui_rh_on = 1; ui_rh_x = x; ui_rh_y = hy; ui_rh_b = b;
      );
    );
  );
);

/*
 * Draw the colored filter bands
 */
function draw_filter_bands()
  local(xf, step, point, xo1, yo1, freq, m, scy, midp, tx0, lx0, x0, y0, x1, y1, bottom, yc, fh)
(
  // Band fill opacity at the curve and at the 0dB line
  FILL_ALPHA_CURVE = Pal[T_BAND_AREA * 4 + 3];
  FILL_ALPHA_LINE = FILL_ALPHA_CURVE * 0.1;

  // Go across the screen in these steps
  step = gfx_w / 1000;
  gfx_x = 0;
  gfx_y = (gfx_h / 2) - gfx_texth;

  gfx_r = 0.6; gfx_g = 0.6; gfx_b = 0.6; gfx_a = 1.0;

  bottom = gfx_h - BOTTOM_MARGIN - gfx_texth;

  midp = db_to_y(0);

  band = 0;

  loop(NUM_BANDS, (
      state = Band_Enabled[band];
      state != BAND_STATE_OFF ? ( 

        gfx_r = Band_Red[band]; gfx_g = Band_Green[band]; gfx_b = Band_Blue[band];

        xo1 = 0;
        yo1 = (gfx_h - gfx_texth)*0.5;
        point = 0;
        // Fill spans up to the exclusive right boundary of the graph.
        loop(1001,
          xf = point === 1000 ? gfx_w : point * step;
          freq = scx_to_freq(xf);

          transfer = (
            band == 0 ? gfx_band1.filter.ivf_analog_magnitude(freq) :
              band == 1 ? gfx_band2.filter.ivf_analog_magnitude(freq) :
                band == 2 ? gfx_band3.filter.ivf_analog_magnitude(freq) :
                  band == 3 ? gfx_band4.filter.ivf_analog_magnitude(freq) :
                    band == 4 ? gfx_band5.filter.ivf_analog_magnitude(freq) :
                      band == 5 ? gfx_band6.filter.ivf_analog_magnitude(freq) :
                        band == 6 ? gfx_band7.filter.ivf_analog_magnitude(freq) :
                          band == 7 ? gfx_band8.filter.ivf_analog_magnitude(freq) :
                            band == 8 ? gfx_band9.filter.ivf_analog_magnitude(freq) :
                              band == 9 ? gfx_band10.filter.ivf_analog_magnitude(freq) :
                                band == 10 ? gfx_band11.filter.ivf_analog_magnitude(freq) :
                                  band == 11 ? gfx_band12.filter.ivf_analog_magnitude(freq) :
                                    band == 12 ? gfx_band13.filter.ivf_analog_magnitude(freq) :
                                      band == 13 ? gfx_band14.filter.ivf_analog_magnitude(freq) :
                                        band == 14 ? gfx_band15.filter.ivf_analog_magnitude(freq) :
                                          band == 15 ? gfx_band16.filter.ivf_analog_magnitude(freq);
          );

          // Prevent magnitude from blowing up
          transfer < 0.001 ? transfer = 0.001;

          // Convert from scalar to db
          m = 20 * log10(transfer);

          // Convert db to screen y
          scy = db_to_y(m);

          point > 0 ? (
            x0 = xo1; y0 = yo1;
            x1 = xf; y1 = scy;

            yo1 < bottom && scy < bottom ? (
              gfx_a = 1.0;

              // Clip line against bottom
              y1 > bottom ? (
                delta = (bottom - y0) / (y1 - y0);
                x1 = x0 + delta * (x1 - x0);
                y1 = bottom;
              );

              y0 > bottom ? (
                delta = (bottom - y1) / (y0 - y1);
                x0 = x1 + delta * (x0 - x1);
                y0 = bottom;
              );

              // Thinner line in very compact mode, thicker if not
              (very_compact_width || very_compact_height) ? draw_line(x0, y0, x1, y1) :
                draw_thick_line(x0, y0, x1, y1);
            );

            // Fill in, one column per step, fading from the curve towards the 0dB line
            tx0=xf|0;
            lx0=xo1|0;
            y1 = min(scy, bottom);
            y0 = min(yo1, bottom);
            state == BAND_STATE_ENABLED ? (
              tx0>lx0 ? (
                yc = (y0 + y1) * 0.5 + (HIDPI ? 2 : 1);
                fh = midp - yc;
                fh >= 1 ? (
                  // Boost, the curve is above the line
                  gfx_gradrect(lx0, yc, tx0 - lx0, fh, Band_Red[band], Band_Green[band], Band_Blue[band], FILL_ALPHA_CURVE,
                    0, 0, 0, 0, 0, 0, 0, (FILL_ALPHA_LINE - FILL_ALPHA_CURVE) / fh);
                ) : fh <= -1 ? (
                  // Cut, the curve is below the line
                  gfx_gradrect(lx0, midp, tx0 - lx0, -fh, Band_Red[band], Band_Green[band], Band_Blue[band], FILL_ALPHA_LINE,
                    0, 0, 0, 0, 0, 0, 0, (FILL_ALPHA_CURVE - FILL_ALPHA_LINE) / -fh);
                );
              );
            );
          );

          xo1 = xf; yo1 = scy;

          point += 1;
        );

      );

      band += 1;
    );
  );
);

/*
 * Draw the response for all filters
 */
function draw_filter_response(group, tc)
  local(xf, step, xo1, yo1, freq, m, scy, midp, tx0, lx0, x0, y0, x1, y1, delta, bottom,
    be0, be1, be2, be3, be4, be5, be6, be7, be8, be9, be10, be11, be12, be13, be14, be15,
    bg0, bg1, bg2, bg3, bg4, bg5, bg6, bg7, bg8, bg9, bg10, bg11, bg12, bg13, bg14, bg15)
(
  // Go across the screen in these steps
  step = 1; //gfx_w / 1000;
  gfx_x = 0;
  gfx_y = (gfx_h / 2) - gfx_texth;

  ui_cola(tc, 1);

  be0 = (Band_Enabled[0] == BAND_STATE_ENABLED) && (Band_Group[0] == group);
  be1 = (Band_Enabled[1] == BAND_STATE_ENABLED) && (Band_Group[1] == group);
  be2 = (Band_Enabled[2] == BAND_STATE_ENABLED) && (Band_Group[2] == group);
  be3 = (Band_Enabled[3] == BAND_STATE_ENABLED) && (Band_Group[3] == group);
  be4 = (Band_Enabled[4] == BAND_STATE_ENABLED) && (Band_Group[4] == group);
  be5 = (Band_Enabled[5] == BAND_STATE_ENABLED) && (Band_Group[5] == group);
  be6 = (Band_Enabled[6] == BAND_STATE_ENABLED) && (Band_Group[6] == group);
  be7 = (Band_Enabled[7] == BAND_STATE_ENABLED) && (Band_Group[7] == group);
  be8 = (Band_Enabled[8] == BAND_STATE_ENABLED) && (Band_Group[8] == group);
  be9 = (Band_Enabled[9] == BAND_STATE_ENABLED) && (Band_Group[9] == group);
  be10 = (Band_Enabled[10] == BAND_STATE_ENABLED) && (Band_Group[10] == group);
  be11 = (Band_Enabled[11] == BAND_STATE_ENABLED) && (Band_Group[11] == group);
  be12 = (Band_Enabled[12] == BAND_STATE_ENABLED) && (Band_Group[12] == group);
  be13 = (Band_Enabled[13] == BAND_STATE_ENABLED) && (Band_Group[13] == group);
  be14 = (Band_Enabled[14] == BAND_STATE_ENABLED) && (Band_Group[14] == group);
  be15 = (Band_Enabled[15] == BAND_STATE_ENABLED) && (Band_Group[15] == group);

  bottom = gfx_h - BOTTOM_MARGIN - gfx_texth;

  xo1 = 0;
  yo1 = (gfx_h - gfx_texth)*0.5;
  xf = 0;
  while (
    freq = scx_to_freq(xf);
    
    // Apply the filters
    m = 1.0;

    be0 ? m *= gfx_band1.filter.ivf_analog_magnitude(freq);
    be1 ? m *= gfx_band2.filter.ivf_analog_magnitude(freq);
    be2 ? m *= gfx_band3.filter.ivf_analog_magnitude(freq);
    be3 ? m *= gfx_band4.filter.ivf_analog_magnitude(freq);
    be4 ? m *= gfx_band5.filter.ivf_analog_magnitude(freq);
    be5 ? m *= gfx_band6.filter.ivf_analog_magnitude(freq);
    be6 ? m *= gfx_band7.filter.ivf_analog_magnitude(freq);
    be7 ? m *= gfx_band8.filter.ivf_analog_magnitude(freq);
    be8 ? m *= gfx_band9.filter.ivf_analog_magnitude(freq);
    be9 ? m *= gfx_band10.filter.ivf_analog_magnitude(freq);
    be10 ? m *= gfx_band11.filter.ivf_analog_magnitude(freq);
    be11 ? m *= gfx_band12.filter.ivf_analog_magnitude(freq);
    be12 ? m *= gfx_band13.filter.ivf_analog_magnitude(freq);
    be13 ? m *= gfx_band14.filter.ivf_analog_magnitude(freq);
    be14 ? m *= gfx_band15.filter.ivf_analog_magnitude(freq);
    be15 ? m *= gfx_band16.filter.ivf_analog_magnitude(freq);
    // ReEQ3: Luftikus mode is in the total
    group == 0 && Lf_On ? m *= 10 ^ (LF_CURVE[min(xf, 16383)] / 20);

    // Prevent magnitude from blowing up
    m < 0.001 ? m = 0.001;

    // Convert from scalar to db
    m = 20 * log10(m);

    // Convert db to screen y
    scy = db_to_y(m);

    xo1 > 0 && !(yo1 > bottom && scy > bottom) ? (
      x0 = xo1; y0 = yo1;
      x1 = xf; y1 = scy;
      
      // Clip line against bottom
      y1 > bottom ? (
        delta = (bottom - y0) / (y1 - y0);
        x1 = x0 + delta * (x1 - x0);
        y1 = bottom;
      );

      y0 > bottom ? (
        delta = (bottom - y1) / (y0 - y1);
        x0 = x1 + delta * (x0 - x1);
        y0 = bottom;
      );

      gfx_a = 1;

      HIDPI ? (
        draw_thick_line(x0, y0, x1, y1);

        // If we're not in very compact mode then thicken the line up more
        (!very_compact_width && !very_compact_height) ? (
          abs(x1 - x0) > abs(y1 - y0) ? (
            draw_thick_line(x0, y0+1, x1, y1+1);
            draw_thick_line(x0, y0-1, x1, y1-1);
          ) : ( 
            draw_thick_line(x0+1, y0, x1+1, y1);
            draw_thick_line(x0-1, y0, x1-1, y1);
          );
        );
      ) : (
        // Thinner line in very compact mode, thicker if not
        (very_compact_width || very_compact_height) ? draw_line(x0, y0, x1, y1) :
          draw_thick_line(x0, y0, x1, y1);
      )

      /*
      midp = (gfx_h - gfx_texth) / 2;

      // Fill in positive gain (above mid line)
      scy < midp-3 ? ( 
        gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.3;

        tx0=xf|0;
        lx0=xo|0;
        tx0>lx0 ? (
          gfx_triangle(xo1, yo1+2, xf-1, scy+2, xf-1, midp, xo1, midp);
        );
      );

      // Fill in negative gain (below mid line)
      scy > midp+3 ? ( 
        gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.2;

        tx0=xf|0;
        lx0=xo|0;
        tx0>lx0 ? (
          gfx_triangle(xo1, yo1-2, xf-1, scy-2, xf-1, midp, xo1, midp);
        );
      );
      */
    );

    xo1 = xf; yo1 = scy;

    xf += step;
    xf < gfx_w;
  );
);

/*
 * Draw the eq grid
 */
function draw_grid() local (db, y, x, f, gb, major, lab, k, s, lw) (
  s = ui_pt(1);
  gb = gfx_h - BOTTOM_MARGIN - ui_pt(20);

  // Frequency lines, brighter at each decade, and labels (Body, for legibility at 1x)
  gfx_setfont(FONT_BODY);
  f = 10;
  while (
    x = floor(freq_to_scx(f)) + 0.5;
    major = f == 100 || f == 1000 || f == 10000;
    ui_cola(major ? T_GRID_DECADE : T_GRID, 1);
    gfx_line(x, HEADER_H, x, gb, 0);

    (f == 20 || f == 50 || f == 100 || f == 200 || f == 500 || f == 1000 || f == 2000 || f == 5000 || f == 10000 || f == 20000)
      && (!compact_width || major) ? (
      lab = #;
      f >= 1000 ? sprintf(lab, "%dk", f / 1000) : sprintf(lab, "%d", f);
      lw = ui_text_w(lab);
      ui_cola(T_AXIS_LABEL, 1);
      // Kept inside the window: 20k sits close to the right edge
      ui_text_l(min(x - lw * 0.5, gfx_w - lw - ui_pt(4)), gb + ui_pt(2), ui_pt(14), lab);
    );
    f += (f < 100 ? 10 : f < 1000 ? 100 : f < 10000 ? 1000 : 10000);
    f < MAX_FREQ;
  );

  // Gain lines and labels on the right
  db = DB_EQ_RANGE;
  k = 0;
  while (
    y = floor(db_to_y(db)) + 0.5;
    ui_cola(db == 0 ? T_ZERO_LINE : T_GRID, 1);
    gfx_line(0, y, gfx_w, y, 0);
    !compact_height || (k % 2) == 0 ? (
      lab = #;
      db > 0 ? sprintf(lab, "+%d", db) : db < 0 ? sprintf(lab, "−%d", -db) : strcpy(lab, "0");
      // The top label doubles as the dB range button (ui_draw_header draws it, over the curves)
      k == 0 && !compact_width && !compact_height ? (strcpy(#ui_dbb_lab, lab); ui_dbb_cy = y) : (
        ui_cola(T_DB_LABEL, 1);
        ui_text_r(gfx_w - ui_pt(42), y - ui_pt(8), ui_pt(32), ui_pt(16), lab);
      );
    );
    db -= DB_EQ_RANGE_STEPS;
    k += 1;
    db >= -DB_EQ_RANGE;
  );

  gfx_setfont(FONT_BASE);
);

/*
 * Return true if the mouse is over the freq and dB
 */
function is_node_selected(band) local (x, y, d) ( 
  x = get_filter_x(band);
  y = get_filter_y(band);
  d = sqrt((x - mouse_x)^2 + (y - mouse_y)^2);
  d < ui_pt(12);
);

/*
 * Return nearest node to mouse within dist or -1 if none
 */
function get_node_in_range(dist)
  local(band, found, founddist, dist, x, y, d)
(
  band = 0;
  found = -1;
  founddist = 1000000;

  while( 
    Band_Enabled[band] != BAND_STATE_OFF ? (
      x = get_filter_x(band);
      y = get_filter_y(band);

      d = sqrt((x - mouse_x)^2 + (y - mouse_y)^2);
      d < founddist && d < dist ? (
        founddist = d;
        found = band;
      );
    );
    band += 1;
    band < NUM_BANDS;
  );

  found;
);

/*
 * Return node nearby to mouse or -1 if none
 */
function get_nearby_node()
  local(band, found, founddist, dist, x, y, d)
(
  get_node_in_range(dist = rscale(70, 140));
);

/*
 * Return node nearest to mouse within node halo dist or -1 if none
 */
function get_nearest_node()
  local(band, found, founddist, dist, x, y, d)
(
  get_node_in_range(dist = ui_pt(12));
);

/*
 * Draw a round cornered rectangle
 */
function draw_filled_rect(x, y, w, h, rad, alias) ( 
    gfx_circle(x+rad, y+rad, rad, 1, alias);
    gfx_circle(x+w-rad-1, y+rad, rad, 1, alias);
    gfx_circle(x+w-rad-1, y+h-rad-1, rad, 1, alias);
    gfx_circle(x+rad, y+h-rad-1, rad, 1, alias);

    gfx_rect(x, y+rad, rad*2, h-rad*2, alias);
    gfx_rect(x+w-rad*2, y+rad, rad*2, h-rad*2, alias);
    gfx_rect(x+rad, y, w-rad*2, rad*2, alias);
    gfx_rect(x+rad, y+h-rad*2, w-rad*2, rad*2, alias);

    gfx_rect(x+rad, y+rad, w-rad*2, h-rad*2, alias);
);

/*
 * Return true if mouse is within current window boundaries
 */
function mouse_within_window() ( 
  mouse_x >= 0 && mouse_x < gfx_w && mouse_y >= 0 && mouse_y < gfx_h;
);

/*
 * Return true if mouse is within panel
 */
function mouse_within_panel() ( 
  // (ReEQ3: only while the panel shows, which needs a selected band)
  ui_tb_show && !compact_width && !compact_height ?
    (mouse_x >= ui_tb_x && mouse_x < ui_tb_x + ui_tb_w && mouse_y >= panel_y && mouse_y < panel_y + panel_h) :
  ui_lf_show && !compact_width && !compact_height ?
    (mouse_x >= ui_lf_x && mouse_x < ui_lf_x + ui_lf_w && mouse_y >= panel_y && mouse_y < panel_y + panel_h) :
    (ShowPanel && selected_node != -1 && (mouse_x >= panel_x && mouse_x < panel_x+panel_w && mouse_y >= panel_y && mouse_y < panel_y+panel_h));
);

/*
 * Draw the info panel showing frequency, note, cent and dB
 */
function draw_info_panel(note_select)
  local(x, y, xbase, ybase, read_freq, read_amp, q, band, C0, semi, octave, note, cent, keys, nn, note_freq, centstr, width, rect_height, slope, panel_offset_x, line1, line2, t, lw)
 (
  hide = 0;
  mouse_within_window() || node_drag_mode && !box_region_drag_mode ? 
  (
    gfx_set(0, 0.5, 1);
    read_freq = note_select == 0 ? spectrum.x_to_freq(mouse_x) : note_select;
    read_amp = y_to_db(mouse_y);
    
    node_drag_mode == 1 ?
    (
      read_freq = Band_Frequency[node_drag];
      read_amp = y_to_db(get_filter_y(node_drag));
      q = Band_Q[node_drag];
    );
    
    node_drag_mode == 0 ? (
      q = -1;
      slope = -1;
      node_hover = mouse_within_panel() || mouse_y >= gfx_h - BOTTOM_MARGIN ? -1 : do_listen ? get_nearest_node() : get_nearby_node();

      node_hover == -1 ? node_hover = listen_node;

      node_hover != -1 ? ( 
        band = node_hover;
        q = Band_Q[band];
        read_freq = Band_Frequency[band];
        read_amp = y_to_db(get_filter_y(band));
        Band_Type[band] == FILTER_LOW_CUT || Band_Type[band] == FILTER_LOW_CUT_BUTTERWORTH || Band_Type[band] == FILTER_HIGH_CUT || Band_Type[band] == FILTER_HIGH_CUT_BUTTERWORTH ? slope = 6 + Band_Slope[band] * 6;
        band = NUM_BANDS;

        // Hide info panel if it's too low
        y = db_to_y(read_amp);
        y > gfx_h - gfx_texth - BOTTOM_MARGIN - (RAISED_BOTTOM * ENABLE_RAISED_BOTTOM) ? hide = 1;
      );
    );
    
    //Only show info while hovering band point or in listen mode (handy to see freq etc)
    node_drag_mode || node_hover != -1 || do_listen && !hide ? (

      x = freq_to_scx(read_freq);
      y = db_to_y(read_amp);

      // 440Hz is A4, get C0 as offset from that
      C0 = 440 * pow(2, -4.75);

      // Get seminotes (note number), octave and note within octave
      semi = round(12 * log2(read_freq / C0));
      octave = floor(semi / 12);
      note = semi - octave * 12;

      // Cents from the nearest note, rounded
      note_freq = C0 * 2 ^ (semi / 12);
      cent = floor(1200 * log2(read_freq / note_freq) + 0.5);

      keys="CCDDEFFGGAAB";
      strcpy_substr(nn=#,keys,note,1);
      note==1 || note==3 || note==6 || note==8 || note==10 ? strcat(nn,"#");
      strcat(nn, int2str(octave));
      cent < 0 ? sprintf(centstr=#, " −%d¢", -cent) : sprintf(centstr=#, " +%d¢", cent);
      strcat(nn, centstr);

      // The band the card describes, if any
      band = node_drag_mode != 0 ? node_drag : node_hover;

      // Line 1: frequency and note. Line 2: gain, then Q, slope or cut for shapes that use them.
      line1 = #;
      read_freq < 1000 ? sprintf(line1, read_freq < 100 ? "%.1f Hz" : "%.0f Hz", read_freq) : sprintf(line1, "%.2f kHz", read_freq / 1000);
      line2 = #;
      sprintf(line2, "%s dB", ui_fmt_db(#, read_amp));
      band >= 0 && band < NUM_BANDS ? (
        t = Band_Type[band];
        ui_is_cut(t) ? (
          strcpy(line2, "");
          sprintf(line2, "%d dB/oct", ui_slope_db(ui_slope_index(Band_Slope[band])));
          (t == FILTER_LOW_CUT || t == FILTER_HIGH_CUT) && Band_Slope[band] > 0 ? strcat(line2, sprintf(#, " · Res %.2f", Band_Q[band]));
        ) : t == FILTER_PULTEC_LOW_SHELF ? (
          strcat(line2, sprintf(#, " · Cut %.2f", Band_Q[band] / 40));
        ) : t != FILTER_LOW_CUT_ANALOG && t != FILTER_HIGH_CUT_ANALOG ? (
          (t == FILTER_NOTCH || t == FILTER_BAND_PASS || t == FILTER_ALL_PASS) ? strcpy(line2, "");
          strlen(line2) > 0 ? strcat(line2, " · ");
          strcat(line2, sprintf(#, "Q %.2f", Band_Q[band]));
        );
        // A dynamic band's live change
        Band_Dyn_On[band] && band_dyn_capable(t) && Band_Enabled[band] == BAND_STATE_ENABLED ?
          strcat(line2, sprintf(#, " · %s dB dyn", ui_fmt_db(#, Band_Dyn_Gain[band])));
      );

      // Measure and place the card next to the point, kept inside the graph
      gfx_setfont(FONT_EMPH);
      width = ui_text_w(line1);
      gfx_setfont(FONT_BODY);
      width = max(width + ui_text_w(nn) + ui_pt(4), ui_text_w(line2)) + ui_pt(18);
      rect_height = ui_pt(42);

      xbase = x + ui_pt(16);
      xbase + width > gfx_w - ui_pt(48) ? xbase = x - ui_pt(16) - width;
      xbase = max(ui_pt(8), xbase);
      ybase = y - rect_height - ui_pt(12);
      ybase < HEADER_H + ui_pt(6) ? ybase = y + ui_pt(14);

      ui_box(xbase, ybase, width, rect_height, ui_pt(5), T_POPOVER, 0.95, T_BORDER);

      gfx_setfont(FONT_EMPH);
      ui_col(T_TEXT);
      ui_text_l(xbase + ui_pt(9), ybase + ui_pt(5), ui_pt(16), line1);
      gfx_setfont(FONT_BODY);
      ui_col(T_TEXT_DIM);
      gfx_setfont(FONT_EMPH); lw = ui_text_w(line1); gfx_setfont(FONT_BODY);
      ui_text_l(xbase + ui_pt(9) + lw + ui_pt(4), ybase + ui_pt(5), ui_pt(16), nn);
      ui_col(T_TEXT_SECONDARY);
      ui_text_l(xbase + ui_pt(9), ybase + ui_pt(22), ui_pt(15), line2);
      gfx_setfont(FONT_BASE);
    );
  );
);

/*
 * Draw the listener boundaries and set the Q for the bandpass filter
*/
function draw_listen_helper()
  local (mouse_spec, lread_freq, rread_freq, lfreq, rfreq, lx, rx, node, width, gain, sy)
(
  ui_cola(T_LISTEN, 1);
  
  listen_freq = spectrum.x_to_freq(mouse_x);

  mouse_spec = (mouse_x - spectrum.left_margin) / (gfx_w - spectrum.left_margin - spectrum.right_margin);

  lread_freq = spectrum.min_freq * exp(spectrum.freq_log_max * (mouse_spec - listen_width));
  rread_freq = spectrum.min_freq * exp(spectrum.freq_log_max * (mouse_spec + listen_width));

  lfreq = lread_freq;
  rfreq = rread_freq;

  lx = spectrum.freq_to_x(lfreq);
  rx = spectrum.freq_to_x(rfreq);

  node_drag_mode == 1 || node_hover != -1  || listen_node != -1 ? (

    node_drag_mode == 1 ? node = node_drag : node = node_hover;

    listen_node != -1 ? node = listen_node;

    listen_freq = Band_Frequency[node];
    listen_q = Band_Q[node];
    listen_group = Band_Group[node];
    width = ivf_qtobw(listen_q);

    // Peak or notch? - Has a wider band range
    Band_Type[node] == FILTER_PEAK || Band_Type[node] == FILTER_NOTCH ? ( 
      width *= 2;
    );

    lread_freq = listen_freq / (pow(2, width/2));
    rread_freq = listen_freq * (pow(2, width/2));

    lfreq = lread_freq;
    rfreq = rread_freq;

    lx = spectrum.freq_to_x(lfreq);
    rx = spectrum.freq_to_x(rfreq);

    listen_q = ivf_bwtoq(width);

    // Peak, Band Pass or Notch?
    Band_Type[node] == FILTER_PEAK || Band_Type[node] == FILTER_BAND_PASS || Band_Type[node] == FILTER_NOTCH ? ( 

      Band_Type[node] == FILTER_PEAK ? (
        gain = Band_Enabled[node] == BAND_STATE_ENABLED ? Band_Gain[node] : 0;
        listen_filter.ivf_listen_bell(lfreq, rfreq, Band_Frequency[node], Band_Q[node], gain);
      ) : (
        Band_Type[node] == FILTER_BAND_PASS ? (
          listen_filter.ivf_listen_notch(lfreq, rfreq, Band_Frequency[node], Band_Q[node]);
        ) : ( 
          listen_filter.ivf_band_pass(listen_freq, Band_Q[node]);
        );
      );

      ui_cola(T_LISTEN, 1);
      gfx_line(lx, 0, lx, gfx_h - BOTTOM_MARGIN);
      gfx_line(rx, 0, rx, gfx_h - BOTTOM_MARGIN);

      ui_cola(T_LISTEN, 0.8);
      gfx_line(lx-1, 0, lx-1, gfx_h - BOTTOM_MARGIN);
      gfx_line(rx+1, 0, rx+1, gfx_h - BOTTOM_MARGIN);

      ui_cola(T_LISTEN_SHADOW, 1);
      gfx_rect(lx-3, 0, 2, gfx_h - BOTTOM_MARGIN);

      ui_cola(T_LISTEN_SHADOW, 1);
      gfx_rect(rx+2, 0, 2, gfx_h - BOTTOM_MARGIN);

    ) : (
      // Cut or shelf
      ui_cola(T_LISTEN, 1);
      lx = spectrum.freq_to_x(listen_freq);

      Band_Type[node] == FILTER_LOW_CUT ? (
        listen_filter.ivf_high_cut(listen_freq, Band_Q[node], Band_Slope[node]);
      );
      Band_Type[node] == FILTER_LOW_CUT_BUTTERWORTH ? (
        listen_filter.ivf_high_cut_bw(listen_freq, Band_Slope[node]);
      );

      Band_Type[node] == FILTER_LOW_CUT_ANALOG ? (
        listen_filter.ivf_high_cut(listen_freq, 0.701, 3);
      );
      Band_Type[node] == FILTER_HIGH_CUT_ANALOG ? (
        listen_filter.ivf_low_cut(listen_freq, 0.701, 3);
      );

      Band_Type[node] == FILTER_LOW_SHELF ? (
        lx = spectrum.freq_to_x(rfreq);
        rfreq = min(max(rfreq, 10), MAX_FREQ);
        listen_filter.ivf_high_cut_bw(rfreq, 3);
      );
      Band_Type[node] == FILTER_HIGH_SHELF ? (
        lx = spectrum.freq_to_x(lfreq);
        lfreq = min(max(lfreq, 10), MAX_FREQ);
        listen_filter.ivf_low_cut_bw(lfreq, 3);
      );

      Band_Type[node] == FILTER_HIGH_CUT ? (
        listen_filter.ivf_low_cut(listen_freq, Band_Q[node], Band_Slope[node]);
      );
      Band_Type[node] == FILTER_HIGH_CUT_BUTTERWORTH ? (
        listen_filter.ivf_low_cut_bw(listen_freq, Band_Slope[node]);
      );

      Band_Type[node] == FILTER_TILT_SHELF || Band_Type[node] == FILTER_ALL_PASS ? (
        listen_filter.ivf_bypass();
      );

      Band_Type[node] == FILTER_PULTEC_LOW_SHELF ? (
        // Pultec style - maybe we can do better?
        lx = spectrum.freq_to_x(rfreq);
        rfreq = min(max(rfreq, 10), MAX_FREQ);
        listen_filter.ivf_high_cut_bw(rfreq, 3);
      );

      Band_Type[node] != FILTER_TILT_SHELF && Band_Type[node] != FILTER_ALL_PASS ? gfx_line(lx, 0, lx, gfx_h - BOTTOM_MARGIN);
    );

  ) : (


    // listen_gain = db_to_gain(8);
    mouse_cap & 1 ? (
      listen_gain = db_to_gain(y_to_db(mouse_y));

      sy = mouse_y;

      sy < gfx_h - BOTTOM_MARGIN ? (
        ui_cola(T_LISTEN, 1);
        gfx_line(lx, sy, rx, sy);
        gfx_line(lx, sy+1, rx, sy+1);
      );

    ) : listen_gain = db_to_gain(0);

    listen_filter.ivf_listen_bell(lfreq, rfreq, listen_freq, 0.7071, 0);
  
    ui_cola(T_LISTEN, 1);
    gfx_line(lx, 0, lx, gfx_h - BOTTOM_MARGIN);
    gfx_line(rx, 0, rx, gfx_h - BOTTOM_MARGIN);

    ui_cola(T_LISTEN, 0.8);
    gfx_line(lx-1, 0, lx-1, gfx_h - BOTTOM_MARGIN);
    gfx_line(rx+1, 0, rx+1, gfx_h - BOTTOM_MARGIN);

    ui_cola(T_LISTEN_SHADOW, 1);
    gfx_rect(lx-3, 0, 2, gfx_h - BOTTOM_MARGIN);

    ui_cola(T_LISTEN_SHADOW, 1);
    gfx_rect(rx+2, 0, 2, gfx_h - BOTTOM_MARGIN);
  );
);

/*
 * Animated apha glow effect for node selection halos
 */
function glow_node_selection_halo() local(amount, curr_time, diff_time, tstart, tend) (
  amount = 0.5 + sin(band_selected_circle_phase * 2 * $pi) * 0.5;

  curr_time = time_precise();
  diff_time = curr_time - band_selected_circle_last_time;
  band_selected_circle_last_time = curr_time;

  // Time dependent...
  band_selected_circle_phase += 1.0 * diff_time;

  band_selected_circle_phase > 1.0 ? band_selected_circle_phase -= 1.0;

  // Interpolate within desired range
  tstart = 0.4;
  tend = 0.8;
  band_selected_circle_alpha = tstart + (tend - tstart) * amount;
);

/*
 * Create a band
 */
function create_band(band, x, y) local (m, g, f, i, enabledBands) (
  f = scx_to_freq(x);
  g = y_to_db(y);

  // See if any bands are enabled
  enabledBands = 0;
  i = 0;
  while ( 
    Band_Enabled[i] == BAND_STATE_ENABLED ? enabledBands += 1;
    i += 1;
    i < NUM_BANDS;
  );

  // No bands exist, default group is stereo
  enabledBands == 0 ? selected_node_group = 0;

  Band_Enabled[band] = BAND_STATE_ENABLED;
  Band_Group[band] = selected_node_group;
  Band_Frequency[band] = f;
  Band_Gain[band] = g;
  Band_Q[band] = 0.7071;
  Band_Slope[band] = 1; //12db
  band_dyn_defaults(band);

  // Select band type based on frequency
  f < 20 ? ( 
    Band_Type[band] = FILTER_LOW_CUT;
    Band_Gain[band] = 0;
  ) : f < 30 ? ( 
    Band_Type[band] = FILTER_LOW_SHELF;
    Band_Q[band] = 0.36;
  ) : f < 10000 ? ( 
    Band_Type[band] = FILTER_PEAK;
  ) : f < 15000 ? ( 
    Band_Type[band] = FILTER_HIGH_SHELF;
    Band_Q[band] = 0.36;
  ) : ( 
    Band_Type[band] = FILTER_HIGH_CUT;
    Band_Gain[band] = 0;
  );

  set_filter_from_xy(band, x, y);

  flag_filter_update(band);

  filters_to_sliders();
);

/*
 * Split the band
 */
function split_band(band, other) (
  Band_Enabled[band] = Band_Enabled[other];
  Band_Group[band] = 1;
  Band_Type[band] = Band_Type[other];
  Band_Frequency[band] = Band_Frequency[other];
  Band_Gain[band] = Band_Gain[other];
  Band_Q[band] = Band_Q[other];
  Band_Slope[band] = Band_Slope[other];
  band_dyn_copy(band, other);

  Band_Group[other] = 2;

  Band_Update[band] = 1;
  Band_GfxUpdate[band] = 1;
  Band_Update[other] = 1;
  Band_GfxUpdate[other] = 1;

  flag_filter_update(band);
  flag_filter_update(other);

  filters_to_sliders();
);

/*
 * Split the band
 */
function duplicate_band(band, other) (
  Band_Enabled[band] = Band_Enabled[other];
  Band_Group[band] = Band_Group[other];
  Band_Type[band] = Band_Type[other];
  Band_Frequency[band] = Band_Frequency[other];
  Band_Gain[band] = Band_Gain[other];
  Band_Q[band] = Band_Q[other];
  Band_Slope[band] = Band_Slope[other];
  band_dyn_copy(band, other);

  Band_Update[band] = 1;
  Band_GfxUpdate[band] = 1;
  Band_Update[other] = 1;
  Band_GfxUpdate[other] = 1;

  flag_filter_update(band);
  flag_filter_update(other);

  filters_to_sliders();
);

/*
 * Node selection functions
 */
function select_node_clear() local(i) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] = 0;
    i += 1;
  );
);

function select_node(band) local(i) (
  Band_Selected[band] = 1;
);

function deselect_node(band) local(i) (
  Band_Selected[band] = 0;
);

function is_node_group_selected(band) (
  Band_Selected[band];
);

function preserve_node_selected_states() local(i) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected_States[i] = Band_Selected[i];
    i += 1;
  );
);

function select_nodes_in_box(x1, y1, x2, y2, mode) local(i, x, y) (
  i = 0;
  while (i < NUM_BANDS) (
    x = get_filter_x(i);
    y = get_filter_y(i);

    (mode == 1) ? (
      (x >= x1 && x <= x2 && y >= y1 && y <= y2) ? (
        select_node(i);
      ) : (
        deselect_node(i);
      );
    ) : (
      (x >= x1 && x <= x2 && y >= y1 && y <= y2) ? (
        Band_Selected_States[i] ? deselect_node(i) : select_node(i);
      ) : (
        Band_Selected_States[i] ? select_node(i) : deselect_node(i);
      );
    );
    i += 1;
  );

  band = get_nearby_node();
  band != -1 ? (
    selected_node = band;
  );
);

function is_box_dragging() (
  box_region_drag_mode ? (
    mouse_x != select_box_x || mouse_y != select_box_y
  ) : (
    0
  )
);

function set_node_drag_offsets(band, x, y) local(i, by, iy) (
  by = y_to_db(get_filter_y(band));
  i = 0;
  while (i < NUM_BANDS) (
    Band_Drag_OffsetX[i] = x - get_filter_x(i);
    Band_Drag_OffsetY[i] = y - get_filter_y(i);
    Band_Invert_dB[i] = 0;

    i != band ? (
      iy = y_to_db(get_filter_y(i));
      by > 0 ? (
        iy < 0 ? Band_Invert_dB[i] = 1;
      ) : (
        iy > 0 ? Band_Invert_dB[i] = 1;
      );
    );

    i += 1;
  );
);

function update_drag_nodes_position(x, y, diffx, diffy) local(i, mmx, mmy, posx, posy) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      posx = x + diffx;
      posy = y - diffy;

      Band_Invert_dB[i] == 1 ? posy = y - -diffy;

      mmx = posx - Band_Drag_OffsetX[i];
      mmy = posy - Band_Drag_OffsetY[i];

      //jj1

      set_filter_from_xy(i, mmx, mmy);
    );
    i += 1;
  );
  filters_to_sliders();
);

function update_drag_nodes_Q(x, y, diffx, diffy, md) local(i, mmx, mmy, posx, posy, md, scalar) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      posx = x + diffx;
      posy = y - diffy;

      mmx = posx - Band_Drag_OffsetX[i];
      mmy = posy - Band_Drag_OffsetY[i];

      Band_Frequency[i] = scx_to_freq(mmx);

      Band_Type[i] != FILTER_LOW_CUT && Band_Type[i] != FILTER_LOW_CUT_BUTTERWORTH && Band_Type[i] != FILTER_HIGH_CUT && Band_Type[i] != FILTER_HIGH_CUT_BUTTERWORTH
        && Band_Type[i] != FILTER_LOW_CUT_ANALOG && Band_Type[i] != FILTER_HIGH_CUT_ANALOG ? (
        scalar = 0.5 / max(gfx_ext_retina, 1);

        Band_Q[i] = max(0.10, min(40, per_to_q(q_to_per(Band_Q[i], 100) + md * scalar, 100)));

        // Notify Reaper that a parameter change has happened
        notify_touched_Q(i);
      );

      // Notify Reaper that a parameter change has happened
      notify_touched_frequency(i);
      flag_filter_update(i);
    );
    i += 1;
  );
  filters_to_sliders();
);

function update_node_scroll_Q(band, md) local(i) (
    Band_Type[band] != FILTER_LOW_CUT && Band_Type[band] != FILTER_LOW_CUT_BUTTERWORTH && Band_Type[band] != FILTER_HIGH_CUT && Band_Type[band] != FILTER_HIGH_CUT_BUTTERWORTH
      && Band_Type[band] != FILTER_LOW_CUT_ANALOG && Band_Type[band] != FILTER_HIGH_CUT_ANALOG ? (
      Band_Q[band] = max(0.10, min(40, per_to_q(q_to_per(Band_Q[band], 1) + md * 0.008, 1)));

      // Notify Reaper that a parameter change has happened
      notify_touched_Q(band);

      flag_filter_update(band);
      filters_to_sliders();
  );
);

function update_selected_nodes_scroll_Q(md) local(i) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      update_node_scroll_Q(i, md);
    );
    i += 1;
  );
  filters_to_sliders();
);

function update_node_scroll_slope(band, md) local(t, i, k, qx, qy) (
  t = Band_Type[band];
  ui_has_slope(t) ? (
    k = Band_Slope[band];
    mouse_cap & 8 ? (
      // Fine: 1 dB/oct a step
      k = k - md / 6;
    ) : (
      i = ui_slope_index_t(t, k);
      // From a fractional slope the first step lands on the chip in that direction
      !ui_slope_on_chip(t, k) && (ui_slope_chip(t, i) / 6 - 1 - k) * -md > 0 ? md = 0;
      i = max(min(i - md, ui_slope_n(t) - 1), 0);
      k = ui_slope_chip(t, i) / 6 - 1;
    );
    k = min(max(k, ui_slope_kmin(t)), ui_slope_kmax(t));
    qx = get_filter_x(band);
    qy = get_filter_y(band);
    Band_Slope[band] = k;
    set_filter_from_xy(band, qx, qy);
    flag_filter_update(band);
    filters_to_sliders();
  );
);

function update_selected_nodes_scroll_slope(md) local(i) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      update_node_scroll_slope(i, md);
    );
    i += 1;
  );
  filters_to_sliders();
);

function toggle_nodes_enabled(band) local(i, toggle) (
  toggle = Band_Enabled[band];
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      Band_Enabled[i] = toggle==BAND_STATE_ENABLED ? BAND_STATE_DISABLED : BAND_STATE_ENABLED;
      flag_filter_update(i);
    );
    i += 1;
  );
  filters_to_sliders();
);

/*
 * Dynamics on or off for the selected bands that can be dynamic (the node card's DYN)
 */
function dyn_selected_nodes(on) local(i) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] && band_dyn_capable(Band_Type[i]) ? (
      Band_Dyn_On[i] = on;
      flag_filter_update(i);
      notify_touched_dyn(i, 0);
    );
    i += 1;
  );
  filters_to_sliders();
);

function invert_nodes_gain() local(i) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      Band_Gain[i] = -Band_Gain[i];
      flag_filter_update(i);
    );
    i += 1;
  );
  filters_to_sliders();
);

function zero_nodes_gain() local(i, x, y) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      x = get_filter_x(i);
      y = db_to_y(0);

      set_filter_from_xy(i, x, y);

      flag_filter_update(i);
    );
    i += 1;
  );
  filters_to_sliders();
);

function delete_selected_nodes() local(i) (
  selected_node = -1;
  listen_node = -1;
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      Band_Enabled[i] = BAND_STATE_OFF;

      i == 0 ? gfx_band1.filter.ri_visual_off() :
      i == 1 ? gfx_band2.filter.ri_visual_off() :
      i == 2 ? gfx_band3.filter.ri_visual_off() :
      i == 3 ? gfx_band4.filter.ri_visual_off() :
      i == 4 ? gfx_band5.filter.ri_visual_off() :
      i == 5 ? gfx_band6.filter.ri_visual_off() :
      i == 6 ? gfx_band7.filter.ri_visual_off() :
      i == 7 ? gfx_band8.filter.ri_visual_off();
      i == 8 ? gfx_band9.filter.ri_visual_off() :
      i == 9 ? gfx_band10.filter.ri_visual_off() :
      i == 10 ? gfx_band11.filter.ri_visual_off() :
      i == 11 ? gfx_band12.filter.ri_visual_off() :
      i == 12 ? gfx_band13.filter.ri_visual_off() :
      i == 13 ? gfx_band14.filter.ri_visual_off() :
      i == 14 ? gfx_band15.filter.ri_visual_off() :
      i == 15 ? gfx_band16.filter.ri_visual_off();
      flag_filter_update(i);
    );
    i += 1;
  );
  filters_to_sliders();
);

function split_selected_nodes() local(i, fband) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      // Split band
      fband = 0;
      while(
        Band_Enabled[fband]==BAND_STATE_OFF ? (                
          split_band(fband, i);
          fband = NUM_BANDS;
        );
        fband += 1;
        fband < NUM_BANDS;
      );
    );
    i += 1;
  );
  filters_to_sliders();
);

function duplicate_selected_nodes() local(i, fband) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      // Duplicate band
      fband = 0;
      while(
        Band_Enabled[fband]==BAND_STATE_OFF ? (                
          duplicate_band(fband, i);
          fband = NUM_BANDS;
        );
        fband += 1;
        fband < NUM_BANDS;
      );
    );
    i += 1;
  );
  filters_to_sliders();
);

function stereo_selected_nodes(stereo) local(i) (
  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      Band_Group[i] = stereo;

      flag_filter_update(i);
    );
    i += 1;
  );
  filters_to_sliders();
);

function set_shape_selected_nodes(shape, has_slope) local(i, newshape) (
  newshape = FilterMappingTo[shape];

  i = 0;
  while (i < NUM_BANDS) (
    Band_Selected[i] ? (
      ui_is_cut(newshape) != ui_is_cut(Band_Type[i]) || !ui_has_slope(newshape) || !ui_has_slope(Band_Type[i]) ? Band_Slope[i] = 1;
      newshape == FILTER_PEAK ? Band_Slope[i] = max(Band_Slope[i], 1);

      // Preserve Q when switching between normal low/high cuts
      !((newshape == FILTER_LOW_CUT || newshape == FILTER_HIGH_CUT) && (Band_Type[i] == FILTER_LOW_CUT || Band_Type[i] == FILTER_HIGH_CUT)) ? (
        Band_Q[i] = 0.7071;
      );

      Band_Type[i] = newshape;
      Band_Type[i] == FILTER_PULTEC_LOW_SHELF ? (Band_Q[i] = 20; Band_Slope[i] = 1);

      Band_Type[i] == FILTER_BAND_PASS || Band_Type[i] == FILTER_NOTCH || Band_Type[i] == FILTER_ALL_PASS || Band_Type[i] == FILTER_LOW_CUT
        || Band_Type[i] == FILTER_LOW_CUT_BUTTERWORTH || Band_Type[i] == FILTER_HIGH_CUT || Band_Type[i] == FILTER_HIGH_CUT_BUTTERWORTH ? (
        Band_Gain[i] = 0;
      );

      notify_touched_Q(i);
      notify_touched_gain(i);

      flag_filter_update(i);
    );
    i += 1;
  );
  filters_to_sliders();
);

function set_node_slope(band, slope) (
  x = get_filter_x(band);
  y = get_filter_y(band);

  Band_Slope[band] = slope;

  set_filter_from_xy(band, x, y);

  flag_filter_update(band);
);

function set_slopes_selected_nodes(slope) local(i, x, y) (
  i = 0;
  while (i < NUM_BANDS) (
    // Each selected band of a shape that has a slope, kept to its shape's range
    Band_Selected[i] && ui_has_slope(Band_Type[i]) ? (
      set_node_slope(i, min(max(slope, ui_slope_kmin(Band_Type[i])), ui_slope_kmax(Band_Type[i])));
    );
    i += 1;
  );
  filters_to_sliders();
);

/*
 * Return 1 if mouse is over number button
 */
function is_mouse_number_button() instance (x, y, width, height)
(
  mouse_x >= x && mouse_x <= x+width && mouse_y >= y && mouse_y <= y + height;
);

/*
 * Handle the number style button
 */
function handle_number_button() instance (x, y, width, menutext, label, drag, height, db, oldy, type)
  local (oldy, md)
(
  (button_focus == -1 || button_focus == x) && node_drag_mode == 0 && box_region_drag_mode == 0 ? (
  mouse_cap & 1 && !drag ? (
    this.is_mouse_number_button() ? (
      drag = 1;
      oldy = mouse_y;

      gfx_x = x / 2;
      gfx_y = y / 2;
      button_focus = x;
    );
  ) : ( 
    !(mouse_cap & 1) ? ( drag = 0; button_focus = -1; );
  );

  drag ? ( 
    md = (mouse_y - oldy);
    type == 0 ? (
      md > 0 ? db -= 0.1 * abs(md*0.5);
      md < 0 ? db += 0.1 * abs(md*0.5);
      abs(db) < 0.005 ? db = 0;
      db = min(FIELD_DB_MAX, db);
      db = max(FIELD_DB_MIN, db);
    ) : type == 3 ? (
      // transformer drive, 0..36dB
      db -= md * 0.075;
      db = min(max(db, 0), 36);
    ) : type == 2 ? (
      // Pan, -100..100%
      db -= md * 0.5;
      abs(db) < 0.25 ? db = 0;
      db = min(max(db, -100), 100);
    ) : (
      md > 0 ? db -= abs(md*0.5);
      md < 0 ? db += abs(md*0.5);
      db = min(SCALE_MAX, db);
      db = max(0, db);
    );
    oldy = mouse_y;
  );

  );

  db;
);

/*
 * Return 1 if mouse is over number button
 */
function is_mouse_number_dial() instance (x, y, r, v) local (rad)
(
  rad = r + gfx_texth*2;
  // Across, no further than halfway to the next dial (they sit closer in a dynamic band's panel)
  mouse_x >= x - min(rad, ui_dial_hx) && mouse_x <= x + min(rad, ui_dial_hx) && mouse_y >= y - rad && mouse_y <= y + rad;
);

/*
 * Handle the number style button
 */
function handle_number_dial(val) instance (x, y, r, v, width, menutext, label, drag, height, db, oldy, type)
  local (oldy, md, mouse_speed)
(
  v = val;
  (button_focus == -1 || button_focus == x) && node_drag_mode == 0 && box_region_drag_mode == 0 ? (
    mouse_cap & 1 && !drag ? (
      this.is_mouse_number_dial() ? (
        drag = 1;
        oldy = mouse_y;

        gfx_x = x / 2;
        gfx_y = y / 2;
        button_focus = x;
      );
    ) : ( 
      !(mouse_cap & 1) ? ( drag = 0; button_focus = -1; );
    );

    drag ? (
      mouse_cap & 16 ? mouse_speed = 12 : mouse_speed = 1;
      md = (mouse_y - oldy) / mouse_speed;

      md > 0 ? v -= 0.01 * abs(md*0.5);
      md < 0 ? v += 0.01 * abs(md*0.5);
      v < 0.0 ? v = 0;
      v > 1.0 ? v = 1;

      oldy = mouse_y;
    );
  );

  v;
);


// Gain does nothing for a notch, band pass or all pass; Q nothing for the fixed-shape cuts
function ui_gain_inert(t) (
  t == FILTER_NOTCH || t == FILTER_BAND_PASS || t == FILTER_ALL_PASS;
);

function ui_q_inert(b) local(t) (
  t = Band_Type[b];
  t == FILTER_LOW_CUT_BUTTERWORTH || t == FILTER_HIGH_CUT_BUTTERWORTH || t == FILTER_LOW_CUT_ANALOG || t == FILTER_HIGH_CUT_ANALOG
    || ((t == FILTER_LOW_CUT || t == FILTER_HIGH_CUT) && Band_Slope[b] == 0);
);

////////////////////////////////////////////////////////////////////////////////////////////
// Value stepper: a popover with a column per digit, for setting a dial, knob or field exactly.
// Each control is an id (SV_FREQ .. SV_OUT); b is the band for the panel's controls.
////////////////////////////////////////////////////////////////////////////////////////////

/*
 * A control's range, digits (integer and decimal), default, title and unit, into sv_min, sv_max,
 * sv_int, sv_dec, sv_def, #sv_lab and #sv_unit
 */
function sv_spec(id, b) (
  strcpy(#sv_unit, "dB"); sv_def = 0;
  id == SV_FREQ ? (sv_min = MIN_FREQ; sv_max = MAX_FREQ; sv_int = 5; sv_dec = 1; sv_def = 500; strcpy(#sv_lab, "Frequency"); strcpy(#sv_unit, "Hz")) :
  id == SV_GAIN ? (sv_min = -BAND_GAIN_MAX; sv_max = BAND_GAIN_MAX; sv_int = 2; sv_dec = 1; strcpy(#sv_lab, "Gain")) :
  id == SV_Q ? (sv_min = MIN_Q; sv_max = MAX_Q; sv_int = 2; sv_dec = 2; sv_def = 0.7071; strcpy(#sv_lab, ui_is_cut(Band_Type[b]) ? "Resonance" : "Q"); strcpy(#sv_unit, "")) :
  id == SV_THRESH ? (sv_min = DYN_THRESH_MIN; sv_max = 0; sv_int = 2; sv_dec = 1; sv_def = -24; strcpy(#sv_lab, "Threshold")) :
  id == SV_RATIO ? (sv_min = 1; sv_max = DYN_RATIO_MAX; sv_int = 2; sv_dec = 1; sv_def = 4; strcpy(#sv_lab, "Ratio"); strcpy(#sv_unit, ":1")) :
  id == SV_RANGE ? (sv_min = -DYN_RANGE_MAX; sv_max = DYN_RANGE_MAX; sv_int = 2; sv_dec = 1; sv_def = -6; strcpy(#sv_lab, "Range")) :
  id == SV_ATTACK ? (sv_min = DYN_ATK_MIN; sv_max = DYN_ATK_MAX; sv_int = 3; sv_dec = 1; sv_def = 5; strcpy(#sv_lab, "Attack"); strcpy(#sv_unit, "ms")) :
  id == SV_RELEASE ? (sv_min = DYN_REL_MIN; sv_max = DYN_REL_MAX; sv_int = 4; sv_dec = 0; sv_def = 80; strcpy(#sv_lab, "Release"); strcpy(#sv_unit, "ms")) :
  id == SV_SCALE ? (sv_min = 0; sv_max = SCALE_MAX; sv_int = 3; sv_dec = 0; sv_def = 100; strcpy(#sv_lab, "Scale"); strcpy(#sv_unit, "%")) :
  id == SV_TX ? (sv_min = 0; sv_max = 36; sv_int = 2; sv_dec = 1; sv_def = 0; strcpy(#sv_lab, "Transformer Drive"); strcpy(#sv_unit, "dB")) :
  id == SV_PAN ? (sv_min = -100; sv_max = 100; sv_int = 3; sv_dec = 1; sv_def = 0; strcpy(#sv_lab, Out_PanMode ? "Mid / Side" : "Pan"); strcpy(#sv_unit, "%")) : (
    // The toolbar's dB fields
    sv_min = FIELD_DB_MIN; sv_max = FIELD_DB_MAX; sv_int = 3; sv_dec = 1;
    strcpy(#sv_lab, id == SV_IN ? "In" : id == SV_OUT ? "Out" : id == SV_MID ? (Stereo_Mode ? "Left" : "Mid") : (Stereo_Mode ? "Right" : "Side"));
  );
);

function sv_get(id, b) (
  id == SV_FREQ ? Band_Frequency[b] : id == SV_GAIN ? Band_Gain[b] : id == SV_Q ? Band_Q[b] :
  id == SV_THRESH ? Band_Dyn_Thresh[b] : id == SV_RATIO ? Band_Dyn_Ratio[b] : id == SV_RANGE ? Band_Dynamic_Range[b] :
  id == SV_ATTACK ? Band_Dyn_Attack[b] : id == SV_RELEASE ? Band_Dyn_Release[b] :
  id == SV_IN ? InGain : id == SV_SCALE ? Scale : id == SV_MID ? MLGain : id == SV_SIDE ? SRGain : id == SV_PAN ? Out_Pan : id == SV_TX ? Tx_Drive : Gain;
);

/*
 * Write a control's value as it is and tell REAPER (undo, automation). The panel's dials, the dynamics
 * knobs and range handle, the toolbar's fields and the stepper all set their values through here (node
 * drags and the wheel on the graph have their own paths). A band's sliders are brought up to date
 * before REAPER is told, so it records the new value.
 */
function sv_put(id, b, v) (
  id <= SV_RELEASE ? (
    id == SV_FREQ ? Band_Frequency[b] = v : id == SV_GAIN ? Band_Gain[b] = v : id == SV_Q ? Band_Q[b] = v :
      id == SV_THRESH ? Band_Dyn_Thresh[b] = v : id == SV_RATIO ? Band_Dyn_Ratio[b] = v : id == SV_RANGE ? Band_Dynamic_Range[b] = v :
      id == SV_ATTACK ? Band_Dyn_Attack[b] = v : Band_Dyn_Release[b] = v;
    // The dials reshape the band's filter; the dynamics settings are read as they run
    id <= SV_Q ? flag_filter_update(b);
    filters_to_sliders();
    id == SV_FREQ ? notify_touched_frequency(b) : id == SV_GAIN ? notify_touched_gain(b) : id == SV_Q ? notify_touched_Q(b) :
      notify_touched_dyn(b, id - SV_THRESH + 1);
  ) :
  id == SV_IN ? (InGain = v; slider_automate(InGain)) :
  id == SV_SCALE ? (Scale = v; flag_filter_update_all(); slider_automate(Scale)) :
  id == SV_MID ? (MLGain = v; slider_automate(MLGain)) :
  id == SV_SIDE ? (SRGain = v; slider_automate(SRGain)) :
  id == SV_PAN ? (Out_Pan = v; slider_automate(Out_Pan)) :
  id == SV_TX ? (Tx_Drive = v; slider_automate(Tx_Drive)) :
  (Gain = v; slider_automate(Gain));
);

// Set a control, kept to its range
function sv_set(id, b, v) (
  sv_spec(id, b);
  sv_put(id, b, min(max(v, sv_min), sv_max));
);

/*
 * The control is there and active: a panel control needs its band selected, enabled and in the panel,
 * and not inert (a dynamics knob needs the band's dynamics shown, Attack and Release need Manual
 * timing); a toolbar field needs the toolbar
 */
function sv_live(id, b) local(t) (
  id <= SV_RELEASE ? (
    t = Band_Type[b];
    b >= 0 && b == selected_node && ShowPanel && Band_Enabled[b] != BAND_STATE_OFF && (
      id == SV_FREQ ? 1 :
      id == SV_GAIN ? !ui_is_cut(t) && !ui_gain_inert(t) :
      id == SV_Q ? !ui_q_inert(b) :
      ui_dyn_panel && (id == SV_ATTACK || id == SV_RELEASE ? !Band_Dyn_Auto[b] : 1)
    );
  ) : !compact_width && !compact_height;
);

// v rounded to the control's last digit (sv_spec first)
function sv_round(v) local(k) (
  k = 10 ^ sv_dec;
  floor(v * k + 0.5) / k;
);

/*
 * Step a shown value v by st on its magnitude (dir 1 up, -1 down), so the digit moves as drawn; the
 * magnitude stops at zero, and a control that can't be positive stays negative. dir 0 flips the sign.
 * Rounded and kept to the range (sv_spec first).
 */
function sv_step(v, st, dir) local(sg) (
  dir == 0 ? v = -v : (
    sg = v < 0 || (v == 0 && sv_max <= 0) ? -1 : 1;
    v = sg * max(abs(v) + dir * st, 0);
  );
  min(max(sv_round(v), sv_min), sv_max);
);

/*
 * The stepper id of the control under the mouse, or -1. Uses the positions drawn last frame: the
 * panel's dials, the dynamics grid (ui_draw_dyn_block) and the toolbar's fields.
 */
function sv_hit() local(b, c, r, id) (
  id = -1; b = selected_node;
  b >= 0 && mouse_within_panel() ? (
    dial_freq.is_mouse_number_dial() ? id = SV_FREQ :
    dial_gain.is_mouse_number_dial() ? id = SV_GAIN :
    dial_q.is_mouse_number_dial() ? id = SV_Q :
    ui_dyn_shown ? (
      c = floor((mouse_x - ui_dyn_gx) / ui_dyn_cw);
      r = abs(mouse_y - ui_dyn_r1) < ui_pt(16) ? 0 : abs(mouse_y - ui_dyn_r2) < ui_pt(16) ? 1 : -1;
      c >= 0 && c < 3 && r >= 0 && r * 3 + c < 5 ? id = SV_THRESH + r * 3 + c;
    );
  ) : BOTTOM_MARGIN > 0 && mouse_y >= gfx_h - BOTTOM_MARGIN ? (
    button_in_gain.is_mouse_number_button() ? id = SV_IN :
    button_scale.is_mouse_number_button() ? id = SV_SCALE :
    button_mid_gain.is_mouse_number_button() ? id = SV_MID :
    button_side_gain.is_mouse_number_button() ? id = SV_SIDE :
    button_pan.is_mouse_number_button() ? id = SV_PAN :
    button_tx.is_mouse_number_button() ? id = SV_TX :
    button_gain.is_mouse_number_button() ? id = SV_OUT;
  );
  id >= 0 && !sv_live(id, b) ? -1 : id;
);

/*
 * Open the stepper for a control, pointing at it
 */
/*
 * ReEQ3: typed values. Plain numbers, with "k" for thousands ("2k", "2.5k", "2k5"); note names for a
 * frequency ("A4", "C#2+13", "Bb3-20": cents after the octave); "x" for a gain ratio in dB ("2x" is
 * +6.02); "50%" for that position of the control's travel (the pan takes % as its own unit). Units
 * (Hz, kHz, dB, ms) are ignored. Returns the value; ui_parse_ok says whether it made sense.
 */
function ui_ch_lower(c) ( c >= 'A' && c <= 'Z' ? c + 32 : c; );
function sv_parse(str, id) local(n, i, c, num, frac, fdiv, sgn, have, k, note, acc, oct, octs, cents, csgn, pct, xr, v, t0) (
  ui_parse_ok = 0;
  n = strlen(str);
  // Skip spaces at either end
  i = 0; while (i < n && str_getchar(str, i) == ' ') (i += 1);
  while (n > i && str_getchar(str, n - 1) == ' ') (n -= 1);
  c = ui_ch_lower(str_getchar(str, i));
  // A note name: a letter A..G first
  id == SV_FREQ && c >= 'a' && c <= 'g' ? (
    note = c == 'c' ? 0 : c == 'd' ? 2 : c == 'e' ? 4 : c == 'f' ? 5 : c == 'g' ? 7 : c == 'a' ? 9 : 11;
    i += 1;
    acc = 0;
    i < n ? (c = str_getchar(str, i); c == '#' ? (acc = 1; i += 1) : c == 'b' ? (acc = -1; i += 1));
    octs = 1;
    i < n && str_getchar(str, i) == '-' ? (octs = -1; i += 1);
    oct = 0; have = 0;
    while (i < n && (c = str_getchar(str, i)) >= '0' && c <= '9') (oct = oct * 10 + c - '0'; have = 1; i += 1);
    cents = 0; csgn = 1;
    i < n && ((c = str_getchar(str, i)) == '+' || c == '-') ? (
      csgn = c == '-' ? -1 : 1; i += 1;
      while (i < n && (c = str_getchar(str, i)) >= '0' && c <= '9') (cents = cents * 10 + c - '0'; i += 1);
    );
    have ? (
      v = 440 * 2 ^ ((12 * (octs * oct + 1) + note + acc - 69) / 12 + csgn * cents / 1200);
      ui_parse_ok = 1;
    );
  ) : (
    sgn = 1;
    c = str_getchar(str, i);
    c == '-' ? (sgn = -1; i += 1) : c == '+' ? i += 1;
    num = 0; frac = 0; fdiv = 1; have = 0; k = 1; pct = 0; xr = 0;
    while (i < n && (c = str_getchar(str, i)) >= '0' && c <= '9') (num = num * 10 + c - '0'; have = 1; i += 1);
    i < n && (str_getchar(str, i) == '.' || str_getchar(str, i) == ',') ? (
      i += 1;
      while (i < n && (c = str_getchar(str, i)) >= '0' && c <= '9') (frac = frac * 10 + c - '0'; fdiv *= 10; have = 1; i += 1);
    );
    // A suffix: k (and 2k5), x, %, or a unit
    i < n ? (
      c = ui_ch_lower(str_getchar(str, i));
      c == 'k' ? (
        k = 1000; i += 1;
        // "2k5": the digits after k are the decimals
        fdiv == 1 ? while (i < n && (t0 = str_getchar(str, i)) >= '0' && t0 <= '9') (frac = frac * 10 + t0 - '0'; fdiv *= 10; i += 1);
      ) : c == 'x' ? xr = 1 : c == '%' ? pct = 1;
    );
    have ? (
      v = sgn * (num + frac / fdiv) * k;
      ui_parse_ok = 1;
      xr ? (
        // A gain ratio: only for the dB controls
        v > 0 && (id == SV_GAIN || id == SV_RANGE || id == SV_THRESH || id >= SV_IN && id != SV_SCALE && id != SV_PAN) ?
          v = 20 * log10(v) : ui_parse_ok = 0;
      ) : pct && id != SV_PAN && id != SV_SCALE ? (
        // A share of the control's travel, as its knob or dial maps it
        t0 = min(max(v / 100, 0), 1);
        sv_spec(id, ui_sv_b);
        v = id == SV_FREQ ? per_to_freq(t0, 1.0) : id == SV_Q ? per_to_q(t0, 1.0) :
            id == SV_RATIO ? exp(t0 * log(DYN_RATIO_MAX)) :
            id == SV_ATTACK ? DYN_ATK_MIN * exp(t0 * log(DYN_ATK_MAX / DYN_ATK_MIN)) :
            id == SV_RELEASE ? DYN_REL_MIN * exp(t0 * log(DYN_REL_MAX / DYN_REL_MIN)) :
            sv_min + t0 * (sv_max - sv_min);
      );
    );
  );
  v;
);

function sv_open(id) local(k) (
  ui_sv_id = id;
  ui_sv_b = id <= SV_RELEASE ? selected_node : -1;
  ui_sv_v0 = sv_get(id, ui_sv_b);
  id == SV_FREQ ? (ui_pop_x = dial_freq.x - dial_freq.r; ui_pop_y = dial_freq.y - dial_freq.r; ui_pop_w = 2 * dial_freq.r) :
  id == SV_GAIN ? (ui_pop_x = dial_gain.x - dial_gain.r; ui_pop_y = dial_gain.y - dial_gain.r; ui_pop_w = 2 * dial_gain.r) :
  id == SV_Q ? (ui_pop_x = dial_q.x - dial_q.r; ui_pop_y = dial_q.y - dial_q.r; ui_pop_w = 2 * dial_q.r) :
  id <= SV_RELEASE ? (
    // The knob, 26pt across at the cell's left
    k = id - SV_THRESH;
    ui_pop_x = ui_dyn_gx + (k % 3) * ui_dyn_cw; ui_pop_w = ui_pt(26);
    ui_pop_y = (k < 3 ? ui_dyn_r1 : ui_dyn_r2) - ui_pt(13);
  ) :
  id == SV_IN ? (ui_pop_x = button_in_gain.x; ui_pop_y = button_in_gain.y; ui_pop_w = button_in_gain.width) :
  id == SV_SCALE ? (ui_pop_x = button_scale.x; ui_pop_y = button_scale.y; ui_pop_w = button_scale.width) :
  id == SV_MID ? (ui_pop_x = button_mid_gain.x; ui_pop_y = button_mid_gain.y; ui_pop_w = button_mid_gain.width) :
  id == SV_SIDE ? (ui_pop_x = button_side_gain.x; ui_pop_y = button_side_gain.y; ui_pop_w = button_side_gain.width) :
  id == SV_PAN ? (ui_pop_x = button_pan.x; ui_pop_y = button_pan.y; ui_pop_w = button_pan.width) :
  id == SV_TX ? (ui_pop_x = button_tx.x; ui_pop_y = button_tx.y; ui_pop_w = button_tx.width) :
  (ui_pop_x = button_gain.x; ui_pop_y = button_gain.y; ui_pop_w = button_gain.width);
  ui_popup = 9; ui_pop_skip = 1; ui_block = 1;
  // ReEQ3: typing starts afresh
  #sv_text = ""; ui_sv_bad = 0;
  ui_sv_wheel = mouse_wheel; ui_sv_wacc = 0; ui_sv_wcol = -1; ui_sv_hold = -1;
);

////////////////////////////////////////////////////////////////////////////////////////////
// UI: bottom toolbar, top-right controls, node panel and pickers
////////////////////////////////////////////////////////////////////////////////////////////

function ui_sig(z) (
  1 / (1 + exp(-z));
);

function ui_tanh(z) local(e) (
  e = exp(2 * min(max(z, -20), 20));
  (e - 1) / (e + 1);
);

/*
 * Response curve of a shape for its picker icon: y in a 40 x 22 box for t in 0..1
 */
function ui_shape_y(type, t) (
  type == 14 ? 17 - 12 * t :
  type == 0 ? 16 - 12 * exp(-sqr((t - 0.5) / 0.16)) :
    type == 3 ? 6 + 9 * ui_sig((t - 0.45) / 0.07) :
      type == 4 ? 15 - 9 * ui_sig((t - 0.6) / 0.07) :
        type == 9 ? 10.5 + 5.5 * ui_tanh((0.5 - t) / 0.22) :
          type == 10 ? 5 + 6 * ui_sig((t - 0.22) / 0.05) + 3 * exp(-sqr((t - 0.42) / 0.09)) :
            type == 7 ? 6 + 13 * exp(-sqr((t - 0.5) / 0.035)) :
              type == 8 ? 19 - 14 * exp(-sqr((t - 0.5) / 0.15)) :
                type == 1 ? 7 + 13 * (1 - ui_sig((t - 0.22) / 0.045)) - 3 * exp(-sqr((t - 0.3) / 0.05)) :
                  type == 2 ? 7 + 13 * (1 - ui_sig((t - 0.25) / 0.06)) :
                    type == 12 ? 7 + 12 * (1 - ui_sig((t - 0.1) / 0.035)) - 3 * exp(-sqr((t - 0.26) / 0.08)) :
                      11 - 5 * sin(2 * $pi * (t - 0.15) / 0.7);
);

function ui_shape_base(type) (
  type == 0 ? 16 : type == 3 || type == 4 ? 15 : type == 7 ? 6 : type == 8 ? 5 : type == 14 ? 11 : ui_is_cut(type) || type >= 12 ? 7 : 11;
);

/*
 * Shape icon in a 40 x 22 pt box at x, y, in the current colour
 */
// k scales the 40 x 22pt icon
function ui_shape_icon(type, x, y, k) local(s, m, flip, i, n, t0, t1, y0, y1, base, r, g, b, a) (
  s = ui_pt(1) * k;
  // High cuts draw as mirrored low cuts
  m = type == 5 ? 1 : type == 6 ? 2 : type == 13 ? 12 : type;
  flip = type == 5 || type == 6 || type == 13;

  r = gfx_r; g = gfx_g; b = gfx_b; a = gfx_a;
  base = ui_shape_base(type);
  ui_col_a(T_BORDER, a);
  i = 0;
  loop(9,
    gfx_line(x + (2 + i * 4) * s, y + base * s, x + (4 + i * 4) * s, y + base * s, 1);
    i += 1;
  );
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a;

  n = 24; i = 0;
  loop(n,
    t0 = i / n; t1 = (i + 1) / n;
    y0 = ui_shape_y(m, flip ? 1 - t0 : t0);
    y1 = ui_shape_y(m, flip ? 1 - t1 : t1);
    // All pass: a dashed phase wiggle over the middle
    type != 11 || (t0 >= 0.15 && t1 <= 0.85 && (i % 2) == 0) ?
      ui_thick_line(x + (2 + 36 * t0) * s, y + y0 * s, x + (2 + 36 * t1) * s, y + y1 * s, 1.6 * s);
    i += 1;
  );
);

// Picker tile order: tonal shapes, then cuts and all pass
function ui_tile_type(i) (
  i == 0 ? 0 : i == 1 ? 3 : i == 2 ? 4 : i == 3 ? 9 : i == 4 ? 14 : i == 5 ? 10 : i == 6 ? 7 : i == 7 ? 8 :
    i == 8 ? 1 : i == 9 ? 2 : i == 10 ? 12 : i == 11 ? 5 : i == 12 ? 6 : i == 13 ? 13 : 11;
);
UI_TILES = 15; UI_TILE_COLS = 8;

/*
 * ReEQ3: the slope row shared by the shape picker and the node card. The shape's chips (dimmed for a
 * shape without a slope), and the band's slope after them when it is fractional (Shift+Ctrl+wheel or
 * Shift dragging the slope dial sets one). Returns the chip pressed this frame as a slope step, or -1.
 */
function ui_slope_row(x, y, w, h, b, pr) local(s, t, on, n, cur, cw, k, chip, hov, ret, lw, frac) (
  s = ui_pt(1); ret = -1;
  t = Band_Type[b];
  on = ui_has_slope(t);
  n = on ? ui_slope_n(t) : 10;
  frac = on && !ui_slope_on_chip(t, Band_Slope[b]);
  cur = on && !frac ? ui_slope_index_t(t, Band_Slope[b]) : -1;
  gfx_setfont(FONT_CAP); ui_col_a(T_TEXT_DIM, on ? 1 : 0.35);
  ui_text_l(x, y, h, "SLOPE");
  lw = 48 * s;
  gfx_setfont(FONT_CAP); ui_col_a(frac ? T_SELECTED : T_TEXT_FAINT, on ? 1 : 0.35);
  ui_text_r(x + w - lw, y, lw, h, frac ? sprintf(#, "%s dB/oct", ui_slope_text(#, Band_Slope[b])) : "dB/oct");
  cw = (w - 40 * s - lw - 6 * s - (n - 1) * 3 * s) / n;
  k = 0;
  loop(n,
    chip = floor(x + 40 * s + k * (cw + 3 * s));
    hov = on && ui_in(chip, y, cw, h);
    k == cur ? (ui_band_col(b); gfx_a = 0.14; ui_fill_rrect(chip, y, cw, h, 4 * s); gfx_a = 1; gfx_roundrect(chip, y, cw - 1, h - 1, 4 * s, 1))
             : (ui_col_a(hov ? T_CONTROL_HOVER : T_CONTROL, on ? 1 : 0.35); ui_fill_rrect(chip, y, cw, h, 4 * s);
                ui_col_a(T_BORDER, on ? 1 : 0.35); gfx_roundrect(chip, y, cw - 1, h - 1, 4 * s, 1));
    gfx_setfont(k == cur ? FONT_BODY_B : FONT_BODY);
    ui_col_a(k == cur ? T_SELECTED : hov ? T_TEXT : T_TEXT_SECONDARY, k == cur || on ? 1 : 0.35);
    ui_text_c(chip, y, cw, h, sprintf(#, "%d", on ? ui_slope_chip(t, k) : ui_slope_db(k)));
    pr && hov ? ret = ui_slope_chip(t, k) / 6 - 1;
    k += 1;
  );
  gfx_a = 1;
  ret;
);

// The shape's name with its slope where it has one that isn't the default
function ui_shape_label(lab, b) local(t) (
  t = Band_Type[b];
  ui_is_cut(t) || (ui_has_slope(t) && abs(Band_Slope[b] - ui_slope_default(t)) > 0.001) ?
    sprintf(lab, "%s · %s", ui_shape_name(t), ui_slope_text(#, Band_Slope[b])) : strcpy(lab, ui_shape_name(t));
  lab;
);

function ui_group_name(g) (
  g == 0 ? "Stereo" : g == 1 ? "Mid" : g == 2 ? "Side" : g == 3 ? "Left" : "Right";
);

/*
 * Change a band's shape, following the node menu's rules
 */
function ui_set_shape(b, nt) local(ot) (
  ot = Band_Type[b];
  nt != ot ? (
    // Entering a cut from another shape, or leaving one, starts at 12 dB; between bells, shelves and the
    // tilt shelf the slope is kept (a bell is never shallower than 12)
    ui_is_cut(ot) != ui_is_cut(nt) || !ui_has_slope(nt) || !ui_has_slope(ot) ? Band_Slope[b] = 1;
    nt == FILTER_PEAK ? Band_Slope[b] = max(Band_Slope[b], 1);

    // Preserve Q when switching between normal low/high cuts
    !((nt == FILTER_LOW_CUT || nt == FILTER_HIGH_CUT) && (ot == FILTER_LOW_CUT || ot == FILTER_HIGH_CUT)) ? Band_Q[b] = 0.7071;

    Band_Type[b] = nt;
    nt == FILTER_PULTEC_LOW_SHELF ? (Band_Q[b] = 20; Band_Slope[b] = 1);
    nt == FILTER_BAND_PASS || nt == FILTER_NOTCH || nt == FILTER_ALL_PASS || ui_is_cut(nt) ? Band_Gain[b] = 0;

    notify_touched_Q(b);
    notify_touched_gain(b);
    flag_filter_update(b);
    filters_to_sliders();
  );
);

/*
 * Text-only button, such as the band navigation chevrons
 */
function ui_text_button(x, y, w, h, label) local(hov) (
  hov = ui_hover(x, y, w, h);
  gfx_setfont(FONT_EMPH);
  ui_col(hov ? T_TEXT : T_TEXT_SECONDARY);
  ui_text_c(x, y, w, h, label);
  ui_clicked(x, y, w, h);
);

/*
 * A dial with its small caps label above and value below. Drawing only.
 */
function ui_dial_face(cx, cy, label, v, bipolar, nd, dim, val, unit) local(s, w1, w2, x, a) (
  s = ui_pt(1);
  a = dim ? 0.35 : 1;
  gfx_setfont(FONT_CAP); ui_col_a(T_TEXT_DIM, a);
  ui_text_c(cx - 60 * s, cy - 50 * s, 120 * s, 12 * s, label);
  ui_dial(cx, cy, v, bipolar, nd, dim);
  gfx_setfont(FONT_EMPH); w1 = ui_text_w(val);
  gfx_setfont(FONT_BODY); w2 = strlen(unit) > 0 ? ui_text_w(unit) + 3 * s : 0;
  x = cx - (w1 + w2) * 0.5;
  gfx_setfont(FONT_EMPH); ui_col_a(T_TEXT, a);
  ui_text_l(x, cy + 34 * s, 16 * s, val);
  strlen(unit) > 0 ? (
    gfx_setfont(FONT_BODY); ui_col_a(T_TEXT_DIM, a);
    ui_text_l(x + w1 + 3 * s, cy + 34 * s, 16 * s, unit);
  );
  gfx_a = 1;
);

/*
 * One gradient segment of a meter bar, from fraction f0 to f1 of the bar in tokens t0 to t1, cut off at
 * the bar's fill width fw
 */
function ui_meter_seg(bx, by, bw, bh, fw, f0, f1, t0, t1) local(x0, x1, xc, span, i, j) (
  x0 = bx + f0 * bw; x1 = bx + f1 * bw; xc = min(x1, bx + fw);
  span = max(x1 - x0, 1);
  i = t0 * 4; j = t1 * 4;
  xc > x0 ? gfx_gradrect(floor(x0), by, max(1, ceil(xc - x0)), bh, Pal[i] / 255, Pal[i + 1] / 255, Pal[i + 2] / 255, Pal[i + 3],
    (Pal[j] - Pal[i]) / 255 / span, (Pal[j + 1] - Pal[i + 1]) / 255 / span, (Pal[j + 2] - Pal[i + 2]) / 255 / span, 0, 0, 0, 0, 0);
);

/*
 * Stereo peak meter at the right of a bar field: two bars from -60 to +3 dBFS. The colour follows the
 * scale: green for most of it, easing to amber from -12 dB and red at 0 dB, so anything over 0 dBFS
 * shows a red tip.
 */
function ui_meter(x, y, w, h, mw, p0, p1) local(k, lv, fr, bx, by, bh, fw, q12, q3, q0) (
  bx = floor(x + w - ui_pt(7) - mw); bh = max(1, floor(ui_pt(3)));
  q12 = 48 / 63; q3 = 57 / 63; q0 = 60 / 63;
  k = 0;
  loop(2,
    by = floor(y + h * 0.5 - ui_pt(4) + k * ui_pt(5));
    ui_col(T_DIAL_TRACK);
    gfx_rect(bx, by, mw, bh);
    lv = 20 * log10(max(k == 0 ? p0 : p1, 0.000001));
    fr = min(max((lv + 60) / 63, 0), 1);
    fw = floor(mw * fr);
    fw > 0 ? (
      ui_meter_seg(bx, by, mw, bh, fw, 0, q12, T_METER_OK, T_METER_OK);
      ui_meter_seg(bx, by, mw, bh, fw, q12, q3, T_METER_OK, T_METER_WARN);
      ui_meter_seg(bx, by, mw, bh, fw, q3, q0, T_METER_WARN, T_CLIP);
      ui_meter_seg(bx, by, mw, bh, fw, q0, 1, T_CLIP, T_CLIP);
    );
    k += 1;
  );
);

/*
 * Clip alert over a bar field: its frame and a faint fill fade in red by glow (0..1)
 */
function ui_clip_glow(x, y, w, h, glow) (
  glow > 0.001 ? (
    ui_cola(T_CLIP, 0.10 * glow); ui_fill_rrect(x, y, w, h, ui_pt(5));
    ui_cola(T_CLIP, glow); gfx_roundrect(floor(x), floor(y), floor(w) - 1, floor(h) - 1, ui_pt(5), 1);
    gfx_a = 1;
  );
);

/*
 * Bottom toolbar
 */
// ReEQ3: the Processing button's text, and the pan field's value
function ui_proc_label(lab, short) (
  Proc_Mode ? sprintf(lab, short ? "Linear %s" : "Linear Phase · %s", LP_Res == 0 ? "Low" : LP_Res == 1 ? "Med" : LP_Res == 2 ? "High" : "V.High")
            : strcpy(lab, short ? "Zero Lat." : "Zero Latency");
  Character > 0 ? strcat(lab, Character == 1 ? " · Subtle" : " · Warm");
  lab;
);
function ui_fmt_pan(str, v) (
  abs(v) < 0.05 ? strcpy(str, "C") : sprintf(str, v < 0 ? (Out_PanMode ? "M%.0f" : "L%.0f") : (Out_PanMode ? "S%.0f" : "R%.0f"), abs(v));
);

function ui_draw_bar()
  local(s, y0, bh, h, y, d, labels, units, gap, mw, pol, w_in, w_lr, w_ms, w_sc, w_mid, w_side, w_lim, w_auto, w_pan, w_out,
        wl, wc, wr, gg, pad, xl, xc, xr, x, nv, sc, inv, midv, sidev, outv, ag, can, k, w_proc, w_pn, prl, panv, w_tx, tv, kx, no_scale, tx_pol, tx_pol_keep)
(
  s = ui_pt(1);
  bh = ui_pt(40); y0 = gfx_h - bh;
  h = ui_pt(24); y = floor(y0 + (bh - h) * 0.5);
  pol = ui_pt(22); gg = ui_pt(16); pad = ui_pt(14);
  can = ui_popup == 0 && !ui_block;

  ui_cola(T_BAR, 1); gfx_rect(0, y0, gfx_w, bh);
  ui_cola(T_BORDER_SUBTLE, 1); gfx_line(0, y0, gfx_w, y0, 0);

  sc = sprintf(#, "%d%%", Scale);
  inv = ui_fmt_db(#, InGain);
  midv = ui_fmt_db(#, MLGain);
  sidev = ui_fmt_db(#, SRGain);
  outv = ui_fmt_db(#, Gain);
  ag = #;
  AutoGainEnabled ? sprintf(ag, "Auto %s dB", ui_fmt_db(#, 20 * log10(AG_Target))) : strcpy(ag, "Auto");
  prl = #; panv = ui_fmt_pan(#, Out_Pan);

  // Pick the densest layout that fits: full, then without units, then without labels
  d = 0;
  while (
    labels = d < 2; units = d == 0;
    gap = d == 0 ? ui_pt(8) : d == 1 ? ui_pt(6) : d == 2 ? ui_pt(4) : ui_pt(3);
    mw = d == 0 ? ui_pt(34) : d == 1 ? ui_pt(24) : d == 2 ? ui_pt(18) : ui_pt(12);
    // Tighter: Auto without its value, and smaller margins; tightest (ReEQ3): no meters and no Scale field
    d >= 3 ? (strcpy(ag, "Auto"); gg = ui_pt(8); pad = ui_pt(8));
    d >= 4 ? mw = 0;
    no_scale = d >= 4;

    gfx_setfont(FONT_BODY_B);
    w_lr =ui_text_w("L/R") + ui_pt(18); w_ms = ui_text_w("M/S") + ui_pt(18);
    // Widths come from templates, not the live values, so nothing moves while a value is dragged
    k = max(ui_text_w("+00.0"), ui_text_w("−000.0"));
    w_sc = max(ui_text_w("200%"), ui_text_w(sc));
    w_mid = max(k, ui_text_w(midv)); w_side = max(k, ui_text_w(sidev)); w_out = max(k, ui_text_w(outv)); w_in = max(k, ui_text_w(inv));
    w_auto = (AutoGainEnabled && d < 3 ? max(ui_text_w("Auto −000.0 dB"), ui_text_w(ag)) : ui_text_w(ag)) + ui_pt(18);
    gfx_setfont(FONT_BODY);
    w_lim = ui_text_w("Limit") + ui_pt(18); w_pan = ui_text_w("Panel") + ui_pt(18);
    // ReEQ3: Processing (the long text when there is room) and the output pan with its mode cell
    gfx_setfont(FONT_BODY_B);
    w_pn = max(ui_text_w("R100"), ui_text_w(panv)) + ui_pt(18) + pol;
    gfx_setfont(FONT_CAP);
    labels ? w_pn += ui_text_w("PAN") + ui_pt(7);
    // ReEQ3: the LL/81 knob: knob, name and drive, and its on cell
    gfx_setfont(FONT_BODY_B); w_tx = ui_pt(26) + max(ui_text_w("+36.0"), ui_text_w("Off")) + ui_pt(14);
    gfx_setfont(FONT_CAP); tx_pol = max(pol, ui_text_w("NEVE") + ui_pt(12)); w_tx += tx_pol;
    labels ? w_tx += max(ui_text_w("LL/81"), ui_text_w("1166")) + ui_pt(6);
    units ? (k = ui_text_w("dB") + ui_pt(3); w_mid += k; w_side += k; w_out += k; w_in += k);
    gfx_setfont(FONT_CAP);
    labels ? (
      w_sc += ui_text_w("SCALE") + ui_pt(7);
      w_mid += ui_text_w(Stereo_Mode ? "LEFT" : "MID") + ui_pt(7);
      w_side += ui_text_w(Stereo_Mode ? "RIGHT" : "SIDE") + ui_pt(7);
      w_out += ui_text_w("OUT") + ui_pt(7);
      w_in += ui_text_w("IN") + ui_pt(7);
    );
    w_sc += ui_pt(18); w_mid += ui_pt(16) + pol; w_side += ui_pt(16) + pol; w_out += ui_pt(23) + mw; w_in += ui_pt(23) + mw;

    // Input on the left; scale and the stereo controls (selector first) in the centre; output on the right
    wl = w_in;
    no_scale ? w_sc = -gap;
    wc = w_sc + gap + w_lr + w_ms + gap + w_mid + gap + w_side;
    wr = w_lim + gap + w_auto + gap + w_pan + gap + w_pn + gap + w_tx + gap + w_out;
    d += 1;
    d < 5 && wl + wc + wr + 2 * gg + 2 * pad > gfx_w;
  );

  xl = pad;
  xr = gfx_w - pad - wr;
  xc = floor(gfx_w * 0.5 - wc * 0.5);
  xc = max(xl + wl + gg, min(xc, xr - gg - wc));

  // Input trim with its peak meter
  x = xl;
  button_in_gain.type = 0;
  button_in_gain.x = x; button_in_gain.y = y; button_in_gain.width = w_in; button_in_gain.height = h;
  button_in_gain.db = InGain;
  can ? (
    nv = button_in_gain.handle_number_button();
    nv != InGain ? sv_put(SV_IN, -1, nv);
  );
  ui_field(x, y, w_in, h, labels ? "IN" : "", inv, units ? "dB" : "", button_in_gain.drag || ui_hover(x, y, w_in, h));
  ui_clip_glow(x, y, w_in, h, ui_clip_in);
  mw > 0 ? ui_meter(x, y, w_in, h, mw, ui_ipk0, ui_ipk1);

  // Scale, then the stereo controls: L/R | M/S (Stereo_Mode 0 is M/S, 1 is L/R) and its two trims.
  // The fields drag like the old number buttons.
  x = xc;
  button_scale.type = 1;
  button_scale.x = x; button_scale.y = y; button_scale.width = w_sc; button_scale.height = h;
  button_scale.db = Scale;
  no_scale ? button_scale.x = -100000 : (
  can ? (
    nv = button_scale.handle_number_button();
    nv != Scale ? sv_put(SV_SCALE, -1, nv);
  );
  ui_field(x, y, w_sc, h, labels ? "SCALE" : "", sc, "", button_scale.drag || ui_hover(x, y, w_sc, h));
  );

  x += w_sc + gap;
  nv = ui_seg2(x, y, h, w_lr, w_ms, "L/R", "M/S", Stereo_Mode ? 0 : 1);
  nv != (Stereo_Mode ? 0 : 1) ? (
    Stereo_Mode = nv == 0 ? 1 : 0;
    slider_automate(Stereo_Mode);
  );

  x += w_lr + w_ms + gap;
  button_mid_gain.type = 0;
  button_mid_gain.x = x; button_mid_gain.y = y; button_mid_gain.width = w_mid - pol; button_mid_gain.height = h;
  button_mid_gain.db = MLGain;
  can ? (
    nv = button_mid_gain.handle_number_button();
    nv != MLGain ? sv_put(SV_MID, -1, nv);
  );
  ui_field(x, y, w_mid, h, labels ? (Stereo_Mode ? "LEFT" : "MID") : "", midv, units ? "dB" : "", button_mid_gain.drag || ui_hover(x, y, w_mid - pol, h));
  ui_col(T_BORDER); gfx_line(x + w_mid - pol, y + 1, x + w_mid - pol, y + h - 2, 0);
  ui_col(ui_hover(x + w_mid - pol, y, pol, h) || MidPolarity ? (MidPolarity ? T_ACCENT : T_TEXT) : T_TEXT_DIM);
  gfx_setfont(FONT_BODY); ui_text_c(x + w_mid - pol, y, pol, h, "ø");
  ui_clicked(x + w_mid - pol, y, pol, h) ? (MidPolarity = !MidPolarity; slider_automate(MidPolarity));

  x += w_mid + gap;
  button_side_gain.type = 0;
  button_side_gain.x = x; button_side_gain.y = y; button_side_gain.width = w_side - pol; button_side_gain.height = h;
  button_side_gain.db = SRGain;
  can ? (
    nv = button_side_gain.handle_number_button();
    nv != SRGain ? sv_put(SV_SIDE, -1, nv);
  );
  ui_field(x, y, w_side, h, labels ? (Stereo_Mode ? "RIGHT" : "SIDE") : "", sidev, units ? "dB" : "", button_side_gain.drag || ui_hover(x, y, w_side - pol, h));
  ui_col(T_BORDER); gfx_line(x + w_side - pol, y + 1, x + w_side - pol, y + h - 2, 0);
  ui_col(ui_hover(x + w_side - pol, y, pol, h) || SidePolarity ? (SidePolarity ? T_ACCENT : T_TEXT) : T_TEXT_DIM);
  gfx_setfont(FONT_BODY); ui_text_c(x + w_side - pol, y, pol, h, "ø");
  ui_clicked(x + w_side - pol, y, pol, h) ? (SidePolarity = !SidePolarity; slider_automate(SidePolarity));

  // Output: Limit, Auto (right-click to apply its make-up to Out), Panel, Out with a peak meter
  x = xr;
  ui_button(x, y, w_lim, h, "Limit", LimitOutput ? 1 : 0) ? (LimitOutput = !LimitOutput; slider_automate(LimitOutput));
  x += w_lim + gap;
  ui_button(x, y, w_auto, h, ag, AutoGainEnabled ? 1 : 0) ? (AutoGainEnabled = !AutoGainEnabled; slider_automate(AutoGainEnabled));
  AutoGainEnabled && ui_rpress && ui_free() && ui_in(x, y, w_auto, h) ? (
    gfx_x = x; gfx_y = y - ui_pt(4);
    gfx_showmenu("Apply Make-Up to Output") == 1 ? (
      // Gain uses 6dB per doubling, so convert the same way to keep the level exact
      AutoGainEnabled = 0;
      Gain = min(max(Gain + 6 * log(AG_Target) / log(2), -136), 30);
      gainDb = 2 ^ (Gain / 6);
      ag_gain = 1;
      slider_automate(Gain);
      slider_automate(AutoGainEnabled);
    );
  );
  x += w_auto + gap;
  ui_button(x, y, w_pan, h, "Panel", PanelEnabled ? 1 : 0) ? (PanelEnabled = !PanelEnabled; slider_automate(PanelEnabled));
  x += w_pan + gap;

  // ReEQ3: output pan (a balance), with its mode cell: LR or MS
  button_pan.type = 2;
  button_pan.x = x; button_pan.y = y; button_pan.width = w_pn - pol; button_pan.height = h;
  button_pan.db = Out_Pan;
  can ? (
    nv = button_pan.handle_number_button();
    nv != Out_Pan ? sv_put(SV_PAN, -1, nv);
  );
  ui_field(x, y, w_pn, h, labels ? "PAN" : "", panv, "", button_pan.drag || ui_hover(x, y, w_pn - pol, h));
  ui_col(T_BORDER); gfx_line(x + w_pn - pol, y + 1, x + w_pn - pol, y + h - 2, 0);
  ui_col(ui_hover(x + w_pn - pol, y, pol, h) ? T_TEXT : Out_PanMode ? T_ACCENT : T_TEXT_DIM);
  gfx_setfont(FONT_CAP); ui_text_c(x + w_pn - pol, y, pol, h, Out_PanMode ? "MS" : "LR");
  ui_clicked(x + w_pn - pol, y, pol, h) ? (Out_PanMode = !Out_PanMode; slider_automate(Out_PanMode));
  x += w_pn + gap;

  // ReEQ3: the output transformer (BBC LL/81 MSC or Neve LO1166): a knob for its drive (drag, value
  // box on right-click or typing) and a cell that picks the model or turns it off
  tx_pol_keep = pol; pol = tx_pol;
  button_tx.type = 3;
  button_tx.x = x; button_tx.y = y; button_tx.width = w_tx - pol; button_tx.height = h;
  button_tx.db = Tx_Drive;
  can ? (
    nv = button_tx.handle_number_button();
    nv != Tx_Drive ? sv_put(SV_TX, -1, nv);
  );
  tv = button_tx.drag || ui_hover(x, y, w_tx - pol, h);
  ui_box(x, y, w_tx, h, ui_pt(5), T_CONTROL, 1, tv ? T_BORDER_HOVER : T_BORDER);
  kx = x + ui_pt(14);
  ui_mix = Tx_On ? 0 : 0.65;
  ui_col(T_DIAL_TRACK); ui_thick_arc(kx, y + h * 0.5, ui_pt(8.5), 1.25 * $pi, 2.75 * $pi, ui_pt(1.6));
  Tx_Drive > 0.05 ? (ui_col(T_ACCENT); ui_thick_arc(kx, y + h * 0.5, ui_pt(8.5), 1.25 * $pi, 1.25 * $pi + 1.5 * $pi * Tx_Drive / 36, ui_pt(1.6)));
  ui_col(T_DIAL_FACE); gfx_circle(kx, y + h * 0.5, ui_pt(6), 1, 1);
  ui_col(T_DIAL_POINTER);
  k = 0.75 * $pi + 1.5 * $pi * Tx_Drive / 36;
  ui_thick_line(kx + ui_pt(1.5) * cos(k), y + h * 0.5 + ui_pt(1.5) * sin(k), kx + ui_pt(5) * cos(k), y + h * 0.5 + ui_pt(5) * sin(k), ui_pt(1.3));
  ui_mix = 0;
  k = x + ui_pt(27);
  labels ? (gfx_setfont(FONT_CAP); ui_col(Tx_On ? T_ACCENT : T_TEXT_FAINT); ui_text_l(k, y, h, Tx_Type >= 0.5 ? "1166" : "LL/81"); k += max(ui_text_w("LL/81"), ui_text_w("1166")) + ui_pt(6));
  gfx_setfont(FONT_BODY_B); ui_col(Tx_On ? T_TEXT : T_TEXT_DIM);
  ui_text_l(k, y, h, Tx_On ? sprintf(#, Tx_Drive < 0.05 ? "0.0" : "+%.1f", Tx_Drive) : "Off");
  ui_col(T_BORDER); gfx_line(x + w_tx - pol, y + 1, x + w_tx - pol, y + h - 2, 0);
  ui_col(ui_hover(x + w_tx - pol, y, pol, h) ? T_TEXT : Tx_On ? T_ACCENT : T_TEXT_DIM);
  gfx_setfont(FONT_CAP); ui_text_c(x + w_tx - pol, y, pol, h, Tx_On ? (Tx_Type >= 0.5 ? "NEVE" : "BBC") : "OFF");
  ui_clicked(x + w_tx - pol, y, pol, h) ? (
    gfx_x = x + w_tx - pol; gfx_y = y + h;
    k = gfx_showmenu(sprintf(#, "%sOff|%sBBC LL/81 MSC|%sNeve LO1166 (1073)", Tx_On ? "" : "!",
                             Tx_On && Tx_Type < 0.5 ? "!" : "", Tx_On && Tx_Type >= 0.5 ? "!" : ""));
    k == 1 ? (Tx_On = 0; slider_automate(Tx_On));
    k >= 2 ? (Tx_On = 1; Tx_Type = k - 2; slider_automate(Tx_On); slider_automate(Tx_Type));
  );
  pol = tx_pol_keep;
  x += w_tx + gap;

  button_gain.type = 0;
  button_gain.x = x; button_gain.y = y; button_gain.width = w_out; button_gain.height = h;
  button_gain.db = Gain;
  can ? (
    nv = button_gain.handle_number_button();
    nv != Gain ? sv_put(SV_OUT, -1, nv);
  );
  ui_field(x, y, w_out, h, labels ? "OUT" : "", outv, units ? "dB" : "", button_gain.drag || ui_hover(x, y, w_out, h));

  ui_clip_glow(x, y, w_out, h, ui_clip_out);
  mw > 0 ? ui_meter(x, y, w_out, h, mw, ui_pk0, ui_pk1);

  // dB range: the top scale label is its button (ui_draw_header); it opens the Range popover
  ui_clicked(ui_dbb_x, ui_dbb_y, ui_dbb_w, ui_dbb_h) ? (
    ui_popup = 6; ui_pop_skip = 1; ui_block = 1; ui_pop_x = ui_dbb_x; ui_pop_y = ui_dbb_y; ui_pop_w = ui_dbb_w;
  );
  gfx_setfont(FONT_BASE);
);

/*
 * Header strip with the wordmark (the Analyzer and settings buttons are drawn into it by ui_draw_top),
 * with just the wordmark in compact sizes and none when very short; then the top scale label as the
 * dB range button.
 */
function ui_draw_header() local(s, x, i) (
  s = ui_pt(1);
  HEADER_H > 0 ? (
    ui_cola(T_BAR, 1); gfx_rect(0, 0, gfx_w, HEADER_H);
    ui_cola(T_BORDER_SUBTLE, 1); gfx_line(0, HEADER_H, gfx_w, HEADER_H, 0);

    // Wordmark: Re in white, EQ in bold amber with a superscript 2 (ReEQ squared); then a hairline and a
    // spaced descriptor when there's room
    x = 12 * s;
    gfx_setfont(FONT_DISPLAY); ui_col(T_WORDMARK_RE);
    ui_text_l(x, 0, HEADER_H, "Re");
    x += ui_text_w("Re");
    gfx_setfont(FONT_DISPLAY_B); ui_col(T_WORDMARK_EQ);
    ui_text_l(x, 0, HEADER_H, "EQ");
    x += ui_text_w("EQ") + 1 * s;
    // The 2's top at about the capitals' top (the wordmark's line is centred in the header)
    gfx_setfont(FONT_SUP);
    gfx_x = floor(x); gfx_y = floor(HEADER_H * 0.5 - 7.5 * s);
    gfx_drawstr("3");
    x += ui_text_w("3");
    // A click on the wordmark opens the credits
    ui_clicked(0, 0, x + 6 * s, HEADER_H) ? (ui_popup = 8; ui_pop_skip = 1; ui_block = 1);
    actual_width >= 700 && !compact_height ? (
      x += 10 * s;
      ui_col(T_BORDER); gfx_rect(floor(x), floor(HEADER_H * 0.5 - 7 * s), max(1, floor(s)), floor(14 * s));
      x += 11 * s;
      gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
      #ui_desc = "PARAMETRIC EQUALIZER";
      i = 0;
      loop(strlen(#ui_desc),
        strcpy_substr(#ui_ch, #ui_desc, i, 1);
        ui_text_l(x, 0, HEADER_H, #ui_ch);
        x += ui_text_w(#ui_ch) + 1.4 * s;
        i += 1;
      );
    );
  );

  // The top scale label as the dB range button, on its own line (its menu is handled with the toolbar)
  !compact_width && !compact_height ? (
    ui_dbb_w = 40 * s; ui_dbb_h = 20 * s; ui_dbb_x = gfx_w - 4 * s - ui_dbb_w; ui_dbb_y = floor(ui_dbb_cy - ui_dbb_h * 0.5);
    gfx_setfont(FONT_BODY);
    ui_popup == 6 ? ui_box(ui_dbb_x, ui_dbb_y, ui_dbb_w, ui_dbb_h, 5 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER) :
      ui_hover(ui_dbb_x, ui_dbb_y, ui_dbb_w, ui_dbb_h) ?
        ui_box(ui_dbb_x, ui_dbb_y, ui_dbb_w, ui_dbb_h, 5 * s, T_CONTROL_HOVER, 1, T_BORDER_HOVER) :
        ui_box(ui_dbb_x, ui_dbb_y, ui_dbb_w, ui_dbb_h, 5 * s, T_CONTROL, 1, T_BORDER);
    ui_cola(T_DB_LABEL, 1);
    // 7pt in, so "+30" clears the chevron
    ui_text_l(ui_dbb_x + 7 * s, ui_dbb_y, ui_dbb_h, #ui_dbb_lab);
    ui_cola(T_DB_LABEL, 0.7);
    ui_chevron(ui_dbb_x + ui_dbb_w - 10 * s, ui_dbb_y + ui_dbb_h * 0.5, 3 * s, 1);
  );
  gfx_setfont(FONT_BASE);
);

/*
 * Top right: analyzer menu and the settings menu
 */
function ui_draw_top() local(s, h, y, gw, gx, aw, ax, lab) (
  s = ui_pt(1);
  h = ui_pt(22); y = ui_pt(6);
  gw = ui_pt(24); gx = gfx_w - ui_pt(12) - gw;
  lab = Display_Mode == 2 ? "Analyzer · Off" : Show_PreEQ ? "Analyzer · Pre + Post" : "Analyzer · Post";
  gfx_setfont(FONT_BODY);
  aw = ui_text_w(lab) + ui_pt(16);
  ax = gx - ui_pt(8) - aw;
  ui_top_ax = ax; ui_top_aw = aw; ui_top_gx = gx; ui_top_gw = gw; ui_top_y = y; ui_top_h = h;

  ui_button(ax, y, aw, h, lab, ui_popup == 4 ? 1 : 0) ? (ui_popup = 4; ui_pop_skip = 1; ui_block = 1; ui_pop_x = ax; ui_pop_y = y; ui_pop_w = aw);
  // ReEQ3: Instances (the instance list and EQ Match), then Processing, left of the Analyzer
  ui_proc_label(#ui_prl, gfx_w < ui_pt(860));
  ui_bar_pw = ui_text_w(#ui_prl) + ui_pt(30); ui_bar_px = ax - ui_pt(8) - ui_bar_pw; ui_bar_py = y; ui_bar_ph = h;
  ui_dropdown(ui_bar_px, y, ui_bar_pw, h, #ui_prl, ui_popup == 11) ? (
    ui_popup = 11; ui_pop_skip = 1; ui_block = 1; ui_pop_x = ui_bar_px; ui_pop_y = y; ui_pop_w = ui_bar_pw;
  );
  ui_top_iw = ui_text_w("Instances") + ui_pt(16); ui_top_ix = ui_bar_px - ui_pt(8) - ui_top_iw;
  ui_button(ui_top_ix, y, ui_top_iw, h, "Instances", ui_popup == 10 ? 1 : 0) ? (
    ui_popup = 10; ui_pop_skip = 1; ui_block = 1; ui_pop_x = ui_top_ix; ui_pop_y = y; ui_pop_w = ui_top_iw;
  );
  // ReEQ3: Luftikus mode, lit while it runs; it opens (or closes) its panel
  ui_top_lw = ui_text_w("Luftikus") + ui_pt(16); ui_top_lx = ui_top_ix - ui_pt(8) - ui_top_lw;
  ui_top_lx > ui_pt(150) ? (
    ui_button(ui_top_lx, y, ui_top_lw, h, "Luftikus", Lf_On ? 1 : 0) ? (ui_lf_show = !ui_lf_show; ui_lf_show ? (ui_lf_sel = selected_node; ui_tb_show = 0));
    ui_lf_show && !Lf_On ? (ui_col(T_ACCENT_BORDER); gfx_roundrect(ui_top_lx, y, ui_top_lw - 1, h - 1, ui_pt(5), 1));
  );
  // ReEQ3: Tonal Balance, lit while its panel shows
  ui_top_bw = ui_text_w("Balance") + ui_pt(16); ui_top_bx = ui_top_lx - ui_pt(8) - ui_top_bw;
  ui_top_bx > ui_pt(150) ? (
    ui_button(ui_top_bx, y, ui_top_bw, h, "Balance", ui_tb_show ? 1 : 0) ? (ui_tb_show = !ui_tb_show; ui_tb_show ? ui_lf_show = 0);
  );
  ui_icon_button(gx, y, gw, h, 5, ui_popup == 5 ? 1 : 0) ? (ui_popup = 5; ui_pop_skip = 1; ui_block = 1; ui_pop_x = gx; ui_pop_y = y; ui_pop_w = gw);
  gfx_setfont(FONT_BASE);
);

/*
 * Place a picker above its button, or below it when there's no room, with the pointer on that side
 */
function ui_pop_frame(px, pw, ph) local(s, ax, py, below, x, y, w, h, r, p, e) (
  s = ui_pt(1);
  below = ui_pop_y - 8 * s - ph < 4 * s;
  py = below ? ui_pop_y + 24 * s + 8 * s : ui_pop_y - 8 * s - ph;
  x = floor(px); y = floor(py); w = floor(pw); h = floor(ph); r = floor(8 * s); p = 8 * s;
  ax = floor(max(x + r + p, min(ui_pop_x + ui_pop_w * 0.5, x + w - 1 - r - p)));

  // Body and pointer share one fill; the pointer starts just outside the body so nothing doubles
  ui_cola(T_POPOVER, 0.88);
  ui_fill_rrect(x, y, w, h, r);
  below ? gfx_triangle(ax - p, y - 1, ax + p, y - 1, ax, y - 7 * s) : gfx_triangle(ax - p, y + h, ax + p, y + h, ax, y + h + 7 * s);

  // Outline drawn by hand so it opens where the pointer joins: the pointer reads as part of the frame
  ui_cola(T_BORDER, 1);
  e = y + h - 1;
  gfx_arc(x + r, y + r, r, 1.5 * $pi, 2 * $pi, 1);
  gfx_arc(x + w - 1 - r, y + r, r, 0, 0.5 * $pi, 1);
  gfx_arc(x + w - 1 - r, e - r, r, 0.5 * $pi, $pi, 1);
  gfx_arc(x + r, e - r, r, $pi, 1.5 * $pi, 1);
  gfx_line(x, y + r, x, e - r, 0);
  gfx_line(x + w - 1, y + r, x + w - 1, e - r, 0);
  below ? (
    gfx_line(x + r, y, ax - p, y, 0); gfx_line(ax + p, y, x + w - 1 - r, y, 0);
    gfx_line(x + r, e, x + w - 1 - r, e, 0);
    gfx_line(ax - p, y, ax, y - 7 * s, 1); gfx_line(ax, y - 7 * s, ax + p, y, 1);
  ) : (
    gfx_line(x + r, y, x + w - 1 - r, y, 0);
    gfx_line(x + r, e, ax - p, e, 0); gfx_line(ax + p, e, x + w - 1 - r, e, 0);
    gfx_line(ax - p, e, ax, e + 7 * s, 1); gfx_line(ax, e + 7 * s, ax + p, e, 1);
  );
  py;
);

/*
 * Shape picker: 7 x 2 icon tiles and, for cuts, a slope row
 */
function ui_draw_shape_pop(b) local(s, pw, ph, px, py, tw, th, i, t, tx, ty, on, hov, ax, dy, inpop, pr, k) (
  s = ui_pt(1);
  // The press that opened the picker is not a pick
  pr = ui_press && !ui_pop_skip; ui_pop_skip = 0;
  // Tiles wide enough for the longest name in Body, with 5pt either side
  gfx_setfont(FONT_BODY);
  tw = max((600 * s - 16 * s - 28 * s) / UI_TILE_COLS, ui_text_w("High Cut BW") + 10 * s); th = 58 * s;
  pw = 16 * s + (UI_TILE_COLS - 1) * 4 * s + tw * UI_TILE_COLS;
  ph = 8 * s + th * 2 + 4 * s + 8 * s + 1 + 8 * s + 22 * s + 8 * s;
  px = max(4 * s, min(panel_x + 8 * s, gfx_w - pw - 4 * s));
  py = ui_pop_frame(px, pw, ph);
  inpop = ui_in(px, py, pw, ph);

  i = 0;
  loop(UI_TILES,
    t = ui_tile_type(i);
    tx = floor(px + 8 * s + (i % UI_TILE_COLS) * (tw + 4 * s)); ty = floor(py + 8 * s + floor(i / UI_TILE_COLS) * (th + 4 * s));
    on = t == Band_Type[b];
    hov = ui_in(tx, ty, tw, th);
    on ? (ui_band_col(b); gfx_a = 0.10; ui_fill_rrect(tx, ty, tw, th, 5 * s); gfx_a = 1; gfx_roundrect(tx, ty, tw - 1, th - 1, 5 * s, 1))
       : hov ? ui_box(tx, ty, tw, th, 5 * s, T_CONTROL_HOVER, 1, T_BORDER_HOVER);
    on ? ui_band_col(b) : ui_col(T_TEXT_SECONDARY);
    ui_shape_icon(t, tx + tw * 0.5 - 20 * s, ty + 7 * s, 1);
    gfx_setfont(FONT_BODY);
    ui_col(on ? T_SELECTED : hov ? T_TEXT : T_TEXT_DIM);
    ui_text_c(tx, ty + th - 18 * s, tw, 14 * s, ui_shape_name(t));
    pr && hov ? (
      ui_set_shape(b, t);
      !ui_is_cut(t) ? ui_popup = 0;
    );
    i += 1;
  );

  // Slope row: the shape's slopes (cuts, bells, shelves and the tilt shelf)
  dy = py + 8 * s + th * 2 + 4 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(px + 8 * s, dy, px + pw - 8 * s, dy, 0);
  dy += 1 + 8 * s;
  k = ui_slope_row(px + 8 * s, dy, pw - 16 * s, 22 * s, b, pr);
  k >= 0 ? (
    set_node_slope(b, k);
    filters_to_sliders();
    ui_popup = 0;
  );

  // Any press while open is the popover's: outside closes it
  pr ? (!inpop ? ui_popup = 0; ui_block = 1);
  gfx_setfont(FONT_BASE);
);

/*
 * Stereo placement glyph centred on cx, cy in the current colour, scaled by k.
 * Two circles, one per side: outline = passes, filled = this part, faint = untouched.
 */
function ui_stereo_glyph(g, cx, cy, k) local(s, r) (
  s = ui_pt(1) * k; r = 5.5 * s;
  g == 0 ? (ui_thick_arc(cx - 4 * s, cy, r, 0, 2 * $pi, 1.4 * s); ui_thick_arc(cx + 4 * s, cy, r, 0, 2 * $pi, 1.4 * s)) :
    g == 1 ? gfx_circle(cx, cy, r, 1, 1) :
      g == 2 ? (ui_thick_arc(cx - 8 * s, cy, r, 0, 2 * $pi, 1.4 * s); ui_thick_arc(cx + 8 * s, cy, r, 0, 2 * $pi, 1.4 * s)) :
        // 5: mid and side together; 6: left and right together (the analyser's two-spectrum modes)
        g == 5 ? (gfx_circle(cx, cy, r, 1, 1); ui_thick_arc(cx - 10 * s, cy, r, 0, 2 * $pi, 1.4 * s); ui_thick_arc(cx + 10 * s, cy, r, 0, 2 * $pi, 1.4 * s)) :
        g == 6 ? (gfx_circle(cx - 7 * s, cy, r, 1, 1); gfx_circle(cx + 7 * s, cy, r, 1, 1)) :
        (gfx_circle(g == 3 ? cx - 6 * s : cx + 6 * s, cy, r, 1, 1);
         ui_col(T_TEXT_DISABLED); ui_thick_arc(g == 3 ? cx + 6 * s : cx - 6 * s, cy, r, 0, 2 * $pi, 1.4 * s));
);

/*
 * Stereo placement picker: one row of five tiles
 */
function ui_draw_stereo_pop(b) local(s, pw, ph, px, py, tw, th, g, tx, ty, on, hov, inpop, pr) (
  s = ui_pt(1);
  pr = ui_press && !ui_pop_skip; ui_pop_skip = 0;
  pw = 312 * s; tw = (pw - 16 * s - 16 * s) / 5; th = 52 * s;
  ph = 8 * s + th + 8 * s;
  px = max(4 * s, min(ui_pop_x - 40 * s, gfx_w - pw - 4 * s));
  py = ui_pop_frame(px, pw, ph);
  inpop = ui_in(px, py, pw, ph);

  g = 0;
  loop(5,
    tx = floor(px + 8 * s + g * (tw + 4 * s)); ty = floor(py + 8 * s);
    on = g == Band_Group[b];
    hov = ui_in(tx, ty, tw, th);
    on ? (ui_band_col(b); gfx_a = 0.10; ui_fill_rrect(tx, ty, tw, th, 5 * s); gfx_a = 1; gfx_roundrect(tx, ty, tw - 1, th - 1, 5 * s, 1))
       : hov ? ui_box(tx, ty, tw, th, 5 * s, T_CONTROL_HOVER, 1, T_BORDER_HOVER);

    on ? ui_band_col(b) : ui_col(T_TEXT_SECONDARY);
    ui_stereo_glyph(g, tx + tw * 0.5, ty + 16 * s, 1);
    gfx_setfont(FONT_BODY);
    ui_col(on ? T_SELECTED : hov ? T_TEXT : T_TEXT_DIM);
    ui_text_c(tx, ty + th - 18 * s, tw, 14 * s, ui_group_name(g));
    pr && hov ? (
      Band_Group[b] = g;
      selected_node_group = g;
      flag_filter_update(b);
      filters_to_sliders();
      ui_popup = 0;
    );
    g += 1;
  );

  pr ? (!inpop ? ui_popup = 0; ui_block = 1);
  gfx_setfont(FONT_BASE);
);

/*
 * Node action card: the right-click menu on a node. Acts on the selected nodes, as the old menu did;
 * the header and the highlights describe the band that was right-clicked.
 */
function ui_draw_node_card()
  local(s, b, pad, W, H, x0, y0, x, y, tw, th, i, t, m, tx, ty, on, hov, cut, cur, cw, k, chip, g, bw, bh, inpop, pr, skip, close, lab)
(
  s = ui_pt(1);
  b = ui_card_band;
  // The right press that opened the card is not an outside press
  skip = ui_pop_skip; ui_pop_skip = 0;
  pr = ui_press && !skip;
  close = 0;

  pad = 9 * s; W = 540 * s;
  tw = (W - 2 * pad - (UI_TILE_COLS - 1) * 3 * s) / UI_TILE_COLS; th = 44 * s;
  H = pad + 22 * s + 8 * s + 1 + 8 * s + 10 * s + 5 * s + th * 2 + 3 * s + 8 * s + 20 * s
      + 8 * s + 1 + 8 * s + 10 * s + 5 * s + 34 * s + 8 * s + 1 + 8 * s + 24 * s + pad;
  x0 = floor(max(4 * s, min(ui_card_x + 10 * s, gfx_w - W - 4 * s)));
  y0 = floor(max(4 * s, min(ui_card_y + 6 * s, gfx_h - H - 4 * s)));
  inpop = ui_in(x0, y0, W, H);
  ui_box(x0, y0, W, H, 8 * s, T_POPOVER, 0.94, T_BORDER);

  // Header: badge, shape (and slope), frequency; bypass, duplicate and delete on the right
  x = x0 + pad; y = y0 + pad;
  ui_band_col(b);
  gfx_circle(x + 8 * s, y + 11 * s, 8 * s, 1, 1);
  gfx_setfont(FONT_EMPH); ui_col(T_BADGE_TEXT);
  ui_text_at(x + 8 * s, y + 11 * s, sprintf(#, "%d", b + 1));
  cut = ui_is_cut(Band_Type[b]);
  lab = #;
  ui_shape_label(lab, b);
  gfx_setfont(FONT_BODY_B); ui_col(T_TEXT);
  ui_text_l(x + 24 * s, y, 22 * s, lab);
  k = x + 24 * s + ui_text_w(lab) + 8 * s;
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(k, y, 22 * s, Band_Frequency[b] < 1000 ? sprintf(#, Band_Frequency[b] < 100 ? "%.1f Hz" : "%.0f Hz", Band_Frequency[b]) : sprintf(#, "%.2f kHz", Band_Frequency[b] / 1000));

  bw = 26 * s; bh = 22 * s;
  tx = x0 + W - pad - bw;
  hov = ui_in(tx, y, bw, bh);
  ui_icon_button_draw(tx, y, bw, bh, 4, 2, hov);
  pr && hov ? (delete_selected_nodes(); close = 1);
  tx -= bw + 4 * s;
  hov = ui_in(tx, y, bw, bh);
  ui_icon_button_draw(tx, y, bw, bh, 3, 0, hov);
  pr && hov ? (duplicate_selected_nodes(); close = 1);
  tx -= bw + 4 * s;
  hov = ui_in(tx, y, bw, bh);
  ui_icon_button_draw(tx, y, bw, bh, 2, Band_Enabled[b] == BAND_STATE_DISABLED ? 1 : 0, hov);
  pr && hov ? toggle_nodes_enabled(b);
  // DYN, for bells and shelves
  band_dyn_capable(Band_Type[b]) ? (
    gfx_setfont(FONT_BODY_B); k = ui_text_w("DYN") + 18 * s;
    tx -= k + 8 * s;
    hov = ui_in(tx, y, k, bh);
    ui_button_draw(tx, y, k, bh, "DYN", Band_Dyn_On[b] ? 1 : 0, hov);
    pr && hov ? dyn_selected_nodes(!Band_Dyn_On[b]);
  );

  y += 22 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x0 + W - pad, y, 0);
  y += 1 + 8 * s;

  // Shape tiles
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 10 * s, "SHAPE");
  y += 10 * s + 5 * s;
  i = 0;
  loop(UI_TILES,
    t = ui_tile_type(i);
    tx = floor(x + (i % UI_TILE_COLS) * (tw + 3 * s)); ty = floor(y + floor(i / UI_TILE_COLS) * (th + 3 * s));
    on = t == Band_Type[b];
    hov = ui_in(tx, ty, tw, th);
    on ? (ui_band_col(b); gfx_a = 0.10; ui_fill_rrect(tx, ty, tw, th, 4 * s); gfx_a = 1; gfx_roundrect(tx, ty, tw - 1, th - 1, 4 * s, 1))
       : ui_box(tx, ty, tw, th, 4 * s, hov ? T_CONTROL_HOVER : T_TILE, 1, hov ? T_BORDER_HOVER : T_BORDER_SUBTLE);
    on ? ui_band_col(b) : ui_col(T_TEXT_SECONDARY);
    ui_shape_icon(t, tx + tw * 0.5 - 17 * s, ty + 4 * s, 0.85);
    gfx_setfont(FONT_CAP);
    ui_col(on ? T_SELECTED : hov ? T_TEXT : T_TEXT_DIM);
    ui_text_c(tx, ty + th - 15 * s, tw, 13 * s, ui_shape_name(t));
    pr && hov && !on ? (
      // The old menu's item order: find this type's position in it
      m = 0;
      while (m < 14 && FilterMappingTo[m] != t ? (m += 1; 1) : 0);
      set_shape_selected_nodes(m, cut);
    );
    i += 1;
  );
  y += th * 2 + 3 * s + 8 * s;

  // Slope row
  k = ui_slope_row(x, y, W - 2 * pad, 20 * s, b, pr);
  k >= 0 ? set_slopes_selected_nodes(k);
  gfx_a = 1;
  y += 20 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x0 + W - pad, y, 0);
  y += 1 + 8 * s;

  // Stereo placement: the picker's glyphs and names, a little smaller
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 10 * s, "STEREO");
  y += 10 * s + 5 * s;
  cw = (W - 2 * pad - 12 * s) / 5;
  g = 0;
  loop(5,
    tx = floor(x + g * (cw + 3 * s));
    on = g == Band_Group[b];
    hov = ui_in(tx, y, cw, 34 * s);
    on ? (ui_band_col(b); gfx_a = 0.10; ui_fill_rrect(tx, y, cw, 34 * s, 4 * s); gfx_a = 1; gfx_roundrect(tx, y, cw - 1, 34 * s - 1, 4 * s, 1))
       : ui_box(tx, y, cw, 34 * s, 4 * s, hov ? T_CONTROL_HOVER : T_TILE, 1, hov ? T_BORDER_HOVER : T_BORDER_SUBTLE);
    on ? ui_band_col(b) : ui_col(T_TEXT_SECONDARY);
    ui_stereo_glyph(g, tx + cw * 0.5, y + 12 * s, 0.8);
    gfx_setfont(FONT_CAP);
    ui_col(on ? T_SELECTED : hov ? T_TEXT : T_TEXT_DIM);
    ui_text_c(tx, y + 21 * s, cw, 11 * s, ui_group_name(g));
    pr && hov ? (stereo_selected_nodes(g); selected_node_group = g);
    g += 1;
  );
  y += 34 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x0 + W - pad, y, 0);
  y += 1 + 8 * s;

  // Gain and split
  cw = (W - 2 * pad - 8 * s) / 3;
  hov = ui_in(x, y, cw, 24 * s);
  ui_button_draw(x, y, cw, 24 * s, "Invert Gain", 0, hov);
  pr && hov ? invert_nodes_gain();
  tx = floor(x + cw + 4 * s);
  hov = ui_in(tx, y, cw, 24 * s);
  ui_button_draw(tx, y, cw, 24 * s, "Zero Gain", 0, hov);
  pr && hov ? zero_nodes_gain();
  tx = floor(x + 2 * (cw + 4 * s));
  hov = ui_in(tx, y, cw, 24 * s);
  ui_button_draw(tx, y, cw, 24 * s, "Split", 0, hov);
  pr && hov ? (split_selected_nodes(); close = 1);

  // Any press while open is the card's: an outside left or right press closes it. An outside
  // left press on a node is passed on, so the node drags straight away; others are swallowed.
  (ui_rpress && !inpop && !skip) || close ? ui_popup = 0;
  pr ? (
    !inpop ? (
      ui_popup = 0;
      get_nearest_node() == -1 || mouse_within_panel() ? ui_block = 1;
    ) : ui_block = 1;
  );
  gfx_setfont(FONT_BASE);
);

/*
 * Joined segmented control for the popovers: n segments (up to 5) labelled l0..l4, sel highlighted.
 * Returns the segment pressed this frame, or -1. pr is the popover's fresh press.
 */
function ui_segn(x, y, w, h, n, sel, pr, l0, l1, l2, l3, l4) local(s, i, sx, sw, hov, hit, lab) (
  s = ui_pt(1);
  hit = -1;
  x = floor(x); y = floor(y); w = floor(w); h = floor(h);
  ui_box(x, y, w, h, 5 * s, T_CONTROL, 1, T_BORDER);
  sw = w / n;
  i = 0;
  loop(n,
    sx = floor(x + i * sw);
    lab = i == 0 ? l0 : i == 1 ? l1 : i == 2 ? l2 : i == 3 ? l3 : l4;
    hov = ui_in(sx, y, floor(x + (i + 1) * sw) - sx, h);
    i > 0 ? (ui_col(T_BORDER_SUBTLE); gfx_line(sx, y + 1, sx, y + h - 2, 0));
    i == sel ? (
      ui_box(sx + 1, y + 1, floor(x + (i + 1) * sw) - sx - 2, h - 2, 4 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER);
      gfx_setfont(FONT_CAP_B); ui_col(T_ACCENT);
    ) : (
      hov ? (ui_cola(T_HOVER_WASH, 0.04); ui_fill_rrect(sx + 1, y + 1, floor(x + (i + 1) * sw) - sx - 2, h - 2, 4 * s));
      gfx_setfont(FONT_CAP); ui_col(hov ? T_TEXT : T_TEXT_SECONDARY);
    );
    ui_text_c(sx, y, floor(x + (i + 1) * sw) - sx, h, lab);
    pr && hov ? hit = i;
    i += 1;
  );
  hit;
);

/*
 * A label / control / unit row in the settings popover. Returns the segment pressed, or -1.
 */
function ui_setrow(x, y, w, label, unit, n, sel, pr, l0, l1, l2, l3, l4) local(s) (
  s = ui_pt(1);
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_SECONDARY);
  ui_text_l(x, y, 22 * s, label);
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_FAINT);
  ui_text_l(x + w - 38 * s, y, 22 * s, unit);
  ui_segn(x + 72 * s, y, w - 72 * s - 46 * s, 22 * s, n, sel, pr, l0, l1, l2, l3, l4);
);

/*
 * Header strip for the top popovers
 */
function ui_pop_head(px, py, pw, title, sub) local(s) (
  s = ui_pt(1);
  ui_cola(T_HOVER_WASH, 0.015); gfx_rect(px + 1, py + 1, pw - 2, 29 * s);
  ui_cola(T_BORDER_SUBTLE, 1); gfx_line(px + 1, py + 30 * s, px + pw - 2, py + 30 * s, 0);
  gfx_setfont(FONT_BODY_B); ui_col(T_TEXT);
  ui_text_l(px + 11 * s, py, 30 * s, title);
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_r(px + pw - 11 * s - 120 * s, py, 120 * s, 30 * s, sub);
);

/*
 * Shared close rules for the top popovers. An outside press closes; on the other top button it
 * opens that one instead. Returns nothing; uses ui_popup.
 */
function ui_top_pop_close(px, py, pw, ph, pr, skip) (
  (pr || (ui_rpress && !skip)) && !ui_in(px, py, pw, ph) ? (
    // ReEQ3: a press on another top button opens that one
    pr && ui_in(ui_top_ix, ui_top_y, ui_top_iw, ui_top_h) && ui_popup != 10 ? (
      ui_popup = 10; ui_pop_skip = 1; ui_pop_x = ui_top_ix; ui_pop_y = ui_top_y; ui_pop_w = ui_top_iw;
    ) : pr && ui_in(ui_bar_px, ui_top_y, ui_bar_pw, ui_top_h) && ui_popup != 11 ? (
      ui_popup = 11; ui_pop_skip = 1; ui_pop_x = ui_bar_px; ui_pop_y = ui_top_y; ui_pop_w = ui_bar_pw;
    ) : pr && ui_in(ui_top_ax, ui_top_y, ui_top_aw, ui_top_h) && ui_popup != 4 ? (
      ui_popup = 4; ui_pop_skip = 1; ui_pop_x = ui_top_ax; ui_pop_y = ui_top_y; ui_pop_w = ui_top_aw;
    ) :
    ui_popup == 4 && ui_in(ui_top_gx, ui_top_y, ui_top_gw, ui_top_h) && pr ? (
      ui_popup = 5; ui_pop_skip = 1; ui_pop_x = ui_top_gx; ui_pop_y = ui_top_y; ui_pop_w = ui_top_gw;
    ) : ui_popup == 5 && ui_in(ui_top_ax, ui_top_y, ui_top_aw, ui_top_h) && pr ? (
      ui_popup = 4; ui_pop_skip = 1; ui_pop_x = ui_top_ax; ui_pop_y = ui_top_y; ui_pop_w = ui_top_aw;
    ) : ui_popup = 0;
  );
  pr ? ui_block = 1;
);

/*
 * Analyzer popover: display style, pre-EQ, spectrum mode
 */
/*
 * ReEQ3: a popover row with a title, a note and a switch. Returns 1 when pressed.
 */
function ui_switch_row(x, y, w, title, sub, on, pr) local(s, hov, tx, ty) (
  s = ui_pt(1);
  hov = ui_in(x, y, w, 34 * s);
  ui_box(x, y, w, 34 * s, 5 * s, hov ? T_CONTROL_HOVER : T_TILE, 1, T_BORDER_SUBTLE);
  gfx_setfont(FONT_BODY); ui_col(T_TEXT);
  ui_text_l(x + 9 * s, y + 3 * s, 16 * s, title);
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x + 9 * s, y + 17 * s, 13 * s, sub);
  tx = x + w - 9 * s - 30 * s; ty = y + 9 * s;
  on ? ui_box(tx, ty, 30 * s, 16 * s, 8 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER) : ui_box(tx, ty, 30 * s, 16 * s, 8 * s, T_CONTROL, 1, T_BORDER);
  ui_col(on ? T_ACCENT : T_TEXT_DIM);
  gfx_circle(on ? tx + 22 * s : tx + 8 * s, ty + 8 * s, 5 * s, 1, 1);
  pr && hov;
);

function ui_draw_analyzer_pop() local(s, pad, pw, ph, px, py, x, y, w, tw, th, i, m, tx, ty, on, hov, pr, skip, c, cx0, yy, k, t, g) (
  s = ui_pt(1);
  skip = ui_pop_skip; ui_pop_skip = 0;
  pr = ui_press && !skip;
  // Follows its button, which moves when the UI size changes
  ui_pop_x = ui_top_ax; ui_pop_y = ui_top_y; ui_pop_w = ui_top_aw;
  // ReEQ3: two columns, the original controls on the left and ReEQ3's on the right
  pad = 11 * s; pw = 276 * s + 270 * s + 11 * s;
  ph = 30 * s + 10 * s + 10 * s + 6 * s + 46 * s + 8 * s + 34 * s + 8 * s + 10 * s + 6 * s + 44 * s * 2 + 4 * s + 11 * s;
  px = floor(max(4 * s, gfx_w - 8 * s - pw));
  py = ui_pop_frame(px, pw, ph);
  ui_pop_head(px, py, pw, "Analyzer", Display_Mode == 2 ? "Off" : Show_PreEQ ? "Pre + Post" : "Post");

  x = px + pad; w = 276 * s - 2 * pad; y = py + 30 * s + 10 * s;

  // Display: Off, Fill, Line, Heat, each with a tiny preview
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 10 * s, "DISPLAY");
  y += 10 * s + 6 * s;
  tw = (w - 12 * s) / 4; th = 46 * s;
  i = 0;
  loop(4,
    m = i == 0 ? 2 : i == 3 ? 3 : i - 1;
    tx = floor(x + i * (tw + 4 * s)); ty = floor(y);
    on = Display_Mode == m;
    hov = ui_in(tx, ty, tw, th);
    on ? ui_box(tx, ty, tw, th, 5 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER)
       : ui_box(tx, ty, tw, th, 5 * s, hov ? T_CONTROL_HOVER : T_TILE, 1, hov ? T_BORDER_HOVER : T_BORDER_SUBTLE);
    ui_col(on ? T_ACCENT : T_TEXT_SECONDARY);
    cx0 = tx + tw * 0.5 - 20 * s;
    i == 0 ? (
      k = 0;
      loop(9, gfx_line(cx0 + k * 4.5 * s, ty + 19 * s, cx0 + (k * 4.5 + 2.5) * s, ty + 19 * s, 1); k += 1);
    ) : i == 3 ? (
      // A small spectrum filled with level colours, plum to red, as the Heat display draws it
      k = 0;
      loop(floor(40 * s),
        t = k / (40 * s);
        yy = 0.5 + 0.42 * cos(t * 7.2) * (1 - t * 0.4) - 0.12 * t;
        ui_col_mix(T_AN_HEAT_LOW, T_AN_HEAT_HIGH, yy, 0.3 + 0.7 * yy);
        gfx_line(cx0 + k, ty + (21 - 15 * yy) * s, cx0 + k, ty + 21 * s, 0);
        k += 1;
      );
      gfx_a = 1;
    ) : (
      // A small spectrum: filled under the line for Fill
      k = 0;
      loop(floor(40 * s),
        t = k / (40 * s);
        yy = ty + (8 + 4 * cos(t * 7.2) * (1 - t * 0.4) + 3 * t) * s;
        i == 1 ? (gfx_a = 0.28; gfx_line(cx0 + k, yy, cx0 + k, ty + 21 * s, 0));
        gfx_a = 1;
        k > 0 ? ui_thick_line(cx0 + k - 1, c, cx0 + k, yy, 1.3 * s);
        c = yy;
        k += 1;
      );
    );
    gfx_a = 1;
    gfx_setfont(FONT_CAP);
    ui_col(on || hov ? T_TEXT : T_TEXT_DIM);
    ui_text_c(tx, ty + th - 17 * s, tw, 13 * s, i == 0 ? "Off" : i == 1 ? "Fill" : i == 2 ? "Line" : "Heat");
    pr && hov ? (Display_Mode = m; update_state());
    i += 1;
  );
  y += th + 8 * s;

  // Show Pre-EQ: a row with a switch
  hov = ui_in(x, y, w, 34 * s);
  ui_box(x, y, w, 34 * s, 5 * s, hov ? T_CONTROL_HOVER : T_TILE, 1, T_BORDER_SUBTLE);
  gfx_setfont(FONT_BODY); ui_col(T_TEXT);
  ui_text_l(x + 9 * s, y + 3 * s, 16 * s, "Show Pre-EQ");
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x + 9 * s, y + 17 * s, 13 * s, "Grey line behind the output");
  tx = x + w - 9 * s - 30 * s; ty = y + 9 * s;
  Show_PreEQ ? ui_box(tx, ty, 30 * s, 16 * s, 8 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER) : ui_box(tx, ty, 30 * s, 16 * s, 8 * s, T_CONTROL, 1, T_BORDER);
  ui_col(Show_PreEQ ? T_ACCENT : T_TEXT_DIM);
  gfx_circle(Show_PreEQ ? tx + 22 * s : tx + 8 * s, ty + 8 * s, 5 * s, 1, 1);
  pr && hov ? (Show_PreEQ = !Show_PreEQ; update_state());
  y += 34 * s + 8 * s;

  // Spectrum: the seven modes with the stereo glyphs
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 10 * s, "SPECTRUM");
  y += 10 * s + 6 * s;
  tw = (w - 12 * s) / 4; th = 44 * s;
  i = 0;
  loop(7,
    tx = floor(x + (i % 4) * (tw + 4 * s)); ty = floor(y + floor(i / 4) * (th + 4 * s));
    on = Spectrum_Mode == i;
    hov = ui_in(tx, ty, tw, th);
    on ? ui_box(tx, ty, tw, th, 5 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER)
       : ui_box(tx, ty, tw, th, 5 * s, hov ? T_CONTROL_HOVER : T_TILE, 1, hov ? T_BORDER_HOVER : T_BORDER_SUBTLE);
    ui_col(on ? T_ACCENT : T_TEXT_SECONDARY);
    g = i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 2 : i == 3 ? 5 : i == 4 ? 3 : i == 5 ? 4 : 6;
    ui_stereo_glyph(g, tx + tw * 0.5, ty + 16 * s, 0.85);
    gfx_setfont(FONT_CAP);
    ui_col(on || hov ? T_TEXT : T_TEXT_DIM);
    ui_text_c(tx, ty + th - 15 * s, tw, 12 * s,
      i == 0 ? "Full" : i == 1 ? "Mid" : i == 2 ? "Side" : i == 3 ? "Mid + Side" : i == 4 ? "Left" : i == 5 ? "Right" : "Left + Right");
    pr && hov ? (Spectrum_Mode = i; spectrum.set_show_peaks(Show_Peaks); update_state());
    i += 1;
  );
  // ReEQ3's column
  ui_col(T_BORDER_SUBTLE); gfx_line(px + 276 * s, py + 38 * s, px + 276 * s, py + ph - 10 * s, 0);
  x = px + 276 * s + pad; w = 270 * s - pad; y = py + 30 * s + 10 * s;

  // ReEQ3: Freeze (the maximum over time, cleared when it comes off) and Spectrum Grab
  ui_switch_row(x, y, w, "Freeze", "Holds the maximum; off clears it", Show_Peaks, pr) ? (
    Show_Peaks = !Show_Peaks; spectrum.set_show_peaks(Show_Peaks); slider_automate(Show_Peaks);
  );
  y += 34 * s + 4 * s;
  ui_switch_row(x, y, w, "Spectrum Grab", "Drag a peak of the spectrum into a bell", Grab_On, pr) ? Grab_On = !Grab_On;
  y += 34 * s + 8 * s;

  // External spectrum: none, the sidechain, or the instance picked in the Instances list; collisions
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 10 * s, "EXTERNAL SPECTRUM");
  y += 10 * s + 6 * s;
  k = ui_segn(x, y, w, 22 * s, 3, Ext_Src, pr, "Off", "Sidechain", Ext_Tag ? "Instance" : "Instance…", "", "");
  k >= 0 ? (
    k == 2 && !Ext_Tag ? (ui_popup = 10; ui_pop_skip = 1; ui_pop_x = ui_top_ix; ui_pop_y = ui_top_y; ui_pop_w = ui_top_iw) : Ext_Src = k;
  );
  y += 22 * s + 4 * s;
  ui_switch_row(x, y, w, "Collisions", "Red where both spectra are loud", Collisions_On, pr) ? Collisions_On = !Collisions_On;
  y += 34 * s + 4 * s;
  // The piano under the graph; nodes then snap to notes
  ui_switch_row(x, y, w, "Piano", "Keyboard under the graph; nodes snap to notes", Show_Piano, pr) ? (
    Show_Piano = !Show_Piano; slider_automate(Show_Piano);
  );

  ui_top_pop_close(px, py, pw, ph, pr, skip);
  gfx_setfont(FONT_BASE);
);

/*
 * Settings popover, in two columns: the UI size, dynamics and the analyser's range on the left; the
 * analyser's response and FFT, and the theme, on the right
 */
function ui_draw_settings_pop() local(s, pad, cw, gap, pw, ph, px, py, x, y, y0, w, r, pr, skip, lw, hov) (
  s = ui_pt(1);
  skip = ui_pop_skip; ui_pop_skip = 0;
  pr = ui_press && !skip;
  // Follows its button, which moves when the UI size changes
  ui_pop_x = ui_top_gx; ui_pop_y = ui_top_y; ui_pop_w = ui_top_gw;
  // 588pt wide, so it fits the narrowest full-layout window (600pt) at any size
  pad = 11 * s; cw = 272 * s; gap = 22 * s;
  pw = pad + cw + gap + cw + pad;
  // The taller right column: response, FFT (two rows and two notes) and theme, with two dividers
  ph = 30 * s + 10 * s + (18 * s + 22 * s + 8 * s + 22 * s) + (18 * s + 22 * s + 8 * s + 22 * s + 8 * s + 30 * s) + (18 * s + 30 * s)
       + (8 * s + 1 + 8 * s) * 2 + 11 * s;
  px = floor(max(4 * s, gfx_w - 8 * s - pw));
  py = ui_pop_frame(px, pw, ph);
  ui_pop_head(px, py, pw, "Settings", sprintf(#, "ReEQ³ %s", #VERSION));

  y0 = py + 30 * s + 10 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(floor(px + pad + cw + gap * 0.5), y0, floor(px + pad + cw + gap * 0.5), py + ph - pad, 0);

  // Left column
  x = px + pad; w = cw; y = y0;

  // The UI size, held back by the window (see UI_SCALE). Set here, it's this instance's; "Use default"
  // goes back to the Theme Editor's default.
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); ui_text_l(x, y, 10 * s, "DISPLAY");
  y += 18 * s;
  r = ui_setrow(x, y, w, "UI size", "%", 5, ((UI_Size ? UI_Size : UI_Size_Default) - 100) / 25, pr, "100", "125", "150", "175", "200");
  r >= 0 ? UI_Size = 100 + r * 25;
  y += 22 * s + 4 * s;
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 14 * s, ui_zoom * 100 < (UI_Size ? UI_Size : UI_Size_Default) - 0.5 ? sprintf(#, "Shown at %d%% to fit the window", floor(ui_zoom * 100 + 0.5)) :
    UI_Size ? "Set for this instance" : "The default, from the Theme Editor");
  UI_Size ? (
    lw = ui_text_w("Use default");
    hov = ui_in(x + w - lw - 4 * s, y, lw + 4 * s, 14 * s);
    ui_col(hov ? T_TEXT : T_ACCENT);
    ui_text_l(x + w - lw, y, 14 * s, "Use default");
    pr && hov ? UI_Size = 0;
  );
  y += 14 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x + w, y, 0);
  y += 1 + 8 * s;

  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); ui_text_l(x, y, 10 * s, "DYNAMICS");
  y += 18 * s;
  r = ui_setrow(x, y, w, "Lookahead", "ms", 4, Lookahead_Value, pr, "Off", "1", "5", "10", "");
  r >= 0 ? (Lookahead_Value = r; sliderchange(Lookahead_Value));
  y += 22 * s + 4 * s;
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 14 * s, "Adds latency when on");
  y += 14 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x + w, y, 0);
  y += 1 + 8 * s;

  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); ui_text_l(x, y, 10 * s, "RANGE");
  y += 18 * s;
  r = ui_setrow(x, y, w, "Ceiling", "dB", 3, Ceiling_Value, pr, "0", "20", "40", "", "");
  r >= 0 ? (Ceiling_Value = r; update_state());
  y += 30 * s;
  r = ui_setrow(x, y, w, "Floor", "dB", 3, Floor_Value, pr, "−90", "−140", "−200", "", "");
  r >= 0 ? (Floor_Value = r; update_state());

  // Right column
  x = px + pad + cw + gap; y = y0;

  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); ui_text_l(x, y, 10 * s, "RESPONSE");
  y += 18 * s;
  r = ui_setrow(x, y, w, "Tilt", "dB/oct", 5, Tilt_Value, pr, "0", "1.5", "3", "4.5", "6");
  r >= 0 ? (Tilt_Value = r; update_state());
  y += 30 * s;
  r = ui_setrow(x, y, w, "Smoothing", "oct", 5, Smoothing_Value, pr, "Off", "1/48", "1/24", "1/12", "1/6");
  r >= 0 ? (Smoothing_Value = r; update_state());
  y += 22 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x + w, y, 0);
  y += 1 + 8 * s;

  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); ui_text_l(x, y, 10 * s, "FFT");
  y += 18 * s;
  r = ui_setrow(x, y, w, "Size", "", 4, Block_Value, pr, "2048", "4096", "8192", "16k", "");
  r >= 0 ? (Block_Value = r; update_state());
  y += 30 * s;
  r = ui_setrow(x, y, w, "Window", "", 4, Type_Value, pr, "Ham", "B-H", "Black", "Rect", "");
  r >= 0 ? (Type_Value = r; update_state());
  y += 22 * s + 8 * s;
  // The window's full name, and what the FFT size does
  gfx_setfont(FONT_BODY); ui_col(T_TEXT_SECONDARY);
  ui_text_l(x, y, 16 * s, Type_Value == 0 ? "Hamming Window" : Type_Value == 1 ? "Blackman-Harris Window" : Type_Value == 2 ? "Blackman Window" : "Rectangular Window");
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y + 16 * s, 14 * s, "Larger FFT sizes show more low-end detail");
  y += 30 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x + w, y, 0);
  y += 1 + 8 * s;

  // The theme in use; the editor is a script, which a JSFX can't start
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); ui_text_l(x, y, 10 * s, "THEME");
  y += 18 * s;
  gfx_setfont(FONT_BODY); ui_col(T_TEXT_SECONDARY); ui_text_l(x, y, 16 * s, #theme_name);
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y + 16 * s, 14 * s, "Colours and sizes: the ReEQ3 Theme Editor action");

  ui_top_pop_close(px, py, pw, ph, pr, skip);
  gfx_setfont(FONT_BASE);
);

/*
 * Range popover for the top scale button: the graph's dB range
 */
/*
 * Letter-spaced small capitals centred on cx, as the header's descriptor
 */
function ui_spaced_c(cx, y, h, str) local(s, i, w, x) (
  s = ui_pt(1);
  w = 0; i = 0;
  loop(strlen(str),
    strcpy_substr(#ui_ch, str, i, 1);
    w += ui_text_w(#ui_ch) + 1.4 * s;
    i += 1;
  );
  x = cx - (w - 1.4 * s) * 0.5;
  i = 0;
  loop(strlen(str),
    strcpy_substr(#ui_ch, str, i, 1);
    ui_text_l(x, y, h, #ui_ch);
    x += ui_text_w(#ui_ch) + 1.4 * s;
    i += 1;
  );
);

/*
 * ===================================================================================================
 * ReEQ3 graph overlays: the external spectrum and collisions, the EQ Match preview, Spectrum Grab
 * ===================================================================================================
 */

function ui_prow(x, y, w, label, n, sel, pr, l0, l1, l2, l3, l4) local(s) (
  s = ui_pt(1);
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_SECONDARY);
  ui_text_l(x, y, 22 * s, label);
  ui_segn(x + 92 * s, y, w - 92 * s, 22 * s, n, sel, pr, l0, l1, l2, l3, l4);
);

// A button inside a popover: it takes the popover's fresh press (pr), as the popovers' own controls do
function ui_pbutton(x, y, w, h, label, style, pr) local(hov) (
  hov = ui_in(x, y, w, h);
  ui_button_draw(x, y, w, h, label, style, hov);
  pr && hov;
);

/*
 * ReEQ3: the piano under the graph (A0..C8), each key where its note sits on the frequency axis. Keys
 * holding a band's frequency light up in its colour.
 */
function draw_piano_strip() local(s, top, h, n, f0, f1, x0, x1, xc, k, blk, b, hit, lo, hi) (
  s = ui_pt(1);
  h = 16 * s; top = floor(gfx_h - BOTTOM_MARGIN - 28 * s - h);
  lo = floor(freq_to_scx(440 * 2 ^ ((21 - 69 - 0.5) / 12))); hi = floor(freq_to_scx(440 * 2 ^ ((108 - 69 + 0.5) / 12)));
  ui_cola(T_GRAPH_BG, 0.85); gfx_rect(0, top - 2 * s, gfx_w, h + 4 * s);
  // The keys' surface, then key divisions, the black keys, and the keys holding bands
  ui_col(T_TEXT_SECONDARY); gfx_a = 0.6; gfx_rect(lo, top, hi - lo, h);
  n = 21;
  loop(88,
    k = n % 12;
    blk = k == 1 || k == 3 || k == 6 || k == 8 || k == 10;
    f0 = 440 * 2 ^ ((n - 69 - 0.5) / 12); f1 = 440 * 2 ^ ((n - 69 + 0.5) / 12);
    x0 = freq_to_scx(f0); x1 = freq_to_scx(f1); xc = floor((x0 + x1) * 0.5);
    ui_col(T_GRAPH_BG); gfx_a = 1;
    blk ? (
      gfx_line(xc, top + h * 0.6, xc, top + h - 1, 0);
      gfx_rect(floor(x0), top, max(floor(x1) - floor(x0), 1), floor(h * 0.6));
    ) : (k == 0 || k == 5) && n > 21 ? gfx_line(floor(x0), top, floor(x0), top + h - 1, 0);
    hit = -1; b = 0;
    loop(NUM_BANDS, Band_Enabled[b] != BAND_STATE_OFF && Band_Frequency[b] >= f0 && Band_Frequency[b] < f1 ? hit = b; b += 1);
    hit >= 0 ? (
      ui_band_col(hit); gfx_a = 1;
      gfx_rect(floor(x0), blk ? top : top + floor(h * 0.6), max(floor(x1) - floor(x0), 2), blk ? floor(h * 0.6) : h - floor(h * 0.6));
    );
    // C labels under the keys
    k == 0 ? (
      gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); gfx_a = 1;
      gfx_x = floor(x0) + 1; gfx_y = top + h + 1 * s; gfx_drawstr(sprintf(#, "C%d", floor(n / 12) - 1));
    );
    n += 1;
  );
  gfx_a = 1;
);

function sinh_(x) ( (exp(x) - exp(-x)) * 0.5; );

// A point of the shared 256-point spectra (20Hz..20kHz) to screen x
function pub_x(i) ( freq_to_scx(pub_freq(i)); );

// The analyser's level at a frequency in dB (its tilt taken out), from the post column levels
function an_db_at(f) local(c, v) (
  c = floor(spectrum.freq_to_x(f));
  c = min(max(c, 0), gfx_w - 1);
  v = max(spectrum.bin_y0[c], max(spectrum.bin_y0[max(c - 1, 0)], spectrum.bin_y0[min(c + 1, gfx_w - 1)]));
  spectrum.noise_floor + v * (spectrum.ceiling - spectrum.noise_floor) - spectrum.tilt * (log(f) / log(2) - 10);
);

// A shared-spectrum level (dB) to screen y, as the analyser draws it (its calibration found from this
// instance's own output, so the curves line up whatever the analyser's FFT size)
function pub_y(db, f) (
  spectrum.01_to_y(min(max(1 - ((db + Pub_AnOfs + spectrum.tilt * (log(f) / log(2) - 10) - spectrum.ceiling) /
    (spectrum.noise_floor - spectrum.ceiling)), 0), 1));
);
function pub_calibrate() local(i, f, d, n, acc) (
  n = 0; acc = 0; i = 40;
  loop(18,
    f = pub_freq(i);
    PUB_POST_DB[i] > -70 ? (d = an_db_at(f) - PUB_POST_DB[i]; acc += d; n += 1);
    i += 10;
  );
  n >= 4 ? Pub_AnOfs += 0.2 * (acc / n - Pub_AnOfs);
);

// The external spectrum's array (the sidechain's, or another instance's slot), or -1
function ext_array() local(r) (
  Ext_Src == 1 ? PUB_SC_DB : Ext_Src == 2 && (r = pub_find(Ext_Tag)) >= 0 ? GM_REG + r * GM_SLOT + GM_SPEC + 0.5 : -1;
);
// Read point i of an array that may be in gmem (marked by its .5)
function ext_get(a, i) ( a != floor(a) ? gmem[floor(a) + i] : a[i]; );

// Collisions: where this instance's output and the external spectrum are both loud and close
function coll_compute(a) local(i, o, e, d, c, tot) (
  tot = 0; i = 0;
  loop(PUB_PTS,
    o = PUB_POST_DB[i]; e = ext_get(a, i);
    d = abs(o - e);
    c = min(max((min(o, e) + 54) / 36, 0), 1) * max(0, 1 - d / 9);
    COLL[i] = c; tot += c;
    i += 1;
  );
  tot / PUB_PTS;
);

function draw_ext_overlay() local(a, i, x, y, lx, ly, f, bottom, c, x0, x1, top, k) (
  pub_calibrate();
  a = ext_array();
  a >= 0 ? (
    bottom = gfx_h - spectrum.bottom_margin - gfx_texth;
    // Collisions: a red wash up from the floor
    Collisions_On ? (
      coll_compute(a);
      i = 0;
      loop(PUB_PTS - 1,
        c = (COLL[i] + COLL[i + 1]) * 0.5;
        c > 0.05 ? (
          x0 = floor(pub_x(i)); x1 = floor(pub_x(i + 1)) + 1;
          f = pub_freq(i);
          top = pub_y(min(PUB_POST_DB[i], ext_get(a, i)), f);
          top < bottom ? (
            ui_col(T_DANGER);
            gfx_gradrect(x0, top, max(x1 - x0, 1), bottom - top, gfx_r, gfx_g, gfx_b, 0.45 * c, 0, 0, 0, 0, 0, 0, 0, -0.45 * c / max(bottom - top, 1));
          );
        );
        i += 1;
      );
    );
    // The external spectrum: a thin light red line
    ui_col(T_DANGER); gfx_a = 0.85;
    lx = -1;
    i = 0;
    loop(PUB_PTS,
      f = pub_freq(i);
      f < srate * 0.5 ? (
        x = pub_x(i); y = min(pub_y(ext_get(a, i), f), bottom);
        lx >= 0 && (ly < bottom - 1 || y < bottom - 1) ? ui_thick_line(lx, ly, x, y, 1.2 * ui_pt(1));
        lx = x; ly = y;
      );
      i += 1;
    );
    gfx_a = 1;
  );
);

/*
 * EQ Match: a bell's analogue response in dB, and the fit: bells placed greedily on the largest part
 * of what's left of the difference, their gains then refined together
 */
function eqm_bell_db(f, f0, q, g) local(o, ag, az, nr, ni, dr, di) (
  o = f / f0; ag = 10 ^ (g / 40); az = 0.5 / q;
  nr = 1 - o * o; ni = 2 * az * ag * o; dr = nr; di = 2 * az / ag * o;
  10 * log10((nr * nr + ni * ni) / (dr * dr + di * di));
);

// The fit from EQM_DIFF (valid where EQM_FIT), its level offset taken out first
function eqm_fit_diff(nb) local(i, j, k, w, m, acc, n, best, bi, pk, l, r, bw, q, g, sh, num, den, pass) (
  (
    // The level offset is the median (a mean would follow the very bumps being matched)
    acc = 0; n = 0; i = 0;
    loop(PUB_PTS, EQM_FIT[i] && pub_freq(i) > 100 && pub_freq(i) < 8000 ? n += 1; i += 1);
    n > 0 ? (
      n = 0; i = 0;
      loop(PUB_PTS, EQM_FIT[i] && pub_freq(i) > 100 && pub_freq(i) < 8000 ? (EQM_RES[n] = EQM_DIFF[i]; n += 1); i += 1);
      i = 1;
      loop(n - 1,
        m = EQM_RES[i]; j = i - 1;
        while (j >= 0 && EQM_RES[j] > m) (EQM_RES[j + 1] = EQM_RES[j]; j -= 1);
        EQM_RES[j + 1] = m;
        i += 1;
      );
      acc = EQM_RES[floor(n / 2)];
      i = 0; loop(PUB_PTS, EQM_FIT[i] ? EQM_DIFF[i] -= acc; i += 1);
    );
    // A third of an octave of smoothing (about 8.5 points), clamped to +-15dB
    i = 0;
    loop(PUB_PTS,
      acc = 0; n = 0; j = max(i - 4, 0);
      loop(min(i + 4, PUB_PTS - 1) - j + 1, EQM_FIT[j] ? (acc += EQM_DIFF[j]; n += 1); j += 1);
      EQM_RES[i] = n > 0 ? min(max(acc / n, -15), 15) : 0;
      i += 1;
    );
    memcpy(EQM_DIFF, EQM_RES, PUB_PTS);
    // Greedy placement
    EQM_FitN = 0;
    loop(nb,
      // From 30Hz up (the lowest points are the least certain)
      best = 0; bi = -1; i = 15;
      loop(PUB_PTS - 21, abs(EQM_RES[i]) > best ? (best = abs(EQM_RES[i]); bi = i); i += 1);
      bi >= 0 && best > 0.5 ? (
        pk = EQM_RES[bi];
        l = bi; while (l > 0 && EQM_RES[l] * pk > 0 && abs(EQM_RES[l]) > best * 0.5) (l -= 1);
        r = bi; while (r < PUB_PTS - 1 && EQM_RES[r] * pk > 0 && abs(EQM_RES[r]) > best * 0.5) (r += 1);
        bw = max((r - l) / (PUB_PTS - 1) * log(1000) / log(2), 0.2);
        q = min(max(1 / (2 * sinh_(log(2) * bw / 2)), 0.3), 8);
        g = min(max(pk, -12), 12);
        k = EQM_FitN;
        EQM_FF[k] = pub_freq(bi); EQM_FQ[k] = q; EQM_FG[k] = g;
        EQM_FitN += 1;
        i = 0; loop(PUB_PTS, EQM_RES[i] -= eqm_bell_db(pub_freq(i), EQM_FF[k], q, g); i += 1);
      );
    );
    // Refine the gains together (a few passes of least squares, one band at a time)
    pass = 0;
    loop(6,
      k = 0;
      loop(EQM_FitN,
        num = den = 0; i = 0;
        loop(PUB_PTS,
          // This band's share per dB of its gain, and what's left without it
          sh = eqm_bell_db(pub_freq(i), EQM_FF[k], EQM_FQ[k], EQM_FG[k]);
          m = abs(EQM_FG[k]) > 0.01 ? sh / EQM_FG[k] : 0;
          num += (EQM_RES[i] + sh) * m; den += m * m;
          i += 1;
        );
        g = den > 0 ? min(max(num / den, -12), 12) : EQM_FG[k];
        i = 0;
        loop(PUB_PTS, EQM_RES[i] += eqm_bell_db(pub_freq(i), EQM_FF[k], EQM_FQ[k], EQM_FG[k]) - eqm_bell_db(pub_freq(i), EQM_FF[k], EQM_FQ[k], g); i += 1);
        EQM_FG[k] = g;
        k += 1;
      );
      pass += 1;
    );
    EQM_Fitted = 1;
  );
);

function eqm_fit(nb) local(i, j, k, w, m, acc, n, best, bi, pk, l, r, bw, q, g, sh, num, den, pass, lo, hi, valid) (
  EQM_Count < 3 ? (EQM_FitN = 0) : (
    // The difference, reference over input, with no level offset (its mean over 100Hz..8kHz)
    acc = 0; n = 0; i = 0;
    loop(PUB_PTS,
      lo = EQM_SUM_IN[i] / EQM_Count; hi = EQM_SUM_REF[i] / EQM_Count;
      valid = lo > 0.000000001 && hi > 0.000000001 && pub_freq(i) < srate * 0.45;
      EQM_DIFF[i] = valid ? 10 * log10(hi / lo) : 0;
      EQM_FIT[i] = valid;
      valid && pub_freq(i) > 100 && pub_freq(i) < 8000 ? (acc += EQM_DIFF[i]; n += 1);
      i += 1;
    );
    eqm_fit_diff(nb);
  );
);

// The fit as new bells in free bands; returns how many went in
function eqm_apply() local(k, b, n) (
  n = 0; k = 0;
  loop(EQM_FitN,
    b = 0; while (b < NUM_BANDS && Band_Enabled[b] != BAND_STATE_OFF) (b += 1);
    b < NUM_BANDS ? (
      Band_Enabled[b] = BAND_STATE_ENABLED; Band_Group[b] = 0; Band_Type[b] = FILTER_PEAK;
      Band_Frequency[b] = EQM_FF[k]; Band_Gain[b] = EQM_FG[k]; Band_Q[b] = EQM_FQ[k]; Band_Slope[b] = 1;
      band_dyn_defaults(b);
      flag_filter_update(b);
      n += 1;
    );
    k += 1;
  );
  filters_to_sliders();
  n;
);

// The preview: the difference to match (faint) and the fit's curve
function draw_eqm_preview() local(i, x, y, lx, ly, d, k) (
  EQM_Fitted && EQM_FitN > 0 && ui_popup == 10 ? (
    ui_col(T_ACCENT); gfx_a = 0.35;
    lx = -1; i = 0;
    loop(PUB_PTS,
      x = pub_x(i); y = db_to_y(EQM_DIFF[i] * Scale / 100);
      lx >= 0 ? gfx_line(lx, ly, x, y, 1);
      lx = x; ly = y; i += 1;
    );
    gfx_a = 0.95;
    lx = -1; i = 0;
    loop(PUB_PTS,
      d = 0; k = 0; loop(EQM_FitN, d += eqm_bell_db(pub_freq(i), EQM_FF[k], EQM_FQ[k], EQM_FG[k]); k += 1);
      x = pub_x(i); y = db_to_y(d * Scale / 100);
      lx >= 0 ? ui_thick_line(lx, ly, x, y, 1.6 * ui_pt(1));
      lx = x; ly = y; i += 1;
    );
    gfx_a = 1;
  );
);

/*
 * Spectrum Grab. Point into the spectrum (on or under its line, away from the nodes and the panel): the
 * clearest peak near the mouse lights up, with its frequency and note. Press and drag: a bell is
 * made at the peak (its Q from the peak's width) and follows the mouse up or down. A click without a drag
 * cuts it 6dB.
 */
// The analyser's level (0..1) at a column, lightly smoothed
function grab_lv(c) (
  c = min(max(c, 1), gfx_w - 2);
  (spectrum.bin_y0[c - 1] + 2 * spectrum.bin_y0[c] + spectrum.bin_y0[c + 1]) * 0.25;
);
function grab_reach(c0, d) local(c, m) (
  m = 0; c = max(c0 - d, 1);
  loop(min(c0 + d, gfx_w - 2) - c + 1, m = max(m, grab_lv(c)); c += 1);
  m;
);
function grab_find() local(s, c0, c, best, bc, lv, oct, l, r, minl, minr, prom, half, dbpu, a, b, d, off, fl, fr, bw) (
  ui_grab = 0;
  Grab_On && !tb_rm_on && Display_Mode != 2 && ui_popup == 0 && !ui_block && ui_fade > 0.5 && !mouse_within_panel() &&
    mouse_y > TOP_MARGIN && mouse_y < gfx_h - BOTTOM_MARGIN - gfx_texth && get_nearest_node() == -1 && node_drag_mode == 0 &&
    box_region_drag_mode == 0 && button_focus == -1 &&
    // On or under the spectrum line (its highest point within 8pt, so a narrow peak is easy to reach)
    mouse_y >= spectrum.01_to_y(grab_reach(floor(mouse_x), floor(8 * ui_pt(1)))) - 10 * ui_pt(1) ? (
    s = ui_pt(1);
    dbpu = spectrum.ceiling - spectrum.noise_floor;
    oct = gfx_w * log(2) / FREQ_LOG_MAX;
    // The highest local maximum within 24pt either side
    c0 = floor(mouse_x); best = -1; bc = -1;
    c = max(c0 - floor(24 * s), 2);
    loop(min(c0 + floor(24 * s), gfx_w - 3) - c + 1,
      lv = grab_lv(c);
      lv > best && lv >= grab_lv(c - 1) && lv >= grab_lv(c + 1) ? (best = lv; bc = c);
      c += 1;
    );
    bc > 0 && best > 0.02 ? (
      // Its prominence: walk down each side (up to an octave) until the level rises above the peak
      minl = best; l = bc;
      while (l > 1 && bc - l < oct && grab_lv(l - 1) <= best) (l -= 1; minl = min(minl, grab_lv(l)));
      minr = best; r = bc;
      while (r < gfx_w - 2 && r - bc < oct && grab_lv(r + 1) <= best) (r += 1; minr = min(minr, grab_lv(r)));
      prom = (best - max(minl, minr)) * dbpu;
      prom >= 3 ? (
        // Its centre, between columns (a parabola through the top three)
        a = grab_lv(bc - 1); b = grab_lv(bc + 1);
        d = a - 2 * best + b;
        off = d < 0 ? min(max(0.5 * (a - b) / d, -0.5), 0.5) : 0;
        // Its width where it has fallen 6dB (or half its prominence, when that's less)
        half = min(6, prom * 0.5) / dbpu;
        l = bc; while (l > 1 && grab_lv(l) > best - half) (l -= 1);
        r = bc; while (r < gfx_w - 2 && grab_lv(r) > best - half) (r += 1);
        fl = scx_to_freq(l); fr = scx_to_freq(r);
        bw = max(log(fr / fl) / log(2), 0.04);
        ui_grab = 1;
        ui_grab_x = bc + off; ui_grab_y = spectrum.01_to_y(best);
        ui_grab_l = l; ui_grab_r = r;
        ui_grab_f = scx_to_freq(bc + off);
        ui_grab_db = spectrum.noise_floor + best * dbpu - spectrum.tilt * (log(ui_grab_f) / log(2) - 10);
        ui_grab_q = min(max(1 / (2 * sinh_(log(2) * bw / 2)), 0.7), 16);
      );
    );
  );
);

function draw_grab() local(s, lab, n, w, c, y, ly, bx, by) (
  ui_grab ? (
    s = ui_pt(1);
    // The peak's outline, lit
    ui_col(T_ACCENT); gfx_a = 0.95;
    ly = spectrum.01_to_y(grab_lv(ui_grab_l));
    c = ui_grab_l + 1;
    loop(max(ui_grab_r - ui_grab_l, 0),
      y = spectrum.01_to_y(grab_lv(c));
      ui_thick_line(c - 1, ly, c, y, 2 * s);
      ly = y; c += 1;
    );
    gfx_a = 0.25; gfx_rect(ui_grab_x, ui_grab_y, 1, gfx_h - BOTTOM_MARGIN - gfx_texth - ui_grab_y);
    gfx_a = 1;
    gfx_circle(ui_grab_x, ui_grab_y, 4 * s, 1, 1);
    // Frequency, note and level, with the hint
    lab = #;
    ui_grab_f < 1000 ? sprintf(lab, "%.0f Hz", ui_grab_f) : sprintf(lab, "%.2f kHz", ui_grab_f / 1000);
    n = floor(12 * log(ui_grab_f / 440) / log(2) + 69.5);
    strcat(lab, sprintf(#, "  %s%d", (n % 12) == 0 ? "C" : (n % 12) == 1 ? "C#" : (n % 12) == 2 ? "D" : (n % 12) == 3 ? "D#" :
      (n % 12) == 4 ? "E" : (n % 12) == 5 ? "F" : (n % 12) == 6 ? "F#" : (n % 12) == 7 ? "G" : (n % 12) == 8 ? "G#" :
      (n % 12) == 9 ? "A" : (n % 12) == 10 ? "A#" : "B", floor(n / 12) - 1));
    gfx_setfont(FONT_BODY_B); w = max(ui_text_w(lab), (gfx_setfont(FONT_CAP); ui_text_w("Drag to boost or cut · click: −6 dB"))) + 16 * s;
    bx = min(max(ui_grab_x - w * 0.5, 4 * s), gfx_w - w - 4 * s); by = max(ui_grab_y - 46 * s, TOP_MARGIN);
    ui_box(bx, by, w, 36 * s, 5 * s, T_POPOVER, 0.94, T_ACCENT_BORDER);
    gfx_setfont(FONT_BODY_B); ui_col(T_TEXT); ui_text_c(bx, by + 2 * s, w, 18 * s, lab);
    gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); ui_text_c(bx, by + 19 * s, w, 14 * s, "Drag to boost or cut · click: −6 dB");
  );
);

// A press on a lit peak: a bell there at 0dB, selected and dragging (so pulling down cuts it)
function grab_press() local(b) (
  b = 0; while (b < NUM_BANDS && Band_Enabled[b] != BAND_STATE_OFF) (b += 1);
  b < NUM_BANDS ? (
    Band_Enabled[b] = BAND_STATE_ENABLED; Band_Group[b] = 0; Band_Type[b] = FILTER_PEAK;
    Band_Frequency[b] = ui_grab_f; Band_Gain[b] = 0; Band_Q[b] = ui_grab_q; Band_Slope[b] = 1;
    band_dyn_defaults(b);
    flag_filter_update(b);
    filters_to_sliders();
    select_node_clear(); select_node(b);
    selected_node = b;
    node_drag = b; node_drag_mode = 1;
    node_drag_origy = mouse_y;
    node_drag_stablex = mouse_x; node_drag_stabley = mouse_y;
    set_node_drag_offsets(b, mouse_x, mouse_y);
    // Held to the peak's frequency while dragging: only the gain moves
    node_drag_lock = 0;
    dont_deselect_node = 1;
    Grab_Band = b; Grab_X = mouse_x; Grab_Y = mouse_y; Grab_Moved = 0;
  );
  b;
);

// While a grabbed bell is dragged its frequency stays on the peak; on release, a click (no movement)
// cuts it 6dB
function grab_follow() (
  Grab_Band >= 0 ? (
    mouse_cap & 1 ? (
      abs(mouse_y - Grab_Y) > 2 || abs(mouse_x - Grab_X) > 2 ? Grab_Moved = 1;
    ) : (
      !Grab_Moved ? (
        Band_Gain[Grab_Band] = -6;
        flag_filter_update(Grab_Band);
        filters_to_sliders();
        notify_touched_gain(Grab_Band);
      );
      Grab_Band = -1;
    );
  );
);

/*
 * ===================================================================================================
 * ReEQ3: the Instances popover: every ReEQ3 running, its spectrum and collisions with this one; picking
 * one as the external spectrum or the EQ Match reference; this instance's name; EQ Match
 * ===================================================================================================
 */
function inst_name(dst, slot) local(b, n, i, tr, pos) (
  b = GM_REG + slot * GM_SLOT;
  n = gmem[b + 4];
  n > 0 ? (
    strcpy(dst, ""); i = 0;
    loop(n, #inst_ch = " "; str_setchar(#inst_ch, 0, gmem[b + 8 + i]); strcat(dst, #inst_ch); i += 1);
  ) : (
    tr = gmem[b + 2]; pos = gmem[b + 3];
    tr == -1 ? sprintf(dst, "Master · FX %d", pos + 1) : tr < -1 ? strcpy(dst, "ReEQ3") : sprintf(dst, "Track %d · FX %d", tr, pos + 1);
  );
  dst;
);

function ui_draw_inst_pop() local(s, skip, pr, pad, pw, ph, px, py, x, y, w, i, n, b, rowh, now, me, hov, tx, k, lab, sx, sw,
                                   sy, sh, lx, ly, v, c, inpop, bw, secs) (
  s = ui_pt(1);
  skip = ui_pop_skip; ui_pop_skip = 0;
  pr = ui_press && !skip;
  ui_pop_x = ui_top_ix; ui_pop_y = ui_top_y; ui_pop_w = ui_top_iw;
  now = time_precise();
  // The rows: live slots other than this one
  n = 0; i = 0;
  loop(GM_SLOTS,
    b = GM_REG + i * GM_SLOT;
    gmem[b + 1] != 0 && gmem[b + 1] != Instance_Tag && now - gmem[b] < 30 && n < 10 ? (INST_ROWS[n] = i; n += 1);
    i += 1;
  );
  rowh = 34 * s;
  pad = 11 * s; pw = 440 * s;
  ph = 30 * s + 10 * s + 26 * s + 10 * s + 10 * s + 6 * s + max(n, 1) * (rowh + 4 * s) + 8 * s + 1 + 10 * s
       + 10 * s + 6 * s + 22 * s + 8 * s + 26 * s + 8 * s + 22 * s + 8 * s + 14 * s + 11 * s;
  px = floor(max(4 * s, gfx_w - 8 * s - pw));
  py = ui_pop_frame(px, pw, ph);
  inpop = ui_in(px, py, pw, ph);
  ui_pop_head(px, py, pw, "Instances", sprintf(#, "%d other%s", n, n == 1 ? "" : "s"));
  x = px + pad; w = pw - 2 * pad; y = py + 30 * s + 10 * s;

  // This instance's name: shown (or the editing line); Rename edits it, Enter keeps it
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_SECONDARY);
  ui_text_l(x, y, 26 * s, "THIS");
  ui_inst_edit ? (
    ui_key >= 32 && ui_key < 127 && strlen(#inst_edit) < GM_NAME_LEN ? (#inst_ch = " "; str_setchar(#inst_ch, 0, ui_key); strcat(#inst_edit, #inst_ch)) :
    ui_key == 8 && strlen(#inst_edit) > 0 ? strcpy_substr(#inst_edit, #inst_edit, 0, strlen(#inst_edit) - 1) :
    ui_key == 13 ? (strcpy(#Instance_Name, #inst_edit); ui_inst_edit = 0; sliderchange(Out_Pan));
    ui_box(x + 48 * s, y, w - 48 * s - 90 * s, 26 * s, 5 * s, T_CONTROL, 1, T_ACCENT_BORDER);
    gfx_setfont(FONT_BODY_B); ui_col(T_ACCENT);
    ui_text_l(x + 56 * s, y, 26 * s, sprintf(#, "%s▏", #inst_edit));
  ) : (
    gfx_setfont(FONT_BODY_B); ui_col(T_TEXT);
    Pub_Slot >= 0 ? (lab = #; inst_name(lab, Pub_Slot)) : lab = "ReEQ3";
    ui_text_l(x + 48 * s, y, 26 * s, lab);
  );
  ui_inst_edit ? (
    ui_pbutton(x + w - 84 * s, y + 1 * s, 84 * s, 24 * s, "Done", 1, pr) ? (strcpy(#Instance_Name, #inst_edit); ui_inst_edit = 0; sliderchange(Out_Pan));
  ) : (
    ui_pbutton(x + w - 84 * s, y + 1 * s, 84 * s, 24 * s, "Rename", 0, pr) ? (strcpy(#inst_edit, #Instance_Name); ui_inst_edit = 1);
  );
  y += 26 * s + 10 * s;

  // The others
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 10 * s, "OTHER REEQ3 INSTANCES");
  y += 10 * s + 6 * s;
  n == 0 ? (
    gfx_setfont(FONT_BODY); ui_col(T_TEXT_DIM);
    ui_text_l(x, y, rowh, "None running. Other ReEQ3s show here while they play.");
    y += rowh + 4 * s;
  );
  i = 0;
  loop(n,
    k = INST_ROWS[i]; b = GM_REG + k * GM_SLOT;
    me = gmem[b + 1] == Ext_Tag && Ext_Src == 2;
    hov = ui_in(x, y, w, rowh);
    ui_box(x, y, w, rowh, 5 * s, hov ? T_CONTROL_HOVER : T_TILE, 1, me ? T_ACCENT_BORDER : T_BORDER_SUBTLE);
    lab = #; inst_name(lab, k);
    gfx_setfont(FONT_BODY); ui_col(T_TEXT);
    ui_text_l(x + 9 * s, y + 2 * s, 16 * s, lab);
    // Collisions with this instance's output
    gfx_setfont(FONT_CAP);
    c = coll_compute(b + GM_SPEC + 0.5);
    ui_col(c > 0.08 ? T_DANGER : T_TEXT_DIM);
    ui_text_l(x + 9 * s, y + 18 * s, 13 * s, c > 0.08 ? "Collides with this one" : c > 0.03 ? "Some overlap" : "Clear");
    // A small spectrum
    sx = x + 190 * s; sw = 110 * s; sy = y + 4 * s; sh = rowh - 8 * s;
    ui_col(T_TEXT_SECONDARY); gfx_a = 0.9;
    lx = -1; v = 0;
    loop(PUB_PTS / 4,
      ly = sy + sh * min(max((-gmem[b + GM_SPEC + v * 4] - 6) / 72, 0), 1);
      lx >= 0 ? gfx_line(lx, lyp, sx + sw * v / (PUB_PTS / 4 - 1), ly, 1);
      lx = sx + sw * v / (PUB_PTS / 4 - 1); lyp = ly;
      v += 1;
    );
    gfx_a = 1;
    // Show (as the external spectrum) and Match (as the EQ Match reference)
    bw = 54 * s;
    ui_pbutton(x + w - 2 * bw - 12 * s, y + 5 * s, bw, 24 * s, "Show", me ? 1 : 0, pr) ? (
      me ? Ext_Src = 0 : (Ext_Src = 2; Ext_Tag = gmem[b + 1]);
    );
    ui_pbutton(x + w - bw - 6 * s, y + 5 * s, bw, 24 * s, "Match", EQM_Src == 2 && EQM_Tag == gmem[b + 1] ? 1 : 0, pr) ? (
      EQM_Src = 2; EQM_Tag = gmem[b + 1]; EQM_Fitted = 0;
    );
    y += rowh + 4 * s;
    i += 1;
  );
  y += 4 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x + w, y, 0);
  y += 1 + 10 * s;

  // EQ Match
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 10 * s, "EQ MATCH");
  y += 10 * s + 6 * s;
  k = ui_prow(x, y, w, "REFERENCE", 3, EQM_Src - 1, pr, "Sidechain", EQM_Tag ? "Instance" : "Instance…", EQM_HasCap ? "Captured" : "Captured…", "", "");
  k >= 0 ? (EQM_Src = k + 1; EQM_Fitted = 0);
  y += 22 * s + 8 * s;
  // Capture this input as a reference (toggle), Analyse (toggle), Apply
  bw = (w - 8 * s) / 3;
  ui_pbutton(x, y, bw, 26 * s, EQM_Capturing ? sprintf(#, "Capturing %.0f s", EQM_CapCount * PUB_HOP / srate) : "Capture Input", EQM_Capturing ? 1 : 0, pr) ? (
    EQM_Capturing = !EQM_Capturing;
    EQM_Capturing ? (memset(EQM_CAPSUM, 0, PUB_PTS); EQM_CapCount = 0);
    !EQM_Capturing ? sliderchange(Out_Pan);
  );
  secs = EQM_Count * PUB_HOP / srate;
  ui_pbutton(x + bw + 4 * s, y, bw, 26 * s, EQM_Run ? sprintf(#, "Analysing %.0f s", secs) : EQM_Count > 0 ? sprintf(#, "Analyse (%.0f s)", secs) : "Analyse", EQM_Run ? 1 : 0, pr) ? (
    EQM_Run = !EQM_Run;
    EQM_Run ? (memset(EQM_SUM_IN, 0, PUB_PTS); memset(EQM_SUM_REF, 0, PUB_PTS); EQM_Count = 0; EQM_Status = 0; EQM_Fitted = 0) : eqm_fit(EQM_Bands);
  );
  ui_pbutton(x + 2 * bw + 8 * s, y, bw, 26 * s, EQM_Fitted && EQM_FitN > 0 ? sprintf(#, "Apply %d Bands", EQM_FitN) : "Apply", 0, pr) ? (
    EQM_Fitted && EQM_FitN > 0 ? (eqm_apply(); EQM_Fitted = 0);
  );
  y += 26 * s + 8 * s;
  k = ui_prow(x, y, w, "BANDS", 5, EQM_Bands == 4 ? 0 : EQM_Bands == 6 ? 1 : EQM_Bands == 8 ? 2 : EQM_Bands == 10 ? 3 : 4, pr, "4", "6", "8", "10", "12");
  k >= 0 ? (EQM_Bands = k == 0 ? 4 : k == 1 ? 6 : k == 2 ? 8 : k == 3 ? 10 : 12; !EQM_Run && EQM_Count > 0 ? eqm_fit(EQM_Bands));
  y += 22 * s + 8 * s;
  gfx_setfont(FONT_CAP); ui_col(EQM_Status == 3 ? T_DANGER : T_TEXT_DIM);
  ui_text_l(x, y, 14 * s,
    EQM_Status == 3 ? "The reference instance has stopped." :
    EQM_Src == 1 ? "Feed the reference into sidechain 1 (pins 3/4), then Analyse while both play." :
    EQM_Src == 2 ? (EQM_Tag ? "Analyse while both play; stop to see the match, then Apply." : "Pick an instance above with Match.") :
    (EQM_HasCap ? "Analyse this input against the capture; stop, then Apply." : "Capture Input somewhere in the song first."));

  // While a running analysis has enough, keep its fit up to date
  EQM_Run && EQM_Count >= 3 && (ui_eqm_tick += 1) % 15 == 0 ? eqm_fit(EQM_Bands);

  ui_top_pop_close(px, py, pw, ph, pr, skip);
  !inpop && pr ? ui_inst_edit = 0;
  gfx_setfont(FONT_BASE);
);

/*
 * ===================================================================================================
 * ReEQ3: the Luftikus panel (in the band panel's place) and its curve
 * ===================================================================================================
 */
// The original's rounding: half away from zero
function lf_round(v) ( v > 0 ? floor(v + 0.5) : v < 0 ? -floor(-v + 0.5) : 0; );

// The response per column, when anything changed
function lf_curve_update() local(c) (
  (LF_CurveDirty || LF_CurveW != gfx_w || LF_CurveRate != srate) ? (
    LF_CurveDirty = 0; LF_CurveW = gfx_w; LF_CurveRate = srate;
    c = 0;
    loop(min(gfx_w, 16384), LF_CURVE[c] = lf_response_db(min(scx_to_freq(c), srate * 0.4999), srate); c += 1);
  );
);

// Luftikus's own curve: a faint fill from 0dB, in the accent colour
function draw_lf_curve() local(c, y0, y, ly, bottom) (
  Lf_On ? (
    lf_curve_update();
    bottom = gfx_h - BOTTOM_MARGIN - gfx_texth;
    y0 = db_to_y(0);
    ui_col(T_ACCENT);
    c = 0;
    loop(gfx_w,
      y = min(db_to_y(LF_CURVE[c]), bottom);
      gfx_a = 0.12; gfx_line(c, y0, c, y, 0);
      gfx_a = 0.9; c > 0 ? gfx_line(c - 1, ly, c, y, 1);
      ly = y; c += 1;
    );
    gfx_a = 1;
  );
);

// One knob: label, dial, value. Returns the new value (lo..hi); a double click resets it to rst.
function lf_knob(k, cx, cy, label, v, lo, hi, bipolar, step, rst, fmt, unit) local(t, nt, nv, hit) (
  t = (v - lo) / (hi - lo);
  k == 0 ? (lfd0.x = cx; lfd0.y = cy; lfd0.r = 29 * ui_pt(1); nt = ui_popup == 0 && !ui_block ? lfd0.handle_number_dial(t) : t; hit = lfd0.is_mouse_number_dial()) :
  k == 1 ? (lfd1.x = cx; lfd1.y = cy; lfd1.r = 29 * ui_pt(1); nt = ui_popup == 0 && !ui_block ? lfd1.handle_number_dial(t) : t; hit = lfd1.is_mouse_number_dial()) :
  k == 2 ? (lfd2.x = cx; lfd2.y = cy; lfd2.r = 29 * ui_pt(1); nt = ui_popup == 0 && !ui_block ? lfd2.handle_number_dial(t) : t; hit = lfd2.is_mouse_number_dial()) :
  k == 3 ? (lfd3.x = cx; lfd3.y = cy; lfd3.r = 29 * ui_pt(1); nt = ui_popup == 0 && !ui_block ? lfd3.handle_number_dial(t) : t; hit = lfd3.is_mouse_number_dial()) :
  k == 4 ? (lfd4.x = cx; lfd4.y = cy; lfd4.r = 29 * ui_pt(1); nt = ui_popup == 0 && !ui_block ? lfd4.handle_number_dial(t) : t; hit = lfd4.is_mouse_number_dial()) :
  k == 5 ? (lfd5.x = cx; lfd5.y = cy; lfd5.r = 29 * ui_pt(1); nt = ui_popup == 0 && !ui_block ? lfd5.handle_number_dial(t) : t; hit = lfd5.is_mouse_number_dial()) :
           (lfd6.x = cx; lfd6.y = cy; lfd6.r = 29 * ui_pt(1); nt = ui_popup == 0 && !ui_block ? lfd6.handle_number_dial(t) : t; hit = lfd6.is_mouse_number_dial());
  nv = lo + nt * (hi - lo);
  step > 0 ? nv = lf_round(nv / step) * step;
  // Double click: back to its default
  ui_press && hit ? (
    time_precise() - ui_lf_click_t < 0.4 && ui_lf_click_k == k ? nv = rst;
    ui_lf_click_t = time_precise(); ui_lf_click_k = k;
  );
  ui_dial_accent = 1;
  ui_dial_face(cx, cy, label, (nv - lo) / (hi - lo), bipolar, 0, !Lf_On, sprintf(#, fmt, nv), unit);
  ui_dial_accent = 0;
  nv;
);

function ui_draw_lf_panel() local(s, x, y, w, h, hy, hh, bx, bw, sp, cx, cy, v, i, tx, ty, on, hov, k, q) (
  s = ui_pt(1);
  w = floor(min(760 * s, gfx_w - 8 * s)); h = panel_h;
  x = floor(gfx_w / 2 - w / 2); y = panel_y;
  ui_lf_x = x; ui_lf_w = w;
  ui_cola(T_PANEL, 1); ui_fill_rrect(x, y, w, h, 8 * s);
  ui_cola(T_BORDER, 1); gfx_roundrect(x, y, w - 1, h - 1, 8 * s, 1);
  ui_cola(T_ACCENT_BORDER, 1); gfx_line(x + 8 * s, y, x + w - 8 * s, y, 1);

  // Header: name, power; Mastering, Analog, Keep Gain; close
  hy = y + 6 * s; hh = 24 * s;
  gfx_setfont(FONT_BODY_B); ui_col(T_ACCENT);
  ui_text_l(x + 14 * s, hy, hh, "LUFTIKUS");
  bx = x + 14 * s + ui_text_w("LUFTIKUS") + 12 * s;
  gfx_setfont(FONT_BODY_B); bw = ui_text_w("Off") + 22 * s;
  ui_button(bx, hy, bw, hh, Lf_On ? "On" : "Off", Lf_On ? 1 : 0) ? (Lf_On = !Lf_On; slider_automate(Lf_On));
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(bx + bw + 10 * s, hy, hh, "after lkjb's Luftikus (Maag EQ4 style)");
  // Close
  ui_icon_button(x + w - 10 * s - 26 * s, hy, 26 * s, hh, 10, 0) ? ui_lf_show = 0;
  tx = x + w - 10 * s - 26 * s - 8 * s;
  i = 0;
  loop(3,
    gfx_setfont(FONT_BODY);
    q = i == 0 ? "Keep Gain" : i == 1 ? "Analog" : "Mastering";
    on = i == 0 ? Lf_Keep : i == 1 ? Lf_Analog : Lf_Mastering;
    bw = ui_text_w(q) + 18 * s; tx -= bw;
    ui_button(tx, hy, bw, hh, q, on ? 1 : 0) ? (
      i == 0 ? (Lf_Keep = !Lf_Keep; slider_automate(Lf_Keep)) :
      i == 1 ? (Lf_Analog = !Lf_Analog; slider_automate(Lf_Analog)) : (
        Lf_Mastering = !Lf_Mastering; slider_automate(Lf_Mastering);
        // As the original's knobs do: Mastering steps the bands by 1dB and Air by 0.5
        Lf_Mastering ? (
          Lf_G10 = lf_round(Lf_G10); Lf_G40 = lf_round(Lf_G40); Lf_G160 = lf_round(Lf_G160);
          Lf_G640 = lf_round(Lf_G640); Lf_G2k5 = lf_round(Lf_G2k5); Lf_Air = 0.5 * floor(0.5 + 2 * Lf_Air);
          slider_automate(Lf_G10); slider_automate(Lf_G40); slider_automate(Lf_G160); slider_automate(Lf_G640);
          slider_automate(Lf_G2k5); slider_automate(Lf_Air);
        );
      );
    );
    tx -= 6 * s;
    i += 1;
  );
  ui_col(T_BORDER_SUBTLE);
  gfx_line(x + 12 * s, y + 36 * s, x + w - 12 * s, y + 36 * s, 0);

  // Knobs: 10, 40, 160, 640 Hz, the 2.5k shelf, Air with its frequency list, and the trim
  sp = (w - 24 * s - 64 * s) / 7;
  ui_dial_hx = sp * 0.5;
  cy = y + 91 * s;
  cx = x + 12 * s + sp * 0.5;
  v = lf_knob(0, cx, cy, "10 Hz", Lf_G10, -10, 10, 1, Lf_Mastering ? 1 : 0.1, 0, "%.1f", "");
  v != Lf_G10 ? (Lf_G10 = v; slider_automate(Lf_G10));
  cx += sp;
  v = lf_knob(1, cx, cy, "40 Hz", Lf_G40, -10, 10, 1, Lf_Mastering ? 1 : 0.1, 0, "%.1f", "");
  v != Lf_G40 ? (Lf_G40 = v; slider_automate(Lf_G40));
  cx += sp;
  v = lf_knob(2, cx, cy, "160 Hz", Lf_G160, -10, 10, 1, Lf_Mastering ? 1 : 0.1, 0, "%.1f", "");
  v != Lf_G160 ? (Lf_G160 = v; slider_automate(Lf_G160));
  cx += sp;
  v = lf_knob(3, cx, cy, "640 Hz", Lf_G640, -10, 10, 1, Lf_Mastering ? 1 : 0.1, 0, "%.1f", "");
  v != Lf_G640 ? (Lf_G640 = v; slider_automate(Lf_G640));
  cx += sp;
  v = lf_knob(4, cx, cy, "2.5 kHz", Lf_G2k5, -10, 10, 1, Lf_Mastering ? 1 : 0.1, 0, "%.1f", "");
  v != Lf_G2k5 ? (Lf_G2k5 = v; slider_automate(Lf_G2k5));
  cx += sp;
  v = lf_knob(5, cx, cy, "AIR", Lf_Air, 0, 10, 0, Lf_Mastering ? 0.5 : 0.05, 0, "%.1f", "");
  v != Lf_Air ? (Lf_Air = v; slider_automate(Lf_Air));
  // Air's frequency: Off, 2.5k .. 40k, a column of chips
  tx = floor(cx + sp * 0.5 - 4 * s); ty = y + 42 * s;
  i = 0;
  loop(6,
    hov = ui_hover(tx, ty, 52 * s, 15 * s);
    on = Lf_AirType == i;
    on ? ui_box(tx, ty, 52 * s, 15 * s, 3 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER)
       : ui_box(tx, ty, 52 * s, 15 * s, 3 * s, hov ? T_CONTROL_HOVER : T_CONTROL, 1, T_BORDER_SUBTLE);
    gfx_setfont(on ? FONT_CAP_B : FONT_CAP); ui_col(on ? T_ACCENT : hov ? T_TEXT : T_TEXT_SECONDARY);
    ui_text_c(tx, ty, 52 * s, 15 * s, i == 0 ? "Off" : i == 1 ? "2.5k" : i == 2 ? "5k" : i == 3 ? "10k" : i == 4 ? "20k" : "40k");
    ui_clicked(tx, ty, 52 * s, 15 * s) ? (Lf_AirType = i; slider_automate(Lf_AirType));
    ty += 16 * s;
    i += 1;
  );
  cx += sp + 64 * s;
  v = lf_knob(6, cx, cy, "TRIM", Lf_Trim, -20, 20, 1, 0.1, 0, "%.1f", "dB");
  v != Lf_Trim ? (Lf_Trim = v; slider_automate(Lf_Trim));
  gfx_setfont(FONT_BASE);
);

/*
 * ===================================================================================================
 * ReEQ3 Tonal Balance: targets, the overlay on the graph, the panel, matching and remote editing
 * ===================================================================================================
 */

// A target file (as the ReEQ3 Save Tonal Target action writes it): a header line, the name, then
// TB_TSIZE numbers one per line. Returns 1 when it loaded.
function tb_load_file(path) local(h, i, v, ok) (
  ok = 0;
  h = file_open(path);
  h >= 0 ? (
    file_text(h) ? (
      #tb_l1 = ""; file_string(h, #tb_l1); #tb_l2 = ""; file_string(h, #tb_l2);
      str_trim(#tb_l1); str_trim(#tb_l2);
      !strncmp(#tb_l1, "ReEQ3 tonal target", 18) ? (
        i = 0;
        while (i < TB_TSIZE && file_avail(h) > 0) (v = 0; file_var(h, v); TB_TMP[i] = v; i += 1);
        i >= TB_TSIZE - 3 && TB_TMP[TB_OVALID] == 1 ? (
          memcpy(TBT, TB_TMP, TB_TSIZE); strcpy(#TB_Name, #tb_l2); TB_Target = 0; TB_Ver += 1; ok = 1;
        );
      );
    );
    file_close(h);
  );
  ok;
);

// The library: Data/ReEQ3/Targets/index.txt, one name per line (the files are <name>.txt beside it)
function tb_lib_read() local(h) (
  TB_LibN = 0;
  h = file_open("ReEQ3/Targets/index.txt");
  h >= 0 ? (
    file_text(h) ? while (file_avail(h) > 0 && TB_LibN < 40) (
      #tb_ll = ""; file_string(h, #tb_ll); str_trim(#tb_ll);
      strlen(#tb_ll) > 0 ? (strcpy(960 + TB_LibN, #tb_ll); TB_LibN += 1);
    );
    file_close(h);
  );
  TB_LibN;
);

function tb_set_factory(k) (
  tb_factory(k, TBT); TB_Target = k; TB_Learn = 0; TB_FA = 0; TB_Ver += 1;
  #TB_Name = k == 1 ? "Modern" : k == 2 ? "Bass Heavy" : k == 3 ? "Acoustic / Orchestral" : "Pink noise";
);

/*
 * Building a target from dropped audio files, a slice per frame (strings 900.. hold their paths):
 * 3 s segments of 50%-overlapped transforms, the low end's crest per segment
 */
function tb_fa_start() (
  TB_Learn = 0;
  tb_stats_clear();
  TB_FA = 1; TB_FA_I = 0; TB_FA_H = -1; TB_FA_Files = 0; TB_FA_Bad = 0;
);
function tb_fa_seg() local(i, cr) (
  TB_FA_SegN > 0 ? (
    i = 0; loop(TB_PTS, TB_FSEG[i] /= TB_FA_SegN; i += 1);
    cr = TB_FCN > 0 && TB_FCMs / TB_FCN > 0.0000001 ? 20 * log10(TB_FCPk / sqrt(TB_FCMs / TB_FCN)) : -1;
    tb_stats_add(TB_FSEG, cr);
  );
  memset(TB_FSEG, 0, TB_PTS); TB_FA_SegN = 0; TB_FCPk = TB_FCMs = TB_FCN = 0;
);
function tb_fa_name(dst, path) local(i, n, c, a, e) (
  n = strlen(path); a = 0; e = n; i = 0;
  loop(n, c = str_getchar(path, i); c == '/' || c == '\\' ? a = i + 1; c == '.' ? e = i; i += 1);
  e <= a ? e = n;
  strcpy_substr(dst, path, a, e - a);
);
function tb_fa_step() local(ch, sr, n, i, x, y, t0) (
  t0 = time_precise();
  while (TB_FA && time_precise() - t0 < 0.03) (
    TB_FA_H < 0 ? (
      TB_FA_I >= TB_FA_N ? (
        // Done: the statistics become the target
        TB_FA = 0;
        tb_stats_write(TBT, TB_FA_Files, TB_SMG) ? (
          tb_fa_name(#TB_Name, 900);
          TB_FA_Files > 1 ? strcat(#TB_Name, sprintf(#, " +%d", TB_FA_Files - 1));
          TB_Target = 0; TB_Ver += 1; TB_Msg = 0;
        ) : TB_Msg = 1;
      ) : (
        TB_FA_H = file_open(900 + TB_FA_I);
        ch = sr = 0;
        TB_FA_H >= 0 ? file_riff(TB_FA_H, ch, sr);
        TB_FA_H >= 0 && ch >= 1 && sr >= 8000 ? (
          TB_FA_Ch = ch; TB_FA_Sr = sr;
          TB_FA_Nfft = sr > 100000 ? 16384 : sr > 50000 ? 8192 : 4096;
          TB_FA_Pos = 0; TB_FA_Tot = max(file_avail(TB_FA_H), 1); TB_FA_Done = 0;
          TB_FA_SegLen = ceil(3 * sr / (TB_FA_Nfft / 2));
          memset(TB_FSEG, 0, TB_PTS); TB_FA_SegN = 0; TB_FCPk = TB_FCMs = TB_FCN = 0;
          tbfa.tb_bq(0, 250, sr); tbfb.tb_bq(0, 250, sr); tbfa.tb_zero(); tbfb.tb_zero();
        ) : (
          TB_FA_H >= 0 ? file_close(TB_FA_H);
          TB_FA_H = -1; TB_FA_I += 1; TB_FA_Bad += 1;
        );
      );
    ) : (
      n = min(file_avail(TB_FA_H), floor(131072 / TB_FA_Ch) * TB_FA_Ch);
      n = floor(n / TB_FA_Ch) * TB_FA_Ch;
      n > 0 ? (
        file_mem(TB_FA_H, TB_RD, n);
        TB_FA_Done += n;
        i = 0;
        loop(n / TB_FA_Ch,
          x = TB_FA_Ch >= 2 ? (TB_RD[i] + TB_RD[i + 1]) * 0.5 : TB_RD[i];
          y = tbfb.tb_tick(tbfa.tb_tick(x));
          TB_FCPk = max(TB_FCPk, abs(y)); TB_FCMs += y * y; TB_FCN += 1;
          TB_FB[TB_FA_Pos] = x;
          (TB_FA_Pos += 1) >= TB_FA_Nfft ? (
            tb_measure_lin(TB_FB, TB_FA_Nfft, TB_FA_Sr, TB_FSEG, 1);
            TB_FA_SegN += 1;
            memcpy(TB_FB, TB_FB + TB_FA_Nfft / 2, TB_FA_Nfft / 2);
            TB_FA_Pos = TB_FA_Nfft / 2;
            TB_FA_SegN >= TB_FA_SegLen ? tb_fa_seg();
          );
          i += TB_FA_Ch;
        );
      ) : (
        // The end: a last segment of at least a second counts
        TB_FA_SegN >= TB_FA_SegLen / 3 ? tb_fa_seg();
        file_close(TB_FA_H); TB_FA_H = -1; TB_FA_I += 1; TB_FA_Files += 1;
      );
    );
  );
);

// Files dropped on the window: audio builds a target, a .txt target file loads
function tb_drop() local(k, n, e) (
  k = 0; n = 0;
  while (gfx_getdropfile(k, #tb_dp)) (
    e = strlen(#tb_dp);
    e > 4 && !stricmp(strcpy_substr(#tb_de, #tb_dp, e - 4, 4), ".txt") ? (
      tb_load_file(#tb_dp) ? (TB_Learn = 0; TB_FA = 0) : TB_Msg = 2;
    ) : n < 32 ? (
      strcpy(900 + n, #tb_dp); n += 1;
    );
    k += 1;
  );
  k > 0 ? (
    gfx_getdropfile(-1);
    ui_tb_show = 1; ui_lf_show = 0;
    n > 0 ? (TB_FA_N = n; tb_fa_start());
  );
);

// The target menu
function tb_menu() local(k, i, nlib) (
  nlib = tb_lib_read();
  #tb_m = sprintf(#, "%sModern|%sBass Heavy|%sAcoustic / Orchestral|%sPink noise||>Library",
    TB_Target == 1 ? "!" : "", TB_Target == 2 ? "!" : "", TB_Target == 3 ? "!" : "", TB_Target == 4 ? "!" : "");
  nlib == 0 ? strcat(#tb_m, "|<#(empty: save one with the action ReEQ3 Save Tonal Target)") : (
    i = 0;
    loop(nlib, strcat(#tb_m, i == nlib - 1 ? "|<" : "|"); strcat(#tb_m, 960 + i); i += 1);
  );
  strcat(#tb_m, sprintf(#, "||%sLearn from this input (while playing)|%sLearn from the output|%sLearn from the sidechain (pins 3/4)",
    TB_Learn == 1 ? "!" : "", TB_Learn == 2 ? "!" : "", TB_Learn == 3 ? "!" : ""));
  strcat(#tb_m, "||#Drop audio files on the window to build a target from them");
  gfx_x = ui_tb_mx; gfx_y = ui_tb_my;
  k = gfx_showmenu(#tb_m);
  // Items: 4 factory, the library (or its one placeholder), 3 learn, the hint
  k >= 1 && k <= 4 ? tb_set_factory(k) :
  k > 4 && k <= 4 + max(nlib, 1) ? (
    nlib > 0 ? (
      #tb_lp = "ReEQ3/Targets/"; strcat(#tb_lp, 960 + k - 5); strcat(#tb_lp, ".txt");
      tb_load_file(#tb_lp) ? (TB_Learn = 0; TB_FA = 0) : TB_Msg = 2;
    );
  ) : k > 4 + max(nlib, 1) && k <= 7 + max(nlib, 1) ? (
    k -= 4 + max(nlib, 1);
    TB_Learn == k ? TB_Learn = 0 : tb_learn_start(k);
  );
);

// For the Save Tonal Target action: this target, its name and this instance's tag, while the panel shows
function tb_export() local(b, n, i) (
  b = GM_TBX;
  gmem[b] = time_precise(); gmem[b + 1] = Instance_Tag;
  n = min(strlen(#TB_Name), 60); gmem[b + 2] = n;
  i = 0; loop(n, gmem[b + 3 + i] = str_getchar(#TB_Name, i); i += 1);
  i = 0; loop(TB_TSIZE, gmem[b + 100 + i] = TBT[i]; i += 1);
);

// The fit to the target: what would bring the output to the target's mean, as bells
function tb_fit(nb) local(i, f, v) (
  i = 0;
  loop(PUB_PTS,
    f = pub_freq(i);
    v = TBT[TB_OVALID] && TB_LiveN > 0 && f > 25 && f < min(18000, srate * 0.45);
    EQM_FIT[i] = v; EQM_DIFF[i] = v ? -TB_DEV[i] : 0;
    i += 1;
  );
  eqm_fit_diff(nb);
  TB_Fitted = EQM_Fitted; EQM_Fitted = 0;
);

/*
 * Remote editing, the controlling side: the watched instance's slot, sending commands
 */
function rm_slot() ( TB_Rmt != 0 ? pub_find(TB_Rmt) : -1; );
function rm_send(op, b, en, grp, ty, f, g, q, sl) local(r, k, c) (
  TB_RmS >= 0 ? (
    r = GM_RMT + TB_RmS * RM_SLOT;
    k = gmem[r + 2];
    k - gmem[r + 3] < 8 ? (
      c = r + RM_CMD + (k % 8) * 12;
      gmem[c] = op; gmem[c + 1] = b; gmem[c + 2] = en; gmem[c + 3] = grp; gmem[c + 4] = ty;
      gmem[c + 5] = f; gmem[c + 6] = g; gmem[c + 7] = q; gmem[c + 8] = sl;
      gmem[r + 2] = k + 1;
      1;
    ) : 0;
  ) : 0;
);
function rm_has_gain(t) (
  !(t == 1 || t == 2 || t == 5 || t == 6 || t == 7 || t == 8 || t == 11 || t == 12 || t == 13);
);
function rm_node_y(k) local(t) (
  t = TB_RMB[k + 2];
  max(db_to_y(rm_has_gain(t) ? TB_RMB[k + 4] : 0), TOP_MARGIN);
);
// The watched instance's bands into TB_RMB (the band being dragged keeps its own values)
function rm_pull() local(r, b, j) (
  r = GM_RMT + TB_RmS * RM_SLOT;
  b = 0;
  loop(NUM_BANDS,
    b != TB_RmDrag ? (j = 0; loop(8, TB_RMB[b * 8 + j] = gmem[r + RM_BANDS + b * 8 + j]; j += 1));
    b += 1;
  );
);
function rm_send_band(b) local(k) (
  k = b * 8;
  rm_send(1, b, TB_RMB[k], TB_RMB[k + 1], TB_RMB[k + 2], TB_RMB[k + 3], TB_RMB[k + 4], TB_RMB[k + 5], TB_RMB[k + 6]);
);
function rm_hit() local(b, d, best, bi, k) (
  best = sqr(ui_pt(11)); bi = -1; b = 0;
  loop(NUM_BANDS,
    k = b * 8;
    TB_RMB[k] != BAND_STATE_OFF ? (
      d = sqr(mouse_x - freq_to_scx(TB_RMB[k + 3])) + sqr(mouse_y - rm_node_y(k));
      d < best ? (best = d; bi = b);
    );
    b += 1;
  );
  bi;
);
// The mouse over the graph while editing another instance: drag a node (frequency, and gain where it has
// one), the wheel for its Q, a right-click removes it, a double-click on empty graph adds a bell
function rm_mouse(wd) local(b, k, f, g, now) (
  now = time_precise();
  ui_press ? (
    b = rm_hit();
    b >= 0 ? (TB_RmDrag = b; TB_RmSel = b) : (
      now - TB_RmLastClick < 0.35 && abs(mouse_x - TB_RmCX) < 5 && abs(mouse_y - TB_RmCY) < 5 ? (
        rm_send(2, -1, 0, 0, 0, min(max(scx_to_freq(mouse_x), 20), 20000), min(max(y_to_db(mouse_y), -30), 30), 1, 1);
        TB_RmLastClick = 0;
      ) : (TB_RmLastClick = now; TB_RmCX = mouse_x; TB_RmCY = mouse_y);
    );
  );
  TB_RmDrag >= 0 && (mouse_cap & 1) ? (
    k = TB_RmDrag * 8;
    f = min(max(scx_to_freq(mouse_x), 20), min(20000, 0.45 * srate));
    g = rm_has_gain(TB_RMB[k + 2]) ? min(max(floor(y_to_db(mouse_y) * 10 + 0.5) / 10, -30), 30) : TB_RMB[k + 4];
    f != TB_RMB[k + 3] || g != TB_RMB[k + 4] ? (TB_RMB[k + 3] = f; TB_RMB[k + 4] = g; rm_send_band(TB_RmDrag));
  );
  !(mouse_cap & 1) ? TB_RmDrag = -1;
  wd != 0 && (b = rm_hit()) >= 0 ? (
    k = b * 8;
    TB_RMB[k + 5] = min(max(TB_RMB[k + 5] * 2 ^ (wd > 0 ? 0.1 : -0.1), 0.1), 40);
    rm_send_band(b);
  );
  ui_rpress && (b = rm_hit()) >= 0 ? (rm_send(3, b, 0, 0, 0, 0, 0, 0, 0); TB_RMB[b * 8] = BAND_STATE_OFF);
);
function rm_draw() local(r, i, x, y, lx, ly, b, k, sz, bottom) (
  r = GM_RMT + TB_RmS * RM_SLOT;
  bottom = gfx_h - BOTTOM_MARGIN - gfx_texth;
  // Its curve, in the accent colour
  ui_col(T_ACCENT); lx = -1; i = 0;
  loop(TB_PTS,
    pub_freq(i) < srate * 0.5 ? (
      x = pub_x(i); y = min(db_to_y(gmem[r + RM_CURVE + i]), bottom);
      lx >= 0 ? ui_thick_line(lx, ly, x, y, ui_pt(2));
      lx = x; ly = y;
    );
    i += 1;
  );
  // Its nodes, in their bands' colours
  b = 0;
  loop(NUM_BANDS,
    k = b * 8;
    TB_RMB[k] != BAND_STATE_OFF ? (
      x = freq_to_scx(TB_RMB[k + 3]); y = rm_node_y(k);
      sz = b == TB_RmSel ? ui_pt(8) : ui_pt(7);
      ui_band_col(b); gfx_a = TB_RMB[k] == BAND_STATE_ENABLED ? 1 : 0.35;
      gfx_circle(x, y, sz, 1, 1);
      ui_cola(b == TB_RmSel ? T_HIGHLIGHT : T_NODE_EDGE, 1); gfx_circle(x, y, sz, 0, 1);
      gfx_setfont(FONT_NODE); ui_col(T_BADGE_TEXT); ui_text_at(x, y, sprintf(#, "%d", b + 1));
    );
    b += 1;
  );
  // What's being edited
  gfx_setfont(FONT_CAP_B); ui_col(T_ACCENT);
  #tb_rn = "EDITING  "; strcat(#tb_rn, inst_name(#tb_rn2, TB_RmS));
  ui_text_l(ui_pt(14), TOP_MARGIN + ui_pt(4), ui_pt(16), #tb_rn);
  gfx_setfont(FONT_BASE);
);

/*
 * The overlay on the graph: the target's range and the output's average. Spectrum: on the analyser's
 * scale (per-hertz levels, lined up with the analyser on this instance's output). Leveled: the output
 * against the target on the EQ's dB scale, so a bump above the band is a cut to make.
 */
function tb_draw_overlay() local(i, f, x, lx, t0, t1, b0, b1, y, ly, d, n, acc, bottom, m, sd, dn, a0, x0) (
  TBT[TB_OVALID] ? (
    bottom = gfx_h - BOTTOM_MARGIN - gfx_texth;
    TB_View == 1 ? (
      pub_calibrate();
      // Line up with the analyser: the median gap over 100Hz..8kHz, eased
      n = 0; i = 0;
      loop(TB_PTS,
        f = tb_freq(i);
        f > 100 && f < 8000 && PUB_POST_DB[i] > -80 && TB_LiveN > 0 ? (TB_TMP[n] = PUB_POST_DB[i] - (TB_UD[i] - 10 * log10(f / 1000)); n += 1);
        i += 1;
      );
      n > 20 ? (
        i = 1;
        loop(n - 1, m = TB_TMP[i]; d = i - 1; while (d >= 0 && TB_TMP[d] > m) (TB_TMP[d + 1] = TB_TMP[d]; d -= 1); TB_TMP[d + 1] = m; i += 1);
        TB_OffOk ? TB_Off += 0.08 * (TB_TMP[floor(n / 2)] - TB_Off) : (TB_Off = TB_TMP[floor(n / 2)]; TB_OffOk = 1);
      );
      !TB_OffOk ? TB_Off = -30;
    );
    // The range
    ui_col(T_ACCENT);
    lx = -1; i = 0;
    loop(TB_PTS,
      f = tb_freq(i);
      f < srate * 0.5 ? (
        x = pub_x(i); m = TBT[TB_OM + i]; sd = TBT[TB_OS + i];
        TB_View == 1 ? (
          dn = TB_Off - 10 * log10(f / 1000);
          t1 = min(pub_y(m + sd + dn, f), bottom); b1 = min(pub_y(m - sd + dn, f), bottom);
        ) : (t1 = min(db_to_y(sd), bottom); b1 = min(db_to_y(-sd), bottom));
        lx >= 0 ? (gfx_a = 0.16; gfx_triangle(lx, t0, x, t1, x, b1, lx, b0));
        lx = x; t0 = t1; b0 = b1;
      );
      i += 1;
    );
    // The target's mean, dotted
    TB_View == 1 ? (
      gfx_a = 0.5; i = 0;
      loop(TB_PTS / 2, f = tb_freq(2 * i); f < srate * 0.5 ? gfx_circle(pub_x(2 * i), min(pub_y(TBT[TB_OM + 2 * i] + TB_Off - 10 * log10(f / 1000), f), bottom), 0.6, 1, 1); i += 1);
    );
    // The bands' edges
    ui_col(T_ACCENT); gfx_a = 0.25;
    x0 = freq_to_scx(250); gfx_line(x0, TOP_MARGIN, x0, bottom, 0);
    x0 = freq_to_scx(2000); gfx_line(x0, TOP_MARGIN, x0, bottom, 0);
    x0 = freq_to_scx(8000); gfx_line(x0, TOP_MARGIN, x0, bottom, 0);
    // The output's average, white
    TB_LiveN > 0 ? (
      ui_col(T_HIGHLIGHT); a0 = 0.95;
      lx = -1; i = 0;
      loop(TB_PTS,
        f = tb_freq(i);
        f < srate * 0.5 ? (
          x = pub_x(i);
          y = TB_View == 1 ? pub_y(TB_UD[i] + TB_Off - 10 * log10(f / 1000), f) : db_to_y(TB_DEV[i]);
          y = min(max(y, TOP_MARGIN), bottom);
          gfx_a = abs(TB_DEV[i]) > TBT[TB_OS + i] ? a0 : a0 * 0.75;
          lx >= 0 ? ui_thick_line(lx, ly, x, y, ui_pt(1.6));
          lx = x; ly = y;
        );
        i += 1;
      );
    );
    gfx_a = 1;
  );
  // The match's preview: its bells' curve
  TB_Fitted && EQM_FitN > 0 && ui_tb_show ? (
    ui_col(T_ACCENT); gfx_a = 0.9;
    lx = -1; i = 0;
    loop(PUB_PTS,
      f = pub_freq(i);
      acc = 0; n = 0; loop(EQM_FitN, acc += eqm_bell_db(f, EQM_FF[n], EQM_FQ[n], EQM_FG[n]); n += 1);
      x = pub_x(i); y = db_to_y(acc);
      lx >= 0 && (i % 2) ? gfx_line(lx, ly, x, y, 1);
      lx = x; ly = y; i += 1;
    );
    gfx_a = 1;
  );
);

/*
 * The panel: header (target, view, averaging), the broad bands (hold a band's name to solo it), the
 * low end's crest factor, status, and matching (which EQ, how many bands, preview and apply)
 */
function tb_bar(x, y, w, h, b, dv, sd, inb) local(s, sc, cy, yy, t, hov, lab) (
  s = ui_pt(1);
  lab = b == 0 ? "LOW" : b == 1 ? "LOW-MID" : b == 2 ? "HIGH-MID" : "HIGH";
  hov = ui_in(x, y, w, 16 * s);
  ui_press && hov && ui_free() ? TB_SoloHold = b;
  gfx_setfont(inb ? FONT_CAP_B : FONT_CAP);
  ui_col(TB_SoloReq == b ? T_ACCENT : inb && TB_LiveN > 0 ? T_HIGHLIGHT : hov ? T_TEXT : T_TEXT_DIM);
  ui_text_c(x, y, w, 16 * s, TB_SoloReq == b ? "SOLO" : lab);
  // +-8 dB around the target's mean
  t = y + 18 * s; yy = h - 18 * s; cy = t + yy * 0.5; sc = yy / 16;
  ui_box(x + w * 0.3, t, w * 0.4, yy, 3 * s, T_CONTROL, 1, T_BORDER_SUBTLE);
  ui_cola(T_ACCENT_FILL, 1); gfx_rect(x + w * 0.3 + 1, cy - sd * sc, w * 0.4 - 2, 2 * sd * sc);
  ui_cola(T_ACCENT_BORDER, 1); gfx_line(x + w * 0.3 + 1, cy, x + w * 0.7 - 2, cy, 0);
  TB_LiveN > 0 ? (
    yy = min(max(cy - dv * sc, t + 1), t + h - 18 * s - 2);
    ui_col(T_HIGHLIGHT); ui_thick_line(x + w * 0.22, yy, x + w * 0.78, yy, ui_pt(2));
    gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
    gfx_x = x + w * 0.8; gfx_y = yy - gfx_texth * 0.5; gfx_drawstr(sprintf(#, "%+.1f", dv));
  );
);

function ui_draw_tb_panel() local(s, x, y, w, h, hy, hh, bx, bw, k, i, cx, cw, by, bh, lo, hi, sc, px, t, nm, slot, pr) (
  s = ui_pt(1);
  w = floor(min(820 * s, gfx_w - 8 * s)); h = panel_h;
  x = floor(gfx_w / 2 - w / 2); y = panel_y;
  ui_tb_x = x; ui_tb_w = w;
  pr = ui_press && ui_free();
  ui_cola(T_PANEL, 1); ui_fill_rrect(x, y, w, h, 8 * s);
  ui_cola(T_BORDER, 1); gfx_roundrect(x, y, w - 1, h - 1, 8 * s, 1);
  ui_cola(T_ACCENT_BORDER, 1); gfx_line(x + 8 * s, y, x + w - 8 * s, y, 1);

  // Header: name, target, view, averaging, close
  hy = y + 6 * s; hh = 24 * s;
  gfx_setfont(FONT_BODY_B); ui_col(T_ACCENT);
  ui_text_l(x + 14 * s, hy, hh, "TONAL BALANCE");
  bx = x + 14 * s + ui_text_w("TONAL BALANCE") + 12 * s;
  bw = 200 * s;
  #tb_tl = TB_Learn ? "● " : ""; strcat(#tb_tl, #TB_Name);
  ui_dropdown(bx, hy, bw, hh, #tb_tl, 0) ? (ui_tb_mx = bx; ui_tb_my = hy + hh; tb_menu());
  bx += bw + 10 * s;
  k = ui_segn(bx, hy, 170 * s, hh, 3, TB_View, pr, "Off", "Spectrum", "Leveled", "", "");
  k >= 0 ? TB_View = k;
  bx += 170 * s + 10 * s;
  k = ui_segn(bx, hy, 110 * s, hh, 3, TB_Avg, pr, "3 s", "10 s", "∞", "", "");
  k >= 0 ? (TB_Avg = k; TB_ResetReq = 1);
  bx += 110 * s + 6 * s;
  ui_button(bx, hy, 52 * s, hh, "Reset", 0) ? TB_ResetReq = 1;
  ui_icon_button(x + w - 10 * s - 26 * s, hy, 26 * s, hh, 10, 0) ? ui_tb_show = 0;
  ui_col(T_BORDER_SUBTLE);
  gfx_line(x + 12 * s, y + 36 * s, x + w - 12 * s, y + 36 * s, 0);

  // Broad view
  by = y + 42 * s; bh = h - 50 * s;
  cw = 64 * s; cx = x + 12 * s;
  tb_bar(cx, by, cw, bh, 0, TB_BD0, TBT[TB_OBS], TB_IN0); cx += cw;
  tb_bar(cx, by, cw, bh, 1, TB_BD1, TBT[TB_OBS + 1], TB_IN1); cx += cw;
  tb_bar(cx, by, cw, bh, 2, TB_BD2, TBT[TB_OBS + 2], TB_IN2); cx += cw;
  tb_bar(cx, by, cw, bh, 3, TB_BD3, TBT[TB_OBS + 3], TB_IN3); cx += cw;
  !(mouse_cap & 1) ? TB_SoloHold = -1;
  TB_SoloReq = TB_SoloHold;

  // The low end's crest factor, 4..24 dB, its target range
  cx += 14 * s; cw = 230 * s;
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_SECONDARY);
  ui_text_l(cx, by, 16 * s, "LOW-END CREST FACTOR");
  t = by + 20 * s; lo = 4; hi = 24; sc = cw / (hi - lo);
  ui_box(cx, t, cw, 14 * s, 3 * s, T_CONTROL, 1, T_BORDER_SUBTLE);
  ui_cola(T_ACCENT_FILL, 1);
  px = cx + (min(max(TBT[TB_OCM] - TBT[TB_OCS], lo), hi) - lo) * sc;
  gfx_rect(px, t + 1, (min(max(TBT[TB_OCM] + TBT[TB_OCS], lo), hi) - lo) * sc + cx - px, 14 * s - 2);
  TB_CrestOk ? (
    px = cx + (min(max(TB_Crest, lo), hi) - lo) * sc;
    ui_col(T_HIGHLIGHT); ui_thick_line(px, t - 2 * s, px, t + 16 * s, ui_pt(2));
  );
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(cx, t + 16 * s, 14 * s, "dynamic");
  gfx_x = cx; gfx_y = t + 16 * s; gfx_drawstr("compressed", 2 | 4, cx + cw, t + 30 * s);
  gfx_setfont(FONT_BODY_B); ui_col(T_TEXT);
  ui_text_l(cx, t + 34 * s, 18 * s, TB_CrestOk ? sprintf(#, "%.1f dB", TB_Crest) : "—");
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  TB_CrestOk ? (
    ui_text_l(cx + 70 * s, t + 34 * s, 18 * s,
      TB_Crest > TBT[TB_OCM] + TBT[TB_OCS] ? "more dynamic than the target" :
      TB_Crest < TBT[TB_OCM] - TBT[TB_OCS] ? "more compressed than the target" : "within the target");
  );
  // Status: what the target is, or what's going on
  t += 58 * s;
  gfx_setfont(FONT_CAP); ui_col(TB_Msg ? T_DANGER : T_TEXT_DIM);
  TB_FA ? (
    sprintf(#tb_st, "Analysing file %d of %d · %d%%", TB_FA_I + 1, TB_FA_N, TB_FA_H >= 0 ? floor(100 * TB_FA_Done / TB_FA_Tot) : 0);
  ) : TB_Learn ? (
    sprintf(#tb_st, "Learning · %d segments (%d s) · click the target to stop", TBT[TB_OSEG] * TBT[TB_OVALID], 3 * TBT[TB_OSEG] * TBT[TB_OVALID]);
  ) : TB_Msg == 1 ? strcpy(#tb_st, "Nothing usable in those files (silent, or not audio)") :
      TB_Msg == 2 ? strcpy(#tb_st, "That isn't a ReEQ3 tonal target file") :
      TB_Target > 0 ? strcpy(#tb_st, "Factory shape: drawn up, not measured") :
      TBT[TB_OFILES] > 0 ? sprintf(#tb_st, "From %d file%s · %d segments", TBT[TB_OFILES], TBT[TB_OFILES] > 1 ? "s" : "", TBT[TB_OSEG]) :
      sprintf(#tb_st, "%d segments", TBT[TB_OSEG]);
  ui_text_l(cx, t, 14 * s, #tb_st);
  TB_FA_Bad > 0 && !TB_FA ? (t += 14 * s; ui_text_l(cx, t, 14 * s, sprintf(#, "%d file%s couldn't be read", TB_FA_Bad, TB_FA_Bad > 1 ? "s" : "")));

  // Matching: which EQ, how many bells, preview, apply
  cx += cw + 18 * s; cw = x + w - 12 * s - cx;
  ui_col(T_BORDER_SUBTLE); gfx_line(cx - 9 * s, by, cx - 9 * s, by + bh, 0);
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_SECONDARY);
  ui_text_l(cx, by, 16 * s, "MATCH TO TARGET");
  slot = rm_slot();
  TB_Rmt != 0 && slot < 0 ? (TB_Rmt = 0);
  #tb_eq = "EQ: "; strcat(#tb_eq, TB_Rmt ? inst_name(#tb_en, slot) : "this instance");
  ui_dropdown(cx, by + 18 * s, cw, 22 * s, #tb_eq, 0) ? (
    // This instance, then the others running
    #tb_im = TB_Rmt == 0 ? "!This instance" : "This instance"; TB_IMN = 0; i = 0;
    loop(GM_SLOTS,
      gmem[GM_REG + i * GM_SLOT + 1] != 0 && gmem[GM_REG + i * GM_SLOT + 1] != Instance_Tag && time_precise() - gmem[GM_REG + i * GM_SLOT] < 30 ? (
        strcat(#tb_im, gmem[GM_REG + i * GM_SLOT + 1] == TB_Rmt ? "|!" : "|"); strcat(#tb_im, inst_name(#tb_en, i));
        INST_ROWS[TB_IMN] = i; TB_IMN += 1;
      );
      i += 1;
    );
    gfx_x = cx; gfx_y = by + 40 * s;
    k = gfx_showmenu(#tb_im);
    k == 1 ? TB_Rmt = 0 : k > 1 ? (TB_Rmt = gmem[GM_REG + INST_ROWS[k - 2] * GM_SLOT + 1]; TB_RmDrag = -1; TB_RmSel = -1);
    TB_Fitted = 0;
  );
  k = ui_segn(cx, by + 46 * s, cw, 22 * s, 4, TB_MBands == 4 ? 0 : TB_MBands == 6 ? 1 : TB_MBands == 8 ? 2 : 3, pr, "4", "6", "8", "12", "");
  k >= 0 ? (TB_MBands = k == 0 ? 4 : k == 1 ? 6 : k == 2 ? 8 : 12; TB_Fitted ? tb_fit(TB_MBands));
  bw = (cw - 6 * s) / 2;
  ui_button(cx, by + 74 * s, bw, 24 * s, TB_Fitted ? "Hide" : "Preview", TB_Fitted ? 1 : 0) ? (
    TB_Fitted ? TB_Fitted = 0 : tb_fit(TB_MBands);
  );
  ui_button(cx + bw + 6 * s, by + 74 * s, bw, 24 * s, "Apply", 0) ? (
    !TB_Fitted ? tb_fit(TB_MBands);
    TB_Fitted && EQM_FitN > 0 ? (
      TB_Rmt == 0 ? eqm_apply() : (
        TB_RmS = slot; k = 0;
        loop(EQM_FitN, rm_send(2, -1, 0, 0, 0, EQM_FF[k], EQM_FG[k], EQM_FQ[k], 1); k += 1);
      );
      TB_Fitted = 0;
    );
  );
  gfx_setfont(FONT_BASE);
);

/*
 * ReEQ3: the Processing popover, from the toolbar: Zero Latency or Linear Phase and its resolution, the
 * Character and its oversampling, with the latency they add
 */
function ui_draw_proc_pop() local(s, pad, pw, ph, px, py, x, y, w, pr, skip, k, lat, inpop) (
  s = ui_pt(1);
  skip = ui_pop_skip; ui_pop_skip = 0;
  pr = ui_press && !skip;
  ui_pop_x = ui_bar_px; ui_pop_y = ui_bar_py; ui_pop_w = ui_bar_pw;
  pad = 11 * s; pw = 360 * s;
  ph = 30 * s + 10 * s + (22 * s + 8 * s) * 4 + 8 * s + 1 + 8 * s + 14 * s * 3 + 11 * s;
  px = floor(max(4 * s, min(ui_bar_px, gfx_w - pw - 4 * s)));
  py = ui_pop_frame(px, pw, ph);
  inpop = ui_in(px, py, pw, ph);
  lat = (LP_On ? LP_LAT : la_len) + (Character > 0 && Quality ? 15 : 0);
  ui_pop_head(px, py, pw, "Processing", lat > 0 ? sprintf(#, "Latency %.1f ms", 1000 * lat / srate) : "No latency");

  x = px + pad; w = pw - 2 * pad; y = py + 30 * s + 10 * s;
  k = ui_prow(x, y, w, "MODE", 2, Proc_Mode, pr, "Zero Latency", "Linear Phase", "", "", "");
  k >= 0 && k != Proc_Mode ? (Proc_Mode = k; slider_automate(Proc_Mode));
  y += 22 * s + 8 * s;
  k = ui_prow(x, y, w, "RESOLUTION", 4, LP_Res, pr, "Low", "Medium", "High", "Very High", "");
  k >= 0 && k != LP_Res ? (LP_Res = k; slider_automate(LP_Res));
  y += 22 * s + 8 * s;
  k = ui_prow(x, y, w, "CHARACTER", 3, Character, pr, "Clean", "Subtle", "Warm", "", "");
  k >= 0 && k != Character ? (Character = k; slider_automate(Character));
  y += 22 * s + 8 * s;
  k = ui_prow(x, y, w, "OVERSAMPLE", 2, Quality ? 1 : 0, pr, "Off", "2x", "", "", "");
  k >= 0 && k != Quality ? (Quality = k; slider_automate(Quality));
  y += 22 * s + 8 * s;
  ui_col(T_BORDER_SUBTLE); gfx_line(x, y, x + w, y, 0);
  y += 1 + 8 * s;
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(x, y, 14 * s, "Linear Phase: no phase shift, at the resolution's latency.");
  ui_text_l(x, y + 14 * s, 14 * s, "Spectral bands always run at that resolution.");
  ui_text_l(x, y + 28 * s, 14 * s, "Character: analogue-style saturation (2x adds 15 samples).");

  ui_top_pop_close(px, py, pw, ph, pr, skip);
  gfx_setfont(FONT_BASE);
);

/*
 * The credits, opened from the wordmark: a rounded card in the middle of the window over a dimmed
 * view. OK, a press outside it or Escape closes it.
 */
function ui_draw_credits()
  local(s, pr, rpr, inside, cw, ch, cx, cy, x, y, w1, w2, w3, mid, t, zt, zb, n, colw, i, u, e, hh, cr, cg, cb, x0, w0, y0, h1, h2, a1,
        okw, okh, okx, oky, hov)
(
  s = ui_pt(1);
  pr = ui_press && !ui_pop_skip; rpr = ui_rpress && !ui_pop_skip; ui_pop_skip = 0;

  ui_cola(T_SCRIM, 1);
  gfx_rect(0, 0, gfx_w, gfx_h);

  cw = 360 * s; ch = 404 * s;
  cx = floor(gfx_w * 0.5 - cw * 0.5); cy = floor(max(4 * s, gfx_h * 0.5 - ch * 0.5));
  mid = cx + cw * 0.5;
  inside = ui_in(cx, cy, cw, ch);
  ui_box(cx, cy, cw, ch, 12 * s, T_POPOVER, 0.97, T_BORDER);

  // Behind the wordmark: soft spectrum columns in the band colours, breathing, fading out towards the
  // sides, and kept above the descriptor. Each column fades in from its top, then thins towards its foot.
  t = time_precise();
  zt = cy + 12 * s; zb = cy + 66 * s;
  n = 48; colw = cw / n;
  i = 0;
  loop(n,
    u = (i + 0.5) / n;
    e = min(1, min(u, 1 - u) / 0.25);
    hh = (0.35 + 0.65 * abs(sin(u * 9 + t / 0.7) * sin(u * 3.3 - t / 1.1))) * (zb - zt) * 0.85;
    ui_band_col(floor(u * 5) % 5); cr = gfx_r; cg = gfx_g; cb = gfx_b;
    x0 = floor(cx + i * colw + 1); w0 = max(1, floor(colw - 2));
    y0 = zb - hh; h1 = max(1, floor(hh * 0.35)); h2 = max(1, floor(hh - h1));
    a1 = 0.16 * e;
    gfx_gradrect(x0, floor(y0), w0, h1, cr, cg, cb, 0, 0, 0, 0, 0, 0, 0, 0, a1 / h1);
    gfx_gradrect(x0, floor(y0) + h1, w0, h2, cr, cg, cb, a1, 0, 0, 0, 0, 0, 0, 0, (0.05 * e - a1) / h2);
    i += 1;
  );

  // The wordmark at twice its header size
  gfx_setfont(FONT_LOGO); w1 = ui_text_w("Re");
  gfx_setfont(FONT_LOGO_B); w2 = ui_text_w("EQ");
  gfx_setfont(FONT_LOGO_SUP); w3 = ui_text_w("3");
  x = mid - (w1 + w2 + 2 * s + w3) * 0.5; y = cy + 26 * s;
  gfx_a = 1;
  gfx_setfont(FONT_LOGO); ui_col(T_WORDMARK_RE); ui_text_l(x, y, 40 * s, "Re");
  gfx_setfont(FONT_LOGO_B); ui_col(T_WORDMARK_EQ); ui_text_l(x + w1, y, 40 * s, "EQ");
  gfx_setfont(FONT_LOGO_SUP);
  gfx_x = floor(x + w1 + w2 + 2 * s); gfx_y = floor(y + 20 * s - 15 * s);
  gfx_drawstr("3");

  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_spaced_c(mid, cy + 72 * s, 13 * s, "PARAMETRIC EQUALIZER");
  gfx_setfont(FONT_BODY); ui_col(T_TEXT_SECONDARY);
  ui_text_c(cx, cy + 92 * s, cw, 16 * s, sprintf(#, "Version %s", #VERSION));

  ui_col(T_BORDER_SUBTLE); gfx_line(cx + 40 * s, cy + 120 * s, cx + cw - 40 * s, cy + 120 * s, 0);

  gfx_setfont(FONT_EMPH); ui_col(T_TEXT);
  ui_text_c(cx, cy + 132 * s, cw, 18 * s, "Eloy Platas");
  gfx_setfont(FONT_BODY); ui_col(T_TEXT_SECONDARY);
  ui_text_c(cx, cy + 152 * s, cw, 16 * s, "after ReEQ² by Justin Johnson · MIT License");

  ui_col(T_BORDER_SUBTLE); gfx_line(cx + 40 * s, cy + 178 * s, cx + cw - 40 * s, cy + 178 * s, 0);

  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_spaced_c(mid, cy + 190 * s, 13 * s, "FILTERS");
  gfx_setfont(FONT_BODY); ui_col(T_TEXT);
  ui_text_c(cx, cy + 205 * s, cw, 16 * s, "ivantsov-filters by Yuriy Ivantsov (MIT)");

  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_spaced_c(mid, cy + 229 * s, 13 * s, "THANKS");
  gfx_setfont(FONT_BODY); ui_col(T_TEXT);
  ui_text_c(cx, cy + 244 * s, cw, 16 * s, "Cockos, for REAPER");
  ui_text_c(cx, cy + 261 * s, cw, 16 * s, "The REAPER community");

  gfx_setfont(FONT_BODY); ui_col(T_ACCENT);
  ui_text_c(cx, cy + 284 * s, cw, 16 * s, "github.com/Justin-Johnson/ReJJ");

  ui_col(T_BORDER_SUBTLE); gfx_line(cx + 40 * s, cy + 310 * s, cx + cw - 40 * s, cy + 310 * s, 0);

  gfx_setfont(FONT_BODY); ui_col(T_TEXT);
  ui_text_c(cx, cy + 320 * s, cw, 16 * s, "ReEQ², the EQ this one builds on, is free. Its author:");
  ui_col(T_ACCENT);
  ui_text_c(cx, cy + 337 * s, cw, 16 * s, "paypal.me/nitsujdsp");

  // OK, at the foot
  okw = 76 * s; okh = 26 * s; okx = floor(mid - okw * 0.5); oky = floor(cy + ch - 16 * s - okh);
  hov = ui_in(okx, oky, okw, okh);
  ui_button_draw(okx, oky, okw, okh, "OK", 1, hov);

  (pr && (hov || !inside)) || (rpr && !inside) ? ui_popup = 0;
  pr || rpr ? ui_block = 1;
  gfx_setfont(FONT_BASE);
);

function ui_draw_range_pop() local(s, pw, ph, px, py, i, ry, on, hov, pr, skip, rx, rw) (
  s = ui_pt(1);
  skip = ui_pop_skip; ui_pop_skip = 0;
  pr = ui_press && !skip;
  pw = 150 * s; ph = 30 * s + 6 * s + 5 * 24 * s + 6 * s;
  px = floor(max(4 * s, min(ui_dbb_x + ui_dbb_w - pw, gfx_w - pw - 4 * s)));
  py = ui_pop_frame(px, pw, ph);
  ui_pop_head(px, py, pw, "Range", "");
  rx = px + 6 * s; rw = pw - 12 * s;
  i = 0;
  loop(5,
    ry = floor(py + 36 * s + i * 24 * s);
    on = Db_Range == i;
    hov = ui_in(rx, ry, rw, 24 * s);
    on ? ui_box(rx, ry + 1, rw, 22 * s, 4 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER) :
      hov ? (ui_cola(T_HOVER_WASH, 0.04); ui_fill_rrect(rx, ry + 1, rw, 22 * s, 4 * s));
    gfx_setfont(on ? FONT_CAP_B : FONT_CAP);
    ui_col(on ? T_ACCENT : hov ? T_TEXT : T_TEXT_SECONDARY);
    ui_text_l(rx + 9 * s, ry, 24 * s, sprintf(#, "±%d dB", i == 0 ? 6 : i == 1 ? 12 : i == 2 ? 18 : i == 3 ? 24 : 30));
    gfx_setfont(FONT_CAP); ui_col(T_TEXT_FAINT);
    ui_text_r(rx, ry, rw - 9 * s, 24 * s, sprintf(#, "%d dB grid", i == 0 ? 1 : i == 1 ? 3 : i == 2 ? 6 : i == 3 ? 8 : 10));
    pr && hov ? (Db_Range = i; update_state(); ui_popup = 0);
    i += 1;
  );

  // Outside presses close it and are not passed on
  (pr || (ui_rpress && !skip)) && !ui_in(px, py, pw, ph) ? ui_popup = 0;
  pr ? ui_block = 1;
  gfx_setfont(FONT_BASE);
);

/*
 * Node panel for the selected band
 */
// The panel moved the selection: the node selection follows it
function ui_select_only(b) (
  select_node_clear();
  b >= 0 ? (select_node(b); selected_node_group = Band_Group[b]);
);

/*
 * Small knob for the dynamics block, 26pt across. v is 0..1; bipolar fills from the centre; the value
 * arc is the band's colour, or grey; dim draws it inactive.
 */
function ui_knob_small(cx, cy, v, bipolar, grey, dim) local(s, t0, t1, th) (
  s = ui_pt(1);
  cx = floor(cx) + 0.5; cy = floor(cy) + 0.5;
  ui_mix = dim ? 0.65 : 0;
  gfx_a = 1;
  ui_col(T_DIAL_TRACK);
  ui_thick_arc(cx, cy, 12 * s, 1.25 * $pi, 2.75 * $pi, 2 * s);
  bipolar ? (t0 = min(0.5, v); t1 = max(0.5, v)) : (t0 = 0; t1 = v);
  t1 - t0 > 0.004 ? (
    grey ? ui_col(T_TEXT_DIM) : ui_band_col(selected_node);
    ui_thick_arc(cx, cy, 12 * s, 1.25 * $pi + 1.5 * $pi * t0, 1.25 * $pi + 1.5 * $pi * t1, 2 * s);
  );
  ui_col(T_DIAL_RIM); gfx_circle(cx, cy, 9 * s, 1, 1);
  ui_col(T_DIAL_FACE); gfx_circle(cx, cy, 8 * s, 1, 1);
  ui_col(T_DIAL_EDGE); gfx_circle(cx, cy, 8 * s, 0, 1);
  th = 0.75 * $pi + 1.5 * $pi * v;
  ui_col(T_DIAL_POINTER);
  ui_thick_line(cx + 2.5 * s * cos(th), cy + 2.5 * s * sin(th), cx + 7 * s * cos(th), cy + 7 * s * sin(th), 1.6 * s);
  ui_mix = 0;
);

/*
 * Vertical drag over a small knob's cell (id is the cell's number). Shift or Alt drags finely. Returns
 * the new 0..1 value. (Double clicks are the general mouse code's, as for the dials: a plain one resets,
 * Alt opens the value stepper.)
 */
function ui_knob_drag(id, x, y, w, h, v) (
  ui_press && ui_hover(x, y, w, h) ? (
    ui_kd = id; ui_kd_y = mouse_y; button_focus = -2 - id;
  ) : ui_kd == id && (mouse_cap & 1) ? (
    v = min(max(v + (ui_kd_y - mouse_y) * (mouse_cap & 24 ? 0.0004 : 0.005), 0), 1);
    ui_kd_y = mouse_y;
  );
  v;
);

/*
 * One cell of the dynamics grid: a small knob with its label and value beside it. Returns the knob's
 * new 0..1 value; an inert cell only draws.
 */
function ui_dyn_cell(id, x, cy, w, label, v, bipolar, grey, dim, val, unit) local(s, tx, w1) (
  s = ui_pt(1);
  !dim ? v = ui_knob_drag(id, x, cy - 16 * s, w, 32 * s, v);
  ui_knob_small(x + 13 * s, cy, v, bipolar, grey, dim);
  gfx_a = 1; ui_mix = dim ? 0.65 : 0;
  tx = x + 31 * s;
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(tx, cy - 13 * s, 10 * s, label);
  gfx_setfont(FONT_BODY_B); ui_col(T_TEXT);
  ui_text_l(tx, cy - 2 * s, 14 * s, val);
  w1 = ui_text_w(val);
  strlen(unit) > 0 ? (gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM); ui_text_l(tx + w1 + 2 * s, cy - 2 * s, 14 * s, unit));
  ui_mix = 0;
  v;
);

function ui_fmt_ms(s, v) (
  sprintf(s, v < 10 ? "%.1f" : "%.0f", v);
);

/*
 * The Timing cell: a switch, Auto or Manual. Going to Manual starts from the automatic times.
 */
function ui_dyn_timing(x, cy, w, b) local(s, sx, on, hov, tx) (
  s = ui_pt(1);
  on = Band_Dyn_Auto[b];
  hov = ui_hover(x, cy - 16 * s, w, 32 * s);
  sx = x + 1 * s;
  on ? ui_box(sx, cy - 8 * s, 28 * s, 16 * s, 8 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER)
     : ui_box(sx, cy - 8 * s, 28 * s, 16 * s, 8 * s, T_CONTROL, 1, hov ? T_BORDER_HOVER : T_BORDER);
  ui_col(on ? T_ACCENT : T_TEXT_DIM);
  gfx_circle(on ? sx + 20 * s : sx + 8 * s, cy, 5 * s, 1, 1);
  tx = x + 35 * s;
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_l(tx, cy - 13 * s, 10 * s, "TIMING");
  gfx_setfont(FONT_BODY_B); ui_col(on ? T_ACCENT : hov ? T_TEXT : T_TEXT_SECONDARY);
  ui_text_l(tx, cy - 2 * s, 14 * s, on ? "Auto" : "Manual");
  ui_clicked(x, cy - 16 * s, w, 32 * s) ? (
    on ? (
      Band_Dyn_Attack[b] = band_dyn_auto_attack(b);
      Band_Dyn_Release[b] = band_dyn_auto_release(b);
      filters_to_sliders();
      notify_touched_dyn(b, 4); notify_touched_dyn(b, 5);
    );
    Band_Dyn_Auto[b] = !on;
    notify_dyn_state(b);
  );
);

/*
 * The gain change meter: the detector level (-60..0dB) beside its threshold, and the gain change as a
 * share of the range (a cut fills down from the top, a boost up from the bottom), with its value
 */
function ui_dyn_meter(mx, y, b) local(s, top, mh, f, t, g) (
  s = ui_pt(1);
  top = y + 56 * s; mh = 62 * s;
  gfx_a = 1;
  gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
  ui_text_c(mx - 16 * s, y + 42 * s, 32 * s, 10 * s, "GR");

  // The level falls back at 30dB/s, so it reads steadily
  ui_dyn_mb != b ? (ui_dyn_lv = -150; ui_dyn_mb = b);
  ui_dyn_lv = max(Band_Dyn_Level[b], ui_dyn_lv - 30 * ui_dt);
  ui_col(T_DIAL_TRACK);
  gfx_rect(mx - 6 * s, top, 4 * s, mh);
  gfx_rect(mx + 1 * s, top, 5 * s, mh);
  f = min(max((ui_dyn_lv + 60) / 60, 0), 1);
  ui_col(T_TEXT_DIM);
  f > 0 ? gfx_rect(mx - 6 * s, top + mh * (1 - f), 4 * s, mh * f);
  t = min(max(((Band_Dyn_AutoThr[b] ? Band_Dyn_AutoLvl[b] + DYN_AUTO_OFS : Band_Dyn_Thresh[b]) + 60) / 60, 0), 1);
  ui_band_col(b);
  gfx_rect(mx - 8 * s, floor(top + mh * (1 - t)), 8 * s, max(1, floor(1.5 * s)));

  g = Band_Dyn_Gain[b];
  f = min(abs(g) / max(abs(Band_Dynamic_Range[b]), 0.1), 1);
  f > 0.005 ? (Band_Dynamic_Range[b] < 0 ? gfx_rect(mx + 1 * s, top, 5 * s, mh * f) : gfx_rect(mx + 1 * s, top + mh * (1 - f), 5 * s, mh * f));
  gfx_setfont(FONT_CAP); ui_col(T_TEXT);
  ui_text_c(mx - 16 * s, top + mh + 4 * s, 32 * s, 14 * s, ui_fmt_db(#, g));
);

/*
 * A dynamic band's block, to the right of its dials from the hairline at hl to the panel's right edge
 * xr: Threshold, Ratio and Range over Attack, Release and Timing, then the meter
 */
function ui_draw_dyn_block(b, hl, y, xr) local(s, gx, cw, r1, r2, v, nv, a, auto, lr) (
  s = ui_pt(1);
  ui_col(T_BORDER_SUBTLE);
  gfx_line(hl, y + 46 * s, hl, y + 136 * s, 0);
  gx = hl + 12 * s; cw = 92 * s; r1 = y + 68 * s; r2 = y + 116 * s;
  auto = Band_Dyn_Auto[b];
  // The grid, for the double click's hit test next frame (sv_hit)
  ui_dyn_shown = 1; ui_dyn_gx = gx; ui_dyn_cw = cw; ui_dyn_r1 = r1; ui_dyn_r2 = r2;

  // Threshold, -60..0dB, or Auto (ReEQ3): it follows the detector's long-term level
  v = 1 - Band_Dyn_Thresh[b] / DYN_THRESH_MIN;
  Band_Dyn_AutoThr[b] ? (
    ui_dyn_cell(0, gx, r1, cw, "THRESHOLD", 1 - (Band_Dyn_AutoLvl[b] + DYN_AUTO_OFS) / DYN_THRESH_MIN, 0, 1, 1, "Auto", "");
  ) : (
    nv = ui_dyn_cell(0, gx, r1, cw, "THRESHOLD", v, 0, 0, 0, ui_fmt_db(#, Band_Dyn_Thresh[b]), "dB");
    nv != v ? sv_put(SV_THRESH, b, DYN_THRESH_MIN * (1 - nv));
  );
  // The Auto switch: a small "A" under the knob
  a = floor(gx + 13 * s - 8 * s);
  lr = floor(r1 + 15 * s);
  nv = ui_hover(a, lr, 16 * s, 12 * s);
  Band_Dyn_AutoThr[b] ? ui_box(a, lr, 16 * s, 12 * s, 6 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER)
                      : ui_box(a, lr, 16 * s, 12 * s, 6 * s, nv ? T_CONTROL_HOVER : T_CONTROL, 1, nv ? T_BORDER_HOVER : T_BORDER);
  gfx_setfont(FONT_CAP); ui_col(Band_Dyn_AutoThr[b] ? T_ACCENT : nv ? T_TEXT : T_TEXT_DIM);
  ui_text_c(a, lr, 16 * s, 12 * s, "A");
  ui_clicked(a, lr, 16 * s, 12 * s) ? (
    Band_Dyn_AutoThr[b] = !Band_Dyn_AutoThr[b];
    // Start from the level the band hears now
    Band_Dyn_AutoThr[b] ? Band_Dyn_AutoLvl[b] = Band_Dyn_Level[b] > -100 ? Band_Dyn_Level[b] : Band_Dyn_Thresh[b] - DYN_AUTO_OFS;
    notify_dyn_state(b);
  );

  // Ratio, 1..20, on a log scale
  lr = log(DYN_RATIO_MAX);
  v = log(max(Band_Dyn_Ratio[b], 1)) / lr;
  nv = ui_dyn_cell(1, gx + cw, r1, cw, "RATIO", v, 0, 0, 0,
    sprintf(#, Band_Dyn_Ratio[b] < 10 ? "%.1f" : "%.0f", Band_Dyn_Ratio[b]), ":1");
  nv != v ? sv_put(SV_RATIO, b, exp(nv * lr));

  // Range, -24..+24dB: its sign is the direction
  v = (Band_Dynamic_Range[b] / DYN_RANGE_MAX + 1) * 0.5;
  nv = ui_dyn_cell(2, gx + 2 * cw, r1, cw, "RANGE", v, 1, 0, 0, ui_fmt_db(#, Band_Dynamic_Range[b]), "dB");
  nv != v ? sv_put(SV_RANGE, b, DYN_RANGE_MAX * (2 * nv - 1));

  // Attack, 0.1..200ms, and release, 5..2000ms, on log scales; with Auto on they show the automatic
  // times, greyed and inert
  a = auto ? band_dyn_auto_attack(b) : Band_Dyn_Attack[b];
  lr = log(DYN_ATK_MAX / DYN_ATK_MIN);
  v = log(a / DYN_ATK_MIN) / lr;
  nv = ui_dyn_cell(3, gx, r2, cw, "ATTACK", v, 0, auto, auto, ui_fmt_ms(#, a), "ms");
  !auto && nv != v ? sv_put(SV_ATTACK, b, DYN_ATK_MIN * exp(nv * lr));

  a = auto ? band_dyn_auto_release(b) : Band_Dyn_Release[b];
  lr = log(DYN_REL_MAX / DYN_REL_MIN);
  v = log(a / DYN_REL_MIN) / lr;
  nv = ui_dyn_cell(4, gx + cw, r2, cw, "RELEASE", v, 0, auto, auto, ui_fmt_ms(#, a), "ms");
  !auto && nv != v ? sv_put(SV_RELEASE, b, DYN_REL_MIN * exp(nv * lr));

  ui_dyn_timing(gx + 2 * cw, r2, cw, b);

  // ReEQ3 spectral dynamics: Density (0..100) over the trigger Tilt
  Band_Spectral[b] ? (
    v = Band_SpecDensity[b] / 100;
    nv = ui_dyn_cell(5, gx + 3 * cw, r1, cw, "DENSITY", v, 0, 0, 0, sprintf(#, "%.0f", Band_SpecDensity[b]), "%");
    nv != v ? (Band_SpecDensity[b] = floor(nv * 100 + 0.5); notify_dyn_state(b));
    a = gx + 3 * cw; v = Band_SpecTilt[b];
    nv = ui_hover(a, r2 - 16 * s, cw, 32 * s);
    v ? ui_box(a + s, r2 - 8 * s, 28 * s, 16 * s, 8 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER)
      : ui_box(a + s, r2 - 8 * s, 28 * s, 16 * s, 8 * s, T_CONTROL, 1, nv ? T_BORDER_HOVER : T_BORDER);
    ui_col(v ? T_ACCENT : T_TEXT_DIM);
    gfx_circle(v ? a + 21 * s : a + 9 * s, r2, 5 * s, 1, 1);
    gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
    ui_text_l(a + 35 * s, r2 - 13 * s, 10 * s, "TILT");
    gfx_setfont(FONT_BODY_B); ui_col(v ? T_ACCENT : nv ? T_TEXT : T_TEXT_SECONDARY);
    ui_text_l(a + 35 * s, r2 - 2 * s, 14 * s, v ? "3 dB/oct" : "Off");
    ui_clicked(a, r2 - 16 * s, cw, 32 * s) ? (Band_SpecTilt[b] = !v; notify_dyn_state(b));
  );
  ui_dyn_meter(xr - 24 * s, y, b);
);

/*
 * The detection source picker: the band's own input, or a sidechain pair
 */
function ui_draw_dyn_source_pop(b) local(s, pw, ph, px, py, i, tx, ty, tw, th, on, hov, inpop, pr) (
  s = ui_pt(1);
  pr = ui_press && !ui_pop_skip; ui_pop_skip = 0;
  pw = 168 * s; th = 24 * s; tw = pw - 10 * s;
  ph = 5 * s + 4 * th + 6 * s + 5 * s;
  px = max(4 * s, min(ui_pop_x + ui_pop_w * 0.5 - pw * 0.5, gfx_w - pw - 4 * s));
  py = ui_pop_frame(px, pw, ph);
  inpop = ui_in(px, py, pw, ph);
  i = 0;
  loop(4,
    tx = floor(px + 5 * s); ty = floor(py + 5 * s + i * (th + 2 * s));
    on = i == Band_Dyn_Source[b];
    hov = ui_in(tx, ty, tw, th);
    on ? ui_box(tx, ty, tw, th, 4 * s, T_ACCENT_FILL, 1, T_ACCENT_BORDER) : hov ? ui_box(tx, ty, tw, th, 4 * s, T_CONTROL_HOVER, 1, T_BORDER_HOVER);
    gfx_setfont(on ? FONT_BODY_B : FONT_BODY);
    ui_col(on ? T_ACCENT : T_TEXT);
    ui_text_l(tx + 8 * s, ty, th, i == 0 ? "Band" : sprintf(#, "SC %d", i));
    i > 0 ? (
      gfx_setfont(FONT_BODY); ui_col(T_TEXT_DIM);
      ui_text_r(tx, ty, tw - 8 * s, th, sprintf(#, "Ch. %d/%d", 2 * i + 1, 2 * i + 2));
    );
    pr && hov ? (Band_Dyn_Source[b] = i; notify_dyn_state(b); ui_popup = 0);
    i += 1;
  );
  pr ? (!inpop ? ui_popup = 0; ui_block = 1);
  gfx_setfont(FONT_BASE);
);

/*
 * One arrow of a column: hover, dimmed when it would change nothing. A press steps once and arms the
 * repeat (after 0.4s, then every 0.06s while held over it). Returns the value to set, or v.
 */
function sv_arrow(code, x, y, w, h, dir, v, st, pr) local(s, nv, en, hov, go) (
  s = ui_pt(1);
  nv = sv_step(v, st, dir);
  en = nv != v;
  hov = en && ui_in(x, y, w, h);
  hov ? (ui_cola(T_HOVER_WASH, 0.06); ui_fill_rrect(x, y, w, h, 3 * s));
  ui_col(!en ? T_TEXT_DISABLED : hov ? T_TEXT : T_TEXT_DIM);
  ui_chevron(x + w * 0.5, y + h * 0.5, 3.5 * s, dir == 0 ? (y < ui_sv_dy ? -1 : 1) : -dir);
  go = 0;
  hov && pr ? (go = 1; ui_sv_hold = code; ui_sv_ht = ui_t + 0.4) :
    hov && ui_sv_hold == code && (mouse_cap & 1) && ui_t >= ui_sv_ht ? (go = 1; ui_sv_ht = ui_t + 0.06);
  go ? nv : v;
);

/*
 * The stepper popover (ui_popup 9): title, revert and close; then the sign column where the value can
 * be negative, a column per digit with its arrows, and the unit. Every step applies at once; revert
 * puts back the opening value; close, Esc or a press outside keep the current one.
 */
function ui_draw_stepper() local(s, id, b, skip, pr, cwid, wpt, nsign, ncol, uw, cw, pw, ph, px, py, x0, y1, y2, y3, ah, v, nv, n, c, k, p, d, x, st,
                                  lead, hov, en, ix, dw, a) (
  s = ui_pt(1);
  id = ui_sv_id; b = ui_sv_b;
  skip = ui_pop_skip; ui_pop_skip = 0;
  pr = ui_press && !skip;
  !(mouse_cap & 1) ? ui_sv_hold = -1;
  sv_spec(id, b);

  cwid = 17 * s; wpt = sv_dec > 0 ? 6 * s : 0; ah = 16 * s;
  nsign = sv_min < 0;
  ncol = nsign + sv_int + sv_dec;
  gfx_setfont(FONT_BODY);
  uw = strlen(#sv_unit) > 0 ? ui_text_w(#sv_unit) + 5 * s : 0;
  cw = ncol * cwid + wpt + uw;
  gfx_setfont(FONT_BODY_B);
  pw = max(cw + 20 * s, ui_text_w(#sv_lab) + 11 * s + 58 * s);
  ph = 30 * s + 4 * s + ah + 26 * s + ah + 6 * s;
  px = floor(max(4 * s, min(ui_pop_x + ui_pop_w * 0.5 - pw * 0.5, gfx_w - pw - 4 * s)));
  py = ui_pop_frame(px, pw, ph);
  // Nearly opaque: it sits over the panel's own labels and values
  ui_cola(T_POPOVER, 0.7); ui_fill_rrect(px + 1, floor(py) + 1, floor(pw) - 2, floor(ph) - 2, floor(8 * s) - 1);
  ui_pop_head(px, py, pw, #sv_lab, "");

  // The value as shown, and as a whole count of its last digit
  v = sv_round(sv_get(id, b));
  n = floor(abs(v) * 10 ^ sv_dec + 0.5);
  nv = v;

  // ReEQ3: typing. Printable keys build the text (shown in the header); Enter applies it, Backspace
  // takes a character back
  ui_key >= 32 && ui_key < 127 ? (
    strlen(#sv_text) < 16 ? (#sv_ch = " "; str_setchar(#sv_ch, 0, ui_key); strcat(#sv_text, #sv_ch));
    ui_sv_bad = 0;
  ) : ui_key == 8 && strlen(#sv_text) > 0 ? (
    strcpy_substr(#sv_text, #sv_text, 0, strlen(#sv_text) - 1); ui_sv_bad = 0;
  ) : ui_key == 13 && strlen(#sv_text) > 0 ? (
    ui_sv_typed = sv_parse(#sv_text, id);
    ui_parse_ok ? (sv_set(id, b, ui_sv_typed); ui_popup = 0; #sv_text = "") : ui_sv_bad = 1;
  );

  // Revert (greyed until the value has changed) and close
  ix = px + pw - 6 * s - 22 * s;
  hov = ui_in(ix, py + 4 * s, 22 * s, 22 * s);
  hov ? (ui_cola(T_HOVER_WASH, 0.06); ui_fill_rrect(ix, py + 4 * s, 22 * s, 22 * s, 4 * s));
  ui_col(hov ? T_TEXT : T_TEXT_SECONDARY);
  ui_icon(10, ix + 11 * s, py + 15 * s);
  pr && hov ? ui_popup = 0;
  ix -= 24 * s;
  en = sv_get(id, b) != ui_sv_v0;
  hov = en && ui_in(ix, py + 4 * s, 22 * s, 22 * s);
  hov ? (ui_cola(T_HOVER_WASH, 0.06); ui_fill_rrect(ix, py + 4 * s, 22 * s, 22 * s, 4 * s));
  ui_col(!en ? T_TEXT_DISABLED : hov ? T_TEXT : T_TEXT_SECONDARY);
  ui_icon(9, ix + 11 * s, py + 15 * s);
  pr && hov ? sv_put(id, b, ui_sv_v0);

  // Columns, centred: arrows above and below each digit
  x0 = floor(px + (pw - cw) * 0.5);
  y1 = py + 34 * s; y2 = y1 + ah; y3 = y2 + 26 * s;
  ui_sv_dy = y2;
  dw = (mouse_wheel - ui_sv_wheel) / 120;
  ui_sv_wheel = mouse_wheel;
  x = x0;
  nsign ? (
    gfx_setfont(FONT_DISPLAY_B);
    ui_col(T_TEXT);
    ui_text_c(x, y2, cwid, 26 * s, v < 0 ? "−" : sv_max > 0 ? "+" : "");
    // Either arrow flips the sign, where the value can be positive
    sv_max > 0 ? (
      a = sv_arrow(0, x + 1, y1, cwid - 2, ah, 0, v, 0, pr); nv == v ? nv = a;
      a = sv_arrow(1, x + 1, y3, cwid - 2, ah, 0, v, 0, pr); nv == v ? nv = a;
    );
    x += cwid;
  );
  c = 0;
  loop(sv_int + sv_dec,
    // This column steps 10^k; its digit is at place p of n
    k = sv_int - 1 - c; p = k + sv_dec;
    st = 10 ^ k;
    c == sv_int ? (
      gfx_setfont(FONT_DISPLAY_B); ui_col(T_TEXT);
      ui_text_c(x, y2, wpt, 26 * s, ".");
      x += wpt;
    );
    d = floor(n / 10 ^ p) % 10;
    lead = k > 0 && floor(n / 10 ^ p) == 0;
    gfx_setfont(FONT_DISPLAY_B);
    ui_col(lead ? T_TEXT_DISABLED : T_TEXT);
    ui_text_c(x, y2, cwid, 26 * s, sprintf(#, "%d", d));
    // One step per frame from the arrows; every arrow still draws
    a = sv_arrow(2 + 2 * c, x + 1, y1, cwid - 2, ah, 1, v, st, pr); nv == v ? nv = a;
    a = sv_arrow(3 + 2 * c, x + 1, y3, cwid - 2, ah, -1, v, st, pr); nv == v ? nv = a;

    // The wheel over the column steps it, in whole notches (a trackpad's part notches add up)
    ui_in(x, y1, cwid, y3 + ah - y1) ? (
      ui_sv_wcol != c ? (ui_sv_wcol = c; ui_sv_wacc = 0);
      ui_sv_wacc += dw;
      abs(ui_sv_wacc) >= 1 ? (
        loop(floor(abs(ui_sv_wacc)), nv = sv_step(nv, st, sign(ui_sv_wacc)));
        ui_sv_wacc -= sign(ui_sv_wacc) * floor(abs(ui_sv_wacc));
      );
    );
    x += cwid;
    c += 1;
  );
  uw > 0 ? (
    gfx_setfont(FONT_BODY); ui_col(T_TEXT_DIM);
    ui_text_l(x + 5 * s, y2, 26 * s, #sv_unit);
  );
  nv != v && ui_popup == 9 && strlen(#sv_text) == 0 ? sv_set(id, b, nv);

  // ReEQ3: what's being typed, over the digits (Enter applies, Esc leaves)
  strlen(#sv_text) > 0 && ui_popup == 9 ? (
    ui_cola(T_POPOVER, 1); ui_fill_rrect(px + 4 * s, y1, pw - 8 * s, y3 + ah - y1, 4 * s);
    ui_box(px + 8 * s, y2 - 2 * s, pw - 16 * s, 30 * s, 5 * s, T_CONTROL, 1, ui_sv_bad ? T_DANGER_BORDER : T_ACCENT_BORDER);
    gfx_setfont(FONT_DISPLAY_B); ui_col(ui_sv_bad ? T_DANGER : T_TEXT);
    ui_text_c(px + 8 * s, y2 - 2 * s, pw - 16 * s, 30 * s, sprintf(#, "%s_", #sv_text));
    gfx_setfont(FONT_CAP); ui_col(T_TEXT_DIM);
    ui_text_c(px + 8 * s, y3 + 2 * s, pw - 16 * s, 12 * s, ui_sv_bad ? "Not a value for this control" : "Enter to apply");
  );

  // Outside presses close it and are not passed on
  (pr || (ui_rpress && !skip)) && !ui_in(px, py, pw, ph) ? ui_popup = 0;
  pr ? ui_block = 1;
  gfx_setfont(FONT_BASE);
);

function ui_draw_panel()
  local(s, b, t, x, y, w, h, hy, hh, lab, sw, sx, gw2, gx2, rx, ib, k, n, i, cx, cy, sp, v, rv, cut, dimg, dimq, val, unit, done, orig, f,
        dx, dw, hl, dyn, le, hnarrow)
(
  s = ui_pt(1);
  b = selected_node; t = Band_Type[b];
  x = panel_x; y = panel_y; w = panel_w; h = panel_h;
  cut = ui_is_cut(t);

  // Card, see-through so the response shows underneath
  ui_cola(T_PANEL, 1); ui_fill_rrect(x, y, w, h, 8 * s);
  ui_cola(T_BORDER, 1); gfx_roundrect(x, y, w - 1, h - 1, 8 * s, 1);
  ui_cola(T_BORDER_HOVER, 1); gfx_line(x + 8 * s, y, x + w - 8 * s, y, 1);

  // Header: band badge, shape and placement pickers
  hy = y + 6 * s; hh = 24 * s;
  ui_band_col(b);
  gfx_circle(x + 21 * s, y + 18 * s, 9 * s, 1, 1);
  gfx_setfont(FONT_EMPH); ui_col(T_BADGE_TEXT);
  ui_text_at(x + 21 * s, y + 18 * s, sprintf(#, "%d", b + 1));

  lab = #;
  ui_shape_label(lab, b);
  gfx_setfont(FONT_BODY);
  sw = ui_text_w(lab) + 33 * s; sx = x + 38 * s;
  ui_dropdown(sx, hy, sw, hh, lab, ui_popup == 1) ? (ui_popup = 1; ui_pop_skip = 1; ui_block = 1; ui_pop_x = sx; ui_pop_y = hy; ui_pop_w = sw);

  gfx_setfont(FONT_BODY);
  gw2 = ui_text_w(ui_group_name(Band_Group[b])) + 33 * s; gx2 = sx + sw + 8 * s;
  ui_dropdown(gx2, hy, gw2, hh, ui_group_name(Band_Group[b]), ui_popup == 2) ? (ui_popup = 2; ui_pop_skip = 1; ui_block = 1; ui_pop_x = gx2; ui_pop_y = hy; ui_pop_w = gw2);

  // ReEQ3 header: the analogue Gain-Q interaction, for bells (G·Q, lit when on)
  t == FILTER_PEAK ? (
    dx = gx2 + gw2 + 8 * s;
    gfx_setfont(FONT_BODY_B); dw = ui_text_w("G·Q") + 18 * s;
    ui_button(dx, hy, dw, hh, "G·Q", Band_GainQ[b] ? 1 : 0) ? (
      Band_GainQ[b] = !Band_GainQ[b];
      flag_filter_update(b);
      notify_dyn_state(b);
    );
    gx2 += dw + 8 * s;
  );

  // Header: dynamics, for bells and shelves. DYN, then on a dynamic band its detection source and Listen
  // (the detector's signal, an ear, so it isn't mistaken for the band solo's headphones). le is where
  // the left-hand controls end.
  le = gx2 + gw2;
  band_dyn_capable(t) ? (
    dx = gx2 + gw2 + 8 * s;
    ui_col(T_BORDER);
    gfx_line(dx, hy + 3 * s, dx, hy + hh - 3 * s, 0);
    dx += 8 * s;
    gfx_setfont(FONT_BODY_B); dw = ui_text_w("DYN") + 18 * s;
    ui_button(dx, hy, dw, hh, "DYN", Band_Dyn_On[b] ? 1 : 0) ? (
      Band_Dyn_On[b] = !Band_Dyn_On[b];
      flag_filter_update(b);
      filters_to_sliders();
      notify_touched_dyn(b, 0);
    );
    le = dx + dw;
    // ReEQ3: spectral dynamics, for a dynamic band
    Band_Dyn_On[b] ? (
      dx += dw + 6 * s;
      gfx_setfont(FONT_BODY_B); dw = ui_text_w("SPEC") + 18 * s;
      ui_button(dx, hy, dw, hh, "SPEC", Band_Spectral[b] ? 1 : 0) ? (
        Band_Spectral[b] = !Band_Spectral[b];
        flag_filter_update(b);
        notify_dyn_state(b);
      );
      le = dx + dw;
    );
    Band_Dyn_On[b] && ui_dyn_panel ? (
      dx += dw + 6 * s;
      gfx_setfont(FONT_BODY); dw = ui_text_w("Band") + 33 * s;
      ui_dropdown(dx, hy, dw, hh, Band_Dyn_Source[b] == 0 ? "Band" : sprintf(#, "SC %d", Band_Dyn_Source[b]), ui_popup == 7) ? (
        ui_popup = 7; ui_pop_skip = 1; ui_block = 1; ui_pop_x = dx; ui_pop_y = hy; ui_pop_w = dw;
      );
      dx += dw + 6 * s;
      // Link: detection follows the band; unlinked, it has its own node on the graph
      ui_icon_button(dx, hy, 26 * s, hh, Band_Dyn_Link[b] ? 7 : 8, Band_Dyn_Link[b] ? 1 : 0) ? (
        Band_Dyn_Link[b] ? dyn_unlink(b) : (Band_Dyn_Link[b] = 1);
        flag_filter_update(b);
        notify_dyn_state(b);
      );
      dx += 26 * s + 6 * s;
      ui_icon_button(dx, hy, 26 * s, hh, 6, Dyn_Listen == b ? 1 : 0) ? (
        Dyn_Listen = Dyn_Listen == b ? -1 : b;
        Dyn_Listen >= 0 && listen_node != -1 ? (listen_node = -1; flag_filter_update(b));
      );
      le = dx + 26 * s;
    );
  );

  // Header right: band navigation, left out when the left-hand controls would reach the icons
  rx = x + w - 10 * s;
  hnarrow = le + 8 * s > rx - 220 * s;
  !hnarrow ? (
  ui_text_button(rx - 22 * s, hy, 22 * s, hh, "›") ? (
    done = 0;
    while (
      selected_node += 1;
      selected_node >= NUM_BANDS ? selected_node = 0;
      Band_Enabled[selected_node] != BAND_STATE_OFF ? (listen_node != -1 ? listen_node = selected_node; Dyn_Listen >= 0 ? Dyn_Listen = selected_node; done = 1);
      !done;
    );
    ui_select_only(selected_node);
    flag_filter_update(selected_node);
    filters_to_sliders();
  );

  // k / N: this band's position among the bands in use
  n = 0; k = 0; i = 0;
  loop(NUM_BANDS,
    Band_Enabled[i] != BAND_STATE_OFF ? (n += 1; i <= b ? k += 1);
    i += 1;
  );
  gfx_setfont(FONT_BODY);
  ui_col(T_TEXT_SECONDARY);
  ui_text_c(rx - 58 * s, hy, 36 * s, hh, sprintf(#, "%d / %d", k, n));

  ui_text_button(rx - 80 * s, hy, 22 * s, hh, "‹") ? (
    done = 0;
    while (
      selected_node -= 1;
      selected_node < 0 ? selected_node = NUM_BANDS - 1;
      Band_Enabled[selected_node] != BAND_STATE_OFF ? (listen_node != -1 ? listen_node = selected_node; Dyn_Listen >= 0 ? Dyn_Listen = selected_node; done = 1);
      !done;
    );
    ui_select_only(selected_node);
    flag_filter_update(selected_node);
    filters_to_sliders();
  );

  ui_col(T_BORDER);
  gfx_line(rx - 86 * s, hy + 3 * s, rx - 86 * s, hy + hh - 3 * s, 0);
  );

  // Header right: solo (listen), bypass, duplicate, delete
  ib = hnarrow ? rx : rx - 92 * s;
  ui_icon_button(ib - 26 * s, hy, 26 * s, hh, 4, 2) ? (
    Band_Enabled[b] = BAND_STATE_OFF;
    listen_node = -1;
    flag_filter_update(b);
    filters_to_sliders();
    orig = b; done = 0;
    while (
      selected_node += 1;
      selected_node >= NUM_BANDS ? selected_node = 0;
      Band_Enabled[selected_node] != BAND_STATE_OFF ? done = 1 :
        selected_node == orig ? (selected_node = -1; done = 1);
      !done;
    );
    ui_select_only(selected_node);
  );
  selected_node == b ? (
    ui_icon_button(ib - 60 * s, hy, 26 * s, hh, 3, 0) ? (
      f = 0;
      while (Band_Enabled[f] != BAND_STATE_OFF && f < NUM_BANDS) (f += 1);
      f < NUM_BANDS ? (duplicate_band(f, b); selected_node = f; ui_select_only(f));
    );
    ui_icon_button(ib - 94 * s, hy, 26 * s, hh, 2, Band_Enabled[b] == BAND_STATE_DISABLED ? 1 : 0) ? (
      Band_Enabled[b] = Band_Enabled[b] == BAND_STATE_DISABLED ? BAND_STATE_ENABLED : BAND_STATE_DISABLED;
      flag_filter_update(b);
      filters_to_sliders();
    );
    ui_icon_button(ib - 128 * s, hy, 26 * s, hh, 1, listen_node == b ? 1 : 0) ? (
      listen_node = listen_node == b ? -1 : b;
      listen_node != -1 ? Dyn_Listen = -1;
      flag_filter_update(b);
      filters_to_sliders();
    );
  );

  ui_col(T_BORDER_SUBTLE);
  gfx_line(x + 12 * s, y + 36 * s, x + w - 12 * s, y + 36 * s, 0);

  // Dials. The band can change above (navigation, delete), so read it again.
  b = selected_node;
  b >= 0 ? (
    t = Band_Type[b]; cut = ui_is_cut(t);
    // A dynamic band's dials move left for its dynamics block (the block is 327pt from the hairline to
    // the right edge), closer together in a narrow panel
    dyn = ui_dyn_panel && Band_Dyn_On[b] && band_dyn_capable(t);
    dyn ? (
      hl = x + w - (Band_Spectral[b] ? 419 : 327) * s;
      sp = min(max((hl - x - 131 * s) * 0.5, 76 * s), 116 * s);
      cx = hl - 60 * s - sp;
    ) : (
      cx = x + w * 0.5; sp = 116 * s;
    );
    cy = y + 91 * s;
    ui_dial_hx = sp * 0.5;

    // Frequency
    dial_freq.x = cx - sp; dial_freq.y = cy; dial_freq.r = 29 * s;
    rv = freq_to_per(Band_Frequency[b], 1.0);
    ui_popup == 0 && !ui_block ? (
      v = dial_freq.handle_number_dial(rv);
      v != rv ? sv_put(SV_FREQ, b, per_to_freq(v, 1.0));
    );
    f = Band_Frequency[b];
    val = #;
    f < 1000 ? sprintf(val, f < 100 ? "%.1f" : "%.0f", f) : sprintf(val, f < 10000 ? "%.2f" : "%.1f", f / 1000);
    ui_dial_face(cx - sp, cy, "FREQUENCY", freq_to_per(f, 1.0), 0, 0, 0, val, f < 1000 ? "Hz" : "kHz");

    // Gain, or slope for the cuts
    cut ? (
      dial_gain.x = -100000;
      dial_slope.x = cx; dial_slope.y = cy; dial_slope.r = 29 * s;
      // ReEQ3: the dial steps through the slopes; with Shift it moves freely (fractional slopes)
      !dial_slope.drag ? ui_slope_acc = Band_Slope[b] / 19;
      ui_popup == 0 && !ui_block ? (
        ui_slope_acc = dial_slope.handle_number_dial(ui_slope_acc);
        rv = min(max(ui_slope_acc, 0), 1) * 19;
        !(mouse_cap & 8) ? rv = ui_slope_chip(t, ui_slope_index_t(t, rv)) / 6 - 1;
        abs(rv - Band_Slope[b]) > 0.001 ? (set_node_slope(b, rv); filters_to_sliders());
      );
      ui_dial_face(cx, cy, "SLOPE", Band_Slope[b] / 19, 0, 0, 0, ui_slope_text(#, Band_Slope[b]), "dB/oct");
    ) : (
      dial_slope.x = -100000;
      dial_gain.x = cx; dial_gain.y = cy; dial_gain.r = 29 * s;
      dimg = ui_gain_inert(t);
      rv = (Band_Gain[b] / BAND_GAIN_MAX + 1) * 0.5;
      !dimg && ui_popup == 0 && !ui_block ? (
        v = dial_gain.handle_number_dial(rv);
        v != rv ? sv_put(SV_GAIN, b, BAND_GAIN_MAX * (2 * v - 1));
      );
      ui_dial_face(cx, cy, "GAIN", (Band_Gain[b] / BAND_GAIN_MAX + 1) * 0.5, 1, 0, dimg, ui_fmt_db(#, Band_Gain[b]), "dB");
    );

    // Q, or resonance for the cuts
    dimq = ui_q_inert(b);
    dial_q.x = dimq ? -100000 : cx + sp; dial_q.y = cy; dial_q.r = 29 * s;
    rv = q_to_per(Band_Q[b], 1.0);
    !dimq && ui_popup == 0 && !ui_block ? (
      v = dial_q.handle_number_dial(rv);
      v != rv ? sv_put(SV_Q, b, per_to_q(v, 1.0));
    );
    ui_dial_face(cx + sp, cy, cut ? "RESONANCE" : "Q", q_to_per(Band_Q[b], 1.0), 0, 0, dimq, sprintf(#, "%.2f", Band_Q[b]), "");

    dyn ? ui_draw_dyn_block(b, hl, y, x + w);

    // Pickers draw last so they sit on top
    ui_popup == 1 ? ui_draw_shape_pop(b) : ui_popup == 2 ? ui_draw_stereo_pop(b) : ui_popup == 7 && dyn ? ui_draw_dyn_source_pop(b);
  ) : ui_popup = 0;

  gfx_setfont(FONT_BASE);
);

////////////////////////////////////////////////////////////////////////////////////////////
// Main execution loop for input and rendering
////////////////////////////////////////////////////////////////////////////////////////////

// Colour changes from the theme editor, while it runs
theme_live();

// Fonts are set every frame: a recompile can keep last_gfx_ext_retina while losing the fonts
(
  last_gfx_ext_retina = gfx_ext_retina;

  // Nothing is drawn in the base font: functions end on it, and its height (ui_th1, gfx_texth) places the graph
  gfx_setfont(FONT_BASE, "Arial", floor(rscale(12, 20) + 0.5), 'b');
  ui_th1 = gfx_texth;

  // The type scale, in points: Caption 10 (small caps, notes, small tile labels), Body 12 (labels, buttons,
  // fields, the graph's axes, the picker tiles), Emphasis 13 bold (values, titles, badges), Display 15 (the
  // wordmark, the stepper's digits)
  ui_font(FONT_CAP, 10, 0);
  ui_font(FONT_CAP_B, 10, 'b');
  ui_font(FONT_BODY, 12, 0);
  ui_font(FONT_BODY_B, 12, 'b');
  ui_font(FONT_EMPH, 13, 'b');
  ui_font(FONT_DISPLAY, 15, 0);
  ui_font(FONT_DISPLAY_B, 15, 'b');
  // Sized to their places: node numbers to fit the node, the wordmark's superscript, the credits card's wordmark
  ui_font(FONT_NODE, 10.5, 'b');
  ui_font(FONT_SUP, 9, 'b');
  ui_font(FONT_LOGO, 30, 0);
  ui_font(FONT_LOGO_B, 30, 'b');
  ui_font(FONT_LOGO_SUP, 17, 'b');
  gfx_setfont(FONT_BASE);
);

// Update any changed filters

update_visual_filters();

// Draw everything

// Background: a faint vertical gradient over the graph
ui_bg_h = max(gfx_h - BOTTOM_MARGIN, 1);
ui_bgi = T_GRAPH_BG * 4; ui_bgj = T_GRAPH_BG_LOW * 4;
gfx_gradrect(0, 0, gfx_w, ui_bg_h, Pal[ui_bgi] / 255, Pal[ui_bgi + 1] / 255, Pal[ui_bgi + 2] / 255, Pal[ui_bgi + 3], 0, 0, 0, 0,
  (Pal[ui_bgj] - Pal[ui_bgi]) / 255 / ui_bg_h, (Pal[ui_bgj + 1] - Pal[ui_bgi + 1]) / 255 / ui_bg_h, (Pal[ui_bgj + 2] - Pal[ui_bgi + 2]) / 255 / ui_bg_h, 0);

Display_Mode != 2 ? (
  spectrum.draw(0);
  SPEC_MODE == 3 || SPEC_MODE == 6 ? spectrum.draw(1);

  Show_PreEQ ? (
    spectrum.draw(2);
    SPEC_MODE == 3 || SPEC_MODE == 6 ? spectrum.draw(3);
  );

  do_listen || listen_node != -1 ? ( 
    spectrum.draw(4);
    SPEC_MODE == 3 || SPEC_MODE == 6 ? spectrum.draw(5);
  );
);

// The ghost spectrum follows the band whose detector node is dragged, else the selected band, else the
// band being listened to, while that band's detector hears a sidechain or is unlinked. @sample feeds it.
// The embedded view leaves it to the window (both run this when both are open).
!UI_EMBED ? (
  ui_gb = ui_ddrag && dyn_ghost_ok(ui_ddrag_b) ? ui_ddrag_b : dyn_ghost_ok(selected_node) ? selected_node : dyn_ghost_ok(Dyn_Listen) ? Dyn_Listen : -1;
  ui_gb != Ghost_Band ? (
    // Another band's (or no) ghost: start from silence
    memset(spectrum.samples6, 0, spectrum.histsize);
    memset(spectrum.bin_y6, 0, spectrum.max_buffer);
    Ghost_Band = ui_gb;
  );
);

// The ghost spectrum shows with the rest of the controls, or while its band's detector is heard
Ghost_Band >= 0 ? (
  ui_ghost_a = Dyn_Listen == Ghost_Band ? 1 : ui_fade;
  ui_ghost_a > 0.01 ? draw_dyn_ghost(Ghost_Band, ui_ghost_a);
);

// ReEQ3: the external spectrum with collisions, the EQ Match preview, and Spectrum Grab's peak
!UI_EMBED && Display_Mode != 2 ? (
  draw_ext_overlay();
  grab_find();
  draw_grab();
);
!UI_EMBED ? grab_follow();
!UI_EMBED ? draw_eqm_preview();

// ReEQ3 Tonal Balance: dropped files, file analysis, the comparison and its overlay; remote editing
!UI_EMBED ? (
  tb_drop();
  TB_FA ? tb_fa_step();
  ui_tb_show ? (
    TB_Seen = time_precise();
    TBT[TB_OVALID] ? tb_compare(TBT);
    ui_tb_show && time_precise() - TB_ExpT > 0.5 ? (tb_export(); TB_ExpT = time_precise());
  );
  !ui_tb_show ? (TB_SoloReq = TB_SoloHold = -1; TB_Fitted = 0);
  tb_rm_on = ui_tb_show && TB_Rmt != 0 && !compact_width && !compact_height && (TB_RmS = rm_slot()) >= 0;
  tb_rm_on ? (gmem[GM_RMT + TB_RmS * RM_SLOT] = time_precise(); rm_pull());
  ui_tb_show && TB_View > 0 && Display_Mode != 2 && !compact_width && !compact_height ? tb_draw_overlay();
);


ht = (gfx_h - BOTTOM_MARGIN - gfx_texth) + 2;

ui_bgi = T_GRAPH_SHADE * 4;
dst_a = Pal[ui_bgi + 3] / ht;
gfx_gradrect(0, ht/2, gfx_w, ht/2, Pal[ui_bgi] / 255, Pal[ui_bgi + 1] / 255, Pal[ui_bgi + 2] / 255, 0,    0, 0, 0, 0, 0, 0, 0, dst_a*2); 

// Draw the lined grid
!very_compact_height && !very_compact_width ? (
  draw_grid();
);
// ReEQ3: the piano
Show_Piano && !UI_EMBED && !compact_height ? draw_piano_strip();

// Set the colors for the bands: fixed per band. They're still written to Band_Red/Green/Blue,
// which the state saves, so older versions keep loading projects.
band = 0;
loop(NUM_BANDS, (
    ui_band_col(band);
    Band_Red[band] = gfx_r; Band_Green[band] = gfx_g; Band_Blue[band] = gfx_b;
    band += 1;
  );
);

!tb_rm_on ? draw_filter_bands();

// Determine which filter response curves to draw
drawMid = 0;
drawSide = 0;
drawLeft = 0;
drawRight = 0;

idx = 0;
while ( 
  Band_Enabled[idx] == BAND_STATE_ENABLED ? (
    Band_Group[idx] == 1 ? drawMid = 1 :
      Band_Group[idx] == 2 ? drawSide = 1 :
        Band_Group[idx] == 3 ? drawLeft = 1 :
          Band_Group[idx] == 4 ? drawRight = 1;      
  );
  idx += 1;
  idx < NUM_BANDS;
);

// Mid
!tb_rm_on && drawMid ? draw_filter_response(1, T_CURVE_MID);

// Side
!tb_rm_on && drawSide ? draw_filter_response(2, T_CURVE_SIDE);

// Left
!tb_rm_on && drawLeft ? draw_filter_response(3, T_CURVE_LEFT);

// Right
!tb_rm_on && drawRight ? draw_filter_response(4, T_CURVE_RIGHT);

// ReEQ3: Luftikus mode's own curve
draw_lf_curve();

// Stereo
!tb_rm_on ? draw_filter_response(0, T_CURVE);
// ReEQ3: another instance being edited from here: its curve and nodes instead
tb_rm_on ? rm_draw();

// Dynamic bands: their static settings while they move
!tb_rm_on ? draw_dyn_static();

// The header goes over anything that reaches above the graph
ui_draw_header();

// What shows while the mouse is over the window (nodes, hover card, toolbar, top buttons, panel)
// fades in and out with a smoothstep instead of popping
ui_vis = mouse_within_window() || button_focus != -1 || node_drag_mode != 0 || is_box_dragging() || ui_popup != 0;
ui_ft = time_precise();
ui_fdt = min(max(ui_ft - ui_flast, 0), 0.1);
ui_flast = ui_ft;
ui_fraw = ui_vis ? min(1, ui_fraw + ui_fdt / 0.15) : max(0, ui_fraw - ui_fdt / 0.3);
ui_fade = ui_fraw * ui_fraw * (3 - 2 * ui_fraw);

// Mid-fade, keep a copy of the graph as it is now; the end of the frame blends it back over
// those elements at 1 - fade, so they fade with their own translucency intact
ui_fading = ui_fade > 0 && ui_fade < 1;
ui_fading ? (
  ui_snap_w != gfx_w || ui_snap_h != gfx_h ? (gfx_setimgdim(100, gfx_w, gfx_h); ui_snap_w = gfx_w; ui_snap_h = gfx_h);
  gfx_dest = 100; gfx_x = gfx_y = 0; gfx_a = 1; gfx_mode = 2;
  gfx_blit(-1, 1, 0);
  gfx_dest = -1; gfx_mode = 0;
);

ui_fade > 0 ? (

  do_listen || listen_node != -1 ? draw_listen_helper();

  !very_compact_height && !very_compact_width ? (
    !tb_rm_on ? draw_info_panel();
  );

  !tb_rm_on ? (
    draw_dyn_range();
    draw_dyn_detectors();
    draw_nodes();
  );
) : ( 
  ui_rh_on = 0;
  listen_node != -1 ? draw_listen_helper();
  node_drag_mode != 0 || is_box_dragging() ? (
    !tb_rm_on ? (
      draw_info_panel();
      draw_nodes();
    );
  );
);

initialise_gfx == 0 ? ( 
  initialise_gfx = 1;


  spectrum.set_show_peaks(Show_Peaks);
);

// Animate glowing halos for node selection
glow_node_selection_halo();

// A press in the header, or a right press on the toolbar, belongs to them: node selection,
// box select and the node menu sit it out until the button is released
(ui_press || ui_rpress) && mouse_y < HEADER_H ? ui_chrome_press = 1;
(ui_press || ui_rpress) && !compact_width && !compact_height && ui_in(ui_dbb_x, ui_dbb_y, ui_dbb_w, ui_dbb_h) ? ui_chrome_press = 1;
ui_rpress && BOTTOM_MARGIN > 0 && mouse_y >= gfx_h - BOTTOM_MARGIN ? ui_chrome_press = 1;
!(mouse_cap & 3) ? ui_chrome_press = 0;

// A detector node: a press on it selects its band and drags the detector's frequency
// (a band node over the ring comes first)
ui_press && ui_fade > 0 && ui_free() && !mouse_within_panel() && get_nearest_node() == -1 && (ui_dh = dyn_det_hit()) >= 0 ? (
  ui_ddrag = 1; ui_ddrag_b = ui_dh; ui_ddrag_off = dyn_det_nx(ui_dh) - mouse_x; button_focus = -51; ui_ddrag_moved = 0;
  selected_node = ui_dh; ui_select_only(ui_dh);
);
ui_ddrag && (mouse_cap & 1) ? (
  ui_df = min(max(scx_to_freq(mouse_x + ui_ddrag_off), 20), min(20000, 0.45 * srate));
  ui_df != Band_Dyn_DetFreq[ui_ddrag_b] ? (Band_Dyn_DetFreq[ui_ddrag_b] = ui_df; flag_filter_update(ui_ddrag_b); ui_ddrag_moved = 1);
);

// The range handle: a press on it drags the band's range (snapped to 0.1dB), the knob following
ui_press && ui_rh_on && ui_free() && !mouse_within_panel() && sqr(mouse_x - ui_rh_x) + sqr(mouse_y - ui_rh_y) < sqr(ui_pt(7)) ? (
  ui_rdrag = 1; ui_rdrag_b = ui_rh_b; button_focus = -50;
  ui_rdrag_y = mouse_y; ui_rdrag_r = Band_Dynamic_Range[ui_rh_b];
);
ui_rdrag && (mouse_cap & 1) ? (
  // Relative to the press, so a press alone (or on a handle held at the graph's edge) changes nothing
  ui_rv = min(max(floor((ui_rdrag_r + y_to_db(mouse_y) - y_to_db(ui_rdrag_y)) * 10 + 0.5) / 10, -DYN_RANGE_MAX), DYN_RANGE_MAX);
  ui_rv != Band_Dynamic_Range[ui_rdrag_b] ? sv_put(SV_RANGE, ui_rdrag_b, ui_rv);
);

// ReEQ3: a value box without Alt (Linux window managers keep Alt+click): right-click a dial or field,
// or start typing over it (the first key goes into the box)
ui_popup == 0 && !ui_block && node_drag_mode == 0 && button_focus == -1 ? (
  ui_rpress && (ui_kh = sv_hit()) >= 0 ? (
    sv_open(ui_kh); ui_rpress = 0;
  ) : ui_key >= 32 && ui_key < 127 && (ui_kh = sv_hit()) >= 0 ? (
    sv_open(ui_kh);
    #sv_ch = " "; str_setchar(#sv_ch, 0, ui_key); strcpy(#sv_text, #sv_ch);
    ui_key = 0;
  );
);

do_general_mouse = ui_popup == 0 && !ui_block && !ui_chrome_press && !ui_rdrag && !ui_ddrag;
// ReEQ3: editing another instance, the graph's mouse is that instance's
tb_rm_on && do_general_mouse ? (
  tb_rm_in = !mouse_within_panel() && mouse_y > HEADER_H && mouse_y < gfx_h - BOTTOM_MARGIN;
  (tb_rm_in || TB_RmDrag >= 0) ? (rm_mouse(tb_rm_in ? mouse_wheel - last_wheel : 0); do_general_mouse = 0);
);

// While it sits out, keep its state current: a release must not act on a press it never saw,
// wheel movement must not pile up, and listen ends with the modifier
!do_general_mouse ? (
  click_held = 0;
  last_wheel = mouse_wheel;
  !(mouse_cap & 8) && do_listen != 0 ? (do_listen = 0; listen_filter.ivf_bypass());
);
do_general_mouse ? (
  // Right mouse click?
  mouse_cap & 2 ? ( 
    band = 0;
    while( 
      Band_Enabled[band]!=BAND_STATE_OFF && is_node_selected(band) ? (
        // A node outside the selection becomes the selection (Cmd adds it instead);
        // a node inside it keeps the selection, so the card acts on all of them
        !Band_Selected[band] && !(mouse_cap & 4) ? select_node_clear();
        select_node(band);

        selected_node = band;
        selected_node_group = Band_Group[band];

        // The action card, or the native menu where the window is too small for it
        !compact_width && !compact_height ? (
          ui_popup = 3; ui_card_band = band; ui_card_x = mouse_x; ui_card_y = mouse_y; ui_pop_skip = 1;
        ) : (
          #menu = "";
          Band_Enabled[band] == BAND_STATE_DISABLED ? #menu += "Enable" : #menu += "Disable";
          #menu += "|Invert Gain";
          #menu += "|Zero Gain";
          #menu += "||>Shape|";
          Band_Type[band] == 0 ? #menu += "!"; #menu += "Bell|";
          Band_Type[band] == 1 ? #menu += "!"; #menu += "Low Cut|";
          Band_Type[band] == 2 ? #menu += "!"; #menu += "Low Cut BW|";
          Band_Type[band] == 12 ? #menu += "!"; #menu += "Vintage Lo|";
          Band_Type[band] == 3 ? #menu += "!"; #menu += "Low Shelf|";
          Band_Type[band] == 4 ? #menu += "!"; #menu += "High Shelf|";
          Band_Type[band] == 5 ? #menu += "!"; #menu += "High Cut|";
          Band_Type[band] == 6 ? #menu += "!"; #menu += "High Cut BW|";
          Band_Type[band] == 13 ? #menu += "!"; #menu += "Vintage Hi|";
          Band_Type[band] == 7 ? #menu += "!"; #menu += "Notch|";
          Band_Type[band] == 8 ? #menu += "!"; #menu += "Band Pass|";
          Band_Type[band] == 9 ? #menu += "!"; #menu += "Tilt Shelf|";
          Band_Type[band] == 10 ? #menu += "!"; #menu += "Pultec Low|";
          Band_Type[band] == 11 ? #menu += "!"; #menu += "<All Pass|";

          // Only slope for cut filters
          has_slope_menu = 0;
          Band_Type[band] == FILTER_LOW_CUT || Band_Type[band] == FILTER_LOW_CUT_BUTTERWORTH || Band_Type[band] == FILTER_HIGH_CUT || Band_Type[band] == FILTER_HIGH_CUT_BUTTERWORTH ? (
            #menu += ">Slope|";

            slope = 0;
            while(
              match("%ddB", FilterSlopes[slope], value);

              Band_Slope[band] == ((value / 6)-1) ? #menu += "!";
              slope == NumFilterSlopes-1 ? #menu += "<";
              #menu += FilterSlopes[slope]; #menu += "|";

              slope += 1;
              slope < NumFilterSlopes;
            );
            has_slope_menu = 1;
          );

          #menu += ">Stereo Placement|";
          Band_Group[band] == 0 ? #menu += "!"; #menu += "Stereo|";
          Band_Group[band] == 1 ? #menu += "!"; #menu += "Mid|";
          Band_Group[band] == 2 ? #menu += "!"; #menu += "Side|";
          Band_Group[band] == 3 ? #menu += "!"; #menu += "Left|";
          Band_Group[band] == 4 ? #menu += "!"; #menu += "<Right|";

          #menu += "|Split|Duplicate|Delete";

          gfx_x = mouse_x;
          gfx_y = mouse_y;

          last_clicked_item = gfx_showmenu(#menu);

          last_clicked_item == 1 ? (
            toggle_nodes_enabled(band);
          );

          last_clicked_item == 2 ? (
            invert_nodes_gain();
          );

          last_clicked_item == 3 ? (
            zero_nodes_gain();
          );

          last_clicked_item >= 4 && last_clicked_item <= 17 ? (
            set_shape_selected_nodes(last_clicked_item - 4, has_slope_menu);
          );

          has_slope_menu ? (
            last_clicked_item >= 18 && last_clicked_item <= 27 ? (
              match("%ddB", FilterSlopes[last_clicked_item - 18], value);

              set_slopes_selected_nodes((value / 6) - 1);
            );
          ) : last_clicked_item += 10;

          last_clicked_item >= 28 && last_clicked_item <= 32 ? (
            stereo_selected_nodes(last_clicked_item - 28);
          );

          last_clicked_item == 33 ? (
            split_selected_nodes();
          );

          last_clicked_item == 34 ? (
            duplicate_selected_nodes();
          );

          last_clicked_item == 35 ? (
            delete_selected_nodes();
          );
        );

        band = NUM_BANDS;
      );
      band += 1;
      band < NUM_BANDS;
    );
  );

  (!(mouse_cap & 1)) && click_held ? (
    box_region_drag_mode = 0;
  );

  // Mouse button 1 lifted when CMD held down
  (!(mouse_cap & 1)) && click_held == 1 ? (
    band = get_nearest_node();
    band != -1 ? (
      // In some cases clicking and lifting on a node deselects it
      //!dont_deselect_node ? deselect_node(band);

      !dont_deselect_node ? (
        //select_node_clear();
        deselect_node(band);
      ) : (
        //select_node_clear();
        select_node(band);
      );

    );
    click_held = 0;
    dont_deselect_node = 0;
  );

  // Mouse button 1 lifted when CMD not held down
  (!(mouse_cap & 1)) && click_held == 2 ? (
    band = get_nearest_node();
    band != -1 ? (
      // In some cases clicking and lifting on a node deselects it
      //!dont_deselect_node ? deselect_node(band);

      !dont_deselect_node ? select_node_clear();
      select_node(band);

    );
    click_held = 0;
    dont_deselect_node = 0;
  );

  // Left mouse click?
  mouse_cap & 1 ? (
    (mouse_cap & 4) ? click_held = 1 : click_held = 2;
    
    click_up ? (
      tm = time_precise();
      // The value (dial, knob or field) pressed, if any; a double click needs both presses on it
      ui_sv_hit = sv_hit();

      // Double click?
      tm - click_time < 0.4 ? (
        // On a value, a double click resets it to its default (the slope too); Alt opens its stepper
        ui_sv_hit >= 0 && ui_sv_hit == ui_sv_click ? (
          mouse_cap & 16 ? sv_open(ui_sv_hit) : (
            sv_spec(ui_sv_hit, selected_node);
            sv_set(ui_sv_hit, selected_node, sv_def);
          );
        ) : !(mouse_cap & 16) && selected_node != -1 && mouse_within_panel() && dial_slope.is_mouse_number_dial() ? (
          set_node_slope(selected_node, 1);
          filters_to_sliders();
          flag_filter_update_all();
        ) : (
          // Handle general double click cases
          !mouse_within_panel() ? (
            // Delete band?
            mouse_cap & 16 ? (
              band = 0;
              while( 
                Band_Enabled[band]!=BAND_STATE_OFF && is_node_selected(band) ? (
                  selected_node = -1;
                  listen_node = -1;
                  Band_Enabled[band] = BAND_STATE_OFF;

                  band == 0 ? gfx_band1.filter.ri_visual_off() :
                  band == 1 ? gfx_band2.filter.ri_visual_off() :
                  band == 2 ? gfx_band3.filter.ri_visual_off() :
                  band == 3 ? gfx_band4.filter.ri_visual_off() :
                  band == 4 ? gfx_band5.filter.ri_visual_off() :
                  band == 5 ? gfx_band6.filter.ri_visual_off() :
                  band == 6 ? gfx_band7.filter.ri_visual_off() :
                  band == 7 ? gfx_band8.filter.ri_visual_off();
                  band == 8 ? gfx_band9.filter.ri_visual_off() :
                  band == 9 ? gfx_band10.filter.ri_visual_off() :
                  band == 10 ? gfx_band11.filter.ri_visual_off() :
                  band == 11 ? gfx_band12.filter.ri_visual_off() :
                  band == 12 ? gfx_band13.filter.ri_visual_off() :
                  band == 13 ? gfx_band14.filter.ri_visual_off() :
                  band == 14 ? gfx_band15.filter.ri_visual_off() :
                  band == 15 ? gfx_band16.filter.ri_visual_off();

                  flag_filter_update(band);

                  filters_to_sliders();

                  band = NUM_BANDS;
                );
                band += 1;
                band < NUM_BANDS;
              );
            ) : (
              // Band toggle?
              toggled_band = 0;
              band = 0;
              while( 
                 Band_Enabled[band]!=BAND_STATE_OFF && is_node_selected(band) ? (
                  Band_Enabled[band]==BAND_STATE_DISABLED ? Band_Enabled[band] = BAND_STATE_ENABLED : Band_Enabled[band] = BAND_STATE_DISABLED;
                  toggled_band = 1;
                  band = NUM_BANDS;
                );
                band += 1;
                band < NUM_BANDS;
              );

              // Create band?
              !toggled_band && mouse_y < gfx_h - BOTTOM_MARGIN - gfx_texth ? ( 
                band = 0;
                while(
                  Band_Enabled[band]==BAND_STATE_OFF ? (                
                    create_band(band, mouse_x+1, mouse_y);
                    band = NUM_BANDS;
                  );
                  band += 1;
                  band < NUM_BANDS;
                );
              );
            );
          );
        );
      );
      click_time = tm;
      ui_sv_click = ui_sv_hit;
    );

    click_up = 0;

    !mouse_within_panel() && node_drag_mode == 0 && box_region_drag_mode == 0 && button_focus == -1 ? (
      band = get_nearest_node();
      band != -1 ? (

        is_node_group_selected(band) ? (
          dont_deselect_node = 0;
        ) : (
          dont_deselect_node = 1;
        );

        (mouse_cap & 4) ? (
          select_node(band);          
        ) : (
          !is_node_group_selected(band) ? select_node_clear();
          select_node(band);          
        );

        //jj
        selected_node = band;
        selected_node_group = Band_Group[band];
        node_drag = band;
        node_drag_mode = 1;
        node_drag_origy = mouse_y;
        node_drag_offy = mouse_y - db_to_y(Band_Gain[band]);
        node_drag_offx = mouse_x - freq_to_scx(Band_Frequency[band]);

        node_drag_stablex = mouse_x;
        node_drag_stabley = mouse_y;

        set_node_drag_offsets(band, mouse_x, mouse_y);

        mouse_cap & 4 ? ( 
          node_drag_lock = 1;
        ) : node_drag_lock = 0;
      ) : (
        // ReEQ3: a press on a peak Spectrum Grab has lit makes a bell there and drags it
        ui_grab && ui_press && (ui_grab_f_held = ui_grab_f; grab_press() < NUM_BANDS) ? ui_grab = 0 :
        // mouse_cap & 8 is here to check for listen mode...
        mouse_y < gfx_h - BOTTOM_MARGIN - gfx_texth && !(mouse_cap & 8)  ? (

          !(mouse_cap & 4) ? select_node_clear();

          selected_node = -1;

          !box_region_drag_mode ? (
            preserve_node_selected_states();
            mouse_cap & 4 ? box_region_drag_mode = 2 : box_region_drag_mode = 1;
            select_box_x = mouse_x;
            select_box_y = mouse_y;
          );
        );
        listen_node = -1;        
      );
    );

    node_drag_mode ? (

      mouse_cap & 16 ? (
        node_drag_mouse_speed == 1 ? (
          // Changing speed - reset offsets
          set_node_drag_offsets(node_drag, mouse_x, mouse_y);
          node_drag_stablex = mouse_x;
          node_drag_stabley = mouse_y;
        );

        node_drag_mouse_speed = 6;
      ) : (
        node_drag_mouse_speed == 6 ? (
          // Changing speed - reset offsets
          set_node_drag_offsets(node_drag, mouse_x, mouse_y);
          node_drag_stablex = mouse_x;
          node_drag_stabley = mouse_y;
          0;
        );

        node_drag_mouse_speed = 1;
      );

      mouse_cap & 4 ? (
        node_drag_lock = 1;
      ) : (
        node_drag_lock != 0 ? (
          // Reset offsets
          set_node_drag_offsets(node_drag, mouse_x, mouse_y);
          node_drag_stablex = mouse_x;
          node_drag_stabley = mouse_y;
        );
        node_drag_lock = 0;
      );

      // Normal drag?
      node_drag_lock == 0 ? (
        // Don't deselect node when mouse click lifted
        (mouse_x != node_drag_stablex || mouse_y != node_drag_stabley) ? dont_deselect_node = 1;

        node_drag_origy = mouse_y;

        diffx = ((mouse_x - node_drag_stablex) / node_drag_mouse_speed) + ofx;
        diffy = (node_drag_stabley - mouse_y) / node_drag_mouse_speed;
        
        update_drag_nodes_position(node_drag_stablex, node_drag_stabley, diffx, diffy);
      );

      // Fixed gain with Q control drag?
      node_drag_lock == 1 ? (
        // Don't deselect node when mouse click lifted
        (mouse_x != node_drag_stablex || mouse_y != node_drag_stabley) ? dont_deselect_node = 1;

        diffx = (mouse_x - node_drag_stablex) / node_drag_mouse_speed;
        diffy = (node_drag_stabley - mouse_y) / node_drag_mouse_speed;

        md = (node_drag_origy - mouse_y) / node_drag_mouse_speed;
        node_drag_origy = mouse_y;

        update_drag_nodes_Q(node_drag_stablex, node_drag_stabley, diffx, diffy, md);
      );

      flag_filter_update(node_drag);
    );

  ) : (
    node_drag_mode = 0;
    node_drag_lock = 0;
    click_up = 1;
  );

  // Enable or disable listen mode
  mouse_cap & 8 && !box_region_drag_mode ? (
    do_listen == 0 ? ( 
      do_listen = 1;
    );
  ) : (
    do_listen != 0 ? ( 
      do_listen = 0;
      listen_filter.ivf_bypass();
    );
  );

  // Get mouse wheel movements
  mw = mouse_wheel;
  md = -(mw - last_wheel) / 120;
  last_wheel = mw;

  // Over a detector node the wheel sets the detector's width, as it sets Q over a node
  md != 0 && ui_fade > 0 && get_nearest_node() == -1 && (ui_dh = dyn_det_hit()) >= 0 ? (
    Band_Dyn_DetWidth[ui_dh] = min(max(dyn_det_width(ui_dh) * 2 ^ (md * 0.15), 0.25), 8);
    flag_filter_update(ui_dh);
    notify_dyn_state(ui_dh);
    md = 0;
  );

  md != 0.0 ? ( 
    done_band = 0;

    band = get_nearby_node();
    band != -1 ? (
        done_band = 1;
        mouse_cap & 4 ? (
          // Alter filter slope (with Shift too, in 1 dB/oct steps)
          md < 0 ? md = -1;
          md > 0 ? md = 1;

          Band_Selected[band] ? (
            update_selected_nodes_scroll_slope(md);
          ) : (
            update_node_scroll_slope(band, md);
          );
        ) : (
          // Alter filter Q
          // If we're selecting a band then affect all other selected bands. Otherwise only
          // affect the closest band.      
          Band_Selected[band] ? (
            update_selected_nodes_scroll_Q(md);
          ) : (
            update_node_scroll_Q(band, md);
          );
        );

        flag_filter_update(band);
    );

    // Shift held and not on a band?  Alter freeform listen width
    mouse_cap & 8 && done_band == 0 ? ( 
      listen_width -= md / 200;
      listen_width = min(0.30, listen_width);
      listen_width = max(0.01, listen_width);
    );
  );
);

box_region_drag_mode ? (
  // Draw node selector region
  ui_cola(T_HIGHLIGHT, 0.4);

  box_x = min(mouse_x, select_box_x);
  box_y = min(mouse_y, select_box_y);
  box_xx = max(mouse_x, select_box_x);
  box_yy = max(mouse_y, select_box_y);
  box_yy = min(box_yy, gfx_h - BOTTOM_MARGIN - gfx_texth);

  gfx_rect(box_x, box_y, box_xx - box_x, box_yy - box_y);

  ui_cola(T_HIGHLIGHT, 0.8);
  gfx_x = box_x; gfx_y = box_y;
  gfx_lineto(box_xx, box_y);
  gfx_lineto(box_xx, box_yy);
  gfx_lineto(box_x, box_yy);
  gfx_lineto(box_x, box_y);

  // Select the nodes within this region
  select_nodes_in_box(box_x, box_y, box_xx, box_yy, box_region_drag_mode);
);

// Bottom toolbar, top-right controls and the node panel

// Close a picker when its band or the panel goes away, or on Escape
(ui_popup == 1 || ui_popup == 2 || ui_popup == 7) && (!ShowPanel || selected_node < 0 || Band_Enabled[selected_node] == BAND_STATE_OFF || ui_key == 27) ? ui_popup = 0;
ui_popup == 7 && !ui_dyn_panel ? ui_popup = 0;
// Listen to a detector only while its band is dynamic
Dyn_Listen >= 0 && !(Band_Dyn_On[Dyn_Listen] && band_dyn_capable(Band_Type[Dyn_Listen]) && Band_Enabled[Dyn_Listen] != BAND_STATE_OFF) ? Dyn_Listen = -1;
ui_popup == 3 && (compact_width || compact_height || Band_Enabled[ui_card_band] == BAND_STATE_OFF || ui_key == 27) ? ui_popup = 0;
(ui_popup == 4 || ui_popup == 5) && (compact_height || compact_width || ui_key == 27) ? ui_popup = 0;
ui_popup == 6 && (compact_width || compact_height || ui_key == 27) ? ui_popup = 0;
ui_popup == 8 && (UI_EMBED || ui_key == 27) ? ui_popup = 0;
(ui_popup == 10 || ui_popup == 11) && (compact_height || compact_width || ui_key == 27) ? (ui_popup = 0; ui_inst_edit = 0);
ui_popup == 0 && ui_lf_show && ui_key == 27 ? ui_lf_show = 0;
ui_popup == 0 && ui_tb_show && ui_key == 27 ? ui_tb_show = 0;
// The value stepper, when its control goes away or turns inert
ui_popup == 9 && (ui_key == 27 || !sv_live(ui_sv_id, ui_sv_b)) ? ui_popup = 0;

// Output peak meter: the audio side holds the peak since the last frame, this side decays it
ui_t = time_precise();
ui_dt = min(max(ui_t - ui_last_t, 0), 0.5);
ui_t - ui_last_t > 0.5 ? (out_pk0 = out_pk1 = 0; ui_pk0 = ui_pk1 = 0; in_pk0 = in_pk1 = 0; ui_ipk0 = ui_ipk1 = 0;
                          ui_clipo_raw = ui_clipi_raw = ui_clipo_hold = ui_clipi_hold = 0);
ui_last_t = ui_t;
// Clip alerts: over 0 dBFS the field's frame fades to red (0.08 s), holds 0.6 s after the last clip,
// then fades back (0.8 s), eased with a smoothstep
max(out_pk0, out_pk1) >= 1 ? (ui_clipo_hold = 0.6; ui_clipo_raw = min(1, ui_clipo_raw + ui_dt / 0.08)) :
  ui_clipo_hold > 0 ? ui_clipo_hold -= ui_dt : ui_clipo_raw = max(0, ui_clipo_raw - ui_dt / 0.8);
max(in_pk0, in_pk1) >= 1 ? (ui_clipi_hold = 0.6; ui_clipi_raw = min(1, ui_clipi_raw + ui_dt / 0.08)) :
  ui_clipi_hold > 0 ? ui_clipi_hold -= ui_dt : ui_clipi_raw = max(0, ui_clipi_raw - ui_dt / 0.8);
ui_clip_out = ui_clipo_raw * ui_clipo_raw * (3 - 2 * ui_clipo_raw);
ui_clip_in = ui_clipi_raw * ui_clipi_raw * (3 - 2 * ui_clipi_raw);

ui_pk0 = max(out_pk0, ui_pk0 * 10 ^ (-1.2 * ui_dt));
ui_pk1 = max(out_pk1, ui_pk1 * 10 ^ (-1.2 * ui_dt));
out_pk0 = out_pk1 = 0;
ui_ipk0 = max(in_pk0, ui_ipk0 * 10 ^ (-1.2 * ui_dt));
ui_ipk1 = max(in_pk1, ui_ipk1 * 10 ^ (-1.2 * ui_dt));
in_pk0 = in_pk1 = 0;

// ui_draw_top and ui_draw_bar record the buttons they drew; the mouse code reads them next frame
ui_top_h = 0;
// ui_draw_dyn_block records the dynamics grid when it draws it
ui_dyn_shown = 0;
ui_fade > 0 ? (
  !compact_height && !compact_width ? ui_draw_bar();
  !compact_height && !compact_width ? ui_draw_top();
  // ReEQ3: the Luftikus panel takes the band panel's place while shown; picking a band closes it
  ui_lf_show && selected_node != ui_lf_sel && selected_node != -1 ? ui_lf_show = 0;
  ui_lf_sel = selected_node;
  ui_tb_show && !compact_width && !compact_height ? ui_draw_tb_panel() :
  ui_lf_show && !compact_width && !compact_height ? ui_draw_lf_panel() :
  ShowPanel && selected_node != -1 ? ui_draw_panel();
  ui_popup == 3 ? ui_draw_node_card();
  ui_popup == 4 ? ui_draw_analyzer_pop();
  ui_popup == 5 ? ui_draw_settings_pop();
  ui_popup == 6 ? ui_draw_range_pop();
  ui_popup == 8 ? ui_draw_credits();
  ui_popup == 9 ? ui_draw_stepper();
  ui_popup == 10 ? ui_draw_inst_pop();
  ui_popup == 11 ? ui_draw_proc_pop();
);

// Mid-fade: blend the graph saved earlier back over the fading elements
ui_fading ? (
  gfx_dest = -1; gfx_x = gfx_y = 0; gfx_a = 1 - ui_fade; gfx_mode = 2;
  gfx_blit(100, 1, 0);
  gfx_mode = 0; gfx_a = 1;
);

gainDb = 2 ^ (Gain/6);
gainIn = 2 ^ (InGain/6);
gainML = 2 ^ (MLGain/6);
gainSR = 2 ^ (SRGain/6);

gfx_r = gfx_g = gfx_b = gfx_a = 1.0; gfx_x = 100; gfx_y = 120;

//Band_Enabled[0] != 0 ? _global.test = Band_Enabled[0];

//gfx_printf("Global = %d", _global.test);  gfx_x = 100; gfx_y += 30;



//gfx_printf("gain_diff         = %f", diffdb);  gfx_x = 100; gfx_y += 120;

// gfx_printf("gain_diff         = %f", gain_diff);  gfx_x = 100; gfx_y = 120;

// gfx_printf("srate         = %f", srate);  gfx_x = 100; gfx_y = 120;
//gfx_printf("bands enabled = %d %d %d %d %d %d %d %d", Band_Enabled[0], Band_Enabled[1], Band_Enabled[2], Band_Enabled[3], Band_Enabled[4], Band_Enabled[5], Band_Enabled[6], Band_Enabled[7]);  gfx_x = 100; gfx_y = 180;


// Embedded: a click over a node stays here, so nodes drag in place, without REAPER's tooltip in the
// way; a click anywhere else opens the full window (0x200, REAPER 7.45+; 0x400, REAPER 7.79+).
// Bits 1 and 2 are REAPER's and are kept.
UI_EMBED ? (
  ui_on_node = node_drag_mode != 0 || get_nearest_node() != -1;
  gfx_ext_flags = (gfx_ext_flags & 0xFF) | 0x100 | (ui_on_node ? 0x400 : 0x200);
) : (
  gfx_ext_flags = (gfx_ext_flags & 0xFF) | 0x100;
);

// Remember the mouse buttons for the next frame's fresh-press test
ui_prev_cap = mouse_cap;
