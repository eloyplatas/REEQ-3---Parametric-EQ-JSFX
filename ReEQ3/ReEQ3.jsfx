  Band_Update[12] && (Band_Dyn_On[12] || AF_Clock>=AF_Due[12]) ? (AF_Due[12]=AF_Clock+32; Band_Update[12] = 0; Band_Enabled[12] != BAND_STATE_ENABLED ? band13.band_off() :
