  Band_Update[9] && (Band_Dyn_On[9] || AF_Clock>=AF_Due[9]) ? (AF_Due[9]=AF_Clock+32; Band_Update[9] = 0; Band_Enabled[9] != BAND_STATE_ENABLED ? band10.band_off() :
