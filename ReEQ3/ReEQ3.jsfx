    Band_Dyn_On[14] && band_dyn_capable(Band_Type[14]) ? band15.band_dyn_set_filter(14, band_scalar) :
    (band15.band_dyn_reset(); band15.band_set_filter(Band_Type[14], Band_Frequency[14], Band_Gain[14] * band_scalar, band_q_eff(14, Band_Gain[14] * band_scalar), Band_Slope[14])); );
  Band_Update[15] && (Band_Dyn_On[15] || AF_Clock>=AF_Due[15]) ? (AF_Due[15]=AF_Clock+32; Band_Update[15] = 0; Band_Enabled[15] != BAND_STATE_ENABLED ? band16.band_off() :
    Band_Dyn_On[15] && band_dyn_capable(Band_Type[15]) ? band16.band_dyn_set_filter(15, band_scalar) :
    (band16.band_dyn_reset(); band16.band_set_filter(Band_Type[15], Band_Frequency[15], Band_Gain[15] * band_scalar, band_q_eff(15, Band_Gain[15] * band_scalar), Band_Slope[15])); );
);

/*
 * Auto gain
 *
 * The make-up gain is worked out from the EQ curve, not measured from the audio:
 * it is the gain that keeps pink noise at the same K-weighted (LUFS) loudness.
 * Each band's power response is sampled at AG_POINTS log spaced frequencies
 * and cached, and only re-measured when that band changes.
 */

/*
 * Power response of a biquad at w radians per sample
 */
function biquad_power(b0, b1, b2, a1, a2, w) local(c1, s1, c2, s2, nr, ni, dr, di) (
  c1 = cos(w); s1 = sin(w);
  c2 = cos(2 * w); s2 = sin(2 * w);
  nr = b0 + b1 * c1 + b2 * c2; ni = -(b1 * s1 + b2 * s2);
  dr = 1 + a1 * c1 + a2 * c2; di = -(a1 * s1 + a2 * s2);
  (nr * nr + ni * ni) / (dr * dr + di * di);
);

/*
 * Frequencies and weights. Pink noise has equal power per octave, so on a log
 * spaced grid its weight is flat and only the K-weighting (ITU-R BS.1770, its
 * 48kHz coefficients) remains. Points at or above Nyquist are left out.
 */
function ag_init_weights() local(i, w) (
  i = 0;
  loop(AG_POINTS,
    AG_Freq[i] = 20 * 1000 ^ (i / (AG_POINTS - 1));
    w = 2 * $pi * AG_Freq[i] / 48000;
    AG_Weight[i] = AG_Freq[i] < srate * 0.5 ?
      biquad_power(1.53512485958697, -2.69169618940638, 1.19839281085285, -1.69065929318241, 0.73248077421585, w) *
      biquad_power(1, -2, 1, -1.99004745483398, 0.99007225036621, w) : 0;
    i += 1;
  );
);

/*
 * Measure one band's power response into its row of AG_Power
 */
function ag_measure(b) instance(filter) local(i, m, p) (
  p = AG_Power + b * AG_POINTS;
  Band_Enabled[b] == BAND_STATE_ENABLED ? (
    this.band_set_meter(Band_Type[b], Band_Frequency[b], Band_Gain[b] * Scale / 100.0, band_q_eff(b, Band_Gain[b] * Scale / 100.0), Band_Slope[b]);

    i = 0;
    loop(AG_POINTS,
      m = filter.ri_magnitude(AG_Freq[i]);
      p[i] = m * m;
      i += 1;
    );
  ) : (
    memset(p, 1, AG_POINTS);
  );
);

function ag_measure_band(b) (
    b == 0 ? ag_band1.ag_measure(0) :
    b == 1 ? ag_band2.ag_measure(1) :
    b == 2 ? ag_band3.ag_measure(2) :
    b == 3 ? ag_band4.ag_measure(3) :
    b == 4 ? ag_band5.ag_measure(4) :
    b == 5 ? ag_band6.ag_measure(5) :
    b == 6 ? ag_band7.ag_measure(6) :
    b == 7 ? ag_band8.ag_measure(7) :
    b == 8 ? ag_band9.ag_measure(8) :
    b == 9 ? ag_band10.ag_measure(9) :
    b == 10 ? ag_band11.ag_measure(10) :
    b == 11 ? ag_band12.ag_measure(11) :
    b == 12 ? ag_band13.ag_measure(12) :
    b == 13 ? ag_band14.ag_measure(13) :
    b == 14 ? ag_band15.ag_measure(14) :
    b == 15 ? ag_band16.ag_measure(15);
);

/*
 * Re-measure changed bands and recompute the make-up gain (AG_Target)
 */
function update_auto_gain() local(b, i, changed, pw, gm, gs, group, sum, wsum) (
  changed = 0;
  b = 0;
  loop(NUM_BANDS,
    // Group and enabled changes don't always flag the band
    Band_Group[b] != AG_Group[b] || Band_Enabled[b] != AG_Enabled[b] ? (
      AG_Group[b] = Band_Group[b];
      AG_Enabled[b] = Band_Enabled[b];
      Band_AgUpdate[b] = 1;
    );
    Band_AgUpdate[b] ? (
      Band_AgUpdate[b] = 0;
      ag_measure_band(b);
      changed = 1;
    );
    b += 1;
  );

  changed ? (
    sum = wsum = 0;
    i = 0;
    loop(AG_POINTS,
      // Power gain on the mid and side parts of the signal. A left or right
      // band changes half the power of both.
      gm = gs = 1;
      b = 0;
      loop(NUM_BANDS,
        Band_Enabled[b] == BAND_STATE_ENABLED ? (
          pw = AG_Power[b * AG_POINTS + i];
          group = Band_Group[b];
          group == 0 ? (gm *= pw; gs *= pw) :
            group == 1 ? gm *= pw :
              group == 2 ? gs *= pw :
                (pw = (pw + 1) * 0.5; gm *= pw; gs *= pw);
        );
        b += 1;
      );
      sum += AG_Weight[i] * (AG_MID_SHARE * gm + (1 - AG_MID_SHARE) * gs);
      wsum += AG_Weight[i];
      i += 1;
    );

    AG_Target = sum > 0 && wsum > 0 ? sqrt(wsum / sum) : 1;
    AG_Target = min(max(AG_Target, AG_MIN), AG_MAX);
  );
);

/*
 * ===================================================================================================
 * ReEQ3: Linear Phase processing and spectral dynamics (the engine is Dependencies/reeq3-lp.jsfx-inc)
 * ===================================================================================================
 *
 * In Linear Phase mode every band goes through the FFT engine. In Zero Latency mode only spectral
 * bands do (they need it), after the other bands' filters. Each band in the engine keeps a row of its
 * magnitude per bin (its analogue response, so nothing cramps near Nyquist); the rows multiply into
 * the 2x2 response matrix in band order, and the engine designs its filter from that.
 */

// A band's magnitude row (and, for spectral bands, its shape row: how much of the band's effect each bin
// gets, 0..1) at gain g
function lp_fill(b, g) instance(filter) local(k, row, df, sh, m, t) (
  t = Band_Type[b];
  this.band_set_visual(t, Band_Frequency[b], g, band_q_eff(b, g), Band_Slope[b]);
  row = LP_BMAG + b * LP_ROW; df = srate / LP_N;
  k = 0;
  loop(LP_NB, row[k] = filter.ivf_analog_magnitude(k * df); k += 1);
  Band_Spectral[b] ? (
    // The shape at 12dB, as a share of 12dB
    this.band_set_visual(t, Band_Frequency[b], 12, band_q_eff(b, 12), Band_Slope[b]);
    sh = LP_BSHAPE + b * LP_ROW;
    k = 0;
    loop(LP_NB,
      m = 20 * log10(max(filter.ivf_analog_magnitude(k * df), 0.000001)) / 12;
      sh[k] = min(max(m, 0), 1);
      k += 1;
    );
  );
  LP_LastG[b] = g;
);

function lp_fill_band(b, g) (
  b == 0 ? lpb1.lp_fill(0, g) : b == 1 ? lpb2.lp_fill(1, g) : b == 2 ? lpb3.lp_fill(2, g) :
  b == 3 ? lpb4.lp_fill(3, g) : b == 4 ? lpb5.lp_fill(4, g) : b == 5 ? lpb6.lp_fill(5, g) :
  b == 6 ? lpb7.lp_fill(6, g) : b == 7 ? lpb8.lp_fill(7, g) : b == 8 ? lpb9.lp_fill(8, g) :
  b == 9 ? lpb10.lp_fill(9, g) : b == 10 ? lpb11.lp_fill(10, g) : b == 11 ? lpb12.lp_fill(11, g) :
  b == 12 ? lpb13.lp_fill(12, g) : b == 13 ? lpb14.lp_fill(13, g) : b == 14 ? lpb15.lp_fill(14, g) :
  lpb16.lp_fill(15, g);
);

// The gain a band in the engine is drawn at now: its static gain, plus its dynamic change unless it is
// spectral (whose change is per bin), times Scale
function lp_band_gain(b) (
  (Band_Gain[b] + (LP_DynB[b] && !LP_Spec[b] ? Band_Dyn_Gain[b] : 0)) * Scale / 100;
);

/*
 * The response matrix from the rows, in band order. A spectral band's row is scaled bin by bin by its
 * live gain change (in dB, times its shape).
 */
function lp_build() local(b, k, row, sp, sh, g, m, a, c, mm, x0, x1, sc) (
  lp_identity();
  sc = Scale / 100;
  b = 0;
  loop(NUM_BANDS,
    LP_Band[b] ? (
      g = Band_Group[b];
      row = LP_BMAG + b * LP_ROW;
      sp = LP_Spec[b] ? LP_SPG + b * LP_ROW : -1;
      sh = LP_BSHAPE + b * LP_ROW;
      (g == 1 || g == 2) ? LP_CROSS = 1;
      k = 0;
      loop(LP_NB,
        m = row[k];
        sp >= 0 ? m *= 10 ^ (sp[k] * sh[k] * sc * 0.05);
        g == 0 ? (
          LP_M11[k] *= m; LP_M12[k] *= m; LP_M21[k] *= m; LP_M22[k] *= m;
        ) : g == 3 ? (
          LP_M11[k] *= m; LP_M12[k] *= m;
        ) : g == 4 ? (
          LP_M21[k] *= m; LP_M22[k] *= m;
        ) : (
          // Mid or Side: B = [[a, c], [c, a]] with a = (1 + m) / 2, c = +-(m - 1) / 2, times M
          a = (1 + m) * 0.5; c = (g == 1 ? m - 1 : 1 - m) * 0.5;
          x0 = LP_M11[k]; x1 = LP_M21[k];
          LP_M11[k] = a * x0 + c * x1; LP_M21[k] = c * x0 + a * x1;
          x0 = LP_M12[k]; x1 = LP_M22[k];
          LP_M12[k] = a * x0 + c * x1; LP_M22[k] = c * x0 + a * x1;
        );
        k += 1;
      );
    );
    b += 1;
  );
);

/*
 * Spectral dynamics for band b, once per frame: the gain change each bin wants from its own level
 * (soft knee, ratio, range), spread over neighbouring bins by the density, then attack and release per
 * bin. Leaves the change in dB (before the band's shape) in its LP_SPG row.
 */
function lp_spectral(b) local(g, lv, sh, sp, k, thr, ratio, range, over, y, want, tilt, f, df, dens, wo, a,
                              v, hop_ms, atk, rel, att_ms, rel_ms, worst, lvl, lmax, i0) (
  df = srate / LP_N;
  g = Band_Group[b];
  // The detector: the band's placement on its own input or its sidechain
  lv = Band_Dyn_Source[b] > 0 ? LP_SLV : LP_LV;
  sh = LP_BSHAPE + b * LP_ROW; sp = LP_SPG + b * LP_ROW;
  thr = Band_Dyn_AutoThr[b] ? Band_Dyn_AutoLvl[b] + DYN_AUTO_OFS : Band_Dyn_Thresh[b];
  ratio = max(Band_Dyn_Ratio[b], 1);
  range = Band_Dynamic_Range[b];
  tilt = Band_SpecTilt[b];
  lmax = -150;
  k = 0;
  loop(LP_NB,
    sh[k] > 0.02 ? (
      lvl = g == 0 ? max(lv[k], lv[LP_ROWL + k]) : g == 1 ? lv[2 * LP_ROWL + k] : g == 2 ? lv[3 * LP_ROWL + k] :
            g == 3 ? lv[k] : lv[LP_ROWL + k];
      tilt ? lvl += 3 * log(max(k * df, 20) / 1000) / log(2);
      sh[k] > 0.5 ? lmax = max(lmax, lvl);
      over = lvl - thr;
      y = over <= -DYN_KNEE * 0.5 ? 0 : over >= DYN_KNEE * 0.5 ? over : sqr(over + DYN_KNEE * 0.5) / (2 * DYN_KNEE);
      y *= 1 - 1 / ratio;
      want = range < 0 ? -min(y, -range) : min(y, range);
    ) : want = 0;
    LP_TMP[k] = want;
    k += 1;
  );
  Band_Spec_Level[b] = lmax;
  // Density: 0 spreads a triggered bin over about an octave, 100 over a 24th of one. A decaying peak
  // hold up the bins and back down, the decay per bin set by how many octaves the bin spans.
  dens = min(max(Band_SpecDensity[b], 0), 100);
  wo = 2 ^ (-dens / 100 * 4.585);
  i0 = 2;
  v = 0; k = i0;
  loop(LP_NB - i0,
    a = exp(-(log((k + 1) / k) / log(2)) / wo * 3);
    v = range < 0 ? min(LP_TMP[k], v * a) : max(LP_TMP[k], v * a);
    LP_TMP[k] = v;
    k += 1;
  );
  v = 0; k = LP_NB - 1;
  loop(LP_NB - i0,
    a = exp(-(log((k + 1) / k) / log(2)) / wo * 3);
    v = range < 0 ? min(LP_TMP[k], v * a) : max(LP_TMP[k], v * a);
    LP_TMP[k] = v;
    k -= 1;
  );
  // Attack and release per bin, at the frame rate (Auto: 5 and 120 ms)
  hop_ms = 1000 * LP_H / srate;
  att_ms = Band_Dyn_Auto[b] ? 5 : Band_Dyn_Attack[b];
  rel_ms = Band_Dyn_Auto[b] ? 120 : Band_Dyn_Release[b];
  atk = 1 - exp(-hop_ms / max(att_ms, 0.1));
  rel = 1 - exp(-hop_ms / max(rel_ms, 1));
  worst = 0;
  k = 0;
  loop(LP_NB,
    want = LP_TMP[k]; v = sp[k];
    v += (abs(want) > abs(v) ? atk : rel) * (want - v);
    sp[k] = v;
    abs(v * sh[k]) > abs(worst) ? worst = v * sh[k];
    k += 1;
  );
  Band_Dyn_Gain[b] = worst;
);

/*
 * Once per frame, before the filter is applied: dynamic bands follow their gain, spectral bands work
 * out theirs, and the filter is designed again when anything moved
 */
function lp_frame_dynamics() local(b, g, changed) (
  changed = 0;
  b = 0;
  loop(NUM_BANDS,
    LP_Band[b] && LP_DynB[b] ? (
      LP_Spec[b] ? (
        lp_spectral(b); changed = 1;
      ) : (
        g = lp_band_gain(b);
        abs(g - LP_LastG[b]) > 0.05 ? (lp_fill_band(b, g); changed = 1);
      );
    );
    b += 1;
  );
  changed ? (lp_build(); lp_design_full());
);

/*
 * ===================================================================================================
 * ReEQ3: Character (output saturation) and output pan
 * ===================================================================================================
 *
 * Subtle and Warm: an asymmetric tanh curve with unity slope at zero, so quiet material passes clean and
 * the colour grows with level (Warm more, and with more even harmonics). Its bias is taken out by a 5Hz
 * high pass. HQ (the Quality setting) runs it at twice the rate through a half-band FIR.
 */
function tanh_(x) local(e) (
  e = exp(2 * min(max(x, -20), 20));
  (e - 1) / (e + 1);
);
function chr_set(mode) (
  mode == 1 ? (chr_d = 0.55; chr_b = 0.12) : (chr_d = 1.25; chr_b = 0.32);
  chr_t = tanh_(chr_d * chr_b);
  chr_k = 1 / (chr_d * (1 - chr_t * chr_t));
);
function chr_curve(x) (
  (tanh_(chr_d * (x + chr_b)) - chr_t) * chr_k;
);

// Half-band FIR (windowed sinc, CHR_TAPS taps) for 2x up and down sampling
function chr_init() local(i, n, c, w, x) (
  CHR_TAPS = 31; c = (CHR_TAPS - 1) / 2;
  i = 0;
  loop(CHR_TAPS,
    x = i - c;
    w = 0.42 - 0.5 * cos(2 * $pi * i / (CHR_TAPS - 1)) + 0.08 * cos(4 * $pi * i / (CHR_TAPS - 1));
    CHR_FIR[i] = (x == 0 ? 0.5 : sin($pi * x * 0.5) / ($pi * x)) * w;
    i += 1;
  );
  memset(CHR_HIST, 0, 128);
  chr_pos = 0;
);

// One channel through the saturator. hist is that channel's 2 x CHR_TAPS history (upsampled, then the
// shaped samples waiting for the decimator)
function chr_tick(x, ch) local(h, d, i, acc0, acc1, y0, y1, p, out) (
  CHR_HQ ? (
    // Up: the zero-stuffed stream through the half-band, two output samples per input
    h = CHR_HIST + ch * 64;
    i = CHR_TAPS - 1; loop(CHR_TAPS - 1, h[i] = h[i - 1]; i -= 1); h[0] = x;
    // Even outputs use the even taps on the stuffed stream: polyphase
    acc0 = acc1 = 0; i = 0;
    loop((CHR_TAPS + 1) / 2,
      acc0 += CHR_FIR[2 * i] * h[i];
      2 * i + 1 < CHR_TAPS ? acc1 += CHR_FIR[2 * i + 1] * h[i];
      i += 1;
    );
    y0 = chr_curve(2 * acc0); y1 = chr_curve(2 * acc1);
    // Down: half-band on the shaped 2x stream, keep one of two
    // (the even phase, so the whole path is a whole CHR_TAPS - 1 / 2 samples late)
    d = h + CHR_TAPS;
    i = CHR_TAPS; loop(CHR_TAPS - 1, d[i] = d[i - 2]; i -= 1);
    d[1] = y0; d[0] = y1;
    out = 0; i = 0;
    loop(CHR_TAPS, out += CHR_FIR[i] * d[i + 1]; i += 1);
    out;
  ) : chr_curve(x);
);

/*
 * ===================================================================================================
 * ReEQ3: shared spectra (instance list, external spectrum, collisions, EQ Match)
 * ===================================================================================================
 *
 * Every ReEQ3 measures its output (and, when asked, its input and sidechain) on 256 points from 20Hz
 * to 20kHz about ten times a second, on the audio side so a closed window still takes part. Its output
 * goes into its slot in the shared memory (gmem=ReEQ3), with its track, position and name, so other
 * instances can list it, draw it and match to it.
 */
PUB_PTS = 256; PUB_N = 4096; PUB_HOP = 2048;
GM_REG = 4096; GM_SLOTS = 64; GM_SLOT = 320; GM_NAME_LEN = 31; GM_SPEC = 40;
// ReEQ3 remote editing (a slot per instance) and the tonal target for the Save Tonal Target action
GM_RMT = GM_REG + GM_SLOTS * GM_SLOT; RM_SLOT = 512; RM_BANDS = 8; RM_CURVE = 136; RM_CMD = 400;
GM_TBX = GM_RMT + GM_SLOTS * RM_SLOT;

function pub_freq(i) ( 20 * 1000 ^ (i / (PUB_PTS - 1)); );

// One ring's last PUB_N samples into 256 points of dB (power per point, a sine reads its peak level),
// smoothed over time into out (sm 0..1: the share of the new measurement)
function pub_measure(ring, out, sm) local(i, p, k, w, f, lo, hi, kl, kh, acc, n, v, df) (
  i = 0; p = PUB_POS;
  loop(PUB_N,
    w = 0.5 - 0.5 * cos(2 * $pi * i / PUB_N);
    PUB_FFT[i] = ring[p] * w;
    (p += 1) >= PUB_N ? p = 0;
    i += 1;
  );
  fft_real(PUB_FFT, PUB_N);
  fft_permute(PUB_FFT, PUB_N / 2);
  PUB_FFT[1] = 0;
  df = srate / PUB_N;
  i = 0;
  loop(PUB_PTS,
    f = pub_freq(i);
    lo = f * 2 ^ (-1 / 48 * 5); hi = f * 2 ^ (1 / 48 * 5);
    kl = max(1, floor(lo / df + 0.5)); kh = min(PUB_N / 2 - 1, max(kl, floor(hi / df + 0.5)));
    acc = 0; n = 0; k = kl;
    loop(kh - kl + 1, acc = max(acc, sqr(PUB_FFT[2 * k]) + sqr(PUB_FFT[2 * k + 1])); k += 1);
    // Hann's gain 0.5 and the transform's length (fft_real gives twice the complex transform)
    v = 10 * log10(acc * 4 / (PUB_N * PUB_N) + 0.000000000001);
    f >= srate * 0.5 ? v = -120;
    out[i] = out[i] <= -119 ? v : out[i] + sm * (v - out[i]);
    i += 1;
  );
);

// This instance's slot: the one with its tag, else a free or stale one (no heartbeat for 20 s)
function pub_claim() local(i, b, best, now) (
  now = time_precise();
  best = -1; i = 0;
  while (i < GM_SLOTS && best < 0) (
    gmem[GM_REG + i * GM_SLOT + 1] == Instance_Tag ? best = i;
    i += 1;
  );
  i = 0;
  while (best < 0 && i < GM_SLOTS) (
    b = GM_REG + i * GM_SLOT;
    gmem[b + 1] == 0 || now - gmem[b] > 20 ? best = i;
    i += 1;
  );
  best >= 0 ? (
    b = GM_REG + best * GM_SLOT;
    gmem[b + 1] = Instance_Tag; gmem[b] = now;
  );
  best;
);

// Publish the output spectrum, place and name
function pub_publish() local(b, i, n, pos, tr) (
  (Pub_Slot < 0 || gmem[GM_REG + Pub_Slot * GM_SLOT + 1] != Instance_Tag) ? Pub_Slot = pub_claim();
  // A copy of an instance brings the same tag: whichever finds the slot fresh from someone else takes a
  // new one
  Pub_Slot >= 0 && gmem[GM_REG + Pub_Slot * GM_SLOT + 5] != Pub_RT && time_precise() - gmem[GM_REG + Pub_Slot * GM_SLOT] < 0.6 &&
    gmem[GM_REG + Pub_Slot * GM_SLOT + 5] != 0 ? (
    Instance_Tag = floor(rand(1000000000)) + 1;
    Pub_Slot = pub_claim();
  );
  Pub_Slot >= 0 ? (
    b = GM_REG + Pub_Slot * GM_SLOT;
    gmem[b] = time_precise();
    gmem[b + 5] = Pub_RT;
    pos = 0; tr = get_host_placement(pos);
    gmem[b + 2] = tr; gmem[b + 3] = pos;
    n = min(strlen(#Instance_Name), GM_NAME_LEN);
    gmem[b + 4] = n;
    i = 0; loop(n, gmem[b + 8 + i] = str_getchar(#Instance_Name, i); i += 1);
    i = 0; loop(PUB_PTS, gmem[b + GM_SPEC + i] = PUB_POST_DB[i]; i += 1);
  );
);

// Another instance's slot by its tag (-1 when it is gone)
function pub_find(tag) local(i, r) (
  r = -1; i = 0;
  while (i < GM_SLOTS && r < 0) (
    gmem[GM_REG + i * GM_SLOT + 1] == tag && time_precise() - gmem[GM_REG + i * GM_SLOT] < 30 ? r = i;
    i += 1;
  );
  r;
);

/*
 * EQ Match: averages of this instance's input and of the reference (power, per point), taken while
 * the analysis runs. The reference is the sidechain, another instance's output, or a captured spectrum.
 */
function eqm_tick() local(i, rb, ref) (
  rb = EQM_Src == 2 ? pub_find(EQM_Tag) : -1;
  EQM_Src == 2 && rb < 0 ? EQM_Status = 3 : (
    i = 0;
    loop(PUB_PTS,
      EQM_SUM_IN[i] += 10 ^ (PUB_PRE_DB[i] / 10);
      ref = EQM_Src == 1 ? PUB_SC_DB[i] : EQM_Src == 2 ? gmem[GM_REG + rb * GM_SLOT + GM_SPEC + i] : EQM_CAP[i];
      EQM_SUM_REF[i] += 10 ^ (ref / 10);
      i += 1;
    );
    EQM_Count += 1;
  );
);

// Capturing a reference: the average of this instance's input
function eqm_capture_tick() local(i) (
  i = 0;
  loop(PUB_PTS, EQM_CAPSUM[i] += 10 ^ (PUB_PRE_DB[i] / 10); i += 1);
  EQM_CapCount += 1;
  i = 0;
  loop(PUB_PTS, EQM_CAP[i] = 10 * log10(EQM_CAPSUM[i] / EQM_CapCount + 0.000000000001); i += 1);
  EQM_HasCap = 1;
);

/*
 * ReEQ3 Tonal Balance, audio side: the output's average (TB_LIVE) and learning a target from this
 * instance's input, its output or the sidechain, a measurement every PUB_HOP
 */
function tb_learn_seg() local(i, cr) (
  TB_LSegN > 0 ? (
    i = 0; loop(TB_PTS, TB_SEG[i] /= TB_LSegN; i += 1);
    cr = TB_LCN > 0 && TB_LCMs / TB_LCN > 0.0000001 ? 20 * log10(TB_LCPk / sqrt(TB_LCMs / TB_LCN)) : -1;
    tb_stats_add(TB_SEG, cr);
    tb_stats_write(TBT, 0, TB_SMA) ? (TB_Target = 0; TB_Ver += 1);
  );
  memset(TB_SEG, 0, TB_PTS); TB_LSegN = 0; TB_LCPk = TB_LCMs = TB_LCN = 0;
);
function tb_learn_points() local(i) (
  i = 0; loop(TB_PTS, TB_SEG[i] += TB_MEAS[i]; i += 1);
  (TB_LSegN += 1) >= TB_SegLen ? tb_learn_seg();
);
// With the output's transform in PUB_FFT
function tb_hop_post() local(i, a) (
  memset(TB_MEAS, 0, TB_PTS);
  tb_points(PUB_FFT, PUB_N, srate, TB_MEAS, 1);
  // Silence leaves the average where it was
  tb_klevel(TB_MEAS) > TB_GATE ? (
    TB_LiveN += 1;
    a = TB_Avg == 2 ? 1 / TB_LiveN : max(PUB_HOP / ((TB_Avg == 1 ? 10 : 3) * srate), 1 / TB_LiveN);
    i = 0; loop(TB_PTS, TB_LIVE[i] += a * (TB_MEAS[i] - TB_LIVE[i]); i += 1);
  );
  TB_Learn == 2 ? tb_learn_points();
);
function tb_hop_learn() (
  TB_Learn == 1 || TB_Learn == 3 ? (
    TB_Learn == 1 ? pub_measure(PUB_RPRE, PUB_PRE_DB, 1) : pub_measure(PUB_RSC, PUB_SC_DB, 0.5);
    memset(TB_MEAS, 0, TB_PTS);
    tb_points(PUB_FFT, PUB_N, srate, TB_MEAS, 1);
    tb_learn_points();
  );
);
function tb_learn_start(src) (
  TB_FA = 0;
  tb_stats_clear();
  memset(TB_SEG, 0, TB_PTS); TB_LSegN = 0; TB_LCPk = TB_LCMs = TB_LCN = 0;
  TB_Learn = src;
  #TB_Name = src == 1 ? "Learned from input" : src == 2 ? "Learned from output" : "Learned from sidechain";
);
// The crest meter: the last 3 s or 10 s of half-second chunks, or everything since the reset
function tb_crest_update() local(w, k, i, pk, ms, n) (
  TB_Avg == 2 ? (
    TB_Crest = TB_CAllN > 0 ? 20 * log10(TB_CAllPk / sqrt(TB_CAllMs / TB_CAllN)) : 0;
  ) : (
    w = min(TB_Avg == 1 ? 20 : 6, TB_CCnt);
    pk = ms = 0; n = 0; i = TB_CPos;
    loop(w, i = (i + 31) % 32; pk = max(pk, TB_CRING[2 * i]); ms += TB_CRING[2 * i + 1]; n += 1);
    TB_Crest = n > 0 ? 20 * log10(pk / sqrt(ms / n)) : 0;
  );
  TB_CrestOk = TB_CCnt > 0;
);
function tb_live_reset() (
  memset(TB_LIVE, 0, TB_PTS); TB_LiveN = 0;
  TB_CCnt = TB_CPos = 0; TB_CAllPk = TB_CAllMs = TB_CAllN = 0; TB_CrestOk = 0;
  TB_CkPk = TB_CkMs = TB_CkN = 0;
);

/*
 * ReEQ3 remote editing: an instance shows its bands and curve to another (in gmem, while watched) and
 * takes band changes from it. Per slot: watched time, published time, write and read counts, the bands
 * (8 words each), the curve (256 points, dB) and a ring of 8 commands (12 words: op, band, then the
 * band's values). Ops: 1 set a band, 2 a new bell in a free band, 3 remove a band.
 */
function rm_mag(f) local(m) (
  m = 1;
  Band_Enabled[0] == BAND_STATE_ENABLED && (Band_Group[0] == 0 || (Band_Group[0] == 1 && Stereo_Mode == 0)) ? m *= gfx_band1.filter.ivf_analog_magnitude(f);
  Band_Enabled[1] == BAND_STATE_ENABLED && (Band_Group[1] == 0 || (Band_Group[1] == 1 && Stereo_Mode == 0)) ? m *= gfx_band2.filter.ivf_analog_magnitude(f);
  Band_Enabled[2] == BAND_STATE_ENABLED && (Band_Group[2] == 0 || (Band_Group[2] == 1 && Stereo_Mode == 0)) ? m *= gfx_band3.filter.ivf_analog_magnitude(f);
  Band_Enabled[3] == BAND_STATE_ENABLED && (Band_Group[3] == 0 || (Band_Group[3] == 1 && Stereo_Mode == 0)) ? m *= gfx_band4.filter.ivf_analog_magnitude(f);
  Band_Enabled[4] == BAND_STATE_ENABLED && (Band_Group[4] == 0 || (Band_Group[4] == 1 && Stereo_Mode == 0)) ? m *= gfx_band5.filter.ivf_analog_magnitude(f);
  Band_Enabled[5] == BAND_STATE_ENABLED && (Band_Group[5] == 0 || (Band_Group[5] == 1 && Stereo_Mode == 0)) ? m *= gfx_band6.filter.ivf_analog_magnitude(f);
  Band_Enabled[6] == BAND_STATE_ENABLED && (Band_Group[6] == 0 || (Band_Group[6] == 1 && Stereo_Mode == 0)) ? m *= gfx_band7.filter.ivf_analog_magnitude(f);
  Band_Enabled[7] == BAND_STATE_ENABLED && (Band_Group[7] == 0 || (Band_Group[7] == 1 && Stereo_Mode == 0)) ? m *= gfx_band8.filter.ivf_analog_magnitude(f);
  Band_Enabled[8] == BAND_STATE_ENABLED && (Band_Group[8] == 0 || (Band_Group[8] == 1 && Stereo_Mode == 0)) ? m *= gfx_band9.filter.ivf_analog_magnitude(f);
  Band_Enabled[9] == BAND_STATE_ENABLED && (Band_Group[9] == 0 || (Band_Group[9] == 1 && Stereo_Mode == 0)) ? m *= gfx_band10.filter.ivf_analog_magnitude(f);
  Band_Enabled[10] == BAND_STATE_ENABLED && (Band_Group[10] == 0 || (Band_Group[10] == 1 && Stereo_Mode == 0)) ? m *= gfx_band11.filter.ivf_analog_magnitude(f);
  Band_Enabled[11] == BAND_STATE_ENABLED && (Band_Group[11] == 0 || (Band_Group[11] == 1 && Stereo_Mode == 0)) ? m *= gfx_band12.filter.ivf_analog_magnitude(f);
  Band_Enabled[12] == BAND_STATE_ENABLED && (Band_Group[12] == 0 || (Band_Group[12] == 1 && Stereo_Mode == 0)) ? m *= gfx_band13.filter.ivf_analog_magnitude(f);
  Band_Enabled[13] == BAND_STATE_ENABLED && (Band_Group[13] == 0 || (Band_Group[13] == 1 && Stereo_Mode == 0)) ? m *= gfx_band14.filter.ivf_analog_magnitude(f);
  Band_Enabled[14] == BAND_STATE_ENABLED && (Band_Group[14] == 0 || (Band_Group[14] == 1 && Stereo_Mode == 0)) ? m *= gfx_band15.filter.ivf_analog_magnitude(f);
  Band_Enabled[15] == BAND_STATE_ENABLED && (Band_Group[15] == 0 || (Band_Group[15] == 1 && Stereo_Mode == 0)) ? m *= gfx_band16.filter.ivf_analog_magnitude(f);
  m;
);
function rm_publish(r) local(b, i, f, k) (
  Rm_LastPub = time_precise();
  // The drawing filters (its own window may be closed), from which the curve is read
  update_visual_filters();
  b = 0;
  loop(NUM_BANDS,
    k = r + RM_BANDS + b * 8;
    gmem[k] = Band_Enabled[b]; gmem[k + 1] = Band_Group[b]; gmem[k + 2] = Band_Type[b]; gmem[k + 3] = Band_Frequency[b];
    gmem[k + 4] = Band_Gain[b]; gmem[k + 5] = Band_Q[b]; gmem[k + 6] = Band_Slope[b];
    b += 1;
  );
  i = 0;
  loop(TB_PTS,
    f = tb_freq(i);
    gmem[r + RM_CURVE + i] = f < srate * 0.5 ? 20 * log10(max(rm_mag(f), 0.001)) : 0;
    i += 1;
  );
  gmem[r + 1] = Rm_LastPub;
);
function rm_target_block() local(r, c, op, b, n) (
  Pub_Slot >= 0 ? (
    r = GM_RMT + Pub_Slot * RM_SLOT;
    // A slot just taken: whatever waits in it was meant for someone else
    Pub_Slot != Rm_SlotLive ? (gmem[r + 3] = gmem[r + 2]; Rm_SlotLive = Pub_Slot);
    n = 0;
    while (gmem[r + 3] < gmem[r + 2] && n < 8) (
      c = r + RM_CMD + (gmem[r + 3] % 8) * 12;
      op = gmem[c]; b = gmem[c + 1];
      op == 2 ? (b = 0; while (b < NUM_BANDS && Band_Enabled[b] != BAND_STATE_OFF) (b += 1));
      b >= 0 && b < NUM_BANDS ? (
        op == 1 ? (
          Band_Enabled[b] = gmem[c + 2]; Band_Group[b] = gmem[c + 3]; Band_Type[b] = gmem[c + 4];
          Band_Frequency[b] = gmem[c + 5]; Band_Gain[b] = gmem[c + 6]; Band_Q[b] = gmem[c + 7]; Band_Slope[b] = gmem[c + 8];
        ) : op == 2 ? (
          Band_Enabled[b] = BAND_STATE_ENABLED; Band_Group[b] = 0; Band_Type[b] = FILTER_PEAK;
          Band_Frequency[b] = gmem[c + 5]; Band_Gain[b] = gmem[c + 6]; Band_Q[b] = gmem[c + 7]; Band_Slope[b] = 1;
          band_dyn_defaults(b);
        ) : op == 3 ? (
          Band_Enabled[b] = BAND_STATE_OFF;
        );
        flag_filter_update(b);
        Rm_Changed = 1;
      );
      gmem[r + 3] += 1; n += 1;
    );
    Rm_Changed ? (filters_to_sliders(); Rm_Changed = 0; Rm_LastPub = time_precise() - 0.06);
    time_precise() - gmem[r] < 1.5 && time_precise() - Rm_LastPub > 0.08 ? rm_publish(r);
  );
);

// Per block: count samples and measure every PUB_HOP
function pub_block() (
  (Pub_Count += samplesblock) >= PUB_HOP ? (
    Pub_Count = 0;
    pub_measure(PUB_RPOST, PUB_POST_DB, 0.5);
    TB_Active ? tb_hop_post();
    TB_Learn ? tb_hop_learn();
    (EQM_Run || EQM_Capturing) ? pub_measure(PUB_RPRE, PUB_PRE_DB, 1);
    (EQM_Run && EQM_Src == 1) || Ext_Src == 1 ? pub_measure(PUB_RSC, PUB_SC_DB, 0.5);
    pub_publish();
    EQM_Run ? eqm_tick();
    EQM_Capturing ? eqm_capture_tick();
  );
);

/*
 * ReEQ3 state with no slider, after the per-band arrays (write: 1 writes, 0 reads)
 */
function reeq3_serialize_extra(write) (
  file_var(0, Instance_Tag);
  file_string(0, #Instance_Name);
  file_var(0, Grab_On);
  file_var(0, Ext_Src);
  file_var(0, Ext_Tag);
  file_var(0, Collisions_On);
  file_var(0, EQM_HasCap);
  file_mem(0, EQM_CAP, PUB_PTS);
  file_var(0, EQM_Bands);
);
// ReEQ3 Tonal Balance, from state version 114
function tb_serialize() (
  file_var(0, TB_Target); file_string(0, #TB_Name); file_var(0, TB_Avg); file_var(0, TB_View); file_var(0, TB_MBands);
  file_mem(0, TBT, TB_TSIZE);
);

init_rate != srate ? (
  init_rate = srate;

  // Initialise everything

