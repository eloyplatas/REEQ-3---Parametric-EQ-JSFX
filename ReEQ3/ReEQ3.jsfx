  Band_Update[3] && (Band_Dyn_On[3] || AF_Clock>=AF_Due[3]) ? (AF_Due[3]=AF_Clock+32; Band_Update[3] = 0; Band_Enabled[3] != BAND_STATE_ENABLED ? band4.band_off() :
    Band_Dyn_On[3] && band_dyn_capable(Band_Type[3]) ? band4.band_dyn_set_filter(3, band_scalar) :
    (band4.band_dyn_reset(); band4.band_set_filter(Band_Type[3], Band_Frequency[3], Band_Gain[3] * band_scalar, band_q_eff(3, Band_Gain[3] * band_scalar), Band_Slope[3])); );
  Band_Update[4] && (Band_Dyn_On[4] || AF_Clock>=AF_Due[4]) ? (AF_Due[4]=AF_Clock+32; Band_Update[4] = 0; Band_Enabled[4] != BAND_STATE_ENABLED ? band5.band_off() :
    Band_Dyn_On[4] && band_dyn_capable(Band_Type[4]) ? band5.band_dyn_set_filter(4, band_scalar) :
