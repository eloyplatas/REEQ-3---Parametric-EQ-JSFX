  Band_Update[2] && (Band_Dyn_On[2] || AF_Clock>=AF_Due[2]) ? (AF_Due[2]=AF_Clock+32; Band_Update[2] = 0; Band_Enabled[2] != BAND_STATE_ENABLED ? band3.band_off() :
