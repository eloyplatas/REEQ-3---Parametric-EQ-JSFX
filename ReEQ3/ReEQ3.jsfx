  // Overall gains
  spl0list *= gainDb;
  spl1list *= gainDb;
);

// Feed the correct buffers depending on spectrum modes
SPEC_MODE == 0 ? spectrum.sample0(spl0 + spl1) :
SPEC_MODE == 1 ? spectrum.sample0((spl0 + spl1) * 0.5) :
SPEC_MODE == 2 ? spectrum.sample0((spl0 - spl1) * 0.5) :
SPEC_MODE == 3 ? (spectrum.sample0((spl0 + spl1) * 0.5); spectrum.sample1((spl0 - spl1) * 0.5)) :
SPEC_MODE == 4 ? spectrum.sample0(spl0);
SPEC_MODE == 5 ? spectrum.sample0(spl1) :
