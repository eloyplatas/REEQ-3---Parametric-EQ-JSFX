);

function update_audio_filters() local (band_scalar) (
  band_scalar = Scale / 100.0;

  Band_Update[0] && (Band_Dyn_On[0] || AF_Clock>=AF_Due[0]) ? (AF_Due[0]=AF_Clock+32; Band_Update[0] = 0; Band_Enabled[0] != BAND_STATE_ENABLED ? band1.band_off() :
    Band_Dyn_On[0] && band_dyn_capable(Band_Type[0]) ? band1.band_dyn_set_filter(0, band_scalar) :
    (band1.band_dyn_reset(); band1.band_set_filter(Band_Type[0], Band_Frequency[0], Band_Gain[0] * band_scalar, band_q_eff(0, Band_Gain[0] * band_scalar), Band_Slope[0])); );
  Band_Update[1] && (Band_Dyn_On[1] || AF_Clock>=AF_Due[1]) ? (AF_Due[1]=AF_Clock+32; Band_Update[1] = 0; Band_Enabled[1] != BAND_STATE_ENABLED ? band2.band_off() :
