  Band_Update[5] && (Band_Dyn_On[5] || AF_Clock>=AF_Due[5]) ? (AF_Due[5]=AF_Clock+32; Band_Update[5] = 0; Band_Enabled[5] != BAND_STATE_ENABLED ? band6.band_off() :
    Band_Dyn_On[5] && band_dyn_capable(Band_Type[5]) ? band6.band_dyn_set_filter(5, band_scalar) :
    (band6.band_dyn_reset(); band6.band_set_filter(Band_Type[5], Band_Frequency[5], Band_Gain[5] * band_scalar, band_q_eff(5, Band_Gain[5] * band_scalar), Band_Slope[5])); );
  Band_Update[6] && (Band_Dyn_On[6] || AF_Clock>=AF_Due[6]) ? (AF_Due[6]=AF_Clock+32; Band_Update[6] = 0; Band_Enabled[6] != BAND_STATE_ENABLED ? band7.band_off() :
    Band_Dyn_On[6] && band_dyn_capable(Band_Type[6]) ? band7.band_dyn_set_filter(6, band_scalar) :
    (band7.band_dyn_reset(); band7.band_set_filter(Band_Type[6], Band_Frequency[6], Band_Gain[6] * band_scalar, band_q_eff(6, Band_Gain[6] * band_scalar), Band_Slope[6])); );
  Band_Update[7] && (Band_Dyn_On[7] || AF_Clock>=AF_Due[7]) ? (AF_Due[7]=AF_Clock+32; Band_Update[7] = 0; Band_Enabled[7] != BAND_STATE_ENABLED ? band8.band_off() :
