  Band_Update[10] && (Band_Dyn_On[10] || AF_Clock>=AF_Due[10]) ? (AF_Due[10]=AF_Clock+32; Band_Update[10] = 0; Band_Enabled[10] != BAND_STATE_ENABLED ? band11.band_off() :
