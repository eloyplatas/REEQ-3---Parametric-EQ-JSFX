// ReEQ3: output pan and its mode, Character, the processing mode and the linear phase resolution
slider234:Out_Pan=0<-100,100,0.1>-Output Pan
slider235:Out_PanMode=0<0,1,1{Left/Right,Mid/Side}>-Output Pan Mode
slider236:Character=0<0,2,1{Clean,Subtle,Warm}>-Character
slider237:Proc_Mode=0<0,1,1{Zero Latency,Linear Phase}>-Processing Mode
slider238:LP_Res=1<0,3,1{Low,Medium,High,Very High}>-Linear Phase Resolution

// ReEQ3 Luftikus mode (a port of lkjb's Luftikus): on, the five bands (-10..10), Air (0..10) and its
// frequency, Keep Gain, Analog, Mastering and the trim, with the original's ranges
slider239:Lf_On=0<0,1,1{Off,On}>-Luftikus
slider240:Lf_G10=0<-10,10,0.1>-Luftikus 10 Hz
slider241:Lf_G40=0<-10,10,0.1>-Luftikus 40 Hz
slider242:Lf_G160=0<-10,10,0.1>-Luftikus 160 Hz
slider243:Lf_G640=0<-10,10,0.1>-Luftikus 640 Hz
slider244:Lf_G2k5=0<-10,10,0.1>-Luftikus 2.5 kHz
slider245:Lf_Air=0<0,10,0.05>-Luftikus Air
slider246:Lf_AirType=0<0,5,1{Off,2.5k,5k,10k,20k,40k}>-Luftikus Air Frequency
slider247:Lf_Keep=0<0,1,1{Off,On}>-Luftikus Keep Gain
slider248:Lf_Analog=0<0,1,1{Off,On}>-Luftikus Analog
slider249:Lf_Mastering=0<0,1,1{Off,On}>-Luftikus Mastering
slider250:Lf_Trim=0<-20,20,0.1>-Luftikus Trim

// ReEQ3: the BBC LL/81 MSC output transformer, on and its drive (dB into it, taken off after it)
slider251:Tx_On=0<0,1,1{Off,On}>-Output Transformer
slider252:Tx_Drive=0<0,36,0.1>-Transformer Drive
slider253:Tx_Type=0<0,1,1{BBC LL/81 MSC,Neve LO1166}>-Transformer Model

