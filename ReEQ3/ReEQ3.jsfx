  gfx_band1.filter.ri_bind(MEMORY.alloc_memory(508),-1,0,2);
  ag_band1.filter.ri_bind(MEMORY.alloc_memory(508),-1,0,0);
  band2.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+1*AF_CurveSlots,1,1);
  gfx_band2.filter.ri_bind(MEMORY.alloc_memory(508),-1,1,2);
  ag_band2.filter.ri_bind(MEMORY.alloc_memory(508),-1,1,0);
  band3.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+2*AF_CurveSlots,2,1);
  gfx_band3.filter.ri_bind(MEMORY.alloc_memory(508),-1,2,2);
  ag_band3.filter.ri_bind(MEMORY.alloc_memory(508),-1,2,0);
  band4.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+3*AF_CurveSlots,3,1);
  gfx_band4.filter.ri_bind(MEMORY.alloc_memory(508),-1,3,2);
  ag_band4.filter.ri_bind(MEMORY.alloc_memory(508),-1,3,0);
  band5.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+4*AF_CurveSlots,4,1);
  gfx_band5.filter.ri_bind(MEMORY.alloc_memory(508),-1,4,2);
  ag_band5.filter.ri_bind(MEMORY.alloc_memory(508),-1,4,0);
  band6.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+5*AF_CurveSlots,5,1);
  gfx_band6.filter.ri_bind(MEMORY.alloc_memory(508),-1,5,2);
  ag_band6.filter.ri_bind(MEMORY.alloc_memory(508),-1,5,0);
  band7.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+6*AF_CurveSlots,6,1);
  gfx_band7.filter.ri_bind(MEMORY.alloc_memory(508),-1,6,2);
  ag_band7.filter.ri_bind(MEMORY.alloc_memory(508),-1,6,0);
  band8.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+7*AF_CurveSlots,7,1);
  gfx_band8.filter.ri_bind(MEMORY.alloc_memory(508),-1,7,2);
  ag_band8.filter.ri_bind(MEMORY.alloc_memory(508),-1,7,0);
  band9.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+8*AF_CurveSlots,8,1);
  gfx_band9.filter.ri_bind(MEMORY.alloc_memory(508),-1,8,2);
  ag_band9.filter.ri_bind(MEMORY.alloc_memory(508),-1,8,0);
  band10.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+9*AF_CurveSlots,9,1);
  gfx_band10.filter.ri_bind(MEMORY.alloc_memory(508),-1,9,2);
  ag_band10.filter.ri_bind(MEMORY.alloc_memory(508),-1,9,0);
  band11.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+10*AF_CurveSlots,10,1);
  gfx_band11.filter.ri_bind(MEMORY.alloc_memory(508),-1,10,2);
  ag_band11.filter.ri_bind(MEMORY.alloc_memory(508),-1,10,0);
  band12.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+11*AF_CurveSlots,11,1);
  gfx_band12.filter.ri_bind(MEMORY.alloc_memory(508),-1,11,2);
  ag_band12.filter.ri_bind(MEMORY.alloc_memory(508),-1,11,0);
  band13.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+12*AF_CurveSlots,12,1);
  gfx_band13.filter.ri_bind(MEMORY.alloc_memory(508),-1,12,2);
  ag_band13.filter.ri_bind(MEMORY.alloc_memory(508),-1,12,0);
  band14.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+13*AF_CurveSlots,13,1);
  gfx_band14.filter.ri_bind(MEMORY.alloc_memory(508),-1,13,2);
  ag_band14.filter.ri_bind(MEMORY.alloc_memory(508),-1,13,0);
  band15.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+14*AF_CurveSlots,14,1);
  gfx_band15.filter.ri_bind(MEMORY.alloc_memory(508),-1,14,2);
  ag_band15.filter.ri_bind(MEMORY.alloc_memory(508),-1,14,0);
  band16.filter.ri_bind(MEMORY.alloc_memory(508),AF_Curves+15*AF_CurveSlots,15,1);
  gfx_band16.filter.ri_bind(MEMORY.alloc_memory(508),-1,15,2);
  ag_band16.filter.ri_bind(MEMORY.alloc_memory(508),-1,15,0);
  dyn_curve.filter.ri_bind(MEMORY.alloc_memory(508),-1,0,2);
  ShowPanel = PanelEnabled;

  // ReEQ3: the linear phase engine's bands (drawing-role filters: the analogue response per bin)
  lpb1.filter.ri_bind(MEMORY.alloc_memory(508),-1,0,2);
  lpb2.filter.ri_bind(MEMORY.alloc_memory(508),-1,1,2);
  lpb3.filter.ri_bind(MEMORY.alloc_memory(508),-1,2,2);
  lpb4.filter.ri_bind(MEMORY.alloc_memory(508),-1,3,2);
  lpb5.filter.ri_bind(MEMORY.alloc_memory(508),-1,4,2);
  lpb6.filter.ri_bind(MEMORY.alloc_memory(508),-1,5,2);
  lpb7.filter.ri_bind(MEMORY.alloc_memory(508),-1,6,2);
  lpb8.filter.ri_bind(MEMORY.alloc_memory(508),-1,7,2);
  lpb9.filter.ri_bind(MEMORY.alloc_memory(508),-1,8,2);
  lpb10.filter.ri_bind(MEMORY.alloc_memory(508),-1,9,2);
  lpb11.filter.ri_bind(MEMORY.alloc_memory(508),-1,10,2);
  lpb12.filter.ri_bind(MEMORY.alloc_memory(508),-1,11,2);
  lpb13.filter.ri_bind(MEMORY.alloc_memory(508),-1,12,2);
  lpb14.filter.ri_bind(MEMORY.alloc_memory(508),-1,13,2);
  lpb15.filter.ri_bind(MEMORY.alloc_memory(508),-1,14,2);
  lpb16.filter.ri_bind(MEMORY.alloc_memory(508),-1,15,2);
  LP_Band = MEMORY.alloc_memory(NUM_BANDS); memset(LP_Band, 0, NUM_BANDS);
  LP_Spec = MEMORY.alloc_memory(NUM_BANDS); memset(LP_Spec, 0, NUM_BANDS);
  LP_DynB = MEMORY.alloc_memory(NUM_BANDS); memset(LP_DynB, 0, NUM_BANDS);
  LP_Dirty = MEMORY.alloc_memory(NUM_BANDS); memset(LP_Dirty, 1, NUM_BANDS);
  LP_LastG = MEMORY.alloc_memory(NUM_BANDS);
  Band_Spec_Level = MEMORY.alloc_memory(NUM_BANDS); memset(Band_Spec_Level, -150, NUM_BANDS);
  // Character
  CHR_FIR = MEMORY.alloc_memory(64); CHR_HIST = MEMORY.alloc_memory(4 * 64);
  chr_init();
  // The engine's memory (16384-sample frames at most), then its per-band rows
  LP_LMAX = 16384; LP_ROW = LP_LMAX + 1;
  MEMORY.index = lp_alloc(MEMORY.index, LP_LMAX);
  LP_BMAG = MEMORY.alloc_memory(NUM_BANDS * LP_ROW);
  LP_BSHAPE = MEMORY.alloc_memory(NUM_BANDS * LP_ROW);
  LP_SPG = MEMORY.alloc_memory(NUM_BANDS * LP_ROW); memset(LP_SPG, 0, NUM_BANDS * LP_ROW);
  LP_TMP = MEMORY.alloc_memory(LP_ROW);
  LP_On = 0; LP_L_Live = 0;

  // Shared spectra: the FFT work area inside one 65536-word block, rings, the measured points
  MEMORY.index = ceil(MEMORY.index / 65536) * 65536;
  PUB_FFT = MEMORY.alloc_memory(PUB_N * 2);
  PUB_RPOST = MEMORY.alloc_memory(PUB_N); PUB_RPRE = MEMORY.alloc_memory(PUB_N); PUB_RSC = MEMORY.alloc_memory(PUB_N);
  PUB_POST_DB = MEMORY.alloc_memory(PUB_PTS); PUB_PRE_DB = MEMORY.alloc_memory(PUB_PTS); PUB_SC_DB = MEMORY.alloc_memory(PUB_PTS);
  memset(PUB_POST_DB, -120, PUB_PTS); memset(PUB_PRE_DB, -120, PUB_PTS); memset(PUB_SC_DB, -120, PUB_PTS);
  PUB_POS = 0; Pub_Count = 0; Pub_Slot = -1;
  // EQ Match
  EQM_SUM_IN = MEMORY.alloc_memory(PUB_PTS); EQM_SUM_REF = MEMORY.alloc_memory(PUB_PTS);
  EQM_CAPSUM = MEMORY.alloc_memory(PUB_PTS);
  EQM_DIFF = MEMORY.alloc_memory(PUB_PTS); EQM_RES = MEMORY.alloc_memory(PUB_PTS); EQM_FIT = MEMORY.alloc_memory(PUB_PTS);
  EQM_FF = MEMORY.alloc_memory(16); EQM_FG = MEMORY.alloc_memory(16); EQM_FQ = MEMORY.alloc_memory(16);
  EQM_Run = 0; EQM_Capturing = 0; !EQM_Src ? EQM_Src = 1;
  // The instance list's rows (slot numbers) and the collisions per point
  INST_ROWS = MEMORY.alloc_memory(GM_SLOTS);
  COLL = MEMORY.alloc_memory(PUB_PTS);
  // The LL/81 output transformer
  tx_setup(srate); ne_setup(srate); tx0.tx_reset(); tx1.tx_reset(); ne0.ne_reset(); ne1.ne_reset(); nemk.eu = nemk.ec = 0; nemk.gm = 1;
  // Luftikus mode
  MEMORY.index = lf_alloc(MEMORY.index);
  LF_LastKeep = -1; Lf_Live = 0;
  // Tonal Balance
  MEMORY.index = tb_alloc(MEMORY.index);
  tb_setup(srate);
  TB_RMB = MEMORY.alloc_memory(NUM_BANDS * 8);
  tbca.tb_bq(0, 250, srate); tbcb.tb_bq(0, 250, srate); tbla.tb_bq(0, 250, srate); tblb.tb_bq(0, 250, srate);
  TB_SegLen = ceil(3 * srate / PUB_HOP); TB_ChunkLen = floor(0.5 * srate);
  TB_Solo = TB_SoloReq = TB_SoloHold = -1; TB_Learn = 0; TB_FA = 0; TB_RmDrag = TB_RmSel = -1;
  tb_live_reset(); TB_Active = TB_ActiveLive = 0;
);
// Saved with the state, so allocated once (not again on a sample rate change)
!reeq3_once ? (
  reeq3_once = 1;
  EQM_CAP = 15000000; memset(EQM_CAP, -120, PUB_PTS);
  EQM_Bands = 8;
  Ext_Src = 0; Collisions_On = 1; Grab_On = 1;
  TBT = 15010000; tb_factory(1, TBT); TB_Target = 1; #TB_Name = "Modern"; TB_Avg = 0; TB_View = 1; TB_MBands = 6;
  #Instance_Name = "";
);
// A new instance gets a tag of its own (a loaded state brings its saved one)
!Instance_Tag ? Instance_Tag = floor(rand(1000000000)) + 1;
// This run's own mark, to tell copies apart
!Pub_RT ? Pub_RT = floor(rand(1000000000)) + 1;
Grab_Band = -1;

@slider

// The Quality slider (Eco/HQ oversampling) is no longer used: the filters
// match the analogue curve up to Nyquist without oversampling. It stays so
// that old projects load.

srate != slider_last_rate ? (
  slider_last_rate = srate;
  flag_filter_update_all();
);

button_stereo_mode.select = Stereo_Mode;

gainDb = 2 ^ (Gain/6);
gainIn = 2 ^ (InGain/6);
gainML = 2 ^ (MLGain/6);
gainSR = 2 ^ (SRGain/6);

// Mark filters for update if sliders have changed
Band_Enabled[0] != Node1_Enabled || Band_Group[0] != Node1_Group || Band_Type[0] != Node1_Type || Band_Gain[0] != Node1_Gain || Band_Frequency[0] != slider_to_freq(Node1_Frequency) || Band_Q[0] != per_to_q(Node1_Q,100) || Band_Slope[0] != Node1_Slope || Band_Dyn_On[0] != Node1_DynOn ? flag_filter_update(0);
Band_Enabled[1] != Node2_Enabled || Band_Group[1] != Node2_Group || Band_Type[1] != Node2_Type || Band_Gain[1] != Node2_Gain || Band_Frequency[1] != slider_to_freq(Node2_Frequency) || Band_Q[1] != per_to_q(Node2_Q,100) || Band_Slope[1] != Node2_Slope || Band_Dyn_On[1] != Node2_DynOn ? flag_filter_update(1);
Band_Enabled[2] != Node3_Enabled || Band_Group[2] != Node3_Group || Band_Type[2] != Node3_Type || Band_Gain[2] != Node3_Gain || Band_Frequency[2] != slider_to_freq(Node3_Frequency) || Band_Q[2] != per_to_q(Node3_Q,100) || Band_Slope[2] != Node3_Slope || Band_Dyn_On[2] != Node3_DynOn ? flag_filter_update(2);
Band_Enabled[3] != Node4_Enabled || Band_Group[3] != Node4_Group || Band_Type[3] != Node4_Type || Band_Gain[3] != Node4_Gain || Band_Frequency[3] != slider_to_freq(Node4_Frequency) || Band_Q[3] != per_to_q(Node4_Q,100) || Band_Slope[3] != Node4_Slope || Band_Dyn_On[3] != Node4_DynOn ? flag_filter_update(3);
Band_Enabled[4] != Node5_Enabled || Band_Group[4] != Node5_Group || Band_Type[4] != Node5_Type || Band_Gain[4] != Node5_Gain || Band_Frequency[4] != slider_to_freq(Node5_Frequency) || Band_Q[4] != per_to_q(Node5_Q,100) || Band_Slope[4] != Node5_Slope || Band_Dyn_On[4] != Node5_DynOn ? flag_filter_update(4);
Band_Enabled[5] != Node6_Enabled || Band_Group[5] != Node6_Group || Band_Type[5] != Node6_Type || Band_Gain[5] != Node6_Gain || Band_Frequency[5] != slider_to_freq(Node6_Frequency) || Band_Q[5] != per_to_q(Node6_Q,100) || Band_Slope[5] != Node6_Slope || Band_Dyn_On[5] != Node6_DynOn ? flag_filter_update(5);
Band_Enabled[6] != Node7_Enabled || Band_Group[6] != Node7_Group || Band_Type[6] != Node7_Type || Band_Gain[6] != Node7_Gain || Band_Frequency[6] != slider_to_freq(Node7_Frequency) || Band_Q[6] != per_to_q(Node7_Q,100) || Band_Slope[6] != Node7_Slope || Band_Dyn_On[6] != Node7_DynOn ? flag_filter_update(6);
Band_Enabled[7] != Node8_Enabled || Band_Group[7] != Node8_Group || Band_Type[7] != Node8_Type || Band_Gain[7] != Node8_Gain || Band_Frequency[7] != slider_to_freq(Node8_Frequency) || Band_Q[7] != per_to_q(Node8_Q,100) || Band_Slope[7] != Node8_Slope || Band_Dyn_On[7] != Node8_DynOn ? flag_filter_update(7);
Band_Enabled[8] != Node9_Enabled || Band_Group[8] != Node9_Group || Band_Type[8] != Node9_Type || Band_Gain[8] != Node9_Gain || Band_Frequency[8] != slider_to_freq(Node9_Frequency) || Band_Q[8] != per_to_q(Node9_Q,100) || Band_Slope[8] != Node9_Slope || Band_Dyn_On[8] != Node9_DynOn ? flag_filter_update(8);
Band_Enabled[9] != Node10_Enabled || Band_Group[9] != Node10_Group || Band_Type[9] != Node10_Type || Band_Gain[9] != Node10_Gain || Band_Frequency[9] != slider_to_freq(Node10_Frequency) || Band_Q[9] != per_to_q(Node10_Q,100) || Band_Slope[9] != Node10_Slope || Band_Dyn_On[9] != Node10_DynOn ? flag_filter_update(9);
Band_Enabled[10] != Node11_Enabled || Band_Group[10] != Node11_Group || Band_Type[10] != Node11_Type || Band_Gain[10] != Node11_Gain || Band_Frequency[10] != slider_to_freq(Node11_Frequency) || Band_Q[10] != per_to_q(Node11_Q,100) || Band_Slope[10] != Node11_Slope || Band_Dyn_On[10] != Node11_DynOn ? flag_filter_update(10);
Band_Enabled[11] != Node12_Enabled || Band_Group[11] != Node12_Group || Band_Type[11] != Node12_Type || Band_Gain[11] != Node12_Gain || Band_Frequency[11] != slider_to_freq(Node12_Frequency) || Band_Q[11] != per_to_q(Node12_Q,100) || Band_Slope[11] != Node12_Slope || Band_Dyn_On[11] != Node12_DynOn ? flag_filter_update(11);
Band_Enabled[12] != Node13_Enabled || Band_Group[12] != Node13_Group || Band_Type[12] != Node13_Type || Band_Gain[12] != Node13_Gain || Band_Frequency[12] != slider_to_freq(Node13_Frequency) || Band_Q[12] != per_to_q(Node13_Q,100) || Band_Slope[12] != Node13_Slope || Band_Dyn_On[12] != Node13_DynOn ? flag_filter_update(12);
Band_Enabled[13] != Node14_Enabled || Band_Group[13] != Node14_Group || Band_Type[13] != Node14_Type || Band_Gain[13] != Node14_Gain || Band_Frequency[13] != slider_to_freq(Node14_Frequency) || Band_Q[13] != per_to_q(Node14_Q,100) || Band_Slope[13] != Node14_Slope || Band_Dyn_On[13] != Node14_DynOn ? flag_filter_update(13);
Band_Enabled[14] != Node15_Enabled || Band_Group[14] != Node15_Group || Band_Type[14] != Node15_Type || Band_Gain[14] != Node15_Gain || Band_Frequency[14] != slider_to_freq(Node15_Frequency) || Band_Q[14] != per_to_q(Node15_Q,100) || Band_Slope[14] != Node15_Slope || Band_Dyn_On[14] != Node15_DynOn ? flag_filter_update(14);
Band_Enabled[15] != Node16_Enabled || Band_Group[15] != Node16_Group || Band_Type[15] != Node16_Type || Band_Gain[15] != Node16_Gain || Band_Frequency[15] != slider_to_freq(Node16_Frequency) || Band_Q[15] != per_to_q(Node16_Q,100) || Band_Slope[15] != Node16_Slope || Band_Dyn_On[15] != Node16_DynOn ? flag_filter_update(15);

// Scale applies to every band's gain, so automating it must update them all
Scale != slider_last_scale ? (
  slider_last_scale = Scale;
  flag_filter_update_all();
);

// Update any automation
sliders_to_filters();



update_state();

@serialize

file_avail(handle) >= 0 ? (
  // Read mode
  file_var(0, version);
  // Files before 112 have no UI size: they follow the default
  UI_Size = 0;

  version >= 100 ? (
    file_var(0, numBands);
    file_mem(0, Band_Enabled, numBands);
    file_mem(0, Band_Group, numBands);
    file_mem(0, Band_Type, numBands);
    file_mem(0, Band_Frequency, numBands);
    file_mem(0, Band_Gain, numBands);
    file_mem(0, Band_Q, numBands);
    file_mem(0, Band_Slope, numBands);
    file_mem(0, Band_Dynamic_Range, numBands);
    file_mem(0, Band_Red, numBands);
    file_mem(0, Band_Green, numBands);
    file_mem(0, Band_Blue, numBands);

    // Dynamics, from 110. Older files had no dynamics: their unused range values go back to the default.
    version >= 110 ? (
      file_mem(0, Band_Dyn_On, numBands);
      file_mem(0, Band_Dyn_Thresh, numBands);
      file_mem(0, Band_Dyn_Ratio, numBands);
      file_mem(0, Band_Dyn_Attack, numBands);
      file_mem(0, Band_Dyn_Release, numBands);
      file_mem(0, Band_Dyn_Auto, numBands);
      file_mem(0, Band_Dyn_Source, numBands);
      file_mem(0, Band_Dyn_Link, numBands);
      file_mem(0, Band_Dyn_DetFreq, numBands);
      file_mem(0, Band_Dyn_DetWidth, numBands);
      // Before 111 a linked band's detector had never been placed (its width was 1 by default, not 0), so
      // unlinking it starts at the band
      version < 111 ? (
        band = 0;
        loop(NUM_BANDS, Band_Dyn_Link[band] ? Band_Dyn_DetWidth[band] = 0; band += 1);
      );
    ) : (
      band = 0;
      loop(NUM_BANDS, band_dyn_defaults(band); band += 1);
    );

    // The UI size, from 112: 0 follows the default, else this instance's size in %. Changing it doesn't
    // mark the project modified (that takes a slider change, and an undo point per click): it's saved
    // with the next save, and presets, undo and A/B carry it with the rest of the state.
    version >= 112 ? (
      file_var(0, UI_Size);
      !ui_size_valid(UI_Size) ? UI_Size = 0;
    );

    // ReEQ3, from 113: per band the Gain-Q interaction, Auto threshold and spectral dynamics, then the
    // instance's settings that have no slider. Older states (ReEQ2's, carried over by the upgrade action)
    // drew bells, shelves and tilt shelves at 12 dB/oct whatever their slope: they keep that.
    version >= 113 ? (
      file_mem(0, Band_GainQ, numBands);
      file_mem(0, Band_Dyn_AutoThr, numBands);
      file_mem(0, Band_Spectral, numBands);
      file_mem(0, Band_SpecDensity, numBands);
      file_mem(0, Band_SpecTilt, numBands);
      reeq3_serialize_extra(0);
      version >= 114 ? (tb_serialize(); TB_Target > 0 ? tb_factory(TB_Target, TBT));
    ) : (
      band = 0;
      loop(numBands,
        Band_Type[band] == FILTER_PEAK || Band_Type[band] == FILTER_LOW_SHELF || Band_Type[band] == FILTER_HIGH_SHELF ||
          Band_Type[band] == FILTER_TILT_SHELF ? Band_Slope[band] = 1;
        Band_GainQ[band] = Band_Dyn_AutoThr[band] = Band_Spectral[band] = 0;
        Band_SpecDensity[band] = 50; Band_SpecTilt[band] = 1;
        band += 1;
      );
    );

  ) : (
    // Old version that has no version number
    // We've already read the first value and it wasn't a version
    // number, it's the enabled status for band 0
    Band_Enabled[0] = version;
    file_mem(0, Band_Enabled+1, 7);
    file_mem(0, Band_Group, 8);
    file_mem(0, Band_Type, 8);
    file_mem(0, Band_Frequency, 8);
    file_mem(0, Band_Gain, 8);
    file_mem(0, Band_Q, 8);
    file_mem(0, Band_Slope, 8);
    file_mem(0, Band_Dynamic_Range, 8);
    file_mem(0, Band_Red, 8);
    file_mem(0, Band_Green, 8);
    file_mem(0, Band_Blue, 8);

    band = 0;
    loop(NUM_BANDS, band_dyn_defaults(band); band += 1);
  );

) : (
  // Write mode
  // The version number should reflect the ReEQ version when the file
  // format changed.
  version = 114;

  file_var(0, version);
  file_var(0, NUM_BANDS);
  file_mem(0, Band_Enabled, NUM_BANDS);
  file_mem(0, Band_Group, NUM_BANDS);
  file_mem(0, Band_Type, NUM_BANDS);
  file_mem(0, Band_Frequency, NUM_BANDS);
  file_mem(0, Band_Gain, NUM_BANDS);
  file_mem(0, Band_Q, NUM_BANDS);
  file_mem(0, Band_Slope, NUM_BANDS);
  file_mem(0, Band_Dynamic_Range, NUM_BANDS);
  file_mem(0, Band_Red, NUM_BANDS);
  file_mem(0, Band_Green, NUM_BANDS);
  file_mem(0, Band_Blue, NUM_BANDS);
  file_mem(0, Band_Dyn_On, NUM_BANDS);
  file_mem(0, Band_Dyn_Thresh, NUM_BANDS);
  file_mem(0, Band_Dyn_Ratio, NUM_BANDS);
  file_mem(0, Band_Dyn_Attack, NUM_BANDS);
  file_mem(0, Band_Dyn_Release, NUM_BANDS);
  file_mem(0, Band_Dyn_Auto, NUM_BANDS);
  file_mem(0, Band_Dyn_Source, NUM_BANDS);
  file_mem(0, Band_Dyn_Link, NUM_BANDS);
  file_mem(0, Band_Dyn_DetFreq, NUM_BANDS);
  file_mem(0, Band_Dyn_DetWidth, NUM_BANDS);
  file_var(0, UI_Size);
  file_mem(0, Band_GainQ, NUM_BANDS);
  file_mem(0, Band_Dyn_AutoThr, NUM_BANDS);
  file_mem(0, Band_Spectral, NUM_BANDS);
  file_mem(0, Band_SpecDensity, NUM_BANDS);
  file_mem(0, Band_SpecTilt, NUM_BANDS);
  reeq3_serialize_extra(1);
  tb_serialize();
);

flag_filter_update_all();

filters_to_sliders();

@block

// Get array accessed variables per block to make access faster
// in @sample section

AF_Clock+=samplesblock;
// ReEQ3: band changes sent by another instance (remote editing), and showing this one's bands to it
rm_target_block();
update_audio_filters();
AF_Pending || AF_Job>=0?ri_block_work();
update_auto_gain();
// ReEQ3 Tonal Balance: measured while its panel or overlay shows (or while learning)
TB_Active = time_precise() - TB_Seen < 3 || TB_Learn > 0;
(TB_Active && !TB_ActiveLive) || TB_ResetReq ? (tb_live_reset(); TB_ResetReq = 0);
TB_ActiveLive = TB_Active;
TB_CrestDue ? (tb_crest_update(); TB_CrestDue = 0);
// The band solo: only while the panel holds it
TB_SoloReq >= 0 && time_precise() - TB_Seen > 0.5 ? TB_SoloReq = -1;
TB_SoloReq != TB_Solo ? (
  TB_Solo = TB_SoloReq;
  TB_Solo >= 0 ? (
    tb_lpf = TB_Solo == 0 ? 250 : TB_Solo == 1 ? 2000 : 8000;
    tb_hpf = TB_Solo == 1 ? 250 : TB_Solo == 2 ? 2000 : 8000;
    tsl0a.tb_bq(0, tb_lpf, srate); tsl0b.tb_bq(0, tb_lpf, srate); tsl1a.tb_bq(0, tb_lpf, srate); tsl1b.tb_bq(0, tb_lpf, srate);
    tsh0a.tb_bq(1, tb_hpf, srate); tsh0b.tb_bq(1, tb_hpf, srate); tsh1a.tb_bq(1, tb_hpf, srate); tsh1b.tb_bq(1, tb_hpf, srate);
    tsl0a.tb_zero(); tsl0b.tb_zero(); tsl1a.tb_zero(); tsl1b.tb_zero(); tsh0a.tb_zero(); tsh0b.tb_zero(); tsh1a.tb_zero(); tsh1b.tb_zero();
  );
);
pub_block();

// Dynamic bands: enabled, a bell or shelf, with dynamics on
Dyn_Active0 = Band_Dyn_On[0] && Band_Enabled[0] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[0]); Dyn_Active0 ? band1.band_dyn_block(0) : (Band_Dyn_Gain[0] = 0; Band_Dyn_Level[0] = -150);
Dyn_Active1 = Band_Dyn_On[1] && Band_Enabled[1] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[1]); Dyn_Active1 ? band2.band_dyn_block(1) : (Band_Dyn_Gain[1] = 0; Band_Dyn_Level[1] = -150);
Dyn_Active2 = Band_Dyn_On[2] && Band_Enabled[2] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[2]); Dyn_Active2 ? band3.band_dyn_block(2) : (Band_Dyn_Gain[2] = 0; Band_Dyn_Level[2] = -150);
Dyn_Active3 = Band_Dyn_On[3] && Band_Enabled[3] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[3]); Dyn_Active3 ? band4.band_dyn_block(3) : (Band_Dyn_Gain[3] = 0; Band_Dyn_Level[3] = -150);
Dyn_Active4 = Band_Dyn_On[4] && Band_Enabled[4] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[4]); Dyn_Active4 ? band5.band_dyn_block(4) : (Band_Dyn_Gain[4] = 0; Band_Dyn_Level[4] = -150);
Dyn_Active5 = Band_Dyn_On[5] && Band_Enabled[5] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[5]); Dyn_Active5 ? band6.band_dyn_block(5) : (Band_Dyn_Gain[5] = 0; Band_Dyn_Level[5] = -150);
Dyn_Active6 = Band_Dyn_On[6] && Band_Enabled[6] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[6]); Dyn_Active6 ? band7.band_dyn_block(6) : (Band_Dyn_Gain[6] = 0; Band_Dyn_Level[6] = -150);
Dyn_Active7 = Band_Dyn_On[7] && Band_Enabled[7] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[7]); Dyn_Active7 ? band8.band_dyn_block(7) : (Band_Dyn_Gain[7] = 0; Band_Dyn_Level[7] = -150);
Dyn_Active8 = Band_Dyn_On[8] && Band_Enabled[8] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[8]); Dyn_Active8 ? band9.band_dyn_block(8) : (Band_Dyn_Gain[8] = 0; Band_Dyn_Level[8] = -150);
Dyn_Active9 = Band_Dyn_On[9] && Band_Enabled[9] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[9]); Dyn_Active9 ? band10.band_dyn_block(9) : (Band_Dyn_Gain[9] = 0; Band_Dyn_Level[9] = -150);
Dyn_Active10 = Band_Dyn_On[10] && Band_Enabled[10] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[10]); Dyn_Active10 ? band11.band_dyn_block(10) : (Band_Dyn_Gain[10] = 0; Band_Dyn_Level[10] = -150);
Dyn_Active11 = Band_Dyn_On[11] && Band_Enabled[11] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[11]); Dyn_Active11 ? band12.band_dyn_block(11) : (Band_Dyn_Gain[11] = 0; Band_Dyn_Level[11] = -150);
Dyn_Active12 = Band_Dyn_On[12] && Band_Enabled[12] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[12]); Dyn_Active12 ? band13.band_dyn_block(12) : (Band_Dyn_Gain[12] = 0; Band_Dyn_Level[12] = -150);
Dyn_Active13 = Band_Dyn_On[13] && Band_Enabled[13] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[13]); Dyn_Active13 ? band14.band_dyn_block(13) : (Band_Dyn_Gain[13] = 0; Band_Dyn_Level[13] = -150);
Dyn_Active14 = Band_Dyn_On[14] && Band_Enabled[14] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[14]); Dyn_Active14 ? band15.band_dyn_block(14) : (Band_Dyn_Gain[14] = 0; Band_Dyn_Level[14] = -150);
Dyn_Active15 = Band_Dyn_On[15] && Band_Enabled[15] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[15]); Dyn_Active15 ? band16.band_dyn_block(15) : (Band_Dyn_Gain[15] = 0; Band_Dyn_Level[15] = -150);
// ReEQ3: which bands the linear phase engine runs (all of them in Linear Phase mode, else the spectral
// ones), its frame size, and its filter when a band in it changed
LP_All = Proc_Mode == 1;
lp_any = 0; LP_WANT_LEVELS = 0; LP_WANT_SC = 0; LP_DynAny = 0;
lp_b = 0;
loop(NUM_BANDS,
  lp_live = Band_Enabled[lp_b] == BAND_STATE_ENABLED;
  lp_dyn = lp_live && Band_Dyn_On[lp_b] && band_dyn_capable(Band_Type[lp_b]);
  lp_isspec = lp_dyn && Band_Spectral[lp_b];
  lp_in = LP_All ? lp_live : lp_isspec;
  lp_in != LP_Band[lp_b] || lp_isspec != LP_Spec[lp_b] ? (LP_Band[lp_b] = lp_in; LP_Spec[lp_b] = lp_isspec; LP_Dirty[lp_b] = 1; LP_Changed = 1);
  LP_DynB[lp_b] = lp_in && lp_dyn;
  lp_in ? (
    lp_any = 1;
    lp_dyn ? LP_DynAny = 1;
    lp_isspec ? (
      LP_WANT_LEVELS = 1;
      Band_Dyn_Source[lp_b] > 0 ? (LP_WANT_SC = 1; LP_SC_SRC = Band_Dyn_Source[lp_b]);
    );
  );
  lp_b += 1;
);
lp_want_l = min(2048 * 2 ^ LP_Res * (srate > 64000 ? 2 : 1), LP_LMAX);
LP_On_New = lp_any;
LP_On_New && (!LP_On || lp_want_l != LP_L_Live) ? (
  LP_L_Live = lp_want_l;
  lp_setup(lp_want_l);
  memset(LP_Dirty, 1, NUM_BANDS); memset(LP_SPG, 0, NUM_BANDS * LP_ROW);
  LP_Changed = 1;
);
LP_On = LP_On_New;
LP_On ? (
  lp_b = 0;
  loop(NUM_BANDS,
    LP_Band[lp_b] && LP_Dirty[lp_b] ? (
      LP_Dirty[lp_b] = 0;
      lp_fill_band(lp_b, lp_band_gain(lp_b));
      LP_Changed = 1;
    );
    lp_b += 1;
  );
  LP_Changed ? (LP_Changed = 0; lp_build(); lp_design_full());
);

// Lookahead: the bands hear the input la_len samples late, so the detectors (undelayed) hear ahead of
// them. REAPER is told the delay; Off adds none. (The linear phase engine has its own: none here then.)
la_want = LP_On ? 0 : Lookahead_Value == 0 ? 0 : min(floor(srate * (Lookahead_Value == 1 ? 0.001 : Lookahead_Value == 2 ? 0.005 : 0.01) + 0.5), LA_MAX);
la_want != la_len ? (
  la_len = la_want; la_pos = 0;
  memset(Dyn_LaBuf, 0, 4 * LA_MAX);
);
// The delay REAPER compensates: the lookahead, or the linear phase engine's latency
lp_pdc = la_len + (LP_On ? LP_LAT : 0) + (Character > 0 && Quality ? 15 : 0);
lp_pdc != pdc_delay ? (pdc_delay = lp_pdc; pdc_bot_ch = 0; pdc_top_ch = 2);
// A start or stop mustn't replay what was in the line from before
play_state != la_play ? (
  la_play = play_state;
  la_len > 0 ? memset(Dyn_LaBuf, 0, 4 * LA_MAX);
);

Dyn_Any = Dyn_Active0 || Dyn_Active1 || Dyn_Active2 || Dyn_Active3 || Dyn_Active4 || Dyn_Active5 || Dyn_Active6 || Dyn_Active7 || Dyn_Active8 || Dyn_Active9 || Dyn_Active10 || Dyn_Active11 || Dyn_Active12 || Dyn_Active13 || Dyn_Active14 || Dyn_Active15;
Dyn_Active_Listen = Dyn_Listen >= 0 && Band_Dyn_On[Dyn_Listen] && Band_Enabled[Dyn_Listen] == BAND_STATE_ENABLED && band_dyn_capable(Band_Type[Dyn_Listen]);

Band_Process0 = band1.filter.nrun>0 || !band1.filter.ri_resting();
LP_Band[0] ? Band_Process0 = 0;
AF_Quick0=Band_Group[0]===0?band1.filter.ri_fast_kind():0;
Band_Process1 = band2.filter.nrun>0 || !band2.filter.ri_resting();
LP_Band[1] ? Band_Process1 = 0;
AF_Quick1=Band_Group[1]===0?band2.filter.ri_fast_kind():0;
Band_Process2 = band3.filter.nrun>0 || !band3.filter.ri_resting();
LP_Band[2] ? Band_Process2 = 0;
AF_Quick2=Band_Group[2]===0?band3.filter.ri_fast_kind():0;
Band_Process3 = band4.filter.nrun>0 || !band4.filter.ri_resting();
LP_Band[3] ? Band_Process3 = 0;
AF_Quick3=Band_Group[3]===0?band4.filter.ri_fast_kind():0;
Band_Process4 = band5.filter.nrun>0 || !band5.filter.ri_resting();
LP_Band[4] ? Band_Process4 = 0;
AF_Quick4=Band_Group[4]===0?band5.filter.ri_fast_kind():0;
Band_Process5 = band6.filter.nrun>0 || !band6.filter.ri_resting();
LP_Band[5] ? Band_Process5 = 0;
AF_Quick5=Band_Group[5]===0?band6.filter.ri_fast_kind():0;
Band_Process6 = band7.filter.nrun>0 || !band7.filter.ri_resting();
LP_Band[6] ? Band_Process6 = 0;
AF_Quick6=Band_Group[6]===0?band7.filter.ri_fast_kind():0;
Band_Process7 = band8.filter.nrun>0 || !band8.filter.ri_resting();
LP_Band[7] ? Band_Process7 = 0;
AF_Quick7=Band_Group[7]===0?band8.filter.ri_fast_kind():0;
Band_Process8 = band9.filter.nrun>0 || !band9.filter.ri_resting();
LP_Band[8] ? Band_Process8 = 0;
AF_Quick8=Band_Group[8]===0?band9.filter.ri_fast_kind():0;
Band_Process9 = band10.filter.nrun>0 || !band10.filter.ri_resting();
LP_Band[9] ? Band_Process9 = 0;
AF_Quick9=Band_Group[9]===0?band10.filter.ri_fast_kind():0;
Band_Process10 = band11.filter.nrun>0 || !band11.filter.ri_resting();
LP_Band[10] ? Band_Process10 = 0;
AF_Quick10=Band_Group[10]===0?band11.filter.ri_fast_kind():0;
Band_Process11 = band12.filter.nrun>0 || !band12.filter.ri_resting();
LP_Band[11] ? Band_Process11 = 0;
AF_Quick11=Band_Group[11]===0?band12.filter.ri_fast_kind():0;
Band_Process12 = band13.filter.nrun>0 || !band13.filter.ri_resting();
LP_Band[12] ? Band_Process12 = 0;
AF_Quick12=Band_Group[12]===0?band13.filter.ri_fast_kind():0;
Band_Process13 = band14.filter.nrun>0 || !band14.filter.ri_resting();
LP_Band[13] ? Band_Process13 = 0;
AF_Quick13=Band_Group[13]===0?band14.filter.ri_fast_kind():0;
Band_Process14 = band15.filter.nrun>0 || !band15.filter.ri_resting();
LP_Band[14] ? Band_Process14 = 0;
AF_Quick14=Band_Group[14]===0?band15.filter.ri_fast_kind():0;
Band_Process15 = band16.filter.nrun>0 || !band16.filter.ri_resting();
LP_Band[15] ? Band_Process15 = 0;
AF_Quick15=Band_Group[15]===0?band16.filter.ri_fast_kind():0;

Band_Group0 = Band_Group[0];
Band_Group1 = Band_Group[1];
Band_Group2 = Band_Group[2];
Band_Group3 = Band_Group[3];
Band_Group4 = Band_Group[4];
Band_Group5 = Band_Group[5];
Band_Group6 = Band_Group[6];
Band_Group7 = Band_Group[7];
Band_Group8 = Band_Group[8];
Band_Group9 = Band_Group[9];
Band_Group10 = Band_Group[10];
Band_Group11 = Band_Group[11];
Band_Group12 = Band_Group[12];
Band_Group13 = Band_Group[13];
Band_Group14 = Band_Group[14];
Band_Group15 = Band_Group[15];

Listen_Process = do_listen || listen_node != -1 || !listen_filter.ivf_is_resting();

ag_block_target = AutoGainEnabled ? AG_Target : 1;

// The output Mid/Side gains need the Mid/Side round trip only when they do something
Out_MS = gainML != 1 || gainSR != 1 || MidPolarity || SidePolarity;

// ReEQ3 LL/81: the drive as a gain; switching it on starts it clean
Tx_DriveGain = 10 ^ (min(max(Tx_Drive, 0), 36) / 20);
Tx_Model = Tx_On ? (Tx_Type >= 0.5 ? 2 : 1) : 0;
Tx_Model != Tx_Live ? (tx0.tx_reset(); tx1.tx_reset(); ne0.ne_reset(); ne1.ne_reset());
Tx_Live = Tx_Model;

// ReEQ3 Luftikus mode: its parameters into the engine; switching it on starts its filters clean
lf_block(srate, Lf_G10, Lf_G40, Lf_G160, Lf_G640, Lf_G2k5, Lf_Air, Lf_AirType, Lf_Keep, Lf_Analog, Lf_Mastering, Lf_Trim);
Lf_On && !Lf_Live ? lf_reset();
Lf_Live = Lf_On;

// ReEQ3 output pan: a balance, between left and right or between mid and side
op_p = min(max(Out_Pan / 100, -1), 1);
Out_PanG0 = op_p > 0 ? 1 - op_p : 1;
Out_PanG1 = op_p < 0 ? 1 + op_p : 1;
Out_PanOn = op_p != 0;
// Character
Character != chr_mode_live ? (chr_mode_live = Character; Character > 0 ? chr_set(Character); chr_init(); chr_dc0 = chr_dc1 = chr_dx0 = chr_dx1 = 0);
CHR_HQ != Quality ? (CHR_HQ = Quality; chr_init());
chr_hp = 1 - exp(-2 * $pi * 5 / srate);

@sample

function encodeMS(l, r, mid*, side*) ( 
  mid = (l+r) * 0.5;
  side = (l-r) * 0.5;
);

function decodeMS(mid, side, l*, r*) (
  l = mid + side;
  r = mid - side;
);

spl0 += 0.0000000001; // DeNorm fix
spl1 += 0.0000000001; // DeNorm fix

// Input trim, before everything (the pre-EQ spectrum shows the trimmed input), and its peak for the meter
spl0 *= gainIn;
spl1 *= gainIn;
in_pk0 = max(in_pk0, abs(spl0));
in_pk1 = max(in_pk1, abs(spl1));
pub_in = (spl0 + spl1) * 0.5;

// Dynamic bands: their detectors hear the trimmed input (or a sidechain), before any band
Dyn_Any ? (
  Dyn_Active0 ? band1.band_dyn_tick(0, Band_Group0, Band_Dyn_Source[0]);
  Dyn_Active1 ? band2.band_dyn_tick(1, Band_Group1, Band_Dyn_Source[1]);
  Dyn_Active2 ? band3.band_dyn_tick(2, Band_Group2, Band_Dyn_Source[2]);
  Dyn_Active3 ? band4.band_dyn_tick(3, Band_Group3, Band_Dyn_Source[3]);
  Dyn_Active4 ? band5.band_dyn_tick(4, Band_Group4, Band_Dyn_Source[4]);
  Dyn_Active5 ? band6.band_dyn_tick(5, Band_Group5, Band_Dyn_Source[5]);
  Dyn_Active6 ? band7.band_dyn_tick(6, Band_Group6, Band_Dyn_Source[6]);
  Dyn_Active7 ? band8.band_dyn_tick(7, Band_Group7, Band_Dyn_Source[7]);
  Dyn_Active8 ? band9.band_dyn_tick(8, Band_Group8, Band_Dyn_Source[8]);
  Dyn_Active9 ? band10.band_dyn_tick(9, Band_Group9, Band_Dyn_Source[9]);
  Dyn_Active10 ? band11.band_dyn_tick(10, Band_Group10, Band_Dyn_Source[10]);
  Dyn_Active11 ? band12.band_dyn_tick(11, Band_Group11, Band_Dyn_Source[11]);
  Dyn_Active12 ? band13.band_dyn_tick(12, Band_Group12, Band_Dyn_Source[12]);
  Dyn_Active13 ? band14.band_dyn_tick(13, Band_Group13, Band_Dyn_Source[13]);
  Dyn_Active14 ? band15.band_dyn_tick(14, Band_Group14, Band_Dyn_Source[14]);
  Dyn_Active15 ? band16.band_dyn_tick(15, Band_Group15, Band_Dyn_Source[15]);
);

// The ghost spectrum: the followed band's detector input, before its filter, in its placement
Ghost_Band >= 0 ? (
  gs_src = Band_Dyn_Source[Ghost_Band]; gs_grp = Band_Group[Ghost_Band];
  gs_src > 0 ? (gs_l = spl(2 * gs_src); gs_r = spl(2 * gs_src + 1)) : (gs_l = spl0; gs_r = spl1);
  spectrum.sample6(gs_grp <= 1 ? (gs_l + gs_r) * 0.5 : gs_grp == 2 ? (gs_l - gs_r) * 0.5 : gs_grp == 3 ? gs_l : gs_r);
);

// Lookahead: the main path waits la_len samples (read the oldest, then write over it), and so does
// the detector Listen signal, so what you hear stays where REAPER's delay compensation expects it
la_len > 0 ? (
  la_i = Dyn_LaBuf + 4 * la_pos;
  la_t = la_i[0]; la_i[0] = spl0; spl0 = la_t;
  la_t = la_i[1]; la_i[1] = spl1; spl1 = la_t;
  Dyn_Listen >= 0 ? (
    la_t = la_i[2]; la_i[2] = Dyn_ListenL; Dyn_ListenL = la_t;
    la_t = la_i[3]; la_i[3] = Dyn_ListenR; Dyn_ListenR = la_t;
  );
  (la_pos += 1) >= la_len ? la_pos = 0;
);

// Feed the correct buffers depending on spectrum modes
Show_PreEQ ? (
  SPEC_MODE == 0 ? spectrum.sample2(spl0 + spl1) :
  SPEC_MODE == 1 ? spectrum.sample2((spl0 + spl1) * 0.5) :
  SPEC_MODE == 2 ? spectrum.sample2((spl0 - spl1) * 0.5) :
  SPEC_MODE == 3 ? (spectrum.sample2((spl0 + spl1) * 0.5); spectrum.sample3((spl0 - spl1) * 0.5)) :
  SPEC_MODE == 4 ? spectrum.sample2(spl0);
  SPEC_MODE == 5 ? spectrum.sample2(spl1) :
  SPEC_MODE == 6 ? (spectrum.sample2(spl0); spectrum.sample3(spl1));
);

Listen_Process ? listen_filter.ivf_tick();

!Listen_Process ? (

  Band_Process0 ? (AF_Quick0?(
    af_io.l=spl0;af_io.r=spl1;
    AF_Quick0===1?band1.filter.s1.ip_unity3(af_io):AF_Quick0===2?band1.filter.s1.ip_zero3(af_io):
    AF_Quick0===3?band1.filter.s1.ip_gain3(af_io):AF_Quick0===4?band1.filter.s1.ip_allpass2(af_io):
    AF_Quick0===5?band1.filter.s1.ip_zero2(af_io):AF_Quick0===6?band1.filter.s1.ip_unity2(af_io):band1.filter.s1.ip_notch_parallel(af_io);
    spl0=af_io.l;spl1=af_io.r;
  ):(
    group=Band_Group0;
    group===1 || group===2 ? (
      encodeMS(spl0,spl1,mid0,side0);af_io.l=group===1?mid0:0;af_io.r=group===2?side0:0;
      band1.filter.ri_process(af_io);
      group===1?mid0=af_io.l:side0=af_io.r;decodeMS(mid0,side0,spl0,spl1);
    ) : (
      af_io.l=group===4?0:spl0;af_io.r=group===3?0:spl1;band1.filter.ri_process(af_io);
      group!==4?spl0=af_io.l;group!==3?spl1=af_io.r;
    );
  ););
  Band_Process1 ? (AF_Quick1?(
    af_io.l=spl0;af_io.r=spl1;
    AF_Quick1===1?band2.filter.s1.ip_unity3(af_io):AF_Quick1===2?band2.filter.s1.ip_zero3(af_io):
    AF_Quick1===3?band2.filter.s1.ip_gain3(af_io):AF_Quick1===4?band2.filter.s1.ip_allpass2(af_io):
    AF_Quick1===5?band2.filter.s1.ip_zero2(af_io):AF_Quick1===6?band2.filter.s1.ip_unity2(af_io):band2.filter.s1.ip_notch_parallel(af_io);
    spl0=af_io.l;spl1=af_io.r;
  ):(
    group=Band_Group1;
    group===1 || group===2 ? (
      encodeMS(spl0,spl1,mid0,side0);af_io.l=group===1?mid0:0;af_io.r=group===2?side0:0;
      band2.filter.ri_process(af_io);
      group===1?mid0=af_io.l:side0=af_io.r;decodeMS(mid0,side0,spl0,spl1);
    ) : (
      af_io.l=group===4?0:spl0;af_io.r=group===3?0:spl1;band2.filter.ri_process(af_io);
      group!==4?spl0=af_io.l;group!==3?spl1=af_io.r;
    );
  ););
  Band_Process2 ? (AF_Quick2?(
    af_io.l=spl0;af_io.r=spl1;
    AF_Quick2===1?band3.filter.s1.ip_unity3(af_io):AF_Quick2===2?band3.filter.s1.ip_zero3(af_io):
    AF_Quick2===3?band3.filter.s1.ip_gain3(af_io):AF_Quick2===4?band3.filter.s1.ip_allpass2(af_io):
    AF_Quick2===5?band3.filter.s1.ip_zero2(af_io):AF_Quick2===6?band3.filter.s1.ip_unity2(af_io):band3.filter.s1.ip_notch_parallel(af_io);
    spl0=af_io.l;spl1=af_io.r;
  ):(
    group=Band_Group2;
    group===1 || group===2 ? (
      encodeMS(spl0,spl1,mid0,side0);af_io.l=group===1?mid0:0;af_io.r=group===2?side0:0;
      band3.filter.ri_process(af_io);
      group===1?mid0=af_io.l:side0=af_io.r;decodeMS(mid0,side0,spl0,spl1);
    ) : (
      af_io.l=group===4?0:spl0;af_io.r=group===3?0:spl1;band3.filter.ri_process(af_io);
      group!==4?spl0=af_io.l;group!==3?spl1=af_io.r;
    );
  ););
  Band_Process3 ? (AF_Quick3?(
    af_io.l=spl0;af_io.r=spl1;
    AF_Quick3===1?band4.filter.s1.ip_unity3(af_io):AF_Quick3===2?band4.filter.s1.ip_zero3(af_io):
    AF_Quick3===3?band4.filter.s1.ip_gain3(af_io):AF_Quick3===4?band4.filter.s1.ip_allpass2(af_io):
