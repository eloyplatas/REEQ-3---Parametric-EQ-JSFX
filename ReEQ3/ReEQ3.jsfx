  Band_Update[11] && (Band_Dyn_On[11] || AF_Clock>=AF_Due[11]) ? (AF_Due[11]=AF_Clock+32; Band_Update[11] = 0; Band_Enabled[11] != BAND_STATE_ENABLED ? band12.band_off() :
    Band_Dyn_On[11] && band_dyn_capable(Band_Type[11]) ? band12.band_dyn_set_filter(11, band_scalar) :
