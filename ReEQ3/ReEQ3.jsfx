  Band_Update[8] && (Band_Dyn_On[8] || AF_Clock>=AF_Due[8]) ? (AF_Due[8]=AF_Clock+32; Band_Update[8] = 0; Band_Enabled[8] != BAND_STATE_ENABLED ? band9.band_off() :
